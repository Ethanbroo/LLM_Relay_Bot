-- Card with coloured header and blue body ("Coin Magnet" card in image 2).
-- Returns the card and its body frame (put content in the body).
function Theme.Card(props: Props): (Frame, Frame)
	local headerColor: Color3 = props.HeaderColor or P.CardOrange
	local headerDark: Color3 = props.HeaderDarkColor or P.CardOrangeDark
	local bodyColor: Color3 = props.BodyColor or P.CardBlue
	local bodyDark: Color3 = props.BodyDarkColor or P.CardBlueDark
	local headerHeight: number = props.HeaderHeight or 40

	local card = Instance.new("Frame")
	card.Name = props.Name or "Card"
	card.BackgroundColor3 = bodyDark
	card.Size = UDim2.fromOffset(180, 220)
	applyGeneric(card, props)
	card.ClipsDescendants = false
	Theme.Corner(card, 14)
	Theme.Stroke(card, P.CardOutline, 3, true)

	local bodyFill = Instance.new("Frame")
	bodyFill.Name = "BodyFill"
	bodyFill.BackgroundColor3 = bodyColor
	bodyFill.Size = UDim2.fromScale(1, 1)
	bodyFill.ZIndex = card.ZIndex
	bodyFill.Parent = card
	Theme.Corner(bodyFill, 14)
	Theme.Gradient(bodyFill, lighten(bodyColor, 0.1), bodyDark)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundColor3 = headerColor
	header.Size = UDim2.new(1, 0, 0, headerHeight)
	header.ZIndex = card.ZIndex + 1
	header.Parent = card
	Theme.Corner(header, 14)
	Theme.Gradient(header, lighten(headerColor, 0.15), headerDark)
	-- square off the header's bottom corners
	local headerBottom = Instance.new("Frame")
	headerBottom.BorderSizePixel = 0
	headerBottom.BackgroundColor3 = headerDark
	headerBottom.Size = UDim2.new(1, 0, 0, 12)
	headerBottom.Position = UDim2.new(0, 0, 1, -12)
	headerBottom.ZIndex = card.ZIndex + 1
	headerBottom.Parent = header

	Theme.Label({
		Name = "Title",
		Text = props.Title or "",
		MaxTextSize = props.TitleSize or 26,
		Size = UDim2.new(1, -14, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = card.ZIndex + 2,
		Parent = header,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(0, headerHeight)
	body.Size = UDim2.new(1, 0, 1, -headerHeight)
	body.ZIndex = card.ZIndex + 1
	body.Parent = card
	Theme.Padding(body, 8)

	if props.Parent then
		card.Parent = props.Parent
	end
	return card, body
end

local modalGui: ScreenGui? = nil
local function getModalGui(): ScreenGui
	if not modalGui then
		modalGui = Theme.ScreenGui("ThemeModals", 50)
	end
	return modalGui :: ScreenGui
end

-- Every open panel / dialog, so controllers can avoid stacking dialogs and
-- close the ones that belong to a mode the player just left.
type OpenModal = { name: string, context: string?, close: () -> () }
local openModals: { [Instance]: OpenModal } = {}

-- True while any Theme.Panel / PurchaseDialog / Confirm is on screen.
function Theme.IsModalOpen(): boolean
	return next(openModals) ~= nil
end

-- Close every open dialog whose props.Context equals `context`
-- (or every open dialog when `context` is nil).
function Theme.CloseModals(context: string?)
	local toClose = {}
	for _, entry in openModals do
		if context == nil or entry.context == context then
			table.insert(toClose, entry.close)
		end
	end
	for _, close in toClose do
		close()
	end
end

-- Height of Roblox's top bar (menu / chat buttons). UI placed near the top of
-- a Theme.ScreenGui (which ignores the inset) should start below this.
function Theme.TopInset(): number
	local ok, inset = pcall(function()
		return GuiService.TopbarInset.Height
	end)
	if ok and type(inset) == "number" and inset > 0 then
		return inset
	end
	return 58
end

-- Centered modal panel with a dimmed background and a red close button.
-- Returns (panel, content, close()).
-- props.Name: opening a panel closes an already-open panel with the same Name
--             (so pressing a prompt twice never stacks two copies).
-- props.Context: e.g. "Base" — HUDController closes "Base" dialogs when the
--             player leaves the base (starts a run or a fight).
function Theme.Panel(props: Props): (Frame, Frame, () -> ())
	local panelName: string = props.Name or "Panel"
	for _, entry in openModals do
		if entry.name == panelName then
			entry.close()
			break
		end
	end
	local gui = props.Gui or getModalGui()
	local shade = Instance.new("TextButton")
	shade.Name = (props.Name or "Panel") .. "Shade"
	shade.AutoButtonColor = false
	shade.Text = ""
	shade.BackgroundColor3 = P.Shade
	shade.BackgroundTransparency = 0.45
	shade.Size = UDim2.fromScale(1, 1)
	shade.ZIndex = 10
	shade.Parent = gui

	local card, body = Theme.Card({
		Name = props.Name or "Panel",
		Title = props.Title or "",
		HeaderColor = props.HeaderColor,
		HeaderDarkColor = props.HeaderDarkColor,
		BodyColor = props.BodyColor or P.PanelBlue,
		BodyDarkColor = props.BodyDarkColor or P.PanelBlueDark,
		HeaderHeight = 54,
		TitleSize = 34,
		Size = props.Size or UDim2.fromOffset(560, 440),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 11,
		Parent = shade,
	})
	Theme.ResponsiveScale(card)

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		openModals[shade] = nil
		shade:Destroy()
		if props.OnClose then
			props.OnClose()
		end
	end
	openModals[shade] = { name = panelName, context = props.Context, close = close }
	-- If something destroys the panel directly, forget it too.
	shade.Destroying:Connect(function()
		openModals[shade] = nil
	end)

	if props.Closable ~= false then
		local closeButton = Theme.Button({
			Name = "Close",
			Text = "X",
			Color = P.ButtonRed,
			Size = UDim2.fromOffset(46, 46),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			ZIndex = 20,
			MaxTextSize = 26,
			OnClick = close,
			Parent = card,
		})
		closeButton.ZIndex = 20
	end

	Theme.Pop(card)
	return card, body, close
end

-- Two-route purchase dialog used for employees, boosts and vehicles:
-- [ R$ 200 ]  or  [ (coin) $12,345 ]
function Theme.PurchaseDialog(props: Props): () -> ()
	local _, content, close = Theme.Panel({
		Name = "PurchaseDialog",
		Context = props.Context,
		Title = props.Title or "Buy",
		HeaderColor = props.HeaderColor or P.OfferPurple,
		HeaderDarkColor = props.HeaderDarkColor or P.OfferPurpleDark,
		Size = UDim2.fromOffset(520, 360),
		OnClose = props.OnClose,
	})
	Theme.List(content, "Vertical", 12)

	Theme.Label({
		Name = "Description",
		Text = props.Description or "",
		MaxTextSize = 24,
		Size = UDim2.new(1, 0, 0, 110),
		LayoutOrder = 1,
		ZIndex = 13,
		Parent = content,
	})

	local row = Instance.new("Frame")
	row.Name = "Buttons"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 74)
	row.LayoutOrder = 2
	row.ZIndex = 13
	row.Parent = content
	Theme.List(row, "Horizontal", 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	if props.RobuxPrice then
		local robuxButton = Theme.Button({
			Name = "Robux",
			Text = if props.RobuxEnabled == false then "Robux not set up" else Format.Robux(props.RobuxPrice),
			Color = P.Robux,
			DarkColor = P.RobuxDark,
			Size = UDim2.fromOffset(210, 70),
			ZIndex = 14,
			LayoutOrder = 1,
			OnClick = function()
				close()
				if props.OnRobux then
					props.OnRobux()
				end
			end,
			Parent = row,
		})
		if props.RobuxEnabled == false then
			Theme.SetButtonEnabled(robuxButton, false)
		end
	end

	if props.CashPrice then
		local cashButton = Theme.Button({
			Name = "Cash",
			Text = "      " .. Format.Money(props.CashPrice),
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.fromOffset(230, 70),
			ZIndex = 14,
			LayoutOrder = 2,
			OnClick = function()
				close()
				if props.OnCash then
					props.OnCash()
				end
			end,
			Parent = row,
		})
		Theme.CoinIcon({
			Size = UDim2.fromOffset(34, 34),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, -2),
			ZIndex = 16,
			Parent = cashButton,
		})
		if props.CashAffordable == false then
			Theme.SetButtonEnabled(cashButton, false)
		end
	end

	if props.Footnote then
		Theme.Label({
			Name = "Footnote",
			Text = props.Footnote,
			MaxTextSize = 18,
			TextColor3 = Color3.fromRGB(220, 235, 255),
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = 3,
			ZIndex = 13,
			Parent = content,
		})
	end
	return close
end

function Theme.Confirm(props: Props): () -> ()
	local _, content, close = Theme.Panel({
		Name = props.Name or "Confirm",
		Context = props.Context,
		Title = props.Title or "Are you sure?",
		Size = UDim2.fromOffset(480, 300),
		OnClose = props.OnClose,
	})
	Theme.List(content, "Vertical", 12)
	Theme.Label({
		Text = props.Body or "",
		MaxTextSize = 24,
		Size = UDim2.new(1, 0, 0, 110),
		LayoutOrder = 1,
		ZIndex = 13,
		Parent = content,
	})
	Theme.Button({
		Text = props.ConfirmText or "Yes",
		Color = props.ConfirmColor or P.ButtonGreen,
		Size = UDim2.fromOffset(220, 64),
		LayoutOrder = 2,
		ZIndex = 14,
		OnClick = function()
			close()
			props.OnConfirm()
		end,
		Parent = content,
	})
	return close
end

-------------------------------------------------------------------------------
-- Toasts and floating world text
-------------------------------------------------------------------------------
local toastGui: ScreenGui? = nil
local toastList: Frame? = nil

local TOAST_COLORS = {
	info = P.CardBlue,
	success = P.ButtonGreen,
	error = P.ButtonRed,
	cash = P.MoneyGreen,
}

-- kind: "info" | "success" | "error" | "cash"
function Theme.Toast(text: string, kind: string?)
	if not toastGui then
		toastGui = Theme.ScreenGui("ThemeToasts", 60)
		local list = Instance.new("Frame")
		list.Name = "List"
		list.BackgroundTransparency = 1
		list.AnchorPoint = Vector2.new(0.5, 0)
		list.Position = UDim2.new(0.5, 0, 0, 86)
		list.Size = UDim2.fromOffset(520, 300)
		list.Parent = toastGui
		Theme.List(list, "Vertical", 6)
		toastList = list
	end
	local color = TOAST_COLORS[kind or "info"] or P.CardBlue
	local toast = Instance.new("Frame")
	toast.BackgroundColor3 = color
	toast.Size = UDim2.fromOffset(460, 46)
	toast.LayoutOrder = math.floor(os.clock() * 100)
	toast.Parent = toastList
	Theme.Corner(toast, 12)
	Theme.Stroke(toast, P.CardOutline, 2.5, true)
	Theme.Label({
		Text = text,
		MaxTextSize = 24,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = toast,
	})
	Theme.Pop(toast)
	task.delay(2.6, function()
		Theme.Tween(toast, { BackgroundTransparency = 1 }, 0.3)
		task.wait(0.3)
		toast:Destroy()
	end)
end

function Theme.Billboard(props: Props): BillboardGui
	local board = Instance.new("BillboardGui")
	board.Name = props.Name or "Billboard"
	board.Size = props.Size or UDim2.fromOffset(200, 60)
	board.StudsOffset = props.StudsOffset or Vector3.new(0, 3, 0)
	board.AlwaysOnTop = props.AlwaysOnTop == true
	board.MaxDistance = props.MaxDistance or 160
	board.LightInfluence = 0
	board.ResetOnSpawn = false
	if props.Adornee then
		board.Adornee = props.Adornee
	end
	board.Parent = props.Parent
	return board
end

-- Rising, fading text in the world ("+$12.50" over a shop).
function Theme.FloatText(position: Vector3, text: string, color: Color3?)
	local anchor = Instance.new("Part")
	anchor.Name = "FloatText"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Parent = Workspace

	local board = Theme.Billboard({
		Parent = anchor,
		Adornee = anchor,
		Size = UDim2.fromOffset(180, 50),
		StudsOffset = Vector3.zero,
		AlwaysOnTop = true,
		MaxDistance = 120,
	})
	local label = Theme.Label({ Text = text, TextColor3 = color or P.MoneyGreen, MaxTextSize = 34, Parent = board })
	Theme.Tween(anchor, { Position = position + Vector3.new(0, 6, 0) }, 1.2)
	task.delay(0.6, function()
		Theme.Tween(label, { TextTransparency = 1 }, 0.6)
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Theme.Tween(stroke, { Transparency = 1 }, 0.6)
		end
	end)
	task.delay(1.3, function()
		anchor:Destroy()
	end)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="60">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">BaseCustomers</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BaseCustomers (client)
	A few ambient NPC customers (bright single-colour blocky people, like the
	pink / purple / yellow walkers in reference image 1) strolling along the
	walkways of the areas the local player has unlocked. Purely decorative:
	client-only, no collisions, no Humanoids, capped at 8.

	Public API:
		BaseCustomers.Start(parent: Instance)       -- create the update loop
		BaseCustomers.SetAreas(highestArea: number) -- how many areas they may walk in
		BaseCustomers.Stop()                        -- remove every NPC and the loop

	How they walk: every NPC has a fixed sideways offset from the walkway
	centre line and walks centre -> end of one arm -> pause -> back to the
	centre -> another arm, so they always stay on the walkway.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)

local BuildingFactory = require(script.Parent.BuildingFactory)

local P = Config.Palette

local BaseCustomers = {}

local MAX_NPCS = 8 -- [PROPOSAL]
local WALK_SPEED = 7 -- studs per second [PROPOSAL]
local UPDATE_RATE = 1 / 30
local OUTFITS = { P.Pink, P.OfferPurple, P.WallYellow, P.CardBlue, P.ButtonGreen, P.CardOrange, P.CardPink }
local ARMS = { Vector3.new(0, 0, -1), Vector3.new(0, 0, 1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) }

type Npc = {
	model: Model,
	torso: BasePart,
	head: BasePart,
	hat: BasePart,
	legs: { BasePart },
	arms: { BasePart },
	area: number,
	lateral: number,
	from: Vector3,
	to: Vector3,
	walked: number,
	pause: number,
	atCentre: boolean,
	phase: number,
}

local rng = Random.new()
local folder: Folder? = nil
local connection: RBXScriptConnection? = nil
local npcs: { Npc } = {}
local highest = 1
local accumulator = 0

local function centrePoint(npc: Npc): Vector3
	local c = Layout.AreaCenter(npc.area)
	return Vector3.new(c.X + npc.lateral, Layout.FLOOR_Y, c.Z + npc.lateral)
end

local function armPoint(npc: Npc): Vector3
	local c = Layout.AreaCenter(npc.area)
	local dir = ARMS[rng:NextInteger(1, #ARMS)]
	local distance = rng:NextNumber(24, 58)
	if dir.X ~= 0 then
		return Vector3.new(c.X + dir.X * distance, Layout.FLOOR_Y, c.Z + npc.lateral)
	end
	return Vector3.new(c.X + npc.lateral, Layout.FLOOR_Y, c.Z + dir.Z * distance)
end

local function makeNpc(parent: Instance, index: number): Npc
	local model = Instance.new("Model")
	model.Name = "Customer" .. index
	local color = OUTFITS[(index - 1) % #OUTFITS + 1]
	local function part(name: string, size: Vector3, partColor: Color3): BasePart
		return BuildingFactory.Part(model, {
			Name = name,
			Size = size,
			CFrame = CFrame.new(),
			Color = partColor,
			CanCollide = false,
			CastShadow = true,
		})
	end
	local npc: Npc = {
		model = model,
		torso = part("Torso", Vector3.new(2, 2, 1), color),
		head = part("Head", Vector3.new(1.5, 1.5, 1.5), P.CoinShine),
		hat = part("Hat", Vector3.new(1.6, 0.4, 1.6), color),
		legs = { part("Leg", Vector3.new(0.95, 2, 1), color), part("Leg", Vector3.new(0.95, 2, 1), color) },
		arms = { part("Arm", Vector3.new(0.9, 2, 0.9), color), part("Arm", Vector3.new(0.9, 2, 0.9), color) },
		area = rng:NextInteger(1, math.max(1, highest)),
		lateral = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(4, 9),
		from = Vector3.zero,
		to = Vector3.zero,
		walked = 0,
		pause = rng:NextNumber(0, 2),
		atCentre = true,
		phase = rng:NextNumber(0, math.pi * 2),
	}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			p.CanQuery = false
		end
	end
	local start = centrePoint(npc)
	npc.from = start
	npc.to = armPoint(npc)
	model.Parent = parent
	return npc
end

-- Place every body part for one NPC (walking pose).
local function pose(npc: Npc, position: Vector3, direction: Vector3, walking: boolean)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	local look = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local body = CFrame.lookAt(position, position + look)
	local t = os.clock() * 9 + npc.phase
	local swing = if walking then math.sin(t) * 0.6 else 0
	local bob = if walking then math.abs(math.sin(t)) * 0.15 else 0
	npc.torso.CFrame = body * CFrame.new(0, 3 + bob, 0)
	npc.head.CFrame = body * CFrame.new(0, 4.75 + bob, 0)
	npc.hat.CFrame = body * CFrame.new(0, 5.65 + bob, 0)
	npc.legs[1].CFrame = body * CFrame.new(-0.5, 2, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1, 0)
	npc.legs[2].CFrame = body * CFrame.new(0.5, 2, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -1, 0)
	npc.arms[1].CFrame = body * CFrame.new(-1.45, 3.9 + bob, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -0.9, 0)
	npc.arms[2].CFrame = body * CFrame.new(1.45, 3.9 + bob, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -0.9, 0)
end

local function step(npc: Npc, dt: number)
	if npc.pause > 0 then
		npc.pause -= dt
		pose(npc, npc.from, npc.to - npc.from, false)
		return
	end
	local delta = npc.to - npc.from
	local length = delta.Magnitude
	npc.walked += WALK_SPEED * dt
	if length < 0.01 or npc.walked >= length then
		-- Arrived: pause, then head for the next point.
		npc.from = npc.to
		npc.walked = 0
		npc.atCentre = not npc.atCentre
		if npc.atCentre then
			npc.to = armPoint(npc)
			npc.pause = rng:NextNumber(0.2, 1)
		else
			npc.to = centrePoint(npc)
			npc.pause = rng:NextNumber(1, 3)
		end
		pose(npc, npc.from, delta, false)
		return
	end
	pose(npc, npc.from + delta.Unit * npc.walked, delta, true)
end

local function desiredCount(): number
	return math.min(MAX_NPCS, 2 + highest * 2)
end

local function refill()
	local parent = folder
	if not parent then
		return
	end
	while #npcs < desiredCount() do
		table.insert(npcs, makeNpc(parent, #npcs + 1))
	end
end

function BaseCustomers.Start(parent: Instance)
	if folder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "Customers"
	f.Parent = parent
	folder = f
	refill()
	connection = RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator < UPDATE_RATE then
			return
		end
		local elapsed = math.min(accumulator, 0.25)
		accumulator = 0
		for _, npc in npcs do
			step(npc, elapsed)
		end
	end)
end

function BaseCustomers.SetAreas(highestArea: number)
	local value = math.clamp(math.floor(highestArea), 1, #Config.Areas)
	if value == highest then
		return
	end
	highest = value
	-- Spread some walkers into the newly unlocked area.
	for i, npc in npcs do
		if i % 2 == 0 then
			npc.area = rng:NextInteger(1, highest)
			npc.from = centrePoint(npc)
			npc.to = armPoint(npc)
			npc.walked = 0
			npc.atCentre = true
		end
	end
	refill()
end

function BaseCustomers.Stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(npcs)
end

return BaseCustomers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">BaseVisuals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BaseVisuals (client)
	Draws the LOCAL player's own progress on the shared home map:

		* locked slot (area unlocked)  -> white unlock pad with a thick green
		                                  border, gold price + coin (image 1),
		                                  ProximityPrompt "Unlock". Its name +
		                                  price label is AlwaysOnTop (see buildPad)
		* locked area                  -> a "LOCKED" sign in the middle of the area
		* unlocked revenue section     -> colourful building (BuildingFactory),
		                                  billboard with level, $/s, stock bar and a
		                                  flashing "OUT OF STOCK!", prompts
		                                  "Restock" (E) and "Upgrade" (F)
		* employee spot                -> "Hire me" tile, or the hired employee NPC
		* Combat Arena (a2s4) unlocked -> arena building, prompt "Enter arena"
		* gates of areas >= highestArea-> black iron gate + gold padlock and an
		                                  invisible wall in the opening; the next
		                                  gate gets a billboard + prompt

	Only what changed is rebuilt: every slot / gate remembers its current
	"state" and is rebuilt only when that state changes. Numbers on billboards
	are refreshed on every data update.

	Public API (used by Controllers/BaseController):
		BaseVisuals.Start(callbacks)       -- create the world folder + update loop
			callbacks = {
				OnUnlock(slotId), OnRestock(slotId), OnUpgrade(slotId),
				OnHire(slotId), OnArena(), OnGate(area),
			}
		BaseVisuals.Update(data)           -- apply a PlayerData snapshot (cheap, call often)
		BaseVisuals.ShowIncome(slotId, amount)  -- floating "+$12.50" over a building
		BaseVisuals.EmployeeHop(slotId)    -- the employee does a little hop (restocked)
		BaseVisuals.Pop(slotId)            -- bounce that slot's billboard (feedback)
		BaseVisuals.FloatAt(slotId, text, color?) -- floating text above a slot's front
		BaseVisuals.Destroy()              -- remove everything (no leaks)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local BaseCustomers = require(script.Parent.BaseCustomers)
local BuildingFactory = require(script.Parent.BuildingFactory)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData

local P = Config.Palette
local player = Players.LocalPlayer

export type Callbacks = {
	OnUnlock: (slotId: string) -> (),
	OnRestock: (slotId: string) -> (),
	OnUpgrade: (slotId: string) -> (),
	OnHire: (slotId: string) -> (),
	OnArena: () -> (),
	OnGate: (area: number) -> (),
}

type BuildingUi = {
	content: Frame,
	levelLabel: TextLabel,
	rateLabel: TextLabel,
	stockFill: Frame,
	stockText: TextLabel,
	alertLabel: TextLabel,
	restockPrompt: ProximityPrompt,
	upgradePrompt: ProximityPrompt,
}

type SlotVisual = {
	id: string,
	area: number,
	index: number,
	def: Config.SlotDef,
	cframe: CFrame,
	state: string, -- "none" | "pad" | "building" | "arena"
	folder: Folder?,
	top: BasePart?,
	content: Frame?,
	ui: BuildingUi?,
	arenaBest: TextLabel?,
	hireState: string, -- "none" | "tile" | "employee"
	hireFolder: Folder?,
	employee: Model?,
	employeeBase: CFrame?,
	hopAt: number,
	bobPhase: number,
	flashing: boolean,
}

type GateVisual = {
	area: number,
	state: string, -- "none" | "far" | "active"
	folder: Folder?,
	model: Model?,
	prompt: ProximityPrompt?,
	content: Frame?,
	title: TextLabel?,
	sub: TextLabel?,
}

local BaseVisuals = {}

local callbacks: Callbacks? = nil
local root: Folder? = nil
local heartbeat: RBXScriptConnection? = nil
local slots: { SlotVisual } = {}
local slotById: { [string]: SlotVisual } = {}
local gates: { [number]: GateVisual } = {}
local lockedSigns: { [number]: Folder } = {}
local lastData: PlayerData? = nil
local accumulator = 0

local UPDATE_RATE = 1 / 30
local PROMPT_DISTANCE = 10
local BILLBOARD_DISTANCE = 150
-- Unlock pad / "Hire me" labels (AlwaysOnTop). MaxDistance is measured from the
-- camera: 180 keeps every pad of the player's area labelled from the spawn
-- camera even at the 90-stud max zoom (the far pads are ~178 studs away there).
local PAD_LABEL_DISTANCE = 180
-- How high the pad labels float above their tile: the bottom edge stays clear
-- of the Unlock / Hire prompt shown at the tile itself.
local PAD_LABEL_HEIGHT = 5.6
local EMPLOYEE_HOP_TIME = 0.55

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local function anchor(parent: Instance, name: string, position: Vector3): Part
	local part = BuildingFactory.Part(parent, {
		Name = name,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Color = P.White,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	part.CanQuery = false
	return part
end

local function makePrompt(
	parent: Instance,
	actionText: string,
	objectText: string,
	hold: number,
	key: Enum.KeyCode?,
	gamepadKey: Enum.KeyCode?,
	distance: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = distance or PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.GamepadKeyCode = gamepadKey or Enum.KeyCode.ButtonX
	prompt.Parent = parent
	return prompt
end

-- World-sized billboard (Size in studs) with a "Content" frame inside that
-- Theme.Pop can bounce. `alwaysOnTop` draws it over everything else.
local function billboard(
	adornee: BasePart,
	widthStuds: number,
	heightStuds: number,
	offsetY: number,
	maxDistance: number?,
	alwaysOnTop: boolean?
): (BillboardGui, Frame)
	local board = Theme.Billboard({
		Name = "Info",
		Parent = adornee,
		Adornee = adornee,
		Size = UDim2.fromScale(widthStuds, heightStuds),
		StudsOffset = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = alwaysOnTop == true,
		MaxDistance = maxDistance or BILLBOARD_DISTANCE,
	})
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = board
	return board, content
end

local function label(parent: Instance, text: string, y: number, height: number, color: Color3?): TextLabel
	return Theme.Label({
		Text = text,
		TextColor3 = color or P.White,
		MaxTextSize = 120,
		Position = UDim2.fromScale(0, y),
		Size = UDim2.fromScale(1, height),
		Parent = parent,
	})
end

-- "$1,562.50 (coin)" row, centred.
local function priceRow(parent: Instance, text: string, y: number, height: number): TextLabel
	local row = Instance.new("Frame")
	row.Name = "PriceRow"
	row.BackgroundTransparency = 1
	row.Position = UDim2.fromScale(0, y)
	row.Size = UDim2.fromScale(1, height)
	row.Parent = parent
	Theme.List(row, "Horizontal", 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local widthShare = math.clamp(#text * 0.075, 0.3, 0.8)
	local priceLabel = Theme.Label({
		Text = text,
		TextColor3 = P.PriceGold,
		MaxTextSize = 120,
		StrokeThickness = 3,
		Size = UDim2.fromScale(widthShare, 1),
		LayoutOrder = 1,
		Parent = row,
	})
	Theme.CoinIcon({ Size = UDim2.fromScale(0.15, 0.8), LayoutOrder = 2, Parent = row })
	return priceLabel
end

local function slotFrame(area: number, index: number): CFrame
	local centre = Layout.SlotCenter(area, index)
	local offset = Layout.SLOT_OFFSETS[index]
	local towardsPath = Vector3.new(-math.sign(offset.X), 0, 0)
	return CFrame.lookAt(centre, centre + towardsPath)
end

local function clearSlotState(sv: SlotVisual)
	if sv.folder then
		sv.folder:Destroy()
	end
	sv.folder = nil
	sv.top = nil
	sv.content = nil
	sv.ui = nil
	sv.arenaBest = nil
	sv.flashing = false
end

local function clearHire(sv: SlotVisual)
	if sv.hireFolder then
		sv.hireFolder:Destroy()
	end
	sv.hireFolder = nil
	sv.employee = nil
	sv.employeeBase = nil
	sv.hireState = "none"
end

local function newFolder(name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = root
	return folder
end

local function cb(): Callbacks?
	return callbacks
end

-------------------------------------------------------------------------------
-- Slot states
-------------------------------------------------------------------------------
local function buildPad(sv: SlotVisual)
	local folder = newFolder("Pad_" .. sv.id)
	sv.folder = folder
	local isArena = sv.def.kind == "arena"
	-- Thin tile (top ~0.55 studs above the floor, above the plot outline).
	local tile =
		BuildingFactory.FlatTile(folder, sv.cframe + Vector3.new(0, 0.4, 0), 20, 11, P.PadFill, P.PadBorder, 1.2)
	tile.Name = "UnlockPad"

	local price = Economy.SlotUnlockPrice(sv.id)
	local priceText = Format.Money(price)
	-- Lifted well above the pad AND drawn on top: the pad's white/green
	-- picture is a SurfaceGui, and Roblox can draw it over a normal billboard
	-- that overlaps it on screen, which cut the name + price off (owner feedback).
	local board, content = billboard(tile, 14, 4, PAD_LABEL_HEIGHT, PAD_LABEL_DISTANCE, true)
	board.Name = "PadInfo"
	sv.content = content
	local titleText = if isArena then "⚔️ Combat Arena" else sv.def.icon .. " " .. sv.def.name
	label(content, titleText, 0, 0.42, P.White)
	priceRow(content, priceText, 0.44, 0.56)

	local prompt = makePrompt(tile, "Unlock", sv.def.name .. " - " .. priceText, 0.4, nil, nil, 12)
	prompt.Triggered:Connect(function()
		local c = cb()
		if c then
			c.OnUnlock(sv.id)
		end
	end)
end

local function buildBuilding(sv: SlotVisual)
	local folder = newFolder("Building_" .. sv.id)
	sv.folder = folder
	local model = BuildingFactory.Build(sv.def, sv.cframe)
	model.Parent = folder
	local top = model:FindFirstChild("Top") :: BasePart?
	sv.top = top
	local adornee: BasePart = top or (model.PrimaryPart :: BasePart)

	local _, content = billboard(adornee, 10, 5.4, 3)
	sv.content = content
	local levelLabel = label(content, "", 0, 0.24, P.White)
	local rateLabel = label(content, "", 0.22, 0.26, P.MoneyGreen)

	local bar = Instance.new("Frame")
	bar.Name = "StockBar"
	bar.BackgroundColor3 = P.PillBlack
	bar.Position = UDim2.fromScale(0.08, 0.52)
	bar.Size = UDim2.fromScale(0.84, 0.2)
	bar.Parent = content
	Theme.Corner(bar, 0.5)
	Theme.Stroke(bar, P.CardOutline, 2, true)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = P.ButtonGreen
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bar
	Theme.Corner(fill, 0.5)
	local stockText = Theme.Label({
		Text = "",
		MaxTextSize = 80,
		StrokeThickness = 2,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = bar,
	})
	local alertLabel = label(content, "OUT OF STOCK!", 0.74, 0.26, P.ButtonRed)
	alertLabel.Visible = false

	-- Prompts at the front of the plot (where the server checks distance).
	local front = Layout.SlotFrontPosition(sv.area, sv.index)
	local restockAnchor = anchor(folder, "RestockSpot", front + Vector3.new(0, 2.5, -2.5))
	local upgradeAnchor = anchor(folder, "UpgradeSpot", front + Vector3.new(0, 2.5, 2.5))
	local restockPrompt = makePrompt(restockAnchor, "Restock", sv.def.name, 1, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	local upgradePrompt = makePrompt(upgradeAnchor, "Upgrade", sv.def.name, 0.3, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	restockPrompt.Triggered:Connect(function()
		local c = cb()
		if c then
			c.OnRestock(sv.id)
		end
	end)
	upgradePrompt.Triggered:Connect(function()
		local c = cb()
		if c then
			c.OnUpgrade(sv.id)
		end
	end)

	sv.ui = {
		content = content,
		levelLabel = levelLabel,
		rateLabel = rateLabel,
		stockFill = fill,
		stockText = stockText,
		alertLabel = alertLabel,
		restockPrompt = restockPrompt,
		upgradePrompt = upgradePrompt,
	}
end

local function buildArena(sv: SlotVisual)
	local folder = newFolder("Arena_" .. sv.id)
	sv.folder = folder
	local model = BuildingFactory.BuildArena(sv.def, sv.cframe)
	model.Parent = folder
	local top = model:FindFirstChild("Top") :: BasePart?
	sv.top = top
	local adornee: BasePart = top or (model.PrimaryPart :: BasePart)
	local _, content = billboard(adornee, 11, 3.6, 2.5)
	sv.content = content
	label(content, "⚔️ Combat Arena", 0, 0.55, P.White)
	sv.arenaBest = label(content, "", 0.55, 0.45, P.PriceGold)

	local front = Layout.SlotFrontPosition(sv.area, sv.index)
	local spot = anchor(folder, "ArenaSpot", front + Vector3.new(0, 2.5, 0))
	local prompt = makePrompt(spot, "Enter arena", "Combat Arena", 0.2, nil, nil, 12)
	prompt.Triggered:Connect(function()
		local c = cb()
		if c then
			c.OnArena()
		end
	end)
end

local function refreshBuilding(sv: SlotVisual, section: Types.SectionState)
	local ui = sv.ui
	if not ui then
		return
	end
	local level = math.max(1, math.floor(tonumber(section.level) or 1))
	local stats = Economy.SectionStats(sv.id, level)
	local capacity = math.max(1, stats.stockCapacity)
	local stock = math.clamp(math.floor(tonumber(section.stock) or 0), 0, capacity)
	local maxed = level >= Economy.SectionMaxLevel
	local employee = section.employee == true

	ui.levelLabel.Text = ("Level %d%s%s"):format(
		level,
		if maxed then " (MAX)" else "",
		if employee then "  🧑‍💼" else ""
	)
	-- Per minute so the rate is a whole-dollar amount (no cents).
	ui.rateLabel.Text = Format.Money(stats.incomePerSecond * 60) .. "/min"
	local fraction = stock / capacity
	ui.stockFill.Size = UDim2.fromScale(math.max(fraction, 0.001), 1)
	ui.stockFill.Visible = stock > 0
	ui.stockFill.BackgroundColor3 = P.ButtonRed:Lerp(P.ButtonGreen, fraction)
	ui.stockText.Text = ("Stock %d/%d"):format(stock, capacity)

	if stock <= 0 then
		ui.alertLabel.Visible = true
		if employee then
			ui.alertLabel.Text = "Restocking..."
			ui.alertLabel.TextColor3 = P.White
			sv.flashing = false
		else
			ui.alertLabel.Text = "OUT OF STOCK!"
			ui.alertLabel.TextColor3 = P.ButtonRed
			sv.flashing = true
		end
	else
		ui.alertLabel.Visible = false
		sv.flashing = false
	end

	ui.restockPrompt.Enabled = stock < capacity
	ui.restockPrompt.ActionText = if stock <= 0 then "Restock (empty!)" else "Restock"
	local upgradePrice = Economy.SectionUpgradePrice(sv.id, level)
	if upgradePrice then
		ui.upgradePrompt.ActionText = ("Upgrade to Lv %d"):format(level + 1)
		ui.upgradePrompt.ObjectText = sv.def.name .. " - " .. Format.Money(upgradePrice)
	else
		ui.upgradePrompt.ActionText = "Max level"
		ui.upgradePrompt.ObjectText = sv.def.name .. " - MAX"
	end
end

-------------------------------------------------------------------------------
-- Employee spot
-------------------------------------------------------------------------------
local function buildHireTile(sv: SlotVisual)
	local folder = newFolder("Hire_" .. sv.id)
	sv.hireFolder = folder
	sv.hireState = "tile"
	local pos = Layout.SlotHirePosition(sv.area, sv.index)
	local tile =
		BuildingFactory.FlatTile(folder, CFrame.new(pos + Vector3.new(0, 0.42, 0)), 7, 7, P.HireTile, P.White, 0.45)
	tile.Name = "HireTile"
	-- Drawn on top for the same reason as the unlock pad label (buildPad).
	local board, content = billboard(tile, 6, 6, PAD_LABEL_HEIGHT, PAD_LABEL_DISTANCE, true)
	board.Name = "HireInfo"
	local face = Theme.Label({
		Text = "🧑‍💼",
		MaxTextSize = 200,
		StrokeThickness = 0,
		Position = UDim2.fromScale(0.1, 0),
		Size = UDim2.fromScale(0.8, 0.62),
		Parent = content,
	})
	face.Name = "Businessman"
	label(content, "Hire me", 0.62, 0.38, P.White)
	local prompt = makePrompt(tile, "Hire employee", sv.def.name, 0, nil, nil, 9)
	prompt.Triggered:Connect(function()
		local c = cb()
		if c then
			c.OnHire(sv.id)
		end
	end)
end

local function buildEmployee(sv: SlotVisual)
	local folder = newFolder("Employee_" .. sv.id)
	sv.hireFolder = folder
	sv.hireState = "employee"
	local pos = Layout.SlotHirePosition(sv.area, sv.index)
	local offset = Layout.SLOT_OFFSETS[sv.index]
	local towardsPath = Vector3.new(-math.sign(offset.X), 0, 0)
	local cf = CFrame.lookAt(pos, pos + towardsPath)
	local model = BuildingFactory.BuildEmployee(cf)
	model.Parent = folder
	sv.employee = model
	sv.employeeBase = model:GetPivot()
	-- Small name tag.
	local headTop = model:FindFirstChild("Top") :: BasePart?
	if headTop then
		local _, content = billboard(headTop, 4.5, 1.2, 0.2, 80)
		label(content, "Employee", 0, 1, P.White)
	end
end

-------------------------------------------------------------------------------
-- Gates
-------------------------------------------------------------------------------
local function clearGate(gv: GateVisual, animate: boolean)
	local folder = gv.folder
	local model = gv.model
	gv.folder = nil
	gv.model = nil
	gv.prompt = nil
	gv.content = nil
	gv.title = nil
	gv.sub = nil
	if not folder then
		return
	end
	if not animate or not model then
		folder:Destroy()
		return
	end
	-- Open animation: the blocking wall goes at once, the gate sinks into the floor.
	local blocker = folder:FindFirstChild("GateBlocker")
	if blocker then
		blocker:Destroy()
	end
	local info = folder:FindFirstChild("GatePromptSpot")
	if info then
		info:Destroy()
	end
	local start = model:GetPivot()
	task.spawn(function()
		local began = os.clock()
		local duration = 0.8
		while os.clock() - began < duration and model.Parent do
			local alpha = (os.clock() - began) / duration
			model:PivotTo(start - Vector3.new(0, 12 * alpha * alpha, 0))
			task.wait()
		end
		folder:Destroy()
	end)
end

local function buildGate(gv: GateVisual, active: boolean)
	local folder = newFolder("Gate_" .. gv.area)
	gv.folder = folder
	local pos = Layout.GatePosition(gv.area)
	-- Face west: the side the player arrives from.
	local cf = CFrame.lookAt(pos, pos + Vector3.new(-1, 0, 0))
	local model = BuildingFactory.BuildGate(cf, Layout.GATE_WIDTH)
	model.Parent = folder
	gv.model = model

	-- Invisible wall that really blocks the opening (client parts collide
	-- with the local character).
	local blocker = BuildingFactory.Part(folder, {
		Name = "GateBlocker",
		Size = Vector3.new(1.2, 24, Layout.GATE_WIDTH + 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 12, 0)),
		Color = P.GateIron,
		Transparency = 1,
		CanCollide = true,
		CastShadow = false,
	})
	blocker.CanQuery = true

	if active then
		local top = model:FindFirstChild("Top") :: BasePart?
		local adornee: BasePart = top or (model.PrimaryPart :: BasePart)
		local _, content = billboard(adornee, 18, 5, 2.5, 200)
		gv.content = content
		gv.title = label(content, "", 0, 0.55, P.White)
		gv.sub = label(content, "", 0.55, 0.45, P.PriceGold)
		local spot = anchor(folder, "GatePromptSpot", pos + Vector3.new(-3, 3, 0))
		local prompt = makePrompt(spot, "", "", 0.3, nil, nil, 12)
		local area = gv.area
		prompt.Triggered:Connect(function()
			local c = cb()
			if c then
				c.OnGate(area)
			end
		end)
		gv.prompt = prompt
	end
end

local function refreshGate(gv: GateVisual, data: PlayerData)
	local prompt, title, sub = gv.prompt, gv.title, gv.sub
	if not (prompt and title and sub) then
		return
	end
	local nextArea = Config.Areas[gv.area + 1]
	local price = Format.Money(Economy.GatePrice(gv.area))
	if data.base.barriers[tostring(gv.area)] == true then
		title.Text = "🔓 Unlock " .. nextArea.name
		sub.Text = price
		prompt.ActionText = "Unlock " .. nextArea.name .. ": " .. price
		prompt.ObjectText = "Gate"
	else
		title.Text = "⚔️ Defeat the barrier squad"
		sub.Text = "then unlock " .. nextArea.name .. " for " .. price
		prompt.ActionText = "⚔️ Defeat the barrier squad"
		prompt.ObjectText = "Gate to " .. nextArea.name
	end
end

-------------------------------------------------------------------------------
-- "LOCKED" signs in areas the player has not reached
-------------------------------------------------------------------------------
local function buildLockedSign(area: number): Folder
	local folder = newFolder("Locked_" .. area)
	local c = Layout.AreaCenter(area)
	BuildingFactory.Part(folder, {
		Name = "SignPole",
		Size = Vector3.new(0.8, 9, 0.8),
		CFrame = CFrame.new(c + Vector3.new(0, 4.5, 0)),
		Color = P.GateIron,
		CanCollide = false,
	})
	local board = BuildingFactory.Part(folder, {
		Name = "LockedBoard",
		Size = Vector3.new(0.6, 4, 12),
		CFrame = CFrame.new(c + Vector3.new(0, 8.5, 0)),
		Color = P.ButtonRed,
		CanCollide = false,
	})
	-- Left face points west (towards the player coming from earlier areas).
	BuildingFactory.FaceText(board, Enum.NormalId.Left, "🔒 LOCKED", P.ButtonRed)
	BuildingFactory.FaceText(board, Enum.NormalId.Right, "🔒 LOCKED", P.ButtonRed)
	local _, content = billboard(board, 22, 3, 4.5, 600)
	label(content, Config.Areas[area].name, 0, 1, P.White)
	return folder
end

-------------------------------------------------------------------------------
-- Update loop (30 Hz): flashing alerts and employee idle animation
-------------------------------------------------------------------------------
local function animate()
	local now = os.clock()
	local flashOn = (now % 0.8) < 0.5
	for _, sv in slots do
		local ui = sv.ui
		if ui and sv.flashing then
			ui.alertLabel.Visible = flashOn
		end
		local model, base = sv.employee, sv.employeeBase
		if model and base and model.Parent then
			local bob = math.sin(now * 2.2 + sv.bobPhase) * 0.12
			local hop = 0
			local since = now - sv.hopAt
			if since >= 0 and since < EMPLOYEE_HOP_TIME then
				local x = since / EMPLOYEE_HOP_TIME
				hop = 4 * 2.2 * x * (1 - x) -- parabola, 2.2 studs high
			end
			model:PivotTo(base + Vector3.new(0, bob + hop + 0.12, 0))
		end
	end
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------
function BaseVisuals.Start(cbs: Callbacks)
	if root then
		return
	end
	callbacks = cbs
	local folder = Instance.new("Folder")
	folder.Name = "BaseVisuals"
	folder.Parent = Workspace
	root = folder

	table.clear(slots)
	table.clear(slotById)
	for areaIndex, areaDef in Config.Areas do
		for slotIndex, slotDef in areaDef.slots do
			local sv: SlotVisual = {
				id = slotDef.id,
				area = areaIndex,
				index = slotIndex,
				def = slotDef,
				cframe = slotFrame(areaIndex, slotIndex),
				state = "none",
				hireState = "none",
				hopAt = -100,
				bobPhase = (areaIndex * 4 + slotIndex) * 0.9,
				flashing = false,
			}
			table.insert(slots, sv)
			slotById[slotDef.id] = sv
		end
	end
	for area = 1, #Config.Areas - 1 do
		gates[area] = { area = area, state = "none" }
	end

	BaseCustomers.Start(folder)
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator < UPDATE_RATE then
			return
		end
		accumulator = 0
		animate()
	end)
end

function BaseVisuals.Update(data: PlayerData)
	if not root then
		return
	end
	lastData = data
	local base = data.base
	local highest = math.clamp(math.floor(tonumber(base.highestArea) or 1), 1, #Config.Areas)

	-- Slots -----------------------------------------------------------------
	for _, sv in slots do
		local desired: string
		local section = base.sections[sv.id]
		if sv.area > highest then
			desired = "none"
		elseif sv.def.kind == "arena" then
			desired = if base.arenaUnlocked then "arena" else "pad"
		elseif type(section) == "table" then
			desired = "building"
		else
			desired = "pad"
		end

		if desired ~= sv.state then
			clearSlotState(sv)
			sv.state = desired
			local ok, err = pcall(function()
				if desired == "pad" then
					buildPad(sv)
				elseif desired == "building" then
					buildBuilding(sv)
				elseif desired == "arena" then
					buildArena(sv)
				end
			end)
			if not ok then
				warn(("[BaseVisuals] could not build %s for %s: %s"):format(desired, sv.id, tostring(err)))
			end
			if sv.content and desired ~= "none" then
				Theme.Pop(sv.content)
			end
		end

		if desired == "building" and type(section) == "table" then
			refreshBuilding(sv, section)
		elseif desired == "arena" and sv.arenaBest then
			local best = tonumber(data.combat.highestLevel) or 0
			sv.arenaBest.Text = if best > 0 then ("Best: Level %d"):format(best) else "Fight waves for cash!"
		end

		-- Employee spot
		local desiredHire = "none"
		if desired == "building" and type(section) == "table" then
			desiredHire = if section.employee == true then "employee" else "tile"
		end
		if desiredHire ~= sv.hireState then
			clearHire(sv)
			if desiredHire == "tile" then
				buildHireTile(sv)
			elseif desiredHire == "employee" then
				buildEmployee(sv)
				sv.hopAt = os.clock() -- happy hop when hired
			end
			sv.hireState = desiredHire
		end
	end

	-- Gates -------------------------------------------------------------------
	for area, gv in gates do
		local desired = if area < highest then "none" elseif area == highest then "active" else "far"
		if desired ~= gv.state then
			local wasShown = gv.state ~= "none"
			clearGate(gv, desired == "none" and wasShown)
			gv.state = desired
			if desired ~= "none" then
				buildGate(gv, desired == "active")
			end
		end
		if desired == "active" then
			refreshGate(gv, data)
		end
	end

	-- Locked area signs ---------------------------------------------------------
	for area = 1, #Config.Areas do
		local shouldShow = area > highest
		local sign = lockedSigns[area]
		if shouldShow and not sign then
			lockedSigns[area] = buildLockedSign(area)
		elseif not shouldShow and sign then
			sign:Destroy()
			lockedSigns[area] = nil
		end
	end

	BaseCustomers.SetAreas(highest)
end

local function localRootPosition(): Vector3?
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.Position
	end
	return nil
end

function BaseVisuals.ShowIncome(slotId: string, amount: number)
	local sv = slotById[slotId]
	local top = sv and sv.top
	if not top or type(amount) ~= "number" or amount <= 0 then
		return
	end
	local here = localRootPosition()
	if here and (here - top.Position).Magnitude > 140 then
		return -- too far away to see it anyway
	end
	Theme.FloatText(top.Position + Vector3.new(0, 1.5, 0), "+" .. Format.Money(amount), P.MoneyGreen)
end

function BaseVisuals.FloatAt(slotId: string, text: string, color: Color3?)
	local sv = slotById[slotId]
	if not sv then
		return
	end
	local pos = Layout.SlotFrontPosition(sv.area, sv.index) + Vector3.new(0, 5, 0)
	Theme.FloatText(pos, text, color or P.White)
end

function BaseVisuals.EmployeeHop(slotId: string)
	local sv = slotById[slotId]
	if sv then
		sv.hopAt = os.clock()
	end
end

function BaseVisuals.Pop(slotId: string)
	local sv = slotById[slotId]
	if sv and sv.content then
		Theme.Pop(sv.content)
	end
end

function BaseVisuals.GetData(): PlayerData?
	return lastData
end

function BaseVisuals.Destroy()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	BaseCustomers.Stop()
	if root then
		root:Destroy()
		root = nil
	end
	for _, sv in slots do
		sv.folder = nil
		sv.hireFolder = nil
		sv.employee = nil
		sv.ui = nil
	end
	table.clear(slots)
	table.clear(slotById)
	table.clear(gates)
	table.clear(lockedSigns)
	callbacks = nil
	lastData = nil
end

return BaseVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">BoostOfferVisuals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BoostOfferVisuals (client, plain module - not a controller)
	Draws the random boost offers on the home map for the local player, in
	the look of the purple "+$357.1 / WATCH AD" bubble of reference image 1:

		* a purple rounded bubble (BillboardGui) with a gold coin and
		  "2x CASH 15m" or "⏩ 4h SKIP", over a green "BUY" strip
		* under it a floating, spinning gold coin pickup (with a purple glow)
		* a glowing purple Neon ring on the walkway floor

	When the local character walks within APPROACH_RANGE studs of an offer
	the OnApproach callback runs once (the ShopController then opens the
	Robux-or-cash dialog). It re-arms after walking more than REARM_RANGE away,
	or right away when OnApproach returns false (dialog refused, e.g. another
	dialog was open), so walking back in / staying on it retries.
	Offers disappear when the server says "OfferGone" or when they expire.

	Public API (used by Controllers/ShopController):
		BoostOfferVisuals.Start(opts: { OnApproach: (offer: Offer) -> boolean? })
		BoostOfferVisuals.Add(offer: Offer)        -- offer = server "Offer" payload
		BoostOfferVisuals.Remove(offerId: string)
		BoostOfferVisuals.Get(offerId: string): Offer?
		BoostOfferVisuals.Clear()
		BoostOfferVisuals.Stop()                   -- disconnects everything
	type Offer = { id: string, boostId: string, position: Vector3, expiresAt: number }

	Everything is created on the client only (other players never see your
	offers). Parts are Anchored, CanCollide/CanQuery/CanTouch = false.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local P = Config.Palette
local player = Players.LocalPlayer

export type Offer = { id: string, boostId: string, position: Vector3, expiresAt: number }

type Entry = {
	offer: Offer,
	model: Model,
	coin: BasePart,
	rim: BasePart,
	disc: BasePart,
	phase: number,
	inside: boolean,
}

local BoostOfferVisuals = {}

-- Studs: open the dialog this close (server allows ~12).
local APPROACH_RANGE = 6
-- Studs: walk this far away to be able to trigger it again.
local REARM_RANGE = 10
local RING_RADIUS = 3.6
local RING_SEGMENTS = 18
local COIN_HEIGHT = 3.2
local CHECK_INTERVAL = 0.15

local boostById: { [string]: Config.BoostDef } = {}
for _, def in Config.Boosts do
	boostById[def.id] = def
end

local entries: { [string]: Entry } = {}
local folder: Folder? = nil
local heartbeat: RBXScriptConnection? = nil
local onApproach: ((Offer) -> boolean?)? = nil
local sinceCheck = 0

local function getFolder(): Folder
	local existing = folder
	if existing and existing.Parent then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "BoostOffers"
	created.Parent = Workspace
	folder = created
	return created
end

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- "2x CASH 15m" / "⏩ 4h SKIP"
local function offerText(def: Config.BoostDef?): string
	if not def then
		return "BOOST"
	end
	if def.kind == "multiplier" then
		return ("2x CASH %dm"):format(def.minutes or 0)
	end
	return ("⏩ %dh SKIP"):format(def.hours or 0)
end

-- The purple bubble above the pickup.
local function buildBubble(adornee: BasePart, def: Config.BoostDef?)
	local board = Theme.Billboard({
		Name = "OfferBubble",
		Parent = adornee,
		Adornee = adornee,
		-- Scale-based size = studs, so it looks attached to the world like image 1.
		Size = UDim2.fromScale(7, 3.6),
		StudsOffset = Vector3.new(0, 3.6, 0),
		AlwaysOnTop = false,
		MaxDistance = 260,
	})

	local bubble = Instance.new("Frame")
	bubble.Name = "Bubble"
	bubble.BackgroundColor3 = P.OfferPurple
	bubble.Size = UDim2.fromScale(1, 0.84)
	bubble.Parent = board
	Theme.Corner(bubble, 0.22)
	Theme.Stroke(bubble, P.OfferPurpleDark, 3, true)
	Theme.Gradient(bubble, Theme.Lighten(P.OfferPurple, 0.18), P.OfferPurple)

	-- Little pointer under the bubble.
	local pointer = Instance.new("Frame")
	pointer.Name = "Pointer"
	pointer.BackgroundColor3 = P.OfferPurple
	pointer.AnchorPoint = Vector2.new(0.5, 0.5)
	pointer.Position = UDim2.fromScale(0.5, 0.84)
	pointer.Size = UDim2.fromScale(0.12, 0.2)
	pointer.Rotation = 45
	pointer.ZIndex = 0
	pointer.Parent = board
	Theme.AspectRatio(pointer, 1)
	Theme.Stroke(pointer, P.OfferPurpleDark, 3, true)

	-- Coin + text row.
	local coin = Theme.CoinIcon({
		Size = UDim2.fromScale(0.2, 0.42),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.05, 0.3),
		ZIndex = 2,
		Parent = bubble,
	})
	local aspect = coin:FindFirstChildOfClass("UIAspectRatioConstraint")
	if aspect then
		aspect.DominantAxis = Enum.DominantAxis.Height
	end
	Theme.Label({
		Name = "Text",
		Text = offerText(def),
		MaxTextSize = 80,
		Size = UDim2.fromScale(0.7, 0.46),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.26, 0.3),
		ZIndex = 2,
		Parent = bubble,
	})

	-- Green "BUY" strip.
	local strip = Instance.new("Frame")
	strip.Name = "BuyStrip"
	strip.BackgroundColor3 = P.ButtonGreen
	strip.AnchorPoint = Vector2.new(0.5, 0)
	strip.Position = UDim2.fromScale(0.5, 0.58)
	strip.Size = UDim2.fromScale(0.86, 0.32)
	strip.ZIndex = 2
	strip.Parent = bubble
	Theme.Corner(strip, 0.3)
	Theme.Stroke(strip, P.ButtonGreenDark, 2, true)
	Theme.Label({
		Text = "🛒 BUY",
		MaxTextSize = 60,
		Size = UDim2.fromScale(0.9, 0.86),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		Parent = strip,
	})
end

local function buildEntry(offer: Offer): Entry
	local def = boostById[offer.boostId]
	local model = Instance.new("Model")
	model.Name = "Offer_" .. offer.id
	local base = Vector3.new(offer.position.X, offer.position.Y, offer.position.Z)

	-- Glowing ring on the floor (Neon segments in a circle).
	for i = 1, RING_SEGMENTS do
		local angle = (i / RING_SEGMENTS) * math.pi * 2
		local offset = Vector3.new(math.cos(angle) * RING_RADIUS, 0.3, math.sin(angle) * RING_RADIUS)
		local segmentLength = 2 * math.pi * RING_RADIUS / RING_SEGMENTS + 0.15
		local cf = CFrame.lookAt(base + offset, base + offset + Vector3.new(-math.sin(angle), 0, math.cos(angle)))
		makePart(model, "Ring", Vector3.new(0.45, 0.14, segmentLength), cf, P.OfferPurple, Enum.Material.Neon)
	end
	-- Soft purple disc inside the ring (round axis pointing up).
	local disc = makePart(
		model,
		"Disc",
		Vector3.new(0.1, RING_RADIUS * 2 - 0.4, RING_RADIUS * 2 - 0.4),
		CFrame.new(base + Vector3.new(0, 0.22, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		P.OfferPurple
	)
	disc.Shape = Enum.PartType.Cylinder
	disc.Transparency = 0.6

	-- Floating gold coin pickup (round axis along Z so it stands up like a coin).
	local coinCf = CFrame.new(base + Vector3.new(0, COIN_HEIGHT, 0))
	local rim = makePart(model, "CoinRim", Vector3.new(0.45, 3.3, 3.3), coinCf, P.CoinDark)
	rim.Shape = Enum.PartType.Cylinder
	local coin = makePart(model, "Coin", Vector3.new(0.6, 2.7, 2.7), coinCf, P.Coin)
	coin.Shape = Enum.PartType.Cylinder
	local glow = Instance.new("PointLight")
	glow.Color = P.OfferPurple
	glow.Range = 12
	glow.Brightness = 2
	glow.Parent = coin
	-- "2x" / "⏩" printed on both faces of the coin.
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		local surface = Instance.new("SurfaceGui")
		surface.Name = "Face"
		surface.Face = face
		surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		surface.PixelsPerStud = 40
		surface.LightInfluence = 0
		surface.Parent = coin
		Theme.Label({
			Text = if def and def.kind == "timeskip" then "⏩" else "2x",
			TextColor3 = P.White,
			MaxTextSize = 80,
			Size = UDim2.fromScale(0.8, 0.8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Parent = surface,
		})
	end
	buildBubble(coin, def)

	model.PrimaryPart = coin
	model.Parent = getFolder()
	return {
		offer = offer,
		model = model,
		coin = coin,
		rim = rim,
		disc = disc,
		phase = math.random() * math.pi * 2,
		inside = false,
	}
end

local function characterRoot(): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function onHeartbeat(dt: number)
	local t = os.clock()
	-- Bob + spin.
	for _, entry in entries do
		local base = entry.offer.position
		local y = COIN_HEIGHT + math.sin(t * 2 + entry.phase) * 0.35
		local cf = CFrame.new(base.X, base.Y + y, base.Z) * CFrame.Angles(0, t * 1.6 + entry.phase, 0)
		entry.coin.CFrame = cf
		entry.rim.CFrame = cf
		entry.disc.Transparency = 0.55 + math.sin(t * 3 + entry.phase) * 0.12
	end

	sinceCheck += dt
	if sinceCheck < CHECK_INTERVAL then
		return
	end
	sinceCheck = 0

	-- Expiry (the server also sends "OfferGone").
	local serverNow = Workspace:GetServerTimeNow()
	for id, entry in entries do
		if serverNow >= entry.offer.expiresAt + 1 then
			BoostOfferVisuals.Remove(id)
		end
	end

	-- Walk-in detection (home map only).
	if State.Mode() ~= "Base" then
		return
	end
	local root = characterRoot()
	if not root then
		return
	end
	local position = root.Position
	for _, entry in entries do
		local p = entry.offer.position
		local distance = Vector3.new(position.X - p.X, 0, position.Z - p.Z).Magnitude
		local closeEnough = distance <= APPROACH_RANGE and math.abs(position.Y - p.Y) < 12
		if closeEnough and not entry.inside then
			entry.inside = true
			local callback = onApproach
			if callback then
				task.spawn(function()
					if callback(entry.offer) == false then
						entry.inside = false -- refused: re-arm so it can trigger again
					end
				end)
			end
		elseif entry.inside and distance > REARM_RANGE then
			entry.inside = false
		end
	end
end

function BoostOfferVisuals.Start(opts: { OnApproach: (Offer) -> boolean? })
	onApproach = opts.OnApproach
	if not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(onHeartbeat)
	end
end

function BoostOfferVisuals.Add(offer: Offer)
	if type(offer) ~= "table" or type(offer.id) ~= "string" or typeof(offer.position) ~= "Vector3" then
		return
	end
	if type(offer.expiresAt) ~= "number" then
		return
	end
	local existing = entries[offer.id]
	if existing then
		-- Already shown (e.g. re-sent after "Ready"): just update the data.
		existing.offer = offer
		return
	end
	entries[offer.id] = buildEntry(offer)
end

function BoostOfferVisuals.Get(offerId: string): Offer?
	local entry = entries[offerId]
	return if entry then entry.offer else nil
end

function BoostOfferVisuals.Remove(offerId: string)
	local entry = entries[offerId]
	if not entry then
		return
	end
	entries[offerId] = nil
	entry.model:Destroy()
end

function BoostOfferVisuals.Clear()
	for id in entries do
		BoostOfferVisuals.Remove(id)
	end
end

function BoostOfferVisuals.Stop()
	local connection = heartbeat
	heartbeat = nil
	if connection then
		connection:Disconnect()
	end
	BoostOfferVisuals.Clear()
	onApproach = nil
end

return BoostOfferVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">BuildingFactory</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BuildingFactory (client)
	Builds the chunky, colourful toy models of the home base out of plain
	Parts (no meshes, no image assets), in the style of reference image 1.

	Public API:
		BuildingFactory.Build(slotDef, cframe): Model
			A revenue building in the style `slotDef.style`
			("stand" | "shop" | "diner" | "hut" | "tent" | "station" | "garage" |
			 "tower" | "hangar"; "arena" builds the Combat Arena) coloured with
			`slotDef.color`. Every building has a striped awning, a counter,
			crates and a sign with the name + icon emoji.
			`cframe` = centre of the plot on the floor, LookVector = the side
			that faces the walkway (the front of the building).
			The model contains an invisible part named "Top" above the roof
			(use it for billboards / floating text).
		BuildingFactory.BuildArena(slotDef, cframe): Model    -- ring wall, flags, "COMBAT ARENA" sign
		BuildingFactory.BuildEmployee(cframe): Model          -- blocky NPC: black suit, white shirt, red tie
		BuildingFactory.BuildGate(cframe, width): Model       -- black iron gate with spikes + gold padlock
			(`cframe` LookVector = the side the player arrives from; the gate spans `width` studs across)
		BuildingFactory.FlatTile(parent, cframe, sizeX, sizeZ, fill, border, borderStuds): Part
			A thin floor tile drawn with a SurfaceGui: rounded rectangle `fill`
			with a `border` band (unlock pads, the "Hire me" tile).
		BuildingFactory.Part(parent, spec): Part              -- anchored SmoothPlastic part helper
		BuildingFactory.FaceText(part, face, text, background?, textColor?): SurfaceGui

	All parts are Anchored, SmoothPlastic, CanTouch = false. Decorative parts
	do not collide (so nobody gets stuck); building bodies do collide.
	"Forward" below means towards the walkway (the CFrame's LookVector).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local P = Config.Palette

local BuildingFactory = {}

export type PartSpec = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Shape: Enum.PartType?,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	CastShadow: boolean?,
}

local function darker(color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end

local function lighter(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

-- Pick a contrasting stripe colour for awnings (white on dark colours,
-- a darker shade on very light colours such as white tents).
local function stripeColor(color: Color3): Color3
	local _, s, v = color:ToHSV()
	if v > 0.9 and s < 0.15 then
		return P.ButtonRed
	end
	return P.White
end

function BuildingFactory.Part(parent: Instance, spec: PartSpec): Part
	local part = Instance.new("Part")
	part.Name = spec.Name or "Part"
	part.Anchored = true
	part.Shape = spec.Shape or Enum.PartType.Block
	part.Size = spec.Size
	part.CFrame = spec.CFrame
	part.Color = spec.Color
	part.Material = spec.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = spec.Transparency or 0
	part.CanCollide = if spec.CanCollide == nil then true else spec.CanCollide
	part.CanTouch = false
	part.CastShadow = if spec.CastShadow == nil then true else spec.CastShadow
	part.Parent = parent
	return part
end
local Part = BuildingFactory.Part

-- Builder for one model: helpers take positions in the building's local
-- space: x = right, y = up from the floor, f = forward (towards the walkway).
type Builder = {
	model: Model,
	cf: CFrame,
	at: (x: number, y: number, f: number) -> CFrame,
	box: (name: string, x: number, y: number, f: number, size: Vector3, color: Color3, collide: boolean?) -> Part,
	cyl: (
		name: string,
		x: number,
		y: number,
		f: number,
		diameter: number,
		height: number,
		color: Color3,
		collide: boolean?
	) -> Part,
	ball: (name: string, x: number, y: number, f: number, diameter: number, color: Color3) -> Part,
}

local function newBuilder(name: string, cf: CFrame): Builder
	local model = Instance.new("Model")
	model.Name = name
	local function at(x: number, y: number, f: number): CFrame
		return cf * CFrame.new(x, y, -f)
	end
	local b: Builder = {
		model = model,
		cf = cf,
		at = at,
		box = function(
			partName: string,
			x: number,
			y: number,
			f: number,
			size: Vector3,
			color: Color3,
			collide: boolean?
		): Part
			return Part(
				model,
				{ Name = partName, Size = size, CFrame = at(x, y, f), Color = color, CanCollide = collide }
			)
		end,
		cyl = function(
			partName: string,
			x: number,
			y: number,
			f: number,
			diameter: number,
			height: number,
			color: Color3,
			collide: boolean?
		): Part
			return Part(model, {
				Name = partName,
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(height, diameter, diameter),
				CFrame = at(x, y, f) * CFrame.Angles(0, 0, math.rad(90)),
				Color = color,
				CanCollide = collide,
			})
		end,
		ball = function(partName: string, x: number, y: number, f: number, diameter: number, color: Color3): Part
			return Part(model, {
				Name = partName,
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(diameter, diameter, diameter),
				CFrame = at(x, y, f),
				Color = color,
				CanCollide = false,
			})
		end,
	}
	return b
end

-- White outlined text on one face of a part.
function BuildingFactory.FaceText(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	background: Color3?,
	textColor: Color3?
): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 28
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = background or P.PillBlack
	label.BackgroundTransparency = if background then 0 else 1
	label.Font = Config.Font
	label.Text = text
	label.TextColor3 = textColor or P.White
	label.TextScaled = true
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color = P.TextStroke
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return gui
end

-- Thin floor tile with a rounded-rectangle picture on top. The picture is
-- symmetric, so it looks the same from every side.
function BuildingFactory.FlatTile(
	parent: Instance,
	cframe: CFrame,
	sizeX: number,
	sizeZ: number,
	fill: Color3,
	border: Color3,
	borderStuds: number
): Part
	local tile = Part(parent, {
		Name = "Tile",
		Size = Vector3.new(sizeX, 0.3, sizeZ),
		CFrame = cframe,
		Color = fill,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	tile.CanQuery = false
	local pixelsPerStud = 20
	local gui = Instance.new("SurfaceGui")
	gui.Name = "TileGui"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0.4
	gui.Parent = tile
	local outer = Instance.new("Frame")
	outer.Name = "Border"
	outer.Size = UDim2.fromScale(1, 1)
	outer.BackgroundColor3 = border
	outer.Parent = gui
	local outerCorner = Instance.new("UICorner")
	outerCorner.CornerRadius = UDim.new(0, math.floor(math.min(sizeX, sizeZ) * pixelsPerStud * 0.22))
	outerCorner.Parent = outer
	local inset = math.floor(borderStuds * pixelsPerStud)
	local inner = Instance.new("Frame")
	inner.Name = "Fill"
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	inner.Size = UDim2.new(1, -inset * 2, 1, -inset * 2)
	inner.BackgroundColor3 = fill
	inner.Parent = outer
	local innerCorner = Instance.new("UICorner")
	innerCorner.CornerRadius = UDim.new(0, math.max(4, outerCorner.CornerRadius.Offset - inset))
	innerCorner.Parent = inner
	return tile
end

-------------------------------------------------------------------------------
-- Shared building pieces
-------------------------------------------------------------------------------

-- Striped awning sloping down towards the front.
local function awning(b: Builder, width: number, f: number, y: number, color: Color3)
	local stripes = math.max(4, math.floor(width / 2))
	local stripeW = width / stripes
	local other = stripeColor(color)
	for i = 0, stripes - 1 do
		local x = -width / 2 + (i + 0.5) * stripeW
		local c = if i % 2 == 0 then color else other
		local part = Part(b.model, {
			Name = "Awning",
			Size = Vector3.new(stripeW, 0.3, 4),
			CFrame = b.at(x, y, f + 1.8) * CFrame.Angles(math.rad(-22), 0, 0),
			Color = c,
			CanCollide = false,
		})
		-- little hanging flap at the front edge
		Part(b.model, {
			Name = "AwningFlap",
			Size = Vector3.new(stripeW, 0.7, 0.2),
			CFrame = part.CFrame * CFrame.new(0, -0.35, -2),
			Color = c,
			CanCollide = false,
		})
	end
end

-- Shop counter: coloured front with a white top.
local function counter(b: Builder, width: number, f: number, color: Color3)
	b.box("Counter", 0, 1.5, f, Vector3.new(width, 3, 2), darker(color, 0.15), true)
	b.box("CounterTop", 0, 3.15, f, Vector3.new(width + 0.4, 0.3, 2.4), P.White, false)
end

-- Wooden crates beside the building.
local function crates(b: Builder, x: number, f: number)
	b.box("Crate", x, 1, f, Vector3.new(2, 2, 2), P.Wood, true)
	b.box("Crate", x + 0.3, 2.9, f + 0.2, Vector3.new(1.8, 1.8, 1.8), darker(P.Wood, 0.12), false)
	b.box(
		"Crate",
		x + (if x > 0 then -2.3 else 2.3),
		0.8,
		f + 0.4,
		Vector3.new(1.6, 1.6, 1.6),
		lighter(P.Wood, 0.12),
		false
	)
end

-- Name sign with the icon emoji, facing forward.
local function sign(b: Builder, def: Config.SlotDef, width: number, y: number, f: number, color: Color3)
	local board = b.box("Sign", 0, y, f, Vector3.new(width, 3, 0.5), darker(color, 0.35), false)
	BuildingFactory.FaceText(board, Enum.NormalId.Front, def.icon .. " " .. def.name, darker(color, 0.35))
end

-- Window: light-blue glass pane.
local function window(b: Builder, x: number, y: number, f: number, w: number, h: number)
	b.box("Window", x, y, f, Vector3.new(w, h, 0.2), lighter(P.PanelBlue, 0.45), false)
end

local function finish(b: Builder, topHeight: number): Model
	local top = b.box("Top", 0, topHeight, 0, Vector3.new(1, 1, 1), P.White, false)
	top.Transparency = 1
	top.CanQuery = false
	top.CastShadow = false
	local root = b.box("Root", 0, 0.5, 0, Vector3.new(1, 1, 1), P.White, false)
	root.Transparency = 1
	root.CanQuery = false
	root.CastShadow = false
	b.model.PrimaryPart = root
	b.model:SetAttribute("TopHeight", topHeight)
	return b.model
end

-------------------------------------------------------------------------------
-- Building styles (each about 25-45 parts, footprint within ±13 studs)
-------------------------------------------------------------------------------
local Styles: { [string]: (b: Builder, def: Config.SlotDef, color: Color3) -> number } = {}

-- Open market stall: back wall, four posts, roof, awning, counter.
Styles.stand = function(b, def, color)
	b.box("BackWall", 0, 3.5, -5, Vector3.new(16, 7, 1), color, true)
	for _, x in { -7.5, 7.5 } do
		for _, f in { -4.5, 3.5 } do
			b.box("Post", x, 3.5, f, Vector3.new(0.8, 7, 0.8), P.White, true)
		end
	end
	b.box("Roof", 0, 7.3, -0.5, Vector3.new(17, 0.6, 10.5), lighter(color, 0.15), true)
	b.box("Floor", 0, 0.15, -0.5, Vector3.new(16, 0.3, 10), lighter(color, 0.55), false)
	awning(b, 16, 4.5, 6.8, color)
	counter(b, 13, 3.4, color)
	b.box("Goods", -3, 3.8, 3.4, Vector3.new(2.2, 1, 1.4), P.CardOrange, false)
	b.box("Goods", 0.5, 3.8, 3.4, Vector3.new(2.2, 1, 1.4), P.ButtonGreen, false)
	b.box("Goods", 4, 3.8, 3.4, Vector3.new(2.2, 1, 1.4), P.Coin, false)
	crates(b, -10.5, 2)
	crates(b, 10.5, -2)
	sign(b, def, 15, 9.4, -0.5, color)
	return 12
end

-- Shop: a box with a big front window, door, flat roof with a white rim.
Styles.shop = function(b, def, color)
	b.box("Body", 0, 5.5, -3, Vector3.new(22, 11, 16), color, true)
	b.box("Roof", 0, 11.4, -3, Vector3.new(23, 0.8, 17), P.White, true)
	b.box("RoofRim", 0, 12.1, 4.9, Vector3.new(23, 0.6, 1.2), darker(color, 0.25), false)
	window(b, -3, 4.6, 5.05, 12, 5.2)
	b.box("WindowFrame", -3, 7.4, 5.1, Vector3.new(12.6, 0.4, 0.3), P.White, false)
	b.box("Door", 6.5, 3.5, 5.05, Vector3.new(4, 7, 0.2), darker(color, 0.45), false)
	b.box("DoorKnob", 5.2, 3.5, 5.2, Vector3.new(0.4, 0.4, 0.2), P.Coin, false)
	awning(b, 21, 5, 7.6, color)
	counter(b, 9, 7.5, color)
	crates(b, -10.5, 7.5)
	sign(b, def, 18, 9.9, 5.3, color)
	return 14
end

-- Diner: wide body with rounded ends and a doughnut sign on the roof.
Styles.diner = function(b, def, color)
	b.box("Body", 0, 4.5, -2, Vector3.new(16, 9, 14), color, true)
	b.cyl("RoundEnd", -8, 4.5, -2, 14, 9, color, true)
	b.cyl("RoundEnd", 8, 4.5, -2, 14, 9, color, true)
	b.box("Roof", 0, 9.3, -2, Vector3.new(16, 0.6, 14.4), P.White, true)
	b.cyl("RoofEnd", -8, 9.3, -2, 14.4, 0.6, P.White, true)
	b.cyl("RoofEnd", 8, 9.3, -2, 14.4, 0.6, P.White, true)
	-- stripe band around the middle
	b.box("Stripe", 0, 2.2, 5.05, Vector3.new(16, 1, 0.2), P.White, false)
	window(b, 0, 5.3, 5.05, 14, 3.6)
	-- giant doughnut sign (image 1): a pink disc with a white hole
	local donut = b.cyl("Donut", 0, 14, -2, 7, 1.4, P.Pink, false)
	donut.CFrame = b.at(0, 14, -2) * CFrame.Angles(0, math.rad(90), 0)
	local hole = b.cyl("DonutHole", 0, 14, -2, 2.6, 1.5, P.White, false)
	hole.CFrame = b.at(0, 14, -2) * CFrame.Angles(0, math.rad(90), 0)
	for i, sprinkle in { P.CardBlue, P.Coin, P.ButtonGreen, P.White } do
		local angle = math.rad(i * 90 + 20)
		b.box(
			"Sprinkle",
			math.cos(angle) * 2.4,
			14 + math.sin(angle) * 2.4,
			-1.25,
			Vector3.new(0.9, 0.3, 0.1),
			sprinkle,
			false
		)
	end
	b.box("DonutPost", 0, 11, -2, Vector3.new(0.6, 3, 0.6), P.GateIron, false)
	awning(b, 14, 5.2, 7.2, color)
	counter(b, 8, 7.6, color)
	crates(b, 10.5, 7)
	sign(b, def, 14, 11, 4.6, color)
	return 18
end

-- Round hut with a stepped cone roof and a barber pole.
Styles.hut = function(b, def, color)
	b.cyl("Body", 0, 4, -2, 15, 8, color, true)
	b.cyl("Roof1", 0, 8.6, -2, 17, 1.2, P.White, true)
	b.cyl("Roof2", 0, 9.8, -2, 12.5, 1.2, color, false)
	b.cyl("Roof3", 0, 11, -2, 8, 1.2, P.White, false)
	b.cyl("Roof4", 0, 12.2, -2, 3.6, 1.2, color, false)
	b.ball("RoofBall", 0, 13.3, -2, 1.6, P.Coin)
	b.box("Door", 0, 3, 5.4, Vector3.new(4, 6, 0.6), darker(color, 0.45), false)
	-- barber pole: red / white / blue segments
	for i, c in { P.ButtonRed, P.White, P.CardBlue, P.White, P.ButtonRed } do
		b.cyl("Pole", 6.5, 0.55 + (i - 1) * 1.1, 6, 1.2, 1.1, c, false)
	end
	b.ball("PoleTop", 6.5, 5.8, 6, 1.4, P.White)
	awning(b, 10, 5.8, 6.6, color)
	counter(b, 6, 8.2, color)
	crates(b, -9.5, 6)
	sign(b, def, 12, 9.9, 7, color)
	return 15
end

-- Army tent: low walls with a triangular prism roof (a diamond block, half
-- of it hidden inside the walls).
Styles.tent = function(b, def, color)
	local depth = 14
	b.box("Walls", 0, 1.8, -2, Vector3.new(20, 3.6, depth), color, true)
	local side = depth / math.sqrt(2)
	local roof = b.box("Roof", 0, 3.6, -2, Vector3.new(20.4, side, side), color, true)
	roof.CFrame = b.at(0, 3.6, -2) * CFrame.Angles(math.rad(45), 0, 0)
	b.box("Ridge", 0, 3.6 + depth / 2, -2, Vector3.new(20.8, 0.6, 0.6), darker(color, 0.3), false)
	b.box("DoorFlap", 0, 2.6, 5.05, Vector3.new(5, 5.2, 0.2), darker(color, 0.4), false)
	-- emblem disc on the roof front (e.g. a med tent cross colour)
	local emblem = b.cyl("Emblem", 0, 7, 1.55, 3.6, 0.3, P.ButtonRed, false)
	emblem.CFrame = b.at(0, 7.2, 1.55) * CFrame.Angles(math.rad(45), math.rad(90), 0)
	for _, x in { -10.6, 10.6 } do
		b.box("Peg", x, 0.8, 5.5, Vector3.new(0.4, 1.6, 0.4), P.Wood, false)
	end
	awning(b, 12, 3.6, 4.2, color)
	counter(b, 10, 7.6, color)
	crates(b, 11, 7)
	sign(b, def, 12, 12.6, -2, color)
	return 14
end

-- Station: canopy on pillars, a kiosk at the back and two pumps.
Styles.station = function(b, def, color)
	b.box("Kiosk", 0, 3.5, -6, Vector3.new(12, 7, 8), P.White, true)
	window(b, -2, 3.8, -1.95, 6, 3.5)
	b.box("KioskDoor", 4, 3, -1.95, Vector3.new(2.6, 6, 0.2), darker(color, 0.4), false)
	b.box("KioskStripe", 0, 6.4, -1.95, Vector3.new(12, 0.8, 0.2), color, false)
	for _, x in { -9, 9 } do
		for _, f in { -1, 6 } do
			b.box("Pillar", x, 4.5, f, Vector3.new(1, 9, 1), P.White, true)
		end
	end
	b.box("Canopy", 0, 9.5, 2.5, Vector3.new(21, 1.2, 12), P.White, true)
	b.box("CanopyEdge", 0, 9.5, 8.55, Vector3.new(21, 1.2, 0.2), color, false)
	for _, x in { -4, 4 } do
		b.box("Pump", x, 1.8, 4.5, Vector3.new(1.8, 3.6, 1.4), color, true)
		b.box("PumpScreen", x, 2.8, 5.25, Vector3.new(1.2, 0.8, 0.1), P.PillBlack, false)
		b.box("PumpTop", x, 3.8, 4.5, Vector3.new(2, 0.4, 1.6), P.White, false)
	end
	awning(b, 10, -1.9, 6.2, color)
	counter(b, 6, 9, color)
	crates(b, -11, 8)
	sign(b, def, 16, 11.6, 8.4, color)
	return 13
end

-- Garage: box with a big striped roll-up door and a roof sign.
Styles.garage = function(b, def, color)
	b.box("Body", 0, 5, -3, Vector3.new(22, 10, 16), color, true)
	b.box("Roof", 0, 10.4, -3, Vector3.new(23, 0.8, 17), P.White, true)
	for i = 0, 4 do
		b.box(
			"DoorSlat",
			-2,
			1 + i * 1.5,
			5.05,
			Vector3.new(12, 1.3, 0.2),
			if i % 2 == 0 then P.ButtonGrey else P.White,
			false
		)
	end
	b.box("DoorFrame", -2, 8.1, 5.1, Vector3.new(12.6, 0.6, 0.3), darker(color, 0.3), false)
	window(b, 7.5, 5, 5.05, 4, 3)
	b.box("Tyre", 9.5, 0.9, 7.5, Vector3.new(1.8, 1.8, 0.8), P.PillBlack, false)
	b.box("Tyre", 9.5, 2.6, 7.5, Vector3.new(1.8, 1.6, 0.8), P.PillBlack, false)
	awning(b, 8, 5, 7.6, color)
	counter(b, 6, 9, color)
	crates(b, -10.5, 7.5)
	sign(b, def, 16, 12.2, -3, color)
	return 14
end

-- Tower: shop at the base, tall column, platform and a dish on top.
Styles.tower = function(b, def, color)
	b.box("Base", 0, 3.5, 0, Vector3.new(14, 7, 10), color, true)
	b.box("BaseRoof", 0, 7.3, 0, Vector3.new(15, 0.6, 11), P.White, true)
	window(b, -2.5, 3.8, 5.05, 6, 3.4)
	b.box("Door", 4, 3, 5.05, Vector3.new(2.8, 6, 0.2), darker(color, 0.4), false)
	b.cyl("Column", 0, 14, -2, 4.5, 14, P.White, true)
	for i = 0, 2 do
		b.cyl("ColumnBand", 0, 10 + i * 4, -2, 4.8, 1, color, false)
	end
	b.box("Platform", 0, 21.4, -2, Vector3.new(9, 0.8, 9), color, false)
	b.box("Railing", 0, 22.4, 2.3, Vector3.new(9, 1.2, 0.3), P.White, false)
	local dish = b.ball("Dish", 0, 24, -2, 4.4, P.White)
	dish.Size = Vector3.new(4.4, 4.4, 4.4)
	b.box("Antenna", 0, 26.5, -2, Vector3.new(0.3, 4, 0.3), P.GateIron, false)
	local tip = b.ball("AntennaTip", 0, 28.6, -2, 0.8, P.ButtonRed)
	tip.Material = Enum.Material.Neon
	awning(b, 13, 5, 6.6, color)
	counter(b, 7, 7.8, color)
	crates(b, -9.5, 6)
	sign(b, def, 12, 9.2, 3, color)
	return 25
end

-- Hangar: a big arched roof (a cylinder half sunk into the floor).
Styles.hangar = function(b, def, color)
	local arch = b.cyl("Arch", 0, 0, -3, 22, 15, color, true)
	arch.CFrame = b.at(0, 0, -3) * CFrame.Angles(0, math.rad(90), 0)
	-- white ribs over the arch
	for _, f in { -9, -3, 3 } do
		local rib = b.cyl("Rib", 0, 0, f, 22.4, 0.6, P.White, false)
		rib.CFrame = b.at(0, 0, f) * CFrame.Angles(0, math.rad(90), 0)
	end
	b.box("Doorway", 0, 3.6, 4.55, Vector3.new(12, 7.2, 0.2), darker(color, 0.5), false)
	b.box("DoorStripe", 0, 7.4, 4.6, Vector3.new(12.4, 0.5, 0.25), P.Coin, false)
	-- 4.6: in front of the arch's front face (z 4.5), so they do not z-fight with it
	window(b, -7.8, 4, 4.6, 2.5, 2.5)
	window(b, 7.8, 4, 4.6, 2.5, 2.5)
	awning(b, 10, 5.5, 7, color)
	counter(b, 7, 8.4, color)
	crates(b, 10.5, 7.5)
	sign(b, def, 14, 12.6, 0.8, color)
	return 14
end

-- Combat Arena: octagon ring wall with an open front, flags and a big sign.
local function arenaStyle(b: Builder, def: Config.SlotDef, color: Color3): number
	local radius = 12.5
	b.cyl("ArenaFloor", 0, 0.12, 0, radius * 2, 0.22, lighter(P.Wood, 0.5), false)
	b.cyl("ArenaRing", 0, 0.25, 0, 8, 0.1, P.White, false)
	for i = 0, 7 do
		local angle = math.rad(i * 45)
		-- leave the front segment (pointing at the walkway) open as the entrance
		if i ~= 0 then
			local x = math.sin(angle) * radius
			local f = math.cos(angle) * radius
			local wall =
				b.box("RingWall", x, 2.5, f, Vector3.new(10.2, 5, 1.6), if i % 2 == 0 then color else P.White, true)
			wall.CFrame = b.at(x, 2.5, f) * CFrame.Angles(0, -angle, 0)
			b.box("RingTop", x, 5.2, f, Vector3.new(10.4, 0.4, 2), darker(color, 0.25), false).CFrame = b.at(x, 5.2, f)
				* CFrame.Angles(0, -angle, 0)
		end
	end
	-- Flags on poles around the ring.
	for i, angle in { 45, 135, 225, 315 } do
		local a = math.rad(angle)
		local x, f = math.sin(a) * (radius + 1.5), math.cos(a) * (radius + 1.5)
		b.box("FlagPole", x, 6, f, Vector3.new(0.4, 12, 0.4), P.GateIron, false)
		b.box("Flag", x + 1.6, 10.8, f, Vector3.new(3, 2, 0.15), if i % 2 == 0 then P.White else P.ButtonRed, false)
	end
	-- Entrance arch with the sign.
	local archF = radius + 0.5
	for _, x in { -5.2, 5.2 } do
		b.box("ArchPost", x, 5, archF, Vector3.new(1.4, 10, 1.4), darker(color, 0.2), true)
	end
	local board = b.box("ArenaSign", 0, 10.2, archF, Vector3.new(13, 3, 0.6), P.PillBlack, false)
	BuildingFactory.FaceText(board, Enum.NormalId.Front, def.icon .. " COMBAT ARENA", P.PillBlack)
	-- Two practice targets inside.
	for _, x in { -4, 4 } do
		local target = b.cyl("Target", x, 2.4, -5, 3, 0.4, P.White, false)
		target.CFrame = b.at(x, 2.4, -5) * CFrame.Angles(0, math.rad(90), 0)
		local bull = b.cyl("Bullseye", x, 2.4, -4.75, 1.4, 0.45, P.ButtonRed, false)
		bull.CFrame = b.at(x, 2.4, -4.75) * CFrame.Angles(0, math.rad(90), 0)
		b.box("TargetLeg", x, 0.6, -5, Vector3.new(0.3, 1.2, 0.3), P.Wood, false)
	end
	crates(b, 10.5, 9)
	return 13
end

function BuildingFactory.Build(slotDef: Config.SlotDef, cframe: CFrame): Model
	if slotDef.kind == "arena" or slotDef.style == "arena" then
		return BuildingFactory.BuildArena(slotDef, cframe)
	end
	local b = newBuilder("Building_" .. slotDef.id, cframe)
	local builder = Styles[slotDef.style] or Styles.shop
	local topHeight = builder(b, slotDef, slotDef.color)
	return finish(b, topHeight)
end

function BuildingFactory.BuildArena(slotDef: Config.SlotDef, cframe: CFrame): Model
	local b = newBuilder("Arena_" .. slotDef.id, cframe)
	local topHeight = arenaStyle(b, slotDef, slotDef.color)
	return finish(b, topHeight)
end

-------------------------------------------------------------------------------
-- Employee NPC (black suit, white shirt, red tie) - like the "Hire me" man
-------------------------------------------------------------------------------
function BuildingFactory.BuildEmployee(cframe: CFrame): Model
	local b = newBuilder("Employee", cframe)
	local suit = P.PillBlack
	local skin = P.CoinShine -- classic blocky toy skin tone from the palette
	for _, x in { -0.5, 0.5 } do
		b.box("Leg", x, 1, 0, Vector3.new(0.95, 2, 1), suit, false)
		b.box("Shoe", x, 0.15, 0.15, Vector3.new(1, 0.3, 1.3), P.TextStroke, false)
	end
	b.box("Torso", 0, 3, 0, Vector3.new(2, 2, 1), suit, false)
	b.box("Shirt", 0, 3.25, 0.52, Vector3.new(0.8, 1.5, 0.05), P.White, false)
	b.box("Tie", 0, 3.15, 0.56, Vector3.new(0.3, 1.2, 0.05), P.ButtonRed, false)
	for _, x in { -1.5, 1.5 } do
		b.box("Arm", x, 3, 0, Vector3.new(1, 2, 1), suit, false)
		b.box("Hand", x, 1.8, 0, Vector3.new(0.8, 0.5, 0.8), skin, false)
	end
	b.box("Briefcase", 1.5, 1.1, 0.1, Vector3.new(0.5, 1.1, 1.5), P.Wood, false)
	b.box("Head", 0, 4.75, 0, Vector3.new(1.5, 1.5, 1.5), skin, false)
	b.box("Hair", 0, 5.6, -0.1, Vector3.new(1.6, 0.35, 1.6), P.TextStroke, false)
	for _, x in { -0.35, 0.35 } do
		b.box("Eye", x, 4.95, 0.76, Vector3.new(0.2, 0.3, 0.05), P.TextStroke, false)
	end
	b.box("Smile", 0, 4.4, 0.76, Vector3.new(0.6, 0.12, 0.05), P.TextStroke, false)
	return finish(b, 6.5)
end

-------------------------------------------------------------------------------
-- Iron gate with spikes and a big gold padlock (image 1)
-------------------------------------------------------------------------------
function BuildingFactory.BuildGate(cframe: CFrame, width: number): Model
	local b = newBuilder("Gate", cframe)
	local iron = P.GateIron
	local height = 10
	-- posts with gold ball finials
	for _, x in { -(width / 2 + 0.8), width / 2 + 0.8 } do
		b.box("GatePost", x, height / 2 + 0.5, 0, Vector3.new(1.6, height + 1, 1.6), iron, false)
		b.ball("Finial", x, height + 1.5, 0, 1.4, P.Padlock)
	end
	-- vertical bars with diamond spikes on top
	local bars = math.floor(width / 1.25)
	local spacing = width / bars
	for i = 0, bars - 1 do
		local x = -width / 2 + (i + 0.5) * spacing
		b.box("Bar", x, height / 2, 0, Vector3.new(0.3, height, 0.3), iron, false)
		local spike = b.box("Spike", x, height + 0.3, 0, Vector3.new(0.55, 0.55, 0.3), iron, false)
		spike.CFrame = b.at(x, height + 0.3, 0) * CFrame.Angles(0, 0, math.rad(45))
	end
	-- horizontal rails and a decorative middle bar
	for _, y in { 1.2, height - 1.4 } do
		b.box("Rail", 0, y, 0, Vector3.new(width, 0.45, 0.5), iron, false)
	end
	b.box("CentreBar", 0, height / 2, 0.05, Vector3.new(0.6, height, 0.6), iron, false)
	-- big gold padlock hanging on the front (the side the player comes from)
	local lockY = height / 2 - 0.3
	b.box("Padlock", 0, lockY, 0.75, Vector3.new(2.8, 2.4, 1), P.Padlock, false)
	b.box("PadlockShine", -0.7, lockY + 0.5, 1.27, Vector3.new(0.6, 0.9, 0.05), P.CoinShine, false)
	b.box("Keyhole", 0, lockY - 0.2, 1.27, Vector3.new(0.35, 0.8, 0.05), P.TextStroke, false)
	for _, x in { -0.9, 0.9 } do
		b.box("Shackle", x, lockY + 1.75, 0.75, Vector3.new(0.4, 1.3, 0.4), P.CoinShine, false)
	end
	b.box("ShackleTop", 0, lockY + 2.5, 0.75, Vector3.new(2.2, 0.4, 0.4), P.CoinShine, false)
	return finish(b, height + 3)
end

return BuildingFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CombatVisuals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CombatVisuals (client)
	Draws one combat fight for the local player only: blocky enemy soldiers,
	glowing bullets, grenade warning circles, sniper lasers, spinning gold cash
	coins, death pops and floating damage numbers. Nothing here decides game
	results: the server (CombatService) simulates everything as data and this
	module just renders it.

	How the data arrives (see CombatService header):
	  * 20 Hz snapshots (enemy positions/HP/state, cash pickups) -> enemies are
	    drawn ~100 ms in the past and smoothly interpolated between snapshots.
	  * Projectile spawns { x, z, vx, vz, born } -> bullets move on the client by
	    themselves (position = start + velocity x (serverTime - born)).
	All positions are arena-local (x, z from the arena centre).

	API:
		local visuals = CombatVisuals.new(center: Vector3)
		visuals.ApplySnapshot(snap)          -- CombatDefs.Snap
		visuals.AddProjectiles(list)         -- "ProjectileBatch" entries (same id = replace)
		visuals.RemoveProjectiles(ids)
		visuals.Telegraph(payload)           -- "grenade" | "laser"
		visuals.EnemyDied(list)
		visuals.Damage(list)                 -- floating numbers ("enemy" | "player" | "dodge" | "shield" | "heal" | "boom")
		visuals.Collected(list)              -- "+$12.50" where a coin was picked up
		visuals.ClearCombat()                -- remove enemies, bullets, coins and warnings (end of the fight)
		visuals.Update(dt, rootPosition?) -> { number }
			-- call every frame; returns ids of ENEMY bullets touching the local
			-- player's HumanoidRootPart this frame (each id only once)
		visuals.Destroy()                    -- removes every part this module made
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatDefs = require(Shared.Combat.CombatDefs)
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local P = Config.Palette
local player = Players.LocalPlayer

type Snap = CombatDefs.Snap
type SnapEnemy = CombatDefs.SnapEnemy

local INTERP_DELAY = 0.1 -- draw enemies 100 ms in the past (smooth between snapshots)
local MAX_FLOATS_PER_BATCH = 10
local FLOATS_PER_SECOND = 18 -- floating numbers are parts + billboards: keep them affordable
local BULLET_POOL_MAX = 160
local HALF_X = CombatDefs.HALF_X
local HALF_Z = CombatDefs.HALF_Z
local FLOOR_Y = 0

export type Visuals = {
	ApplySnapshot: (snap: Snap) -> (),
	AddProjectiles: (list: { any }) -> (),
	RemoveProjectiles: (ids: { any }) -> (),
	Telegraph: (payload: { [string]: any }) -> (),
	EnemyDied: (list: { any }) -> (),
	Damage: (list: { any }) -> (),
	Collected: (list: { any }) -> (),
	ClearCombat: () -> (),
	Update: (dt: number, rootPosition: Vector3?) -> { number },
	Destroy: () -> (),
}

type PartSpec = { part: Part, offset: CFrame, color: Color3 }

type EnemyView = {
	id: number,
	type: string,
	model: Model,
	parts: { PartSpec },
	scale: number,
	hpFill: Frame,
	alert: TextLabel,
	board: BillboardGui,
	lastHp: number,
	flashUntil: number,
	flashing: boolean,
	yaw: number,
	x: number,
	z: number,
	state: string,
	spawnAlpha: number,
}

type ProjectileView = {
	id: number,
	part: Part,
	owner: string,
	x: number,
	z: number,
	vx: number,
	vz: number,
	born: number,
	life: number,
	reported: boolean,
}

type TelegraphView = {
	kind: string,
	parts: { Part },
	start: number,
	duration: number,
	x: number,
	z: number,
	radius: number,
	fromX: number,
	fromZ: number,
	disc: Part?,
	ball: Part?,
	beam: Part?,
}

type PickupView = { model: Model, rim: Part, face: Part, x: number, z: number, phase: number }

local CombatVisuals = {}

-------------------------------------------------------------------------------
-- Part helpers
-------------------------------------------------------------------------------
local function newPart(size: Vector3, color: Color3, parent: Instance?, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.Color = color
	part.Parent = parent
	return part
end

local function tween(instance: Instance, goals: { [string]: any }, duration: number, style: Enum.EasingStyle?)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goals
	)
	t:Play()
end

-------------------------------------------------------------------------------
-- Enemy soldier models (blocky, toy-like: red uniform, steel helmet, black gun)
-------------------------------------------------------------------------------
-- Each entry: name, size, offset from the feet centre (facing -Z), colour.
type Piece = { size: Vector3, offset: Vector3, color: Color3 }

local function soldierPieces(typeId: string): { Piece }
	local skin = P.CoinShine -- Lego-yellow skin, matches the toy look of the reference images
	local uniform = P.EnemyRed
	local dark = P.GatePost
	local gun = P.PillBlack
	local pieces: { Piece } = {
		{ size = Vector3.new(0.8, 1.6, 0.8), offset = Vector3.new(-0.45, 0.8, 0), color = dark }, -- left leg
		{ size = Vector3.new(0.8, 1.6, 0.8), offset = Vector3.new(0.45, 0.8, 0), color = dark }, -- right leg
		{ size = Vector3.new(2, 1.9, 1.1), offset = Vector3.new(0, 2.55, 0), color = uniform }, -- torso
		{ size = Vector3.new(2.05, 0.3, 1.15), offset = Vector3.new(0, 1.75, 0), color = dark }, -- belt
		{ size = Vector3.new(0.6, 1.7, 0.6), offset = Vector3.new(-1.3, 2.6, 0), color = uniform }, -- left arm
		{ size = Vector3.new(0.6, 1.7, 0.6), offset = Vector3.new(1.3, 2.6, -0.3), color = uniform }, -- right arm
		{ size = Vector3.new(1.2, 1.2, 1.2), offset = Vector3.new(0, 4.1, 0), color = skin }, -- head
	}
	if typeId == "Officer" then
		-- officer's peaked cap with a gold band
		table.insert(pieces, { size = Vector3.new(1.5, 0.45, 1.5), offset = Vector3.new(0, 4.85, 0), color = gun })
		table.insert(
			pieces,
			{ size = Vector3.new(1.55, 0.18, 1.55), offset = Vector3.new(0, 4.62, 0), color = P.Padlock }
		)
		table.insert(pieces, { size = Vector3.new(1.3, 0.12, 0.6), offset = Vector3.new(0, 4.55, -0.85), color = gun }) -- visor
		table.insert(
			pieces,
			{ size = Vector3.new(0.5, 0.3, 0.12), offset = Vector3.new(-0.5, 3.1, -0.58), color = P.Padlock }
		) -- medal
		table.insert(pieces, { size = Vector3.new(0.4, 0.4, 2.2), offset = Vector3.new(1.3, 2.3, -1.3), color = gun }) -- pistol
	else
		-- steel helmet
		table.insert(pieces, { size = Vector3.new(1.45, 0.6, 1.45), offset = Vector3.new(0, 4.75, 0), color = dark })
		if typeId == "Charger" then
			table.insert(
				pieces,
				{ size = Vector3.new(0.35, 0.35, 1.6), offset = Vector3.new(1.3, 2.0, -1.0), color = P.Wood }
			) -- baton
		elseif typeId == "Grenadier" then
			table.insert(
				pieces,
				{ size = Vector3.new(0.7, 0.7, 0.7), offset = Vector3.new(1.3, 1.8, -0.6), color = P.TroopGreenDark }
			) -- grenade
		elseif typeId == "Gunner" then
			table.insert(
				pieces,
				{ size = Vector3.new(0.7, 0.7, 2.6), offset = Vector3.new(0.9, 2.5, -1.4), color = gun }
			) -- big gun
			table.insert(
				pieces,
				{ size = Vector3.new(0.8, 0.8, 0.8), offset = Vector3.new(0.9, 2.0, -0.8), color = dark }
			) -- ammo box
		elseif typeId == "Sniper" then
			table.insert(
				pieces,
				{ size = Vector3.new(0.3, 0.3, 3.4), offset = Vector3.new(1.0, 2.8, -1.7), color = gun }
			) -- long rifle
			table.insert(
				pieces,
				{ size = Vector3.new(0.35, 0.35, 0.8), offset = Vector3.new(1.0, 3.15, -1.2), color = dark }
			) -- scope
		else
			table.insert(
				pieces,
				{ size = Vector3.new(0.4, 0.4, 2.2), offset = Vector3.new(1.0, 2.6, -1.2), color = gun }
			) -- rifle
		end
	end
	return pieces
end

-------------------------------------------------------------------------------
-- Constructor
-------------------------------------------------------------------------------
function CombatVisuals.new(center: Vector3): Visuals
	local folder = Instance.new("Folder")
	folder.Name = "CombatFx_" .. player.UserId
	folder.Parent = Workspace

	local enemies: { [number]: EnemyView } = {}
	local deadIds: { [number]: boolean } = {}
	local projectiles: { [number]: ProjectileView } = {}
	local telegraphs: { TelegraphView } = {}
	local pickups: { [number]: PickupView } = {}
	local snaps: { Snap } = {}
	local lastSnapT = -math.huge
	local bulletPool: { Part } = {}
	local destroyed = false
	local floatBudget = FLOATS_PER_SECOND

	-- true if we may show one more floating number right now
	local function takeFloat(important: boolean): boolean
		if important then
			return true
		end
		if floatBudget >= 1 then
			floatBudget -= 1
			return true
		end
		return false
	end

	local function world(x: number, z: number, y: number?): Vector3
		return Vector3.new(center.X + x, center.Y + FLOOR_Y + (y or 0), center.Z + z)
	end

	---------------------------------------------------------------------------
	-- Enemies
	---------------------------------------------------------------------------
	local function buildEnemy(id: number, typeId: string, maxHp: number): EnemyView
		local def = CombatDefs.ENEMIES[typeId]
		local scale = if def then def.scale else 1
		local model = Instance.new("Model")
		model.Name = "Enemy_" .. typeId .. "_" .. id
		local parts: { PartSpec } = {}
		local anchor: Part? = nil
		for _, piece in soldierPieces(typeId) do
			local part = newPart(piece.size * scale, piece.color, model)
			part.Name = "Piece"
			table.insert(parts, { part = part, offset = CFrame.new(piece.offset * scale), color = piece.color })
			if not anchor then
				anchor = part
			end
		end
		-- HP bar + "!" warning above the head
		local head = parts[7].part
		local board = Theme.Billboard({
			Name = "EnemyBar",
			Adornee = head,
			Parent = model,
			Size = if typeId == "Officer" then UDim2.fromOffset(150, 34) else UDim2.fromOffset(70, 26),
			StudsOffset = Vector3.new(0, 2.2 * scale, 0),
			AlwaysOnTop = true,
			MaxDistance = 220,
		})
		local back = Instance.new("Frame")
		back.Name = "Back"
		back.BackgroundColor3 = P.PillBlack
		back.AnchorPoint = Vector2.new(0.5, 1)
		back.Position = UDim2.fromScale(0.5, 1)
		back.Size = UDim2.new(1, 0, 0, if typeId == "Officer" then 14 else 9)
		back.Parent = board
		Theme.Corner(back, 0.5)
		Theme.Stroke(back, P.CardOutline, 1.5, true)
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.BackgroundColor3 = P.ButtonRed
		fill.Size = UDim2.fromScale(1, 1)
		fill.Parent = back
		Theme.Corner(fill, 0.5)
		local alert = Theme.Label({
			Name = "Alert",
			Text = "!",
			TextColor3 = P.PriceGold,
			MaxTextSize = 26,
			Size = UDim2.new(1, 0, 1, if typeId == "Officer" then -16 else -10),
			Visible = false,
			Parent = board,
		})
		if typeId == "Officer" then
			alert.Text = "OFFICER"
			alert.TextColor3 = P.White
			alert.Visible = true
		end
		model.Parent = folder
		local view: EnemyView = {
			id = id,
			type = typeId,
			model = model,
			parts = parts,
			scale = scale,
			hpFill = fill,
			alert = alert,
			board = board,
			lastHp = maxHp,
			flashUntil = 0,
			flashing = false,
			yaw = 0,
			x = 0,
			z = 0,
			state = "spawn",
			spawnAlpha = 0,
		}
		return view
	end

	local function setEnemyColor(view: EnemyView, white: boolean)
		for _, spec in view.parts do
			spec.part.Color = if white then P.White else spec.color
		end
		view.flashing = white
	end

	local function setEnemyTransparency(view: EnemyView, transparency: number)
		for _, spec in view.parts do
			spec.part.Transparency = transparency
		end
	end

	local function placeEnemy(view: EnemyView, x: number, z: number, targetX: number, targetZ: number)
		local dx, dz = targetX - x, targetZ - z
		if dx * dx + dz * dz > 0.01 then
			-- Roblox "forward" is -Z: yaw so the soldier faces the target
			view.yaw = math.atan2(-dx, -dz)
		end
		local crouch = if view.state == "charge" then -0.35 * view.scale else 0
		local root = CFrame.new(world(x, z, crouch)) * CFrame.Angles(0, view.yaw, 0)
		local partList = table.create(#view.parts)
		local cframes = table.create(#view.parts)
		for i, spec in view.parts do
			partList[i] = spec.part
			cframes[i] = root * spec.offset
		end
		Workspace:BulkMoveTo(partList, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		view.x, view.z = x, z
	end

	local function removeEnemy(id: number)
		local view = enemies[id]
		if view then
			enemies[id] = nil
			view.model:Destroy()
		end
	end

	-- Death pop: the soldier shrinks away and a few red blocks fly out.
	local function deathPop(view: EnemyView)
		local position = world(view.x, view.z, 2.5 * view.scale)
		for i = 1, 6 do
			local angle = (i / 6) * math.pi * 2
			local cube = newPart(Vector3.new(0.8, 0.8, 0.8), if i % 2 == 0 then P.EnemyRed else P.GatePost, folder)
			cube.CFrame = CFrame.new(position)
			local target = position + Vector3.new(math.cos(angle) * 4, 2 + (i % 3), math.sin(angle) * 4)
			tween(cube, { Position = target, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }, 0.45)
			task.delay(0.5, function()
				cube:Destroy()
			end)
		end
		view.board.Enabled = false
		for _, spec in view.parts do
			tween(spec.part, { Size = spec.part.Size * 0.1, Transparency = 1 }, 0.25)
		end
		local model = view.model
		task.delay(0.3, function()
			model:Destroy()
		end)
	end

	---------------------------------------------------------------------------
	-- Pickups (spinning gold coins)
	---------------------------------------------------------------------------
	local function buildPickup(x: number, z: number, value: number): PickupView
		local model = Instance.new("Model")
		model.Name = "Cash"
		local size = if value >= 1000 then 2.4 elseif value >= 100 then 2.0 else 1.7
		local rim = newPart(Vector3.new(0.35, size, size), P.CoinDark, model)
		rim.Shape = Enum.PartType.Cylinder
		local face = newPart(Vector3.new(0.42, size * 0.75, size * 0.75), P.Coin, model)
		face.Shape = Enum.PartType.Cylinder
		model.Parent = folder
		return { model = model, rim = rim, face = face, x = x, z = z, phase = math.random() * math.pi * 2 }
	end

	---------------------------------------------------------------------------
	-- Bullets (pooled Neon balls)
	---------------------------------------------------------------------------
	local function takeBullet(): Part
		local part = table.remove(bulletPool)
		if part then
			part.Transparency = 0
			return part
		end
		local created = newPart(Vector3.new(1, 1, 1), P.CardOrange, folder, Enum.Material.Neon)
		created.Name = "Bullet"
		created.Shape = Enum.PartType.Ball
		created.CastShadow = false
		return created
	end

	local function releaseBullet(part: Part)
		if #bulletPool < BULLET_POOL_MAX then
			part.Transparency = 1
			part.CFrame = CFrame.new(center + Vector3.new(0, -50, 0))
			table.insert(bulletPool, part)
		else
			part:Destroy()
		end
	end

	local function removeProjectile(id: number)
		local view = projectiles[id]
		if view then
			projectiles[id] = nil
			releaseBullet(view.part)
		end
	end

	---------------------------------------------------------------------------
	-- Public functions
	---------------------------------------------------------------------------
	local visuals = {} :: Visuals

	function visuals.ApplySnapshot(snap: Snap)
		if destroyed or snap.t <= lastSnapT then
			return -- old / out-of-order snapshot
		end
		lastSnapT = snap.t
		table.insert(snaps, snap)
		while #snaps > 12 do
			table.remove(snaps, 1)
		end
		-- create views for new enemies, remove ones the server no longer has
		local present: { [number]: boolean } = {}
		for _, e in snap.enemies do
			present[e.id] = true
			if not enemies[e.id] and not deadIds[e.id] then
				local view = buildEnemy(e.id, e.type, e.maxHp)
				enemies[e.id] = view
				view.x, view.z = e.x, e.z
				placeEnemy(view, e.x, e.z, e.x, e.z + 1)
				setEnemyTransparency(view, 0.7)
			end
		end
		for id, view in enemies do
			if not present[id] then
				-- enemies only disappear when they die (the death event may arrive later)
				enemies[id] = nil
				deadIds[id] = true
				deathPop(view)
			end
		end
		-- pickups: drawn exactly where the latest snapshot says
		local pickupPresent: { [number]: boolean } = {}
		for _, p in snap.pickups do
			pickupPresent[p.id] = true
			if not pickups[p.id] then
				pickups[p.id] = buildPickup(p.x, p.z, p.value)
			end
		end
		for id, view in pickups do
			if not pickupPresent[id] then
				pickups[id] = nil
				view.model:Destroy()
			end
		end
	end

	function visuals.AddProjectiles(list: { any })
		if destroyed or type(list) ~= "table" then
			return
		end
		for _, entry in list do
			if type(entry) == "table" and type(entry.id) == "number" then
				local existing = projectiles[entry.id]
				local part = if existing then existing.part else takeBullet()
				local owner = if entry.ownerKind == "player" then "player" else "enemy"
				if owner == "player" then
					part.Color = P.Coin
					part.Size = Vector3.new(0.8, 0.8, 0.8)
				elseif entry.kind == "sniper" then
					part.Color = P.GateNegative
					part.Size = Vector3.new(1, 1, 1)
				else
					part.Color = P.CardOrangeDark
					part.Size = Vector3.new(1.2, 1.2, 1.2)
				end
				projectiles[entry.id] = {
					id = entry.id,
					part = part,
					owner = owner,
					x = tonumber(entry.x) or 0,
					z = tonumber(entry.z) or 0,
					vx = tonumber(entry.vx) or 0,
					vz = tonumber(entry.vz) or 0,
					born = tonumber(entry.born) or Workspace:GetServerTimeNow(),
					life = tonumber(entry.life) or 5,
					reported = if existing then existing.reported else false,
				}
			end
		end
	end

	function visuals.RemoveProjectiles(ids: { any })
		if type(ids) ~= "table" then
			return
		end
		for _, id in ids do
			if type(id) == "number" then
				removeProjectile(id)
			end
		end
	end

	function visuals.Telegraph(payload: { [string]: any })
		if destroyed then
			return
		end
		local kind = payload.kind
		local duration = math.max(0.1, tonumber(payload.duration) or 0.9)
		local start = tonumber(payload.start) or Workspace:GetServerTimeNow()
		local x = tonumber(payload.x) or 0
		local z = tonumber(payload.z) or 0
		if kind == "grenade" then
			local radius = tonumber(payload.radius) or 5
			-- faint full-size circle (where it will hit) + a growing solid disc
			local outline = newPart(Vector3.new(0.12, radius * 2, radius * 2), P.GateNegative, folder)
			outline.Shape = Enum.PartType.Cylinder
			outline.Transparency = 0.75
			outline.CFrame = CFrame.new(world(x, z, 0.08)) * CFrame.Angles(0, 0, math.rad(90))
			local disc = newPart(Vector3.new(0.14, 0.2, 0.2), P.GateNegative, folder)
			disc.Shape = Enum.PartType.Cylinder
			disc.Transparency = 0.45
			disc.CFrame = CFrame.new(world(x, z, 0.1)) * CFrame.Angles(0, 0, math.rad(90))
			local ball = newPart(Vector3.new(0.9, 0.9, 0.9), P.TroopGreenDark, folder)
			ball.Shape = Enum.PartType.Ball
			table.insert(telegraphs, {
				kind = "grenade",
				parts = { outline, disc, ball },
				start = start,
				duration = duration,
				x = x,
				z = z,
				radius = radius,
				fromX = tonumber(payload.fromX) or x,
				fromZ = tonumber(payload.fromZ) or z,
				disc = disc,
				ball = ball,
				beam = nil,
			})
		elseif kind == "laser" then
			local dx = tonumber(payload.dx) or 0
			local dz = tonumber(payload.dz) or 1
			local length = 120
			local from = world(x, z, 2.8)
			local to = from + Vector3.new(dx, 0, dz) * length
			local beam = newPart(Vector3.new(0.18, 0.18, length), P.GateNegative, folder, Enum.Material.Neon)
			beam.CastShadow = false
			beam.CFrame = CFrame.lookAt((from + to) / 2, to)
			beam.Transparency = 0.35
			table.insert(telegraphs, {
				kind = "laser",
				parts = { beam },
				start = start,
				duration = duration,
				x = x,
				z = z,
				radius = 0,
				fromX = x,
				fromZ = z,
				disc = nil,
				ball = nil,
				beam = beam,
			})
		end
	end

	local function boom(x: number, z: number, radius: number)
		local sphere = newPart(Vector3.new(1, 1, 1), P.CardOrange, folder, Enum.Material.Neon)
		sphere.Shape = Enum.PartType.Ball
		sphere.CastShadow = false
		sphere.Transparency = 0.2
		sphere.CFrame = CFrame.new(world(x, z, 1))
		tween(sphere, { Size = Vector3.new(radius * 2, radius * 2, radius * 2), Transparency = 1 }, 0.35)
		task.delay(0.4, function()
			sphere:Destroy()
		end)
	end

	function visuals.EnemyDied(list: { any })
		if destroyed or type(list) ~= "table" then
			return
		end
		for _, entry in list do
			if type(entry) == "table" and type(entry.id) == "number" then
				deadIds[entry.id] = true
				local view = enemies[entry.id]
				if view then
					enemies[entry.id] = nil
					if type(entry.x) == "number" and type(entry.z) == "number" then
						view.x, view.z = entry.x, entry.z
					end
					deathPop(view)
				end
			end
		end
	end

	function visuals.Damage(list: { any })
		if destroyed or type(list) ~= "table" then
			return
		end
		local shown = 0
		for _, entry in list do
			local important = type(entry) == "table" and entry.kind ~= "enemy" and entry.kind ~= "heal"
			if type(entry) == "table" and shown < MAX_FLOATS_PER_BATCH and takeFloat(important) then
				local x = tonumber(entry.x) or 0
				local z = tonumber(entry.z) or 0
				local amount = tonumber(entry.amount) or 0
				local kind = entry.kind
				local position = world(x + (math.random() - 0.5) * 1.5, z, 6)
				shown += 1
				if kind == "enemy" then
					local text = Format.Short(math.max(1, math.floor(amount + 0.5)))
					if entry.crit then
						Theme.FloatText(position, text .. "!", P.PriceGold)
					else
						Theme.FloatText(position, text, P.White)
					end
				elseif kind == "player" then
					Theme.FloatText(position, "-" .. Format.Short(math.max(1, math.floor(amount + 0.5))), P.ButtonRed)
				elseif kind == "dodge" then
					Theme.FloatText(position, "DODGE", P.White)
				elseif kind == "shield" then
					Theme.FloatText(position, "BLOCKED", P.CardBlue)
				elseif kind == "heal" then
					Theme.FloatText(position, "+" .. Format.Short(math.max(1, math.floor(amount + 0.5))), P.MoneyGreen)
				elseif kind == "boom" then
					shown -= 1
					boom(x, z, CombatDefs.EXPLOSIVE_RADIUS)
				end
			end
		end
	end

	function visuals.Collected(list: { any })
		if destroyed or type(list) ~= "table" then
			return
		end
		local shown = 0
		for _, entry in list do
			if type(entry) == "table" and type(entry.id) == "number" then
				local view = pickups[entry.id]
				if view then
					pickups[entry.id] = nil
					view.model:Destroy()
				end
				if shown < MAX_FLOATS_PER_BATCH and takeFloat(false) then
					shown += 1
					local value = tonumber(entry.value) or 0
					Theme.FloatText(
						world(tonumber(entry.x) or 0, tonumber(entry.z) or 0, 3),
						"+" .. Format.Money(value),
						P.MoneyGreen
					)
				end
			end
		end
	end

	function visuals.ClearCombat()
		for id in enemies do
			removeEnemy(id)
		end
		for id in projectiles do
			removeProjectile(id)
		end
		for _, t in telegraphs do
			for _, part in t.parts do
				part:Destroy()
			end
		end
		table.clear(telegraphs)
		table.clear(snaps)
		for _, view in pickups do
			view.model:Destroy()
		end
		table.clear(pickups)
	end

	-- Enemy position at render time (interpolated between two snapshots).
	local function sampleEnemies(renderT: number): { [number]: { x: number, z: number, e: SnapEnemy } }
		local out: { [number]: { x: number, z: number, e: SnapEnemy } } = {}
		local count = #snaps
		if count == 0 then
			return out
		end
		-- find snapshots a (<= renderT) and b (> renderT)
		local a: Snap = snaps[1]
		local b: Snap? = nil
		for i = 1, count do
			if snaps[i].t <= renderT then
				a = snaps[i]
				b = snaps[i + 1]
			end
		end
		if renderT < snaps[1].t then
			a, b = snaps[1], nil
		end
		local latest = snaps[count]
		local alpha = 0
		if b then
			alpha = math.clamp((renderT - a.t) / math.max(1e-3, b.t - a.t), 0, 1)
		end
		local fromA: { [number]: SnapEnemy } = {}
		for _, e in a.enemies do
			fromA[e.id] = e
		end
		local fromB: { [number]: SnapEnemy } = {}
		if b then
			for _, e in b.enemies do
				fromB[e.id] = e
			end
		end
		for _, e in latest.enemies do
			local ea = fromA[e.id]
			local eb = fromB[e.id]
			if ea and eb then
				out[e.id] = { x = ea.x + (eb.x - ea.x) * alpha, z = ea.z + (eb.z - ea.z) * alpha, e = eb }
			elseif ea then
				out[e.id] = { x = ea.x, z = ea.z, e = e }
			elseif eb then
				out[e.id] = { x = eb.x, z = eb.z, e = e }
			else
				out[e.id] = { x = e.x, z = e.z, e = e }
			end
		end
		return out
	end

	function visuals.Update(dt: number, rootPosition: Vector3?): { number }
		local hits: { number } = {}
		if destroyed then
			return hits
		end
		local now = Workspace:GetServerTimeNow()
		local clock = os.clock()
		floatBudget = math.min(FLOATS_PER_SECOND, floatBudget + dt * FLOATS_PER_SECOND)
		local localRoot: Vector3? = nil
		if rootPosition then
			localRoot = rootPosition - center
		end
		local targetX = if localRoot then localRoot.X else 0
		local targetZ = if localRoot then localRoot.Z else HALF_Z

		-- enemies
		local sampled = sampleEnemies(now - INTERP_DELAY)
		for id, view in enemies do
			local s = sampled[id]
			if s then
				local e = s.e
				view.state = e.state
				-- hit flash when HP dropped
				if e.hp < view.lastHp - 0.01 then
					view.flashUntil = clock + 0.09
				end
				view.lastHp = e.hp
				local fraction = if e.maxHp > 0 then math.clamp(e.hp / e.maxHp, 0, 1) else 0
				view.hpFill.Size = UDim2.fromScale(fraction, 1)
				-- warning "!" while aiming / charging / throwing / lasering
				if view.type ~= "Officer" then
					view.alert.Visible = e.state == "aim"
						or e.state == "charge"
						or e.state == "throw"
						or e.state == "laser"
				else
					view.alert.TextColor3 = if e.state == "aim" then P.PriceGold else P.White
				end
				-- spawn fade-in
				if e.state == "spawn" then
					view.spawnAlpha = math.min(1, view.spawnAlpha + dt * 1.5)
					setEnemyTransparency(view, 0.7 - 0.5 * view.spawnAlpha)
				elseif view.spawnAlpha < 2 then
					view.spawnAlpha = 2
					setEnemyTransparency(view, 0)
				end
				local wantWhite = clock < view.flashUntil
				if wantWhite ~= view.flashing then
					setEnemyColor(view, wantWhite)
				end
				if e.state == "dash" then
					placeEnemy(view, s.x, s.z, s.x + (s.x - view.x) * 10, s.z + (s.z - view.z) * 10)
				else
					placeEnemy(view, s.x, s.z, targetX, targetZ)
				end
			end
		end

		-- projectiles
		for id, view in projectiles do
			local age = now - view.born
			local x = view.x + view.vx * age
			local z = view.z + view.vz * age
			if
				age > view.life
				or math.abs(x) > HALF_X + 1
				or math.abs(z) > HALF_Z + 1
				or CombatDefs.CoverAt(x, z, 0)
			then
				removeProjectile(id)
			else
				view.part.CFrame = CFrame.new(world(x, z, 2.6))
				if view.owner == "enemy" and localRoot and not view.reported then
					local dx, dz = x - localRoot.X, z - localRoot.Z
					if dx * dx + dz * dz <= CombatDefs.CLIENT_HIT_RADIUS * CombatDefs.CLIENT_HIT_RADIUS then
						view.reported = true
						table.insert(hits, id)
						removeProjectile(id) -- hide it right away; the server confirms
					end
				end
			end
		end

		-- telegraphs
		for i = #telegraphs, 1, -1 do
			local t = telegraphs[i]
			local progress = (now - t.start) / t.duration
			if progress >= 1 then
				if t.kind == "grenade" then
					boom(t.x, t.z, t.radius)
				end
				for _, part in t.parts do
					part:Destroy()
				end
				table.remove(telegraphs, i)
			elseif t.kind == "grenade" then
				local alpha = math.clamp(progress, 0, 1)
				local disc = t.disc
				if disc then
					local d = math.max(0.2, t.radius * 2 * alpha)
					disc.Size = Vector3.new(0.14, d, d)
					disc.CFrame = CFrame.new(world(t.x, t.z, 0.1)) * CFrame.Angles(0, 0, math.rad(90))
				end
				local ball = t.ball
				if ball then
					-- lobbed arc from the thrower to the target
					local bx = t.fromX + (t.x - t.fromX) * alpha
					local bz = t.fromZ + (t.z - t.fromZ) * alpha
					local height = 3 + 10 * 4 * alpha * (1 - alpha)
					ball.CFrame = CFrame.new(world(bx, bz, height))
				end
			elseif t.kind == "laser" then
				local beam = t.beam
				if beam then
					-- flicker faster as the shot gets close
					local blink = math.sin(progress * progress * 40) > 0
					beam.Transparency = if blink then 0.15 else 0.6
				end
			end
		end

		-- coins spin and bob
		for _, view in pickups do
			view.phase += dt * 3
			local y = 1.6 + math.sin(view.phase) * 0.25
			local cf = CFrame.new(world(view.x, view.z, y)) * CFrame.Angles(0, view.phase, 0)
			view.rim.CFrame = cf
			view.face.CFrame = cf
		end
		return hits
	end

	function visuals.Destroy()
		if destroyed then
			return
		end
		destroyed = true
		visuals.ClearCombat()
		for _, part in bulletPool do
			part:Destroy()
		end
		table.clear(bulletPool)
		folder:Destroy()
	end

	return visuals
end

return CombatVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">RunnerBoss</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerBoss (client)
	The giant boss that walks out of the castle at the end of an army run
	(owner request: "a boss at final stage of run that comes out of castle
	and does damage to units ... health bar on top of its head").
	Built from plain Parts (no meshes / asset ids): a red brute about 3.5x a
	soldier, horned helmet, angry face and a huge cannon on its right arm.
	All parts are Anchored and moved with workspace:BulkMoveTo every frame.
	It is visual only: RunnerVisuals drives it from RunnerSim's BossOutcome.
	It is about 11.7 studs tall (horns, mid-stride), so RunnerModels.Fort's
	gateway is 13 studs high.

	Public API:
		local boss = RunnerBoss.new(parent, pivot: CFrame, maxHp)
			pivot = its feet, LookVector = where it faces. Created HIDDEN (every
			part invisible, HP bar off) so it can wait behind the castle door.
		boss:Show()                    make it visible + switch its HP bar on (walk-out)
		boss:SetMaxHp(maxHp)           new max HP (bar shows hp / maxHp)
		boss:WalkTo(pivot, duration)   walk (swinging legs) to a new pivot
		boss:Attack() -> Vector3       cannon recoil; returns the muzzle position
		boss:Hit()                     short white flash (throttled)
		boss:SetHp(hp)                 health bar: fill green -> red + "1,234 / 5,000"
		boss:Die()                     topples backwards and fades (victory)
		boss:Roar()                    raises its arms (it won)
		boss:Update(dt)                call every frame
		boss:AimPoints() -> { Vector3 } points on its body for bullets to hit
		boss:Chest() -> Vector3
		boss:Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local RunnerModels = require(script.Parent.RunnerModels)

local P = Config.Palette

export type Boss = {
	Show: (self: Boss) -> (),
	SetMaxHp: (self: Boss, maxHp: number) -> (),
	WalkTo: (self: Boss, pivot: CFrame, duration: number) -> (),
	Attack: (self: Boss) -> Vector3,
	Hit: (self: Boss) -> (),
	SetHp: (self: Boss, hp: number) -> (),
	Die: (self: Boss) -> (),
	Roar: (self: Boss) -> (),
	Update: (self: Boss, dt: number) -> (),
	AimPoints: (self: Boss) -> { Vector3 },
	Chest: (self: Boss) -> Vector3,
	Destroy: (self: Boss) -> (),
}

-- Joints in boss space (feet at the origin, facing -Z). [PROPOSAL] sizes.
local JOINTS: { [string]: CFrame } = {
	body = CFrame.new(),
	head = CFrame.new(0, 7.7, 0),
	leftArm = CFrame.new(-3.0, 7.3, 0),
	rightArm = CFrame.new(3.0, 7.3, 0),
	leftLeg = CFrame.new(-1.15, 3.3, 0),
	rightLeg = CFrame.new(1.15, 3.3, 0),
}
local AIM_ANGLE = math.rad(78) -- the cannon arm is held forward
local MUZZLE = CFrame.new(0, -7.1, 0) -- in the right-arm joint frame

type PieceDef = {
	group: string,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	shape: Enum.PartType?,
	material: Enum.Material?,
}

local function def(
	group: string,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	shape: Enum.PartType?
): PieceDef
	return { group = group, name = name, size = size, offset = offset, color = color, shape = shape, material = nil }
end

local ALONG_ARM = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> along the arm (Y)

local PIECES: { PieceDef } = {
	-- Legs (hip joints)
	def("leftLeg", "Leg", Vector3.new(1.7, 2.6, 1.8), CFrame.new(0, -1.3, 0), P.GatePost),
	def("leftLeg", "Boot", Vector3.new(1.9, 0.8, 2.3), CFrame.new(0, -2.9, -0.2), P.GateIron),
	def("rightLeg", "Leg", Vector3.new(1.7, 2.6, 1.8), CFrame.new(0, -1.3, 0), P.GatePost),
	def("rightLeg", "Boot", Vector3.new(1.9, 0.8, 2.3), CFrame.new(0, -2.9, -0.2), P.GateIron),
	-- Body
	def("body", "Belt", Vector3.new(4.6, 0.7, 2.6), CFrame.new(0, 3.55, 0), P.GatePost),
	def("body", "Buckle", Vector3.new(1.0, 0.6, 0.2), CFrame.new(0, 3.55, -1.35), P.Coin),
	def("body", "Torso", Vector3.new(5.0, 3.8, 2.8), CFrame.new(0, 5.8, 0), P.EnemyRed),
	def("body", "Chest", Vector3.new(3.6, 2.4, 0.3), CFrame.new(0, 6.1, -1.5), P.ButtonRedDark),
	def("body", "Badge", Vector3.new(0.9, 0.9, 0.12), CFrame.new(0, 6.2, -1.7), P.Coin),
	def("body", "PadL", Vector3.new(1.9, 0.9, 2.1), CFrame.new(-3.0, 7.75, 0), P.GatePost),
	def("body", "PadR", Vector3.new(1.9, 0.9, 2.1), CFrame.new(3.0, 7.75, 0), P.GatePost),
	-- Head
	def("head", "Head", Vector3.new(2.2, 2.0, 2.0), CFrame.new(0, 1.15, 0), P.CoinShine),
	def("head", "Helmet", Vector3.new(2.6, 1.0, 2.5), CFrame.new(0, 2.35, 0.05), P.ButtonRedDark),
	def(
		"head",
		"HornL",
		Vector3.new(0.45, 1.2, 0.45),
		CFrame.new(-1.1, 3.0, 0) * CFrame.Angles(0, 0, math.rad(25)),
		P.Coin
	),
	def(
		"head",
		"HornR",
		Vector3.new(0.45, 1.2, 0.45),
		CFrame.new(1.1, 3.0, 0) * CFrame.Angles(0, 0, math.rad(-25)),
		P.Coin
	),
	def("head", "EyeL", Vector3.new(0.45, 0.35, 0.1), CFrame.new(-0.5, 1.35, -1.02), P.Shade),
	def("head", "EyeR", Vector3.new(0.45, 0.35, 0.1), CFrame.new(0.5, 1.35, -1.02), P.Shade),
	def("head", "Brow", Vector3.new(1.8, 0.28, 0.12), CFrame.new(0, 1.75, -1.03) * CFrame.Angles(0, 0, 0), P.Shade),
	def("head", "Mouth", Vector3.new(1.0, 0.2, 0.1), CFrame.new(0, 0.62, -1.02), P.Shade),
	-- Left arm (big fist)
	def("leftArm", "Arm", Vector3.new(1.3, 3.4, 1.3), CFrame.new(0, -1.7, 0), P.EnemyRed),
	def("leftArm", "Fist", Vector3.new(1.6, 1.4, 1.6), CFrame.new(0, -3.8, 0), P.CoinShine),
	-- Right arm with the giant cannon (held forward, see AIM_ANGLE)
	def("rightArm", "Arm", Vector3.new(1.3, 3.0, 1.3), CFrame.new(0, -1.5, 0), P.EnemyRed),
	def("rightArm", "Hand", Vector3.new(1.5, 1.2, 1.5), CFrame.new(0, -3.2, 0), P.CoinShine),
	def(
		"rightArm",
		"Cannon",
		Vector3.new(4.4, 1.9, 1.9),
		CFrame.new(0, -4.6, 0) * ALONG_ARM,
		P.GatePost,
		Enum.PartType.Cylinder
	),
	def("rightArm", "Drum", Vector3.new(1.3, 1.3, 1.3), CFrame.new(1.05, -4.0, 0), P.Coin),
	def(
		"rightArm",
		"Ring",
		Vector3.new(0.5, 2.3, 2.3),
		CFrame.new(0, -6.6, 0) * ALONG_ARM,
		P.ButtonRed,
		Enum.PartType.Cylinder
	),
}

local RunnerBoss = {}

local function hpText(n: number): string
	return (Format.Money(math.max(0, math.floor(n + 0.5))):gsub("^%$", ""))
end

function RunnerBoss.new(parent: Instance, pivot: CFrame, maxHp: number): Boss
	local model = Instance.new("Model")
	model.Name = "Boss"
	local parts: { BasePart } = {}
	local groups: { string } = {}
	local offsets: { CFrame } = {}
	local helmet: BasePart? = nil
	local maxHpNow = maxHp
	for _, piece in PIECES do
		local part = RunnerModels.Part({
			Name = piece.name,
			Size = piece.size,
			CFrame = pivot * JOINTS[piece.group] * piece.offset,
			Color = piece.color,
			Shape = piece.shape,
			Material = piece.material,
			Parent = model,
		})
		table.insert(parts, part)
		table.insert(groups, piece.group)
		table.insert(offsets, piece.offset)
		if piece.name == "Helmet" then
			helmet = part
		end
	end
	-- Glowing cannon mouth.
	local glow = RunnerModels.Part({
		Name = "Glow",
		Size = Vector3.new(0.2, 1.3, 1.3),
		CFrame = pivot,
		Color = P.EnemyRed,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		Parent = model,
	})
	table.insert(parts, glow)
	table.insert(groups, "rightArm")
	table.insert(offsets, CFrame.new(0, -6.85, 0) * ALONG_ARM)
	for _, part in parts do
		part.CastShadow = true
		part.Transparency = 1 -- hidden until Show() (it waits behind the castle door)
	end

	local highlight = Instance.new("Highlight")
	highlight.FillColor = P.White
	highlight.OutlineTransparency = 1
	highlight.FillTransparency = 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = model
	highlight.Parent = model
	model.Parent = parent

	---------------------------------------------------------------------------
	-- Health bar on top of its head
	---------------------------------------------------------------------------
	local gui = Theme.Billboard({
		Name = "BossHp",
		Parent = model,
		Adornee = helmet,
		Size = UDim2.fromOffset(300, 70),
		StudsOffset = Vector3.new(0, 3.4, 0),
		AlwaysOnTop = true,
		MaxDistance = 500,
	})
	gui.Enabled = false -- switched on by Show() when it walks out
	Theme.Label({
		Text = "👹 BOSS",
		TextColor3 = P.White,
		MaxTextSize = 26,
		Size = UDim2.new(1, 0, 0, 28),
		Parent = gui,
	})
	local back = Instance.new("Frame")
	back.Name = "Bar"
	back.BackgroundColor3 = P.PillBlack
	back.Position = UDim2.fromOffset(0, 30)
	back.Size = UDim2.new(1, 0, 0, 34)
	back.Parent = gui
	Theme.Corner(back, 0.5)
	Theme.Stroke(back, P.CardOutline, 3, true)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = P.MoneyGreen
	fill.Position = UDim2.fromOffset(3, 3)
	fill.Size = UDim2.new(1, -6, 1, -6)
	fill.Parent = back
	Theme.Corner(fill, 0.5)
	local hpLabel = Theme.Label({
		Text = "",
		MaxTextSize = 22,
		Size = UDim2.new(1, -12, 1, -4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Parent = back,
	})

	---------------------------------------------------------------------------
	-- Animation state
	---------------------------------------------------------------------------
	local destroyed = false
	local current = pivot
	local walkFrom, walkTo = pivot, pivot
	local walkT, walkDuration = 1, 0
	local walkPhase = 0
	local clock = 0
	local recoil = 0 -- 1 right after a shot, decays to 0
	local flash = 0
	local lastFlash = 0
	local dying: number? = nil -- seconds since Die()
	local roaring = false
	local shown = false

	local self = {} :: Boss

	function self.SetHp(_self: Boss, hp: number)
		local f = if maxHpNow > 0 then math.clamp(hp / maxHpNow, 0, 1) else 0
		fill.Size = UDim2.new(f, -math.floor(6 * f + 0.5), 1, -6)
		fill.Visible = f > 0
		fill.BackgroundColor3 = P.ButtonRed:Lerp(P.MoneyGreen, f)
		hpLabel.Text = hpText(hp) .. " / " .. hpText(maxHpNow)
	end

	function self.SetMaxHp(_self: Boss, newMax: number)
		maxHpNow = math.max(0, newMax)
	end

	function self.Show(_self: Boss)
		if shown or destroyed or dying ~= nil then
			return
		end
		shown = true
		for _, part in parts do
			part.Transparency = 0
		end
		gui.Enabled = true
	end

	function self.WalkTo(_self: Boss, target: CFrame, duration: number)
		walkFrom = current
		walkTo = target
		walkT = 0
		walkDuration = math.max(0.05, duration)
	end

	local function jointCFrames(root: CFrame): { [string]: CFrame }
		local walking = walkT < 1
		local swing = if walking then math.sin(walkPhase) * math.rad(28) else 0
		local breathe = math.sin(clock * 2.2) * 0.08
		local armUp = 0
		if roaring then
			armUp = math.rad(150) + math.sin(clock * 9) * math.rad(10)
		end
		local aim = AIM_ANGLE + recoil * math.rad(28) - (if roaring then math.rad(40) else 0)
		local lean = CFrame.Angles(recoil * math.rad(5), 0, 0)
		local bob = if walking then math.abs(math.sin(walkPhase)) * 0.35 else breathe
		local body = root * CFrame.new(0, bob, 0) * lean
		return {
			body = body,
			head = body * JOINTS.head * CFrame.Angles(if roaring then math.rad(-15) else 0, 0, 0),
			leftArm = body * JOINTS.leftArm * CFrame.Angles(-swing * 0.8 + math.rad(12) + armUp, 0, 0),
			rightArm = body * JOINTS.rightArm * CFrame.Angles(aim, 0, 0),
			leftLeg = root * JOINTS.leftLeg * CFrame.Angles(swing, 0, 0),
			rightLeg = root * JOINTS.rightLeg * CFrame.Angles(-swing, 0, 0),
		}
	end

	function self.Attack(_self: Boss): Vector3
		recoil = 1
		local joints = jointCFrames(current)
		return (joints.rightArm * MUZZLE).Position
	end

	function self.Hit(_self: Boss)
		if clock - lastFlash > 0.12 then
			lastFlash = clock
			flash = 1
		end
	end

	function self.Die(_self: Boss)
		if dying == nil then
			dying = 0
			roaring = false
			gui.Enabled = false
		end
	end

	function self.Roar(_self: Boss)
		roaring = true
	end

	function self.Chest(_self: Boss): Vector3
		return (current * CFrame.new(0, 6, -1.2)).Position
	end

	function self.AimPoints(_self: Boss): { Vector3 }
		return {
			(current * CFrame.new(0, 6.2, -1.6)).Position,
			(current * CFrame.new(-1.6, 5.2, -1.5)).Position,
			(current * CFrame.new(1.6, 5.4, -1.5)).Position,
			(current * CFrame.new(0, 8.9, -1.1)).Position,
			(current * CFrame.new(0, 4.0, -1.4)).Position,
		}
	end

	local outParts: { BasePart } = {}
	local outCFrames: { CFrame } = {}

	function self.Update(_self: Boss, dt: number)
		if destroyed then
			return
		end
		clock += dt
		if walkT < 1 then
			walkT = math.min(1, walkT + dt / walkDuration)
			walkPhase += dt * 7
			current = walkFrom:Lerp(walkTo, walkT)
		end
		recoil = math.max(0, recoil - dt * 3.5)

		local root = current
		if dying then
			local d = (dying :: number) + dt
			dying = d
			local fall = math.clamp(d / 1.1, 0, 1)
			root = current * CFrame.Angles(math.rad(82) * fall * fall, 0, 0) * CFrame.new(0, -fall * 0.6, 0)
			if d > 1.0 then
				local fade = math.clamp((d - 1.0) / 0.8, 0, 1)
				for _, part in parts do
					part.Transparency = fade
				end
			end
		end

		local joints = jointCFrames(root)
		table.clear(outParts)
		table.clear(outCFrames)
		for i, part in parts do
			table.insert(outParts, part)
			table.insert(outCFrames, joints[groups[i]] * offsets[i])
		end
		Workspace:BulkMoveTo(outParts, outCFrames, Enum.BulkMoveMode.FireCFrameChanged)

		if flash > 0 then
			flash = math.max(0, flash - dt * 7)
			highlight.FillTransparency = 1 - 0.65 * flash
		end
	end

	function self.Destroy(_self: Boss)
		if destroyed then
			return
		end
		destroyed = true
		model:Destroy()
	end

	self:SetHp(maxHp)
	self:Update(0)
	return self
end

return RunnerBoss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">RunnerGuns</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerGuns (client)
	The guns of the army runner, built from plain Parts (no meshes, no asset
	ids): one chunky toy model per weapon tier of RunnerDefs.WEAPONS, plus the
	pooled bullets / hit flashes / rocket smoke that every unit fires.

	Gun coordinates: the origin is the GRIP (where the hand holds it) and the
	barrel points along -Z, i.e. along the LookVector of whatever it is welded
	to. The server's "RunnerGun" Tool Handle sits in the avatar's right hand
	with its LookVector pointing forward, so a gun welded to the Handle with
	an identity offset points where the avatar aims.

	Public API:
		RunnerGuns.Weapon(tier) -> RunnerDefs.WeaponDef   (tier clamped to 1..MAX_WEAPON_TIER)
		RunnerGuns.Pieces(tier, scale?) -> { Piece }       part list relative to the grip
			Piece = { name, size, offset: CFrame, color, material?, shape? }
		RunnerGuns.MuzzleOffset(tier, scale?) -> CFrame    muzzle relative to the grip
		RunnerGuns.Build(tier, scale?) -> Model
			unanchored, Massless parts (CanCollide / CanQuery / CanTouch off) with
			a PrimaryPart "GunRoot" at the grip. NOT joined yet: move it with
			model:PivotTo, parent it, then call RunnerGuns.WeldTo.
		RunnerGuns.WeldTo(model, part)
			WeldConstraint from `part` (Part0) to every part of the model. Call it
			only AFTER the model is in place and parented: a WeldConstraint keeps
			the offset the parts have when it switches on.
		RunnerGuns.AttachToHandle(handle: BasePart, tier) -> Model
			builds the gun, PivotTo(handle.CFrame * HANDLE_OFFSET), parents it to
			the Handle and only then welds every part to the Handle (the same
			order VehicleService uses for vehicles).
		RunnerGuns.HANDLE_OFFSET: CFrame                   grip relative to the Tool Handle
		RunnerGuns.HandleMuzzle(handle, tier) -> Vector3   world muzzle of the gun on that Handle
		RunnerGuns.POOL_SIZE: number                       default bullet pool size

		RunnerGuns.newPool(parent, maxBullets?) -> Pool    visual bullets (BulkMoveTo, no tweens)
			pool:Fire(from, to, tier, impact) -> boolean   false when every bullet is busy
				flies from `from` to `to` at the tier's bulletSpeed with its
				bulletStyle; `impact` = true plays a hit flash (rocket: explosion)
			pool:Flash(position, size, color, life)        one-off flash (boss hits, ...)
			pool:Update(dt)                                call every frame
			pool:Active() -> number                        bullets in flight
			pool:Destroy()

	Bullet styles (bulletStyle of RunnerDefs.WEAPONS). The track floor is
	white, so bullets are solid (not Neon: glowing yellows turned white) in
	strong, dark-enough colours, one per gun:
		pistol  small orange slug        rifle   long teal tracer
		smg     small fast pink slug     assault blue tracer
		minigun thin purple stream       rocket  big dark-red rocket + smoke trail + explosion flash
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local RunnerDefs = require(Shared.Runner.RunnerDefs)

local P = Config.Palette

type WeaponDef = RunnerDefs.WeaponDef

export type Piece = {
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
}

export type Pool = {
	Fire: (self: Pool, from: Vector3, to: Vector3, tier: number, impact: boolean) -> boolean,
	Flash: (self: Pool, position: Vector3, size: number, color: Color3, life: number) -> (),
	Update: (self: Pool, dt: number) -> (),
	Active: (self: Pool) -> number,
	Destroy: (self: Pool) -> (),
}

local RunnerGuns = {}

local HIDDEN = CFrame.new(0, -500, 0)
local DEFAULT_POOL = 90 -- [PROPOSAL] max visual bullets alive at once (performance cap)
local FLASH_POOL = 40 -- impact + muzzle flashes (oldest is reused when all are busy)
local SMOKE_POOL = 36

-- A Cylinder part's axis is its X axis; this turns it to lie along Z (the barrel).
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0)

RunnerGuns.POOL_SIZE = DEFAULT_POOL
-- Where the gun's grip sits relative to the server's Tool Handle (identity:
-- the Handle IS the grip; its LookVector is the barrel direction).
RunnerGuns.HANDLE_OFFSET = CFrame.new()

function RunnerGuns.Weapon(tier: number): WeaponDef
	local index = math.clamp(math.floor(tier), 1, RunnerDefs.MAX_WEAPON_TIER)
	return RunnerDefs.WEAPONS[index]
end

local function styleOf(tier: number): string
	return RunnerGuns.Weapon(tier).bulletStyle
end

-------------------------------------------------------------------------------
-- Gun models (one per bullet style, so a new tier only needs a style)
-------------------------------------------------------------------------------
local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?): Piece
	return { name = name, size = size, offset = offset, color = color, material = nil, shape = shape }
end

local function cylinderZ(name: string, length: number, diameter: number, at: Vector3, color: Color3): Piece
	return piece(name, Vector3.new(length, diameter, diameter), CFrame.new(at) * ALONG_Z, color, Enum.PartType.Cylinder)
end

type GunDef = { pieces: { Piece }, muzzle: Vector3 }

-- [PROPOSAL] Shapes and colours are invented (toy look, Config.Palette only).
local GUNS: { [string]: GunDef } = {
	pistol = {
		pieces = {
			piece(
				"Grip",
				Vector3.new(0.26, 0.6, 0.32),
				CFrame.new(0, -0.18, 0.06) * CFrame.Angles(math.rad(-12), 0, 0),
				P.GateIron
			),
			piece("Slide", Vector3.new(0.3, 0.32, 1.05), CFrame.new(0, 0.16, -0.28), P.GatePost),
			piece("Accent", Vector3.new(0.32, 0.08, 0.6), CFrame.new(0, 0.34, -0.3), P.Coin),
			cylinderZ("Barrel", 0.25, 0.16, Vector3.new(0, 0.16, -0.86), P.ButtonGrey),
		},
		muzzle = Vector3.new(0, 0.16, -1.0),
	},
	rifle = {
		pieces = {
			piece("Grip", Vector3.new(0.24, 0.5, 0.3), CFrame.new(0, -0.18, 0.05), P.GateIron),
			piece("Body", Vector3.new(0.3, 0.34, 2.2), CFrame.new(0, 0.12, -0.55), P.Wood),
			piece("Stock", Vector3.new(0.28, 0.46, 0.85), CFrame.new(0, 0.02, 0.9), P.Wood),
			cylinderZ("Barrel", 1.3, 0.16, Vector3.new(0, 0.2, -2.25), P.GatePost),
			cylinderZ("Scope", 0.75, 0.22, Vector3.new(0, 0.44, -0.55), P.GateIron),
		},
		muzzle = Vector3.new(0, 0.2, -2.95),
	},
	smg = {
		pieces = {
			piece("Grip", Vector3.new(0.26, 0.5, 0.3), CFrame.new(0, -0.18, 0.05), P.GateIron),
			piece("Body", Vector3.new(0.32, 0.42, 1.2), CFrame.new(0, 0.13, -0.35), P.GatePost),
			piece("Mag", Vector3.new(0.2, 0.7, 0.26), CFrame.new(0, -0.38, -0.45), P.CardOrange),
			piece("Accent", Vector3.new(0.34, 0.1, 0.8), CFrame.new(0, 0.36, -0.35), P.CardOrange),
			cylinderZ("Barrel", 0.5, 0.15, Vector3.new(0, 0.15, -1.2), P.ButtonGrey),
		},
		muzzle = Vector3.new(0, 0.15, -1.48),
	},
	assault = {
		pieces = {
			piece("Grip", Vector3.new(0.26, 0.52, 0.3), CFrame.new(0, -0.2, 0.05), P.GateIron),
			piece("Body", Vector3.new(0.32, 0.42, 2.0), CFrame.new(0, 0.13, -0.55), P.GatePost),
			piece(
				"Mag",
				Vector3.new(0.22, 0.72, 0.3),
				CFrame.new(0, -0.4, -0.65) * CFrame.Angles(math.rad(14), 0, 0),
				P.CardOrange
			),
			piece("Stock", Vector3.new(0.28, 0.42, 0.75), CFrame.new(0, 0.04, 0.75), P.GateIron),
			piece("Sight", Vector3.new(0.12, 0.2, 0.5), CFrame.new(0, 0.44, -0.4), P.CardOrange),
			cylinderZ("Barrel", 0.9, 0.15, Vector3.new(0, 0.17, -2.0), P.ButtonGrey),
		},
		muzzle = Vector3.new(0, 0.17, -2.5),
	},
	minigun = {
		pieces = {
			piece("Grip", Vector3.new(0.26, 0.5, 0.3), CFrame.new(0, -0.2, 0.05), P.GateIron),
			piece("Motor", Vector3.new(0.8, 0.8, 1.0), CFrame.new(0, 0.2, -0.2), P.ButtonGreyDark),
			piece("Ammo", Vector3.new(0.55, 0.6, 0.6), CFrame.new(0.65, 0.05, -0.1), P.Coin),
			piece("Handle", Vector3.new(0.16, 0.16, 0.8), CFrame.new(0, 0.72, -0.2), P.GatePost),
			cylinderZ("Ring", 0.2, 0.9, Vector3.new(0, 0.2, -1.0), P.GatePost),
			cylinderZ("BarrelA", 2.1, 0.17, Vector3.new(0, 0.42, -2.05), P.ButtonGrey),
			cylinderZ("BarrelB", 2.1, 0.17, Vector3.new(0.21, 0.08, -2.05), P.ButtonGrey),
			cylinderZ("BarrelC", 2.1, 0.17, Vector3.new(-0.21, 0.08, -2.05), P.ButtonGrey),
			cylinderZ("Tip", 0.2, 0.75, Vector3.new(0, 0.2, -3.0), P.GatePost),
		},
		muzzle = Vector3.new(0, 0.2, -3.15),
	},
	rocket = {
		pieces = {
			piece("Grip", Vector3.new(0.26, 0.55, 0.3), CFrame.new(0, -0.2, 0.05), P.GateIron),
			cylinderZ("Tube", 3.2, 0.62, Vector3.new(0, 0.38, -0.45), P.TroopGreenDark),
			cylinderZ("BackRing", 0.3, 0.74, Vector3.new(0, 0.38, 1.05), P.GatePost),
			cylinderZ("FrontRing", 0.3, 0.74, Vector3.new(0, 0.38, -1.95), P.ButtonRed),
			piece("Warhead", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0.38, -2.2), P.ButtonRed, Enum.PartType.Ball),
			piece("Sight", Vector3.new(0.14, 0.3, 0.3), CFrame.new(-0.36, 0.72, -0.6), P.Coin),
		},
		muzzle = Vector3.new(0, 0.38, -2.4),
	},
}

local function gunFor(tier: number): GunDef
	return GUNS[styleOf(tier)] or GUNS.pistol
end

local function scaled(offset: CFrame, scale: number): CFrame
	return offset - offset.Position + offset.Position * scale
end

function RunnerGuns.Pieces(tier: number, scale: number?): { Piece }
	local s = scale or 1
	local list: { Piece } = {}
	for _, p in gunFor(tier).pieces do
		table.insert(list, {
			name = p.name,
			size = p.size * s,
			offset = scaled(p.offset, s),
			color = p.color,
			material = p.material,
			shape = p.shape,
		})
	end
	return list
end

function RunnerGuns.MuzzleOffset(tier: number, scale: number?): CFrame
	return CFrame.new(gunFor(tier).muzzle * (scale or 1))
end

local function makeGunPart(p: Piece, cframe: CFrame, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = p.name
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = p.material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if p.shape then
		part.Shape = p.shape
	end
	part.Size = p.size
	part.CFrame = cframe
	part.Color = p.color
	part.Parent = parent
	return part
end

function RunnerGuns.Build(tier: number, scale: number?): Model
	local model = Instance.new("Model")
	model.Name = "RunnerGunModel"
	model:SetAttribute("Tier", tier)
	local origin = CFrame.new(0, 2000, 0) -- built away from everything; PivotTo moves every part
	local root = makeGunPart(piece("GunRoot", Vector3.new(0.2, 0.2, 0.2), CFrame.new(), P.GatePost), origin, model)
	root.Transparency = 1
	for _, p in RunnerGuns.Pieces(tier, scale) do
		makeGunPart(p, origin * p.offset, model)
	end
	model.PrimaryPart = root
	return model
end

function RunnerGuns.WeldTo(model: Model, part: BasePart)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and item ~= part then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "GunWeld"
			weld.Part0 = part
			weld.Part1 = item
			weld.Parent = item
		end
	end
end

function RunnerGuns.AttachToHandle(handle: BasePart, tier: number): Model
	local model = RunnerGuns.Build(tier)
	-- 1) move EVERY part (PivotTo works outside Workspace; setting only the
	--    root's CFrame would leave the pieces 2000 studs up), 2) parent,
	-- 3) weld: each WeldConstraint keeps the offset the parts have right now.
	model:PivotTo(handle.CFrame * RunnerGuns.HANDLE_OFFSET)
	model.Parent = handle
	RunnerGuns.WeldTo(model, handle)
	return model
end

function RunnerGuns.HandleMuzzle(handle: BasePart, tier: number): Vector3
	return (handle.CFrame * RunnerGuns.HANDLE_OFFSET * RunnerGuns.MuzzleOffset(tier)).Position
end

-------------------------------------------------------------------------------
-- Bullet styles
-------------------------------------------------------------------------------
type Style = {
	size: Vector3, -- the bullet part (long side along its flight)
	color: Color3,
	shape: Enum.PartType,
	hitSize: number, -- impact flash diameter
	hitColor: Color3,
	smoke: boolean, -- rocket smoke trail
}

-- [PROPOSAL] Bullet colours: saturated and dark enough to stand out on the
-- white track floor (owner feedback: the old yellow / pale Neon bullets were
-- invisible on it). Hit flashes use the same colour.
local BULLET_ORANGE = Color3.fromRGB(235, 90, 0)
local BULLET_TEAL = Color3.fromRGB(0, 150, 160) -- not red: enemies wear red
local BULLET_PINK = Color3.fromRGB(220, 30, 150)
local BULLET_BLUE = Color3.fromRGB(25, 85, 235)
local BULLET_PURPLE = Color3.fromRGB(125, 35, 220)
local ROCKET_RED = Color3.fromRGB(170, 20, 20)

local STYLES: { [string]: Style } = {
	pistol = {
		size = Vector3.new(0.38, 0.38, 0.8),
		color = BULLET_ORANGE,
		shape = Enum.PartType.Block,
		hitSize = 1.1,
		hitColor = BULLET_ORANGE,
		smoke = false,
	},
	rifle = {
		size = Vector3.new(0.26, 0.26, 2.8),
		color = BULLET_TEAL,
		shape = Enum.PartType.Block,
		hitSize = 1.3,
		hitColor = BULLET_TEAL,
		smoke = false,
	},
	smg = {
		size = Vector3.new(0.3, 0.3, 0.85),
		color = BULLET_PINK,
		shape = Enum.PartType.Block,
		hitSize = 0.9,
		hitColor = BULLET_PINK,
		smoke = false,
	},
	assault = {
		size = Vector3.new(0.28, 0.28, 1.9),
		color = BULLET_BLUE,
		shape = Enum.PartType.Block,
		hitSize = 1.2,
		hitColor = BULLET_BLUE,
		smoke = false,
	},
	minigun = {
		size = Vector3.new(0.22, 0.22, 3.6),
		color = BULLET_PURPLE,
		shape = Enum.PartType.Block,
		hitSize = 0.9,
		hitColor = BULLET_PURPLE,
		smoke = false,
	},
	rocket = {
		size = Vector3.new(0.6, 0.6, 1.7),
		color = ROCKET_RED,
		shape = Enum.PartType.Block,
		hitSize = 7,
		hitColor = P.CardOrange,
		smoke = true,
	},
}

local function styleFor(tier: number): Style
	return STYLES[styleOf(tier)] or STYLES.pistol
end

-------------------------------------------------------------------------------
-- Pool
-------------------------------------------------------------------------------
type Bullet = {
	part: Part,
	from: Vector3,
	to: Vector3,
	t: number,
	duration: number,
	active: boolean,
	impact: boolean,
	style: Style,
	smokeClock: number,
}

type Effect = {
	part: Part,
	position: Vector3,
	t: number,
	life: number,
	size0: number,
	size1: number,
	transparency0: number,
	rise: number,
	active: boolean,
}

local function effectPart(name: string, parent: Instance, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = material
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one
	part.CFrame = HIDDEN
	part.Parent = parent
	return part
end

function RunnerGuns.newPool(parent: Instance, maxBullets: number?): Pool
	local folder = Instance.new("Folder")
	folder.Name = "Bullets"
	folder.Parent = parent
	local destroyed = false

	local bullets: { Bullet } = {}
	for i = 1, maxBullets or DEFAULT_POOL do
		local part = Instance.new("Part")
		part.Name = "Bullet"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.SmoothPlastic -- solid colour: Neon glows towards white on the white floor
		-- Start in the pistol style for real (Fire only restyles when the style
		-- changes, so without this the first pistol bullets stayed default grey).
		part.Size = STYLES.pistol.size
		part.Color = STYLES.pistol.color
		part.Shape = STYLES.pistol.shape
		part.CFrame = HIDDEN
		part.Parent = folder
		bullets[i] = {
			part = part,
			from = Vector3.zero,
			to = Vector3.zero,
			t = 0,
			duration = 0,
			active = false,
			impact = false,
			style = STYLES.pistol,
			smokeClock = 0,
		}
	end
	local free: { number } = {}
	for i = #bullets, 1, -1 do
		table.insert(free, i)
	end
	local activeCount = 0

	local function makeEffects(count: number, name: string, material: Enum.Material): { Effect }
		local list: { Effect } = {}
		for i = 1, count do
			list[i] = {
				part = effectPart(name, folder, material),
				position = Vector3.zero,
				t = 0,
				life = 0,
				size0 = 1,
				size1 = 1,
				transparency0 = 0,
				rise = 0,
				active = false,
			}
		end
		return list
	end
	local flashes = makeEffects(FLASH_POOL, "Flash", Enum.Material.Neon)
	local smokes = makeEffects(SMOKE_POOL, "Smoke", Enum.Material.SmoothPlastic)
	local nextFlash, nextSmoke = 1, 1

	local function startEffect(
		e: Effect,
		position: Vector3,
		size0: number,
		size1: number,
		color: Color3,
		life: number,
		transparency0: number,
		rise: number
	)
		e.position = position
		e.t = 0
		e.life = math.max(0.05, life)
		e.size0 = size0
		e.size1 = size1
		e.transparency0 = transparency0
		e.rise = rise
		e.active = true
		e.part.Color = color
		e.part.Transparency = transparency0
		e.part.Size = Vector3.one * size0
	end

	local self = {} :: Pool

	function self.Flash(_self: Pool, position: Vector3, size: number, color: Color3, life: number)
		if destroyed then
			return
		end
		local e = flashes[nextFlash]
		nextFlash = nextFlash % #flashes + 1
		startEffect(e, position, size * 0.35, size, color, life, 0.05, 0)
	end

	local function smoke(position: Vector3)
		local e = smokes[nextSmoke]
		nextSmoke = nextSmoke % #smokes + 1
		startEffect(e, position, 0.6, 1.8, P.ButtonGrey, 0.55, 0.25, 1.2)
	end

	function self.Fire(_self: Pool, from: Vector3, to: Vector3, tier: number, impact: boolean): boolean
		if destroyed then
			return false
		end
		local index = table.remove(free)
		if not index then
			return false -- every bullet is busy: skip this shot (visual only)
		end
		local bullet = bullets[index]
		local style = styleFor(tier)
		local speed = math.max(10, RunnerGuns.Weapon(tier).bulletSpeed)
		bullet.from = from
		bullet.to = to
		bullet.t = 0
		bullet.duration = math.max(0.04, (to - from).Magnitude / speed)
		bullet.active = true
		bullet.impact = impact
		bullet.smokeClock = 0
		if bullet.style ~= style then
			bullet.style = style
			bullet.part.Size = style.size
			bullet.part.Color = style.color
			bullet.part.Shape = style.shape
		end
		activeCount += 1
		return true
	end

	function self.Active(_self: Pool): number
		return activeCount
	end

	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}

	local function updateEffect(e: Effect, dt: number)
		e.t += dt
		local a = e.t / e.life
		table.insert(parts, e.part)
		if a >= 1 then
			e.active = false
			table.insert(cframes, HIDDEN)
			return
		end
		local size = e.size0 + (e.size1 - e.size0) * a
		e.part.Size = Vector3.one * size
		e.part.Transparency = e.transparency0 + (1 - e.transparency0) * a
		table.insert(cframes, CFrame.new(e.position + Vector3.new(0, e.rise * a, 0)))
	end

	function self.Update(_self: Pool, dt: number)
		if destroyed then
			return
		end
		table.clear(parts)
		table.clear(cframes)
		for index, bullet in bullets do
			if not bullet.active then
				continue
			end
			bullet.t += dt
			local a = bullet.t / bullet.duration
			table.insert(parts, bullet.part)
			if a >= 1 then
				bullet.active = false
				activeCount -= 1
				table.insert(free, index)
				table.insert(cframes, HIDDEN)
				if bullet.impact then
					local style = bullet.style
					self:Flash(bullet.to, style.hitSize, style.hitColor, if style.smoke then 0.45 else 0.14)
					if style.smoke then
						self:Flash(bullet.to + Vector3.new(0, 1, 0), style.hitSize * 0.55, P.Coin, 0.3)
						smoke(bullet.to + Vector3.new(0, 1.5, 0))
					end
				end
			else
				local pos = bullet.from:Lerp(bullet.to, a)
				local look = if (bullet.to - bullet.from).Magnitude > 0.01
					then bullet.to
					else pos + Vector3.new(0, 0, -1)
				table.insert(cframes, CFrame.lookAt(pos, look))
				if bullet.style.smoke then
					bullet.smokeClock += dt
					if bullet.smokeClock >= 0.05 then
						bullet.smokeClock = 0
						smoke(pos)
					end
				end
			end
		end
		for _, e in flashes do
			if e.active then
				updateEffect(e, dt)
			end
		end
		for _, e in smokes do
			if e.active then
				updateEffect(e, dt)
			end
		end
		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end

	function self.Destroy(_self: Pool)
		if destroyed then
			return
		end
		destroyed = true
		folder:Destroy()
	end

	return self
end

return RunnerGuns
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">RunnerModels</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerModels (client)
	Builds the little toy models used by the army runner, from plain Parts only
	(no meshes, no asset ids). Everything is Anchored, SmoothPlastic and
	non-colliding, so nothing can ever block the running avatar.

	Public API:
		RunnerModels.Part(props) -> Part
			props: { Name?, Size, CFrame, Color, Parent, Transparency?, Material?, Shape? }
		RunnerModels.Soldier(kind, parent, pivot, gunTier?) -> Rig
			kind = "troop" (green helmet + body + arms holding a gun) | "enemy" (red uniform)
			Rig = { model, parts, offsets, pivot, gunParts, gunTier }
			Move a rig fast with RunnerModels.RigCFrames(rig, pivot, out) + workspace:BulkMoveTo.
		RunnerModels.SetRigGun(rig, tier)     -- swap the gun the rig holds (RunnerGuns model, troop scale)
		RunnerModels.RigMuzzle(rig, pivot) -> Vector3  -- world position of the rig's muzzle at `pivot`
		RunnerModels.TROOP_GRIP: CFrame       -- where a soldier's right hand holds the gun (rig space)
		RunnerModels.GUN_SCALE: number        -- troop guns are this x the avatar's gun
		RunnerModels.RigCFrames(rig, pivot, outParts, outCFrames)  -- appends part/CFrame pairs
		RunnerModels.CoinStack(parent, position, coins) -> Model     -- flat gold coins + green cash bricks
		RunnerModels.Sandbags(parent, centre, width) -> Model         -- barricade wall
		RunnerModels.Fort(parent, centre) -> (Model, { Vector3 }, Model)
			castle at the end of the track + points to shoot at + its gate door.
			The gateway is a real opening (FORT_GATE_WIDTH x FORT_GATE_HEIGHT,
			FORT_GATE_DEPTH deep) so the ~11.7-stud boss fits; the boss waits in
			it, hidden behind the door, and walks out once RunnerVisuals has sunk
			the door into the ground.
		RunnerModels.FORT_GATE_WIDTH / FORT_GATE_HEIGHT / FORT_GATE_DEPTH: number
		RunnerModels.SurfaceLabel(part, face, text, maxTextSize?) -> TextLabel
			big white text with a dark outline drawn on one face of a part.

	Coordinates: every builder places its model with the "front" facing +Z,
	i.e. towards the runner, who travels towards -Z. Soldier rigs are built
	facing -Z (the run direction); enemies are rotated 180 degrees.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local RunnerGuns = require(script.Parent.RunnerGuns)

local P = Config.Palette

local RunnerModels = {}

export type Rig = {
	model: Model,
	parts: { BasePart }, -- body parts first, then the gun parts
	offsets: { CFrame },
	pivot: CFrame, -- where the rig was built (feet, facing its front)
	gunParts: number, -- how many entries at the end of `parts` are the gun
	gunTier: number, -- 0 = no gun
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Parent: Instance?,
	Transparency: number?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
}

function RunnerModels.Part(props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.Name or "Part"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = true
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		part.Shape = props.Shape
	end
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color
	part.Transparency = props.Transparency or 0
	part.Parent = props.Parent
	return part
end

-------------------------------------------------------------------------------
-- Soldiers
-------------------------------------------------------------------------------
-- Offsets are relative to the soldier's feet, facing -Z (the run direction).
-- Each entry: name, size, offset, colour key.
type PieceDef = { name: string, size: Vector3, offset: CFrame, color: Color3 }

-- [PROPOSAL] Right hand position of a soldier holding its gun forward.
RunnerModels.TROOP_GRIP = CFrame.new(0.62, 1.55, -0.95)
RunnerModels.GUN_SCALE = 0.62 -- soldiers are ~3 studs tall, the avatar ~5

local function soldierPieces(kind: string): { PieceDef }
	local isEnemy = kind == "enemy"
	local body = if isEnemy then P.EnemyRed else P.TroopGreen
	local dark = if isEnemy then P.ButtonRedDark else P.TroopGreenDark
	local legs = if isEnemy then P.GatePost else P.TroopGreenDark
	-- [PROPOSAL] Lego-style yellow head (toy look of the reference images).
	local head = P.CoinShine
	return {
		{ name = "Legs", size = Vector3.new(1.0, 0.9, 0.6), offset = CFrame.new(0, 0.45, 0), color = legs },
		{ name = "Body", size = Vector3.new(1.15, 1.1, 0.7), offset = CFrame.new(0, 1.45, 0), color = body },
		{ name = "Head", size = Vector3.new(0.8, 0.75, 0.75), offset = CFrame.new(0, 2.38, 0), color = head },
		{ name = "Helmet", size = Vector3.new(1.0, 0.42, 1.0), offset = CFrame.new(0, 2.85, 0.02), color = dark },
		-- Both arms reach forward to hold the gun (the right one at TROOP_GRIP).
		{
			name = "RightArm",
			size = Vector3.new(0.3, 0.3, 0.95),
			offset = CFrame.new(0.66, 1.68, -0.5),
			color = body,
		},
		{
			name = "LeftArm",
			size = Vector3.new(0.3, 0.3, 1.05),
			offset = CFrame.new(0.15, 1.62, -0.62) * CFrame.Angles(0, math.rad(-28), 0),
			color = body,
		},
	}
end

function RunnerModels.Soldier(kind: string, parent: Instance, pivot: CFrame, gunTier: number?): Rig
	local model = Instance.new("Model")
	model.Name = if kind == "enemy" then "Enemy" else "Troop"
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	for _, piece in soldierPieces(kind) do
		local part = RunnerModels.Part({
			Name = piece.name,
			Size = piece.size,
			CFrame = pivot * piece.offset,
			Color = piece.color,
			Parent = model,
		})
		part.CastShadow = false -- 40 little shadows cost more than they add
		table.insert(parts, part)
		table.insert(offsets, piece.offset)
	end
	model.WorldPivot = pivot
	model.Parent = parent
	local rig: Rig = { model = model, parts = parts, offsets = offsets, pivot = pivot, gunParts = 0, gunTier = 0 }
	-- Enemies always carry a rifle; troops the weapon tier of the run.
	RunnerModels.SetRigGun(rig, gunTier or (if kind == "enemy" then 2 else 1))
	return rig
end

-- Replaces the gun the rig holds. The new parts are placed at the rig's
-- build pivot; the next RigCFrames call moves them with the rest.
function RunnerModels.SetRigGun(rig: Rig, tier: number)
	if rig.gunTier == tier and rig.gunParts > 0 then
		return
	end
	for _ = 1, rig.gunParts do
		local part = table.remove(rig.parts)
		table.remove(rig.offsets)
		if part then
			part:Destroy()
		end
	end
	rig.gunParts = 0
	rig.gunTier = tier
	local current = rig.model.WorldPivot
	for _, piece in RunnerGuns.Pieces(tier, RunnerModels.GUN_SCALE) do
		local offset = RunnerModels.TROOP_GRIP * piece.offset
		local part = RunnerModels.Part({
			Name = "Gun" .. piece.name,
			Size = piece.size,
			CFrame = current * offset,
			Color = piece.color,
			Material = piece.material,
			Shape = piece.shape,
			Parent = rig.model,
		})
		-- Anchored like the rest of the rig (moved with BulkMoveTo, no welds);
		-- never collides, is never hit by raycasts and never fires Touched.
		part.Massless = true
		part.CastShadow = false
		table.insert(rig.parts, part)
		table.insert(rig.offsets, offset)
		rig.gunParts += 1
	end
end

function RunnerModels.RigMuzzle(rig: Rig, pivot: CFrame): Vector3
	local tier = math.max(1, rig.gunTier)
	return (pivot * RunnerModels.TROOP_GRIP * RunnerGuns.MuzzleOffset(tier, RunnerModels.GUN_SCALE)).Position
end

-- Appends the rig's parts and their target CFrames to the two lists, ready
-- for workspace:BulkMoveTo(outParts, outCFrames).
function RunnerModels.RigCFrames(rig: Rig, pivot: CFrame, outParts: { BasePart }, outCFrames: { CFrame })
	for i, part in rig.parts do
		table.insert(outParts, part)
		table.insert(outCFrames, pivot * rig.offsets[i])
	end
end

-------------------------------------------------------------------------------
-- Text on a part face
-------------------------------------------------------------------------------
function RunnerModels.SurfaceLabel(part: BasePart, face: Enum.NormalId, text: string, maxTextSize: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.94, 0.8)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Font = Config.Font
	label.Text = text
	label.TextColor3 = P.White
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = gui
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxTextSize or 120
	limit.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color = P.TextStroke
	stroke.Thickness = 6
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

-------------------------------------------------------------------------------
-- Cash stack (cash rows)
-------------------------------------------------------------------------------
function RunnerModels.CoinStack(parent: Instance, position: Vector3, coins: number): Model
	local model = Instance.new("Model")
	model.Name = "CashStack"
	local count = math.clamp(math.floor(coins), 1, 8)
	-- A Cylinder part's round faces point along its X axis; rotate so it lies flat.
	local flat = CFrame.Angles(0, 0, math.rad(90))
	for i = 1, count do
		local offset = Vector3.new(((i % 2) - 0.5) * 0.25, 0.22 + (i - 1) * 0.42, ((i % 3) - 1) * 0.15)
		RunnerModels.Part({
			Name = "Coin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 2.6, 2.6),
			CFrame = CFrame.new(position + Vector3.new(-1.2, 0, 0) + offset) * flat,
			Color = if i % 2 == 0 then P.CoinDark else P.Coin,
			Parent = model,
		})
	end
	-- Green cash bricks next to the coins.
	local bricks = math.clamp(math.ceil(count / 2), 1, 4)
	for i = 1, bricks do
		RunnerModels.Part({
			Name = "Cash",
			Size = Vector3.new(1.6, 0.45, 0.9),
			CFrame = CFrame.new(position + Vector3.new(1.3, 0.23 + (i - 1) * 0.47, 0))
				* CFrame.Angles(0, math.rad((i % 2) * 12), 0),
			Color = if i % 2 == 0 then P.MoneyGreenDark else P.MoneyGreen,
			Parent = model,
		})
	end
	model.Parent = parent
	return model
end

-------------------------------------------------------------------------------
-- Barricade (sandbag wall)
-------------------------------------------------------------------------------
function RunnerModels.Sandbags(parent: Instance, centre: Vector3, width: number): Model
	local model = Instance.new("Model")
	model.Name = "Barricade"
	local bagW = 2.2
	local layers = 3
	for layer = 1, layers do
		local shift = if layer % 2 == 0 then bagW / 2 else 0
		local usable = width - 0.6
		local count = math.max(1, math.floor(usable / bagW))
		local startX = -((count - 1) * bagW) / 2 + shift * 0.5
		for i = 1, count do
			local x = startX + (i - 1) * bagW
			if math.abs(x) <= usable / 2 then
				RunnerModels.Part({
					Name = "Sandbag",
					Size = Vector3.new(bagW - 0.15, 1.0, 1.4),
					CFrame = CFrame.new(centre + Vector3.new(x, 0.5 + (layer - 1) * 0.95, 0)),
					Color = if (i + layer) % 2 == 0 then P.Wood else P.WallYellow,
					Parent = model,
				})
			end
		end
	end
	-- Dark posts at both ends with a rail (barbed wire look).
	for _, side in { -1, 1 } do
		RunnerModels.Part({
			Name = "Post",
			Size = Vector3.new(0.5, 4, 0.5),
			CFrame = CFrame.new(centre + Vector3.new(side * (width / 2 - 0.4), 2, 0)),
			Color = P.GatePost,
			Parent = model,
		})
	end
	RunnerModels.Part({
		Name = "Wire",
		Size = Vector3.new(width - 0.6, 0.18, 0.18),
		CFrame = CFrame.new(centre + Vector3.new(0, 3.7, 0)),
		Color = P.GatePost,
		Parent = model,
	})
	model.Parent = parent
	return model
end

-------------------------------------------------------------------------------
-- Enemy base (boss)
-------------------------------------------------------------------------------
-- [PROPOSAL] Gateway sized for the boss (RunnerBoss: ~11.7 studs with its
-- horns mid-stride, ~8 wide with the shoulder pads and cannon drum).
RunnerModels.FORT_GATE_WIDTH = 11
RunnerModels.FORT_GATE_HEIGHT = 13
RunnerModels.FORT_GATE_DEPTH = 7

-- Returns the model, a few points on its front to aim bullets at and the door.
function RunnerModels.Fort(parent: Instance, centre: Vector3): (Model, { Vector3 }, Model)
	local model = Instance.new("Model")
	model.Name = "EnemyBase"
	local width, height, depth = 30, 15, 14 -- [PROPOSAL] walls 2 studs above the gateway
	local gateW = RunnerModels.FORT_GATE_WIDTH
	local gateH = RunnerModels.FORT_GATE_HEIGHT
	local gateD = RunnerModels.FORT_GATE_DEPTH
	local front = depth / 2 -- the +Z face looks at the runner

	local function block(name: string, size: Vector3, offset: Vector3, color: Color3): Part
		return RunnerModels.Part({
			Name = name,
			Size = size,
			CFrame = CFrame.new(centre + offset),
			Color = color,
			Parent = model,
		})
	end

	-- Main walls (red Lego bricks) built AROUND the gateway opening: left and
	-- right blocks, a lintel above the gate and a back block behind the recess.
	local sideW = (width - gateW) / 2
	for _, side in { -1, 1 } do
		block(
			"Wall",
			Vector3.new(sideW, height, depth),
			Vector3.new(side * (gateW / 2 + sideW / 2), height / 2, 0),
			P.WallRed
		)
	end
	block(
		"Lintel",
		Vector3.new(gateW, height - gateH, depth),
		Vector3.new(0, gateH + (height - gateH) / 2, 0),
		P.WallRed
	)
	block(
		"WallBack",
		Vector3.new(gateW, gateH, depth - gateD),
		Vector3.new(0, gateH / 2, front - gateD - (depth - gateD) / 2),
		P.WallRed
	)
	-- Dark back of the gateway recess (the boss waits in front of it).
	block("Gateway", Vector3.new(gateW, gateH, 0.2), Vector3.new(0, gateH / 2, front - gateD + 0.1), P.Shade)
	local crenels = 7
	for i = 1, crenels do
		local x = -width / 2 + (i - 0.5) * (width / crenels)
		block("Crenel", Vector3.new(2.4, 1.6, 2.4), Vector3.new(x, height + 0.8, front - 1.2), P.WallRed)
	end
	-- Two dark towers with yellow tops.
	for _, side in { -1, 1 } do
		local x = side * (width / 2 + 2)
		block("Tower", Vector3.new(6, height + 6, 6), Vector3.new(x, (height + 6) / 2, 2), P.GatePost)
		block("TowerTop", Vector3.new(7, 1.4, 7), Vector3.new(x, height + 6.7, 2), P.WallYellow)
		block("Window", Vector3.new(2, 2, 0.3), Vector3.new(x, height + 2, 5.1), P.Shade)
	end
	-- Iron door with bars over the gateway. Its own model so it can sink
	-- into the ground (RunnerVisuals sinks it by its own height).
	local door = Instance.new("Model")
	door.Name = "Door"
	block(
		"Door",
		Vector3.new(gateW + 0.4, gateH + 0.2, 0.4),
		Vector3.new(0, (gateH + 0.2) / 2, front + 0.3),
		P.GateIron
	).Parent =
		door
	for i = -2, 2 do
		block("DoorBar", Vector3.new(0.35, gateH, 0.2), Vector3.new(i * 2, gateH / 2, front + 0.55), P.GatePost).Parent =
			door
	end
	door.Parent = model
	-- Flag on the roof.
	block("Pole", Vector3.new(0.4, 9, 0.4), Vector3.new(0, height + 4.5, 0), P.GatePost)
	block("Flag", Vector3.new(4.5, 2.6, 0.2), Vector3.new(2.45, height + 7.4, 0), P.EnemyRed)

	-- Big "ENEMY BASE" sign above the door, facing the runner (+Z = Back face).
	local sign = block("Sign", Vector3.new(16, 3, 0.4), Vector3.new(0, height + 3.4, front + 0.3), P.PillBlack)
	RunnerModels.SurfaceLabel(sign, Enum.NormalId.Back, "ENEMY BASE", 100)

	model.Parent = parent
	local frontZ = centre.Z + front + 0.5
	local y = centre.Y
	local targets = {
		Vector3.new(centre.X - 8, y + 4, frontZ),
		Vector3.new(centre.X + 8, y + 4, frontZ),
		Vector3.new(centre.X, y + 6, frontZ),
		Vector3.new(centre.X - width / 2 - 2, y + 9, frontZ - 3),
		Vector3.new(centre.X + width / 2 + 2, y + 9, frontZ - 3),
		Vector3.new(centre.X, y + 2.5, frontZ),
	}
	return model, targets, door
end

return RunnerModels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">RunnerVisuals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerVisuals (client)
	Draws one army-runner course for the local player only (ARCHITECTURE §5:
	per-player visuals are built on the client). The server already built the
	white track floor; this module adds everything ON the track:

	  * gate rows   - translucent blue / red / gold panels between dark posts,
	                  with huge white outlined labels ("+5", "x2", "-3", "÷2", "WEAPON +1").
	                  When the row before a gold weapon gate is crossed, that gate is
	                  relabelled with the gun you would get ("🔫 SMG"; at the top tier
	                  "🔫 MAX +$X", the cash it pays instead); rows further ahead keep
	                  "WEAPON +1" (the gun depends on the gates you take before them).
	                  The panel you run through vanishes at once (owner request)
	  * cash rows   - stacks of gold coins + green cash bricks; the stack you take
	                  vanishes at once
	  * enemy squads- red-uniform soldiers with rifles and a "N SOLDIERS" label
	  * barricades  - sandbag walls with an HP bar
	  * contest rows- "shoot to grow" gates [owner request], drawn UNLIKE the other
	                  gates: less see-through blue / red panels with dark stripes,
	                  a glowing gold Neon frame each, "🎯 +3" / "🎯 -4" numbers and a
	                  "🎯 SHOOT TO GROW" beam over the row. While the squad shoots
	                  them each side's number grows and the more-shot side widens,
	                  pushing the middle post (and the other side) aside
	  * value labels- a row's cash values, a red toll gate's cash, a squad's
	                  "N SOLDIERS" and a barricade's HP bar stay hidden until the
	                  previous row has been crossed (owner request: far-away labels
	                  cluttered the view); row 1's are visible from the start, and a
	                  squad / barricade also shows its label as soon as the guns reach
	                  it (Engage). They are plain outlined text (no dark pill behind
	                  them; a toll gate's cash floats above its panel), so they never
	                  cover what is further down the track
	  * the castle  - at the end of the track, with a 13-stud gateway; the BOSS
	                  (RunnerBoss) waits hidden behind its door and walks out of it
	  * your squad  - up to 40 green toy soldiers standing NEXT TO the avatar in
	                  rows of RunnerDefs.FORMATION_WIDTH (front row: 2 troops, the
	                  avatar, 2 troops; more rows behind), each holding the same gun.
	                  Near a track edge the WHOLE formation shifts sideways by whole
	                  columns (the avatar's own spot stays free), so troops never
	                  overlap; the avatar itself stays where the player steers.
	                  Slots and shift come from RunnerDefs.FormationSlot / FormationShift
	                  (the same definition RunnerSim uses for wide shooting)
	  * guns        - the avatar holds the server's "RunnerGun" Tool; we weld the
	                  part-built gun of the current weapon tier (RunnerGuns) to its
	                  Handle. The avatar and the front row fire at the gun's TRUE
	                  fireRate (up to FRONT_MAX_RATE = 12/s); the back rows share what
	                  is left of the bullet budget (BULLET_BUDGET of the pool alive),
	                  so the pistol, SMG, assault rifle and minigun clearly differ in
	                  rate, bullet style, colour and speed. Range: RunnerDefs.GUN_RANGE:
	                  a unit whose target is farther holds its fire, so every bullet
	                  flies to its target and hits it (owner request: more bullets hit)
	  * wide shooting [owner request] - with Engagement.across > 0 the troops in
	                  the outer `stance` formation columns on the other lane's side
	                  shoot that lane (RunnerSim's UnitsAcross rule); everyone else
	                  and the avatar shoot the lane the avatar is in
	  * effects     - pop text, gate flashes, hit flashes, falling enemies, confetti

	The OUTCOME of every fight comes from RunnerSim (RunnerController passes it
	in); this module only shows it: enemies fall / barricade HP drains while the
	squad closes the last GUN_RANGE studs (= RunnerDefs.ENGAGE_SECONDS), and the
	boss fight follows the BossOutcome exactly (RunnerSim.BossHpAt / AliveAt).
	RunnerController passes the SERVER's BossOutcome (RunnerFinish reply) so the
	fight on screen always matches what is paid.

	Public API:
		local visuals = RunnerVisuals.new(course, slot, character)
		visuals.fortDistance: number      -- distance (studs from start) of the castle's front
		visuals.stopDistance: number      -- where the avatar stops to fight the boss
		visuals:SetSquad(troops, weaponTier)   -- troops to draw (true count; drawn capped at 40) + gun
		visuals:Update(dt, root: BasePart?, moving: boolean)   -- call every frame
		visuals:Engage(rowIndex, engagement: Engagement)   -- shoot that squad / barricade / contest
			row (re-send when the lane, stance or prediction changes)
		visuals:RowCrossed(rowIndex, lane, outcome?, capacity, engagement: Engagement?)  -- play the row's result
		visuals:OpenCastle(maxHp) -> number   -- intro: the door sinks, then the boss
			appears and walks out; returns its length (RunnerDefs.BOSS_INTRO_SECONDS).
			Call it on arrival; the fight outcome can follow later. Calling again is a no-op.
		visuals:StartBossFight(outcome: BossOutcome, callbacks) -> number (seconds from now until onDone)
			opens the castle first if needed; the fight starts when the intro is
			over (right away if it already is), then RunnerDefs.BOSS_OUTRO_SECONDS
			of victory / defeat before onDone.
			callbacks = { onProgress(alive, hp), onResolved(victory), onDone() }
		visuals:BossFocus() -> Vector3?   -- boss chest (camera framing)
		visuals:Destroy()                 -- removes every instance it created, restores the avatar pose

		Fight = { enemies, kills, share, destroyed, steps?, amount? }   -- one lane at the end of
			the engagement. squads: kills of enemies; barricades: share = fraction of
			its HP taken off; contest: steps it grows by, amount = its number after them
			(share = steps / growMax)
		Engagement = { lane, stance, across, fights: { [lane]: Fight } }
			lane = the lane the avatar is in; stance 0..RunnerDefs.MAX_STANCE and
			across = units shooting the other lane (RunnerSim.UnitsAcross, 0 = none);
			fights = what EACH lane of the row looks like at the end of the engagement

	This module never talks to the server; RunnerController feeds it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local RunnerCourse = require(Shared.Runner.RunnerCourse)
local RunnerDefs = require(Shared.Runner.RunnerDefs)
local RunnerSim = require(Shared.Runner.RunnerSim)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local RunnerBoss = require(script.Parent.RunnerBoss)
local RunnerGuns = require(script.Parent.RunnerGuns)
local RunnerModels = require(script.Parent.RunnerModels)

type Course = RunnerCourse.Course
type Option = RunnerCourse.Option
type Row = RunnerCourse.Row
type RowOutcome = RunnerSim.RowOutcome
type BossOutcome = RunnerSim.BossOutcome
type Rig = RunnerModels.Rig
type Boss = RunnerBoss.Boss

local P = Config.Palette

-------------------------------------------------------------------------------
-- Tunables (all visual only)
-------------------------------------------------------------------------------
local MAX_TROOP_MODELS = 40 -- [REQUIREMENT ARCH §0.10] cap rendered troops
local MAX_ENEMY_MODELS = 12 -- per squad lane [PROPOSAL]
local FRONT_MAX_RATE = 12 -- [PROPOSAL] avatar + front row fire at the gun's true rate, up to this (shots/s)
local MIN_BACK_RATE = 0.3 -- [PROPOSAL] back-row troops never fire slower than this (shots/s)
local BULLET_BUDGET = math.floor(RunnerGuns.POOL_SIZE * 0.8) -- [PROPOSAL] bullets aimed to be alive (rest: boss shots)
local GATE_HEIGHT = 7
local POST_HEIGHT = 8.4
local FORT_DEPTH = 14
-- Shoot-to-grow ("contest") gates [PROPOSAL, visual only]
local CONTEST_TRANSPARENCY = 0.22 -- less see-through than normal gates (0.45)
local CONTEST_POST_HEIGHT = 10.4 -- taller posts that carry the "SHOOT TO GROW" beam
local CONTEST_BEAM_HEIGHT = 1.8
local CONTEST_FRAME = 0.45 -- thickness of the glowing frame bars
local CONTEST_STRIPES = 5 -- dark vertical stripes per panel
local CONTEST_SWING = 0.35 -- how far the middle moves at the most growth difference
local CONTEST_SHARE_MIN = 0.2 -- a side never gets narrower than 20% of the row
local CONTEST_SHARE_MAX = 0.8
local AIM_SPREAD = 3 -- tenths of a stud: bullets land this close to their target point

-- Boss timing is shared with the economy (RunnerDefs; fallback = same values).
local function defNumber(name: string, fallback: number): number
	local value = (RunnerDefs :: any)[name]
	return if type(value) == "number" and value >= 0 then value else fallback
end
local BOSS_INTRO_SECONDS = defNumber("BOSS_INTRO_SECONDS", 2.62) -- door opens + boss walks out
local BOSS_OUTRO_SECONDS = defNumber("BOSS_OUTRO_SECONDS", 2.8) -- victory / defeat before the summary
local BOSS_DOOR_TIME = math.min(0.7, BOSS_INTRO_SECONDS * 0.4) -- [PROPOSAL] door sinks (part of the intro)
local BOSS_WAIT_DEPTH = RunnerModels.FORT_GATE_DEPTH / 2 -- boss waits this deep in the gateway
local BOSS_STAND = 9 -- boss stops this many studs in front of the castle
local SQUAD_GAP = 30 -- the avatar stops this many studs in front of the castle
local DEATH_TIME = 0.45
local HIDDEN = CFrame.new(0, -500, 0)

local GUN_RANGE = RunnerDefs.GUN_RANGE
local FORMATION_WIDTH = math.max(1, math.floor(RunnerDefs.FORMATION_WIDTH))
local FORMATION_HALF = math.floor(FORMATION_WIDTH / 2)
local SPACING_X = RunnerDefs.FORMATION_SPACING_X
local SPACING_Z = RunnerDefs.FORMATION_SPACING_Z

local function toneColor(option: Option): Color3
	local tone = option.tone
	if tone == "negative" or tone == "enemy" then
		return P.GateNegative
	elseif tone == "weapon" then
		return P.GateWeapon
	elseif tone == "cash" then
		return P.MoneyGreen
	end
	if option.op == "sub" or option.op == "div" then
		return P.GateNegative
	elseif option.op == "weapon" or option.op == "damage" then
		return P.GateWeapon
	end
	return P.GatePositive
end

-- Number shown on a shoot-to-grow panel: "🎯 +5" (blue) / "🎯 -6" (red).
local function contestText(option: Option, value: number): string
	local n = math.max(0, math.floor(value + 0.5))
	return "🎯 " .. (if option.op == "sub" then "-" else "+") .. n
end

-------------------------------------------------------------------------------
-- Small UI helpers (billboards over world objects)
-------------------------------------------------------------------------------
type HpBar = { set: (fraction: number, duration: number?) -> (), gui: BillboardGui }

local function makeHpBar(adornee: BasePart, title: string, width: number, offsetY: number): HpBar
	local gui = Theme.Billboard({
		Name = "HpBar",
		Parent = adornee,
		Adornee = adornee,
		Size = UDim2.fromOffset(width, 54),
		StudsOffset = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = false,
		MaxDistance = 160,
	})
	Theme.Label({
		Text = title,
		MaxTextSize = 22,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = gui,
	})
	local back = Instance.new("Frame")
	back.BackgroundColor3 = P.PillBlack
	back.Position = UDim2.fromOffset(0, 28)
	back.Size = UDim2.new(1, 0, 0, 20)
	back.Parent = gui
	Theme.Corner(back, 0.5)
	Theme.Stroke(back, P.CardOutline, 2, true)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = P.ButtonRed
	fill.Position = UDim2.fromOffset(2, 2)
	fill.Size = UDim2.new(1, -4, 1, -4)
	fill.Parent = back
	Theme.Corner(fill, 0.5)
	return {
		gui = gui,
		set = function(fraction: number, duration: number?)
			local f = math.clamp(fraction, 0, 1)
			local goal = UDim2.new(f, -math.floor(4 * f + 0.5), 1, -4) -- offsets must be whole pixels
			if duration and duration > 0 then
				Theme.Tween(fill, { Size = goal }, duration, Enum.EasingStyle.Linear)
			else
				fill.Size = goal
			end
		end,
	}
end

-- Outlined text only (no background), so it never hides what is behind it.
local function makeTextBillboard(adornee: BasePart, text: string, color: Color3, offsetY: number): BillboardGui
	local gui = Theme.Billboard({
		Name = "Value",
		Parent = adornee,
		Adornee = adornee,
		Size = UDim2.fromOffset(150, 46),
		StudsOffset = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = false,
		MaxDistance = 220,
	})
	Theme.Label({
		Name = "Text",
		Text = text,
		TextColor3 = color,
		MaxTextSize = 34,
		StrokeThickness = 3,
		Size = UDim2.new(1, -8, 1, -4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = gui,
	})
	return gui
end

-- Invisible anchor part used to hang billboards in the world.
local function anchorPart(parent: Instance, position: Vector3): Part
	return RunnerModels.Part({
		Name = "Anchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position),
		Color = P.White,
		Transparency = 1,
		Parent = parent,
	})
end

-- An enemy soldier falls (from wherever it is now) and fades out.
local function killRig(rig: Rig, duration: number)
	local down = rig.pivot * CFrame.Angles(math.rad(85), 0, 0)
	for i, part in rig.parts do
		Theme.Tween(
			part,
			{ CFrame = down * rig.offsets[i], Transparency = 1 },
			duration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
	end
	task.delay(duration + 0.1, function()
		rig.model:Destroy()
	end)
end

local function crumble(model: Model, duration: number)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			local push = Vector3.new(math.random(-30, 30) / 10, -2.5, -math.random(10, 40) / 10)
			local spin = CFrame.Angles(math.random() * 2, math.random() * 2, math.random() * 2)
			Theme.Tween(
				item,
				{ CFrame = (item.CFrame + push) * spin, Transparency = 1 },
				duration,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end
	end
	task.delay(duration + 0.1, function()
		model:Destroy()
	end)
end

local function flyAway(model: Model, offset: Vector3, duration: number)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			Theme.Tween(item, { CFrame = item.CFrame + offset, Transparency = 1 }, duration)
		end
	end
	task.delay(duration + 0.1, function()
		model:Destroy()
	end)
end

-- Text of a gate panel without the toll cash ("-4  +$20" -> "-4"); the cash
-- part gets its own label that is revealed later.
local function gateText(option: Option): string
	local text = option.label
	if (option.cash or 0) > 0 then
		local stripped = text:gsub("%s*%+%$.*$", "")
		if stripped ~= "" then
			text = stripped
		end
	end
	if option.tone == "weapon" and option.op == "weapon" then
		text = "🔫 " .. text
	end
	return text
end

-- Soldiers shown as killed (of the `shown` models) for `kills` of `enemies`.
local function shownKills(fight: Fight?, shown: number): number
	if not fight or shown <= 0 or fight.enemies <= 0 or fight.kills <= 0 then
		return 0
	end
	if fight.kills >= fight.enemies then
		return shown
	end
	local k = math.clamp(math.floor(fight.kills / fight.enemies * shown + 0.5), 1, shown)
	if k >= shown then
		k = shown - 1 -- some survived: keep at least one standing
	end
	return k
end

-------------------------------------------------------------------------------
-- Types
-------------------------------------------------------------------------------
export type Fight = {
	enemies: number, -- squad: soldiers in that lane (0 otherwise)
	kills: number, -- squad: soldiers that fall by the end of the engagement
	share: number, -- barricade: fraction of its HP taken off (1 = destroyed); contest: steps / growMax
	destroyed: boolean,
	steps: number?, -- contest: growth steps that lane reaches by the end of the engagement
	amount: number?, -- contest: that gate's number after those steps
}

export type Engagement = {
	lane: number, -- lane the avatar is in now (the lane it will pass)
	stance: number, -- 0..RunnerDefs.MAX_STANCE (0 when across == 0)
	across: number, -- units that shoot the OTHER lane (RunnerSim.UnitsAcross)
	fights: { [number]: Fight }, -- per lane: what EACH lane looks like at the end of the engagement
}

export type BossCallbacks = {
	onProgress: (alive: number, hp: number) -> (),
	onResolved: (victory: boolean) -> (),
	onDone: () -> (),
}

type EnemyRig = { rig: Rig, fall: number, target: number }

type OptionVisual = {
	option: Option,
	centre: Vector3,
	panel: Part?,
	label: TextLabel?,
	model: Model?,
	enemies: { EnemyRig },
	targets: { Vector3 },
	hp: HpBar?,
	anchor: Part?,
	valueLabel: BillboardGui?, -- cash / "N SOLDIERS" / HP bar: hidden until the previous row is crossed
}

-- One side of a shoot-to-grow row (sides[1] = left, sides[2] = right).
type ContestSide = {
	lane: number,
	option: Option,
	ov: OptionVisual, -- its panel / label / centre / targets
	frame: { BasePart }, -- glowing frame bars: top, bottom, left, right
	shown: number, -- number on the panel now
	gone: boolean, -- passed: panel + frame removed
}

type ContestVisual = {
	sides: { ContestSide },
	minX: number, -- lateral extent of both lanes together
	maxX: number,
	share: number, -- left side's share of the width now (animated)
	goal: number, -- share it is moving to
	divider: BasePart, -- middle post (moves with the share)
	distance: number,
}

type RowVisual = {
	row: Row,
	options: { OptionVisual },
	revealed: boolean,
	crossed: boolean,
	contest: ContestVisual?,
}

-- What the units shoot at this frame.
type Aim = {
	own: { Vector3 }, -- the lane the avatar is in (or the boss)
	other: { Vector3 }, -- the other lane (wide shooting)
	side: number, -- +1: the other lane is to the right
	first: number, -- troops whose side x slot column >= first shoot `other`
	wide: boolean,
	boss: boolean,
}

type BossShot = { time: number, killIndex: number }

type BossFight = {
	outcome: BossOutcome,
	callbacks: BossCallbacks,
	clock: number, -- seconds since StartBossFight
	fightStart: number, -- clock value when the fight itself starts (t = 0)
	shots: { BossShot },
	nextShot: number,
	resolved: boolean,
	done: boolean,
}

export type Visuals = {
	fortDistance: number,
	stopDistance: number,
	SetSquad: (self: Visuals, troops: number, weaponTier: number) -> (),
	Update: (self: Visuals, dt: number, root: BasePart?, moving: boolean) -> (),
	Engage: (self: Visuals, rowIndex: number, engagement: Engagement) -> (),
	RowCrossed: (
		self: Visuals,
		rowIndex: number,
		lane: number,
		outcome: RowOutcome?,
		capacity: number,
		engagement: Engagement?
	) -> (),
	OpenCastle: (self: Visuals, maxHp: number) -> number,
	StartBossFight: (self: Visuals, outcome: BossOutcome, callbacks: BossCallbacks) -> number,
	BossFocus: (self: Visuals) -> Vector3?,
	Destroy: (self: Visuals) -> (),
}

local RunnerVisuals = {}

function RunnerVisuals.new(course: Course, slot: number, character: Model): Visuals
	local folder = Instance.new("Folder")
	folder.Name = "ArmyRunnerVisuals"

	local floorY = Layout.FLOOR_Y
	local centreX = Layout.RunnerPoint(slot, 0, 0).X
	local startZ = Layout.RunnerPoint(slot, 0, 0).Z
	local destroyed = false

	local function worldAt(distance: number, lateral: number, height: number?): Vector3
		return Layout.RunnerPoint(slot, distance, lateral) + Vector3.new(0, height or 0, 0)
	end

	---------------------------------------------------------------------------
	-- Rows
	---------------------------------------------------------------------------
	local rowVisuals: { RowVisual } = {}

	local function buildGateRow(row: Row, rowFolder: Folder): { OptionVisual }
		local list: { OptionVisual } = {}
		local edges: { number } = {}
		local function addEdge(x: number)
			for _, e in edges do
				if math.abs(e - x) < 0.6 then
					return
				end
			end
			table.insert(edges, x)
		end
		for lane, option in row.options do
			local width = math.max(2, option.width)
			local centre = worldAt(row.distance, option.x, GATE_HEIGHT / 2 + 0.2)
			local panel = RunnerModels.Part({
				Name = "GatePanel" .. lane,
				Size = Vector3.new(width - 0.5, GATE_HEIGHT, 0.3),
				CFrame = CFrame.new(centre),
				Color = toneColor(option),
				Transparency = 0.45,
				Parent = rowFolder,
			})
			panel.CastShadow = false
			-- The runner travels -Z, so the face it sees is the +Z face = Back.
			local label = RunnerModels.SurfaceLabel(panel, Enum.NormalId.Back, gateText(option), 160)
			addEdge(option.x - width / 2)
			addEdge(option.x + width / 2)
			-- A red "toll" gate also carries cash: a small stack behind it whose
			-- value label stays hidden until the previous row is crossed.
			local tollCash: Model? = nil
			local valueLabel: BillboardGui? = nil
			local cash = option.cash or 0
			if cash > 0 then
				local base = worldAt(row.distance + 2.5, option.x, 0)
				local stack = RunnerModels.CoinStack(rowFolder, base, 4)
				tollCash = stack
				-- The value floats ABOVE the panel (not in front of its "-4" text).
				local anchor = anchorPart(stack, worldAt(row.distance, option.x, GATE_HEIGHT + 2))
				local gui = makeTextBillboard(anchor, "+" .. Format.Money(cash), P.MoneyGreen, 0)
				gui.Enabled = false
				valueLabel = gui
			end
			table.insert(list, {
				option = option,
				centre = centre,
				panel = panel,
				label = label,
				model = tollCash,
				enemies = {},
				targets = {},
				hp = nil,
				anchor = nil,
				valueLabel = valueLabel,
			})
		end
		for _, x in edges do
			RunnerModels.Part({
				Name = "GatePost",
				Size = Vector3.new(0.7, POST_HEIGHT, 0.7),
				CFrame = CFrame.new(worldAt(row.distance, x, POST_HEIGHT / 2)),
				Color = P.GatePost,
				Parent = rowFolder,
			})
		end
		return list
	end

	local function buildCashRow(row: Row, rowFolder: Folder): { OptionVisual }
		local list: { OptionVisual } = {}
		local biggest = 0
		for _, option in row.options do
			biggest = math.max(biggest, option.cash or 0)
		end
		for _, option in row.options do
			local cash = option.cash or 0
			local coins = if biggest > 0 then math.ceil(cash / biggest * 7) else 1
			local base = worldAt(row.distance, option.x, 0)
			local model = RunnerModels.CoinStack(rowFolder, base, coins)
			local anchor = anchorPart(model, base + Vector3.new(0, 3.6, 0))
			local gui = makeTextBillboard(anchor, Format.Money(cash), P.PriceGold, 1.2)
			gui.Enabled = false -- revealed when the previous row is crossed
			table.insert(list, {
				option = option,
				centre = base,
				panel = nil,
				label = nil,
				model = model,
				enemies = {},
				targets = {},
				hp = nil,
				anchor = anchor,
				valueLabel = gui,
			})
		end
		return list
	end

	local function buildSquadRow(row: Row, rowFolder: Folder): { OptionVisual }
		local list: { OptionVisual } = {}
		for _, option in row.options do
			local count = math.max(0, math.floor(option.enemies or 0))
			local shown = math.min(count, MAX_ENEMY_MODELS)
			local width = math.max(4, option.width - 1)
			local perRow = math.max(1, math.min(shown, math.floor(width / 1.7)))
			local rigs: { EnemyRig } = {}
			local model = Instance.new("Model")
			model.Name = "EnemySquad"
			model.Parent = rowFolder
			for i = 1, shown do
				local col = (i - 1) % perRow
				local line = math.floor((i - 1) / perRow)
				local x = option.x + (col - (perRow - 1) / 2) * 1.7
				local pos = worldAt(row.distance - 1 - line * 1.6, x, 0)
				-- Enemies face the runner (+Z): rotate 180 degrees.
				local pivot = CFrame.new(pos) * CFrame.Angles(0, math.pi, 0)
				local rig = RunnerModels.Soldier("enemy", model, pivot)
				table.insert(rigs, { rig = rig, fall = 0, target = 0 })
			end
			local anchor = anchorPart(model, worldAt(row.distance, option.x, 4.5))
			local gui = makeTextBillboard(
				anchor,
				if option.label ~= "" then option.label else tostring(count),
				P.ButtonRed,
				0.8
			)
			gui.Enabled = false -- revealed when the previous row is crossed (like the cash values)
			table.insert(list, {
				option = option,
				centre = worldAt(row.distance, option.x, 0),
				panel = nil,
				label = nil,
				model = model,
				enemies = rigs,
				targets = {},
				hp = nil,
				anchor = anchor,
				valueLabel = gui,
			})
		end
		return list
	end

	local function buildBarricadeRow(row: Row, rowFolder: Folder): { OptionVisual }
		local list: { OptionVisual } = {}
		for _, option in row.options do
			local centre = worldAt(row.distance, option.x, 0)
			local width = math.max(4, option.width - 0.4)
			local model = RunnerModels.Sandbags(rowFolder, centre, width)
			local anchor = anchorPart(model, centre + Vector3.new(0, 4.4, 0))
			local hp = makeHpBar(anchor, "HP " .. Format.Short(math.floor((option.hp or 0) + 0.5)), 150, 1.4)
			hp.set(1)
			hp.gui.Enabled = false -- revealed when the previous row is crossed (like the cash values)
			local targets = {
				centre + Vector3.new(-width / 4, 1.5, 0.7),
				centre + Vector3.new(0, 2.2, 0.7),
				centre + Vector3.new(width / 4, 1.2, 0.7),
			}
			table.insert(list, {
				option = option,
				centre = centre,
				panel = nil,
				label = nil,
				model = model,
				enemies = {},
				targets = targets,
				hp = hp,
				anchor = anchor,
				valueLabel = hp.gui,
			})
		end
		return list
	end

	-- Lays a shoot-to-grow row out for its current share: both panels, their
	-- frames, shooting targets and the middle post (CFrame / Size only).
	local function layoutContest(cv: ContestVisual)
		local split = cv.minX + (cv.maxX - cv.minX) * cv.share
		for i, side in cv.sides do
			local x0 = if i == 1 then cv.minX else split
			local x1 = if i == 1 then split else cv.maxX
			-- Room for the frame bars and half a post on each side.
			local width = math.max(1, x1 - x0 - 2 * CONTEST_FRAME - 0.9)
			local centre = worldAt(cv.distance, (x0 + x1) / 2, GATE_HEIGHT / 2 + 0.2)
			local ov = side.ov
			ov.centre = centre
			local panel = ov.panel
			if side.gone or not panel then
				continue
			end
			panel.Size = Vector3.new(width, GATE_HEIGHT, 0.5)
			panel.CFrame = CFrame.new(centre)
			-- Points on the face the runner sees (+Z).
			ov.targets = {
				centre + Vector3.new(-width * 0.3, -0.9, 0.35),
				centre + Vector3.new(0, 0.7, 0.35),
				centre + Vector3.new(width * 0.3, -0.2, 0.35),
			}
			local f = CONTEST_FRAME
			local top, bottom, left, right = side.frame[1], side.frame[2], side.frame[3], side.frame[4]
			if top and bottom and left and right then
				top.Size = Vector3.new(width + 2 * f, f, 0.65)
				top.CFrame = CFrame.new(centre + Vector3.new(0, GATE_HEIGHT / 2, 0))
				bottom.Size = top.Size
				bottom.CFrame = CFrame.new(centre - Vector3.new(0, GATE_HEIGHT / 2, 0))
				left.Size = Vector3.new(f, GATE_HEIGHT, 0.65)
				left.CFrame = CFrame.new(centre - Vector3.new(width / 2 + f / 2, 0, 0))
				right.Size = left.Size
				right.CFrame = CFrame.new(centre + Vector3.new(width / 2 + f / 2, 0, 0))
			end
		end
		cv.divider.CFrame = CFrame.new(worldAt(cv.distance, split, (CONTEST_POST_HEIGHT - CONTEST_BEAM_HEIGHT) / 2))
	end

	-- Shoot-to-grow gates (row kind "contest"): look unlike every other gate.
	local function buildContestRow(row: Row, rowFolder: Folder): ({ OptionVisual }, ContestVisual?)
		if #row.options ~= 2 then
			return buildGateRow(row, rowFolder), nil
		end
		local a, b = row.options[1], row.options[2]
		local leftOpt, rightOpt = a, b
		if b.x < a.x then
			leftOpt, rightOpt = b, a
		end
		local minX = leftOpt.x - leftOpt.width / 2
		local maxX = rightOpt.x + rightOpt.width / 2
		local list: { OptionVisual } = {}
		local sides: { ContestSide } = {}
		for _, option in { leftOpt, rightOpt } do
			local red = option.tone == "growNegative" or option.op == "sub"
			local color = if red then P.GateNegative else P.GatePositive
			local centre = worldAt(row.distance, option.x, GATE_HEIGHT / 2 + 0.2)
			local panel = RunnerModels.Part({
				Name = "ContestPanel" .. option.lane,
				Size = Vector3.new(math.max(2, option.width - 1.2), GATE_HEIGHT, 0.5),
				CFrame = CFrame.new(centre),
				Color = color,
				Transparency = CONTEST_TRANSPARENCY,
				Parent = rowFolder,
			})
			panel.CastShadow = false
			local value = option.amount or 0
			local label = RunnerModels.SurfaceLabel(panel, Enum.NormalId.Back, contestText(option, value), 160)
			label.ZIndex = 3
			-- Dark vertical stripes behind the number (same SurfaceGui, lower ZIndex).
			local gui = label.Parent
			if gui then
				for k = 0, CONTEST_STRIPES - 1 do
					local stripe = Instance.new("Frame")
					stripe.Name = "Stripe"
					stripe.BorderSizePixel = 0
					stripe.BackgroundColor3 = Theme.Darken(color, 0.45)
					stripe.BackgroundTransparency = 0.3
					stripe.Size = UDim2.fromScale(0.5 / CONTEST_STRIPES, 1)
					stripe.Position = UDim2.fromScale((k + 0.25) / CONTEST_STRIPES, 0)
					stripe.ZIndex = 1
					stripe.Parent = gui
				end
			end
			local frame: { BasePart } = {}
			for _, name in { "FrameTop", "FrameBottom", "FrameLeft", "FrameRight" } do
				local bar = RunnerModels.Part({
					Name = name,
					Size = Vector3.one,
					CFrame = CFrame.new(centre),
					Color = P.Coin,
					Material = Enum.Material.Neon,
					Parent = rowFolder,
				})
				bar.CastShadow = false
				table.insert(frame, bar)
			end
			local ov: OptionVisual = {
				option = option,
				centre = centre,
				panel = panel,
				label = label,
				model = nil,
				enemies = {},
				targets = {},
				hp = nil,
				anchor = nil,
				valueLabel = nil, -- the number is on the panel (like a gate)
			}
			list[option.lane] = ov
			table.insert(sides, { lane = option.lane, option = option, ov = ov, frame = frame, shown = value, gone = false })
		end
		-- Tall outer posts carrying the sign beam, and the middle post that moves.
		for _, x in { minX - 0.35, maxX + 0.35 } do
			RunnerModels.Part({
				Name = "ContestPost",
				Size = Vector3.new(0.8, CONTEST_POST_HEIGHT, 0.8),
				CFrame = CFrame.new(worldAt(row.distance, x, CONTEST_POST_HEIGHT / 2)),
				Color = P.GatePost,
				Parent = rowFolder,
			})
		end
		local divider = RunnerModels.Part({
			Name = "ContestDivider",
			Size = Vector3.new(0.8, CONTEST_POST_HEIGHT - CONTEST_BEAM_HEIGHT, 0.8),
			CFrame = CFrame.new(worldAt(row.distance, (minX + maxX) / 2, (CONTEST_POST_HEIGHT - CONTEST_BEAM_HEIGHT) / 2)),
			Color = P.GatePost,
			Parent = rowFolder,
		})
		local beam = RunnerModels.Part({
			Name = "ContestSign",
			Size = Vector3.new(maxX - minX + 1.5, CONTEST_BEAM_HEIGHT, 0.6),
			CFrame = CFrame.new(
				worldAt(row.distance, (minX + maxX) / 2, CONTEST_POST_HEIGHT - CONTEST_BEAM_HEIGHT / 2)
			),
			Color = P.PillBlack,
			Parent = rowFolder,
		})
		local sign = RunnerModels.SurfaceLabel(beam, Enum.NormalId.Back, "🎯 SHOOT TO GROW", 80)
		sign.TextColor3 = P.Coin
		local trim = RunnerModels.Part({
			Name = "ContestSignTrim",
			Size = Vector3.new(maxX - minX + 1.7, 0.25, 0.7),
			CFrame = CFrame.new(worldAt(row.distance, (minX + maxX) / 2, CONTEST_POST_HEIGHT - CONTEST_BEAM_HEIGHT)),
			Color = P.Coin,
			Material = Enum.Material.Neon,
			Parent = rowFolder,
		})
		trim.CastShadow = false
		local cv: ContestVisual = {
			sides = sides,
			minX = minX,
			maxX = maxX,
			share = 0.5,
			goal = 0.5,
			divider = divider,
			distance = row.distance,
		}
		layoutContest(cv)
		return list, cv
	end

	local contests: { ContestVisual } = {}
	for index, row in course.rows do
		local rowFolder = Instance.new("Folder")
		rowFolder.Name = ("Row%02d_%s"):format(index, row.kind)
		rowFolder.Parent = folder
		local options: { OptionVisual }
		local contest: ContestVisual? = nil
		if row.kind == "cash" then
			options = buildCashRow(row, rowFolder)
		elseif row.kind == "squad" then
			options = buildSquadRow(row, rowFolder)
		elseif row.kind == "barricade" then
			options = buildBarricadeRow(row, rowFolder)
		elseif row.kind == "contest" then
			options, contest = buildContestRow(row, rowFolder)
		else
			options = buildGateRow(row, rowFolder)
		end
		if contest then
			table.insert(contests, contest)
		end
		rowVisuals[index] = { row = row, options = options, revealed = false, crossed = false, contest = contest }
	end

	-- Cash a weapon gate pays at the top tier ("Weapon already maxed: bonus
	-- cash" in RunnerSim: the top weapon's value x the course's value scale).
	local maxWeaponCash = 0
	do
		local ok, scale = pcall(RunnerCourse.ValueScale, course.area, course.level)
		local top = RunnerDefs.WEAPONS[RunnerDefs.MAX_WEAPON_TIER]
		if ok and type(scale) == "number" and top then
			maxWeaponCash = Format.RoundWhole(top.value * scale)
		end
	end

	-- What a gold weapon gate gives when crossed with weapon tier `tierNow`.
	local function weaponGateText(option: Option, tierNow: number): string
		local maxTier = RunnerDefs.MAX_WEAPON_TIER
		if tierNow >= maxTier then
			return "🔫 MAX +" .. Format.Money(maxWeaponCash)
		end
		local step = math.max(1, math.floor(option.amount or 1))
		local def = RunnerDefs.WEAPONS[math.min(maxTier, tierNow + step)]
		return "🔫 " .. (if def then def.short else option.label)
	end

	-- Show a row's value labels (owner request: only once the row before it is
	-- crossed) and name the gun its weapon gates give with the weapon tier the
	-- squad has now (`tierNow`).
	local function reveal(index: number, tierNow: number)
		local rowVisual = rowVisuals[index]
		if not rowVisual or rowVisual.revealed then
			return
		end
		rowVisual.revealed = true
		for _, ov in rowVisual.options do
			local label = ov.label
			if label and ov.option.op == "weapon" then
				label.Text = weaponGateText(ov.option, tierNow)
				Theme.Pop(label)
			end
			local gui = ov.valueLabel
			if gui and gui.Parent then
				gui.Enabled = true
				local holder = gui:FindFirstChildWhichIsA("GuiObject")
				if holder then
					Theme.Pop(holder)
				end
			end
		end
	end
	reveal(1, 1) -- every run starts with the pistol (tier 1)

	---------------------------------------------------------------------------
	-- The castle. It stands on the server's finish plaza (which starts at the
	-- end of the track), never closer than the course's boss distance.
	---------------------------------------------------------------------------
	local trackEnd = Layout.RUNNER_TRACK_LENGTH
	local fortDistance = math.clamp(course.boss.distance, trackEnd + 6, trackEnd + 30)
	local fortCentre = worldAt(fortDistance + FORT_DEPTH / 2, 0, 0)
	local fortModel, _fortTargets, fortDoor = RunnerModels.Fort(folder, fortCentre)
	local stopDistance = math.max(course.boss.distance + 2, fortDistance - SQUAD_GAP)

	---------------------------------------------------------------------------
	-- Your squad (pooled toy soldiers in formation)
	---------------------------------------------------------------------------
	local squadFolder = Instance.new("Folder")
	squadFolder.Name = "Squad"
	squadFolder.Parent = folder
	local rigs: { Rig } = {}
	local positions: { Vector3 } = {}
	local active: { boolean } = {}
	local dying: { number? } = {} -- seconds since the troop died (death animation)
	for i = 1, MAX_TROOP_MODELS do
		rigs[i] = RunnerModels.Soldier("troop", squadFolder, HIDDEN, 1)
		positions[i] = HIDDEN.Position
		active[i] = false
		dying[i] = nil
	end

	local troops = 0 -- soldiers to draw next to the avatar (the run's troops - 1)
	local tier = 1
	local bobClock = 0
	local lastRoot: BasePart? = nil

	---------------------------------------------------------------------------
	-- Guns and bullets
	---------------------------------------------------------------------------
	local pool = RunnerGuns.newPool(folder)
	local avatarGun: Model? = nil
	local avatarGunTier = 0
	local avatarGunHandle: BasePart? = nil
	local fireClocks: { number } = {}
	for i = 0, MAX_TROOP_MODELS do
		fireClocks[i + 1] = math.random() -- random phase so units do not fire in sync
	end
	local shotCounter = 0

	local function currentHandle(): BasePart?
		local tool = character:FindFirstChild("RunnerGun")
		local handle = tool and tool:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			return handle
		end
		return nil
	end

	local function refreshAvatarGun()
		local handle = currentHandle()
		if not handle then
			return
		end
		local gun = avatarGun
		if gun and gun.Parent == handle and avatarGunTier == tier then
			return
		end
		if gun then
			gun:Destroy()
		end
		avatarGun = RunnerGuns.AttachToHandle(handle, tier)
		avatarGunTier = tier
		avatarGunHandle = handle
	end

	local function avatarMuzzle(root: BasePart): Vector3
		local handle = avatarGunHandle
		if handle and handle.Parent and avatarGun and avatarGun.Parent == handle then
			return RunnerGuns.HandleMuzzle(handle, tier)
		end
		return (root.CFrame * CFrame.new(1, 0.4, -1.8)).Position
	end

	---------------------------------------------------------------------------
	-- Engagements (rows being shot at) and the boss fight
	---------------------------------------------------------------------------
	local engaged: { [number]: Engagement } = {}
	local boss: Boss? = nil
	local fight: BossFight? = nil
	local castleOpen = false
	local castleClock = 0 -- seconds since OpenCastle (the intro is over at BOSS_INTRO_SECONDS)
	local knockMotor: Motor6D? = nil
	local knockOriginal: CFrame? = nil
	local knockT = 0
	local knockTarget: CFrame? = nil

	local function aliveTroops(): number
		-- Units drawn next to the avatar (the avatar itself is unit 1 in the boss fight).
		local f = fight
		if f and f.clock >= f.fightStart then
			local t = f.clock - f.fightStart
			return math.max(0, RunnerSim.AliveAt(f.outcome, t) - 1)
		end
		return troops
	end

	-- Avatar knocked down by the boss: VISUAL ONLY. The body is rotated on the
	-- client through the root joint's C0 (never Humanoid.Health, no physics).
	local function knockDownAvatar()
		if knockMotor then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		for _, item in character:GetDescendants() do
			if item:IsA("Motor6D") and item.Part0 == root then
				knockMotor = item
				knockOriginal = item.C0
				local drop = math.max(0, root.Position.Y - floorY - 0.8)
				knockTarget = CFrame.new(0, -drop, 0) * CFrame.Angles(math.rad(88), 0, 0) * item.C0
				knockT = 0
				break
			end
		end
	end

	local function restoreAvatar()
		local motor = knockMotor
		local original = knockOriginal
		knockMotor = nil
		knockOriginal = nil
		knockTarget = nil
		if motor and original and motor.Parent then
			motor.C0 = original
		end
	end

	---------------------------------------------------------------------------
	-- Methods
	---------------------------------------------------------------------------
	local self = {} :: Visuals
	self.fortDistance = fortDistance
	self.stopDistance = stopDistance

	function self.SetSquad(_self: Visuals, newTroops: number, newTier: number)
		-- `newTroops` is the run's troop count INCLUDING the avatar (RunnerSim
		-- counts the avatar as 1 of the troops), so we draw troops - 1 soldiers.
		troops = math.max(0, math.floor(newTroops) - 1)
		local clean = math.clamp(math.floor(newTier), 1, RunnerDefs.MAX_WEAPON_TIER)
		if clean ~= tier then
			tier = clean
			for _, rig in rigs do
				RunnerModels.SetRigGun(rig, tier)
			end
		end
	end

	-- Points to shoot at in one lane of a row: standing soldiers (all of them
	-- once none stands), a barricade's / contest panel's target points.
	local function laneTargets(rowVisual: RowVisual, lane: number): { Vector3 }
		local ov = rowVisual.options[lane]
		if not ov then
			return {}
		end
		if #ov.enemies > 0 then
			local list: { Vector3 } = {}
			for _, enemy in ov.enemies do
				if enemy.target < 0.5 then
					table.insert(list, enemy.rig.pivot.Position + Vector3.new(0, 1.6, 0))
				end
			end
			if #list == 0 then
				for _, enemy in ov.enemies do
					table.insert(list, enemy.rig.pivot.Position + Vector3.new(0, 0.6, 0))
				end
			end
			return list
		end
		return ov.targets
	end

	-- What to shoot right now: the boss, or the nearest engaged row (its two
	-- lanes when the squad shoots wide, see Engagement).
	local function currentAim(): Aim?
		local b = boss
		local f = fight
		if b and f and f.clock >= f.fightStart and not f.resolved then
			return { own = b:AimPoints(), other = {}, side = 1, first = math.huge, wide = false, boss = true }
		end
		local best: number? = nil
		for index in engaged do
			if best == nil or index < best then
				best = index
			end
		end
		if best == nil then
			return nil
		end
		local e = engaged[best]
		local rowVisual = rowVisuals[best]
		if not rowVisual or not rowVisual.options[e.lane] then
			return nil
		end
		local own = laneTargets(rowVisual, e.lane)
		local aim: Aim = { own = own, other = {}, side = 1, first = math.huge, wide = false, boss = false }
		if e.across > 0 and e.stance > 0 and #rowVisual.options == 2 then
			-- RunnerSim's UnitsAcross rule: the outer `stance` columns on the other side.
			local otherLane = if e.lane == 1 then 2 else 1
			local ownOption = rowVisual.options[e.lane].option
			local otherOption = rowVisual.options[otherLane].option
			aim.side = if otherOption.x >= ownOption.x then 1 else -1
			aim.first = FORMATION_HALF - e.stance + 1
			aim.other = laneTargets(rowVisual, otherLane)
			aim.wide = #aim.other > 0
		end
		if #own == 0 and not aim.wide then
			return nil
		end
		return aim
	end

	local function shoot(dt: number, root: BasePart, shown: number)
		local aim = currentAim()
		if not aim then
			return
		end
		local weapon = RunnerGuns.Weapon(tier)
		-- The avatar (unit 0) and the front-row troops (units 1 .. WIDTH-1) fire
		-- at the gun's true rate. Bullets alive ~ shots/s x flight time (at most
		-- GUN_RANGE / bulletSpeed), so the back rows share what the budget has left.
		local trueRate = math.clamp(weapon.fireRate, 0.1, FRONT_MAX_RATE)
		local flight = GUN_RANGE / math.max(10, weapon.bulletSpeed)
		local shotsBudget = BULLET_BUDGET / math.max(0.05, flight)
		local front = math.min(shown + 1, FORMATION_WIDTH)
		local back = shown + 1 - front
		local backRate = trueRate
		if back > 0 then
			backRate = math.clamp((shotsBudget - front * trueRate) / back, math.min(MIN_BACK_RATE, trueRate), trueRate)
		end
		local avatarDown = knockMotor ~= nil
		for unit = 0, shown do
			local index = unit + 1
			local rate = if unit < FORMATION_WIDTH then trueRate else backRate
			local c = fireClocks[index] + dt * rate
			if c < 1 then
				fireClocks[index] = c
				continue
			end
			fireClocks[index] = math.min(c - 1, 0.99)
			if unit == 0 and avatarDown then
				continue
			end
			-- Wide shooting: troops in the outer columns over the other lane shoot it.
			local targets = aim.own
			if aim.wide and unit >= 1 then
				local column = RunnerDefs.FormationSlot(unit)
				if aim.side * column >= aim.first then
					targets = aim.other
				end
			end
			if #targets == 0 then
				continue
			end
			local from: Vector3
			if unit == 0 then
				from = avatarMuzzle(root)
			else
				from = RunnerModels.RigMuzzle(rigs[unit], CFrame.new(positions[unit]))
			end
			shotCounter += 1
			local to = targets[(shotCounter % #targets) + 1]
				+ Vector3.new(
					math.random(-AIM_SPREAD, AIM_SPREAD) / 10,
					math.random(-AIM_SPREAD, AIM_SPREAD) / 10,
					0
				)
			if (to - from).Magnitude > GUN_RANGE then
				continue -- out of range: hold fire (no bullet that fades out short of its target)
			end
			if unit == 0 then
				pool:Flash(from, 0.9, P.CoinShine, 0.06) -- muzzle flash: shows the gun's rate
			end
			if pool:Fire(from, to, tier, true) and aim.boss then
				local b = boss
				if b then
					b:Hit()
				end
			end
		end
	end

	-- Enemies of engaged squads fall over while the squad closes in (in both
	-- lanes when it shoots wide), barricade HP bars drain and contest gates
	-- grow. Progress = share of the last GUN_RANGE studs run.
	local function updateEngagements(dt: number, distance: number, parts: { BasePart }, cframes: { CFrame })
		for index, e in engaged do
			local rowVisual = rowVisuals[index]
			if not rowVisual then
				continue
			end
			local row = rowVisual.row
			local progress = math.clamp((distance - (row.distance - GUN_RANGE)) / GUN_RANGE, 0, 1)
			local fights = e.fights
			for lane, ov in rowVisual.options do
				local laneFight = fights[lane]
				if #ov.enemies > 0 then
					local down = math.floor(shownKills(laneFight, #ov.enemies) * progress + 1e-6)
					for i, enemy in ov.enemies do
						enemy.target = if i <= down then 1 else 0
						if math.abs(enemy.fall - enemy.target) > 0.001 then
							local speed = if enemy.target > enemy.fall then 5 else 3
							local step = math.clamp(enemy.target - enemy.fall, -speed * dt, speed * dt)
							enemy.fall += step
							RunnerModels.RigCFrames(
								enemy.rig,
								enemy.rig.pivot * CFrame.Angles(math.rad(85) * enemy.fall, 0, 0),
								parts,
								cframes
							)
						end
					end
				end
				local hp = ov.hp
				if hp then
					local share = if laneFight then laneFight.share else 0
					hp.set(1 - math.clamp(share, 0, 1) * progress)
				end
			end
			-- Shoot-to-grow: each side's number grows with its share of the
			-- engagement; the more-shot side takes more of the width.
			local cv = rowVisual.contest
			if cv then
				local now: { number } = {}
				for i, side in cv.sides do
					local f = fights[side.lane]
					local steps = if f and f.steps then math.floor(f.steps * progress + 1e-6) else 0
					now[i] = steps
					local value = (side.option.amount or 0) + steps * (side.option.growStep or 0)
					local label = side.ov.label
					if value ~= side.shown and label and not side.gone then
						side.shown = value
						label.Text = contestText(side.option, value)
						Theme.Pop(label)
					end
				end
				local maxSteps = math.max(1, cv.sides[1].option.growMax or RunnerDefs.CONTEST_MAX_STEPS)
				cv.goal = math.clamp(
					0.5 + CONTEST_SWING * ((now[1] or 0) - (now[2] or 0)) / maxSteps,
					CONTEST_SHARE_MIN,
					CONTEST_SHARE_MAX
				)
			end
		end
	end

	-- Boss fight timeline (see StartBossFight).
	local function updateBoss(dt: number, root: BasePart?)
		local f = fight
		local b = boss
		if not b then
			return
		end
		castleClock += dt
		if not f then
			b:Update(dt) -- intro: walking out, waiting for the fight's outcome
			return
		end
		f.clock += dt
		local outcome = f.outcome
		local t = f.clock - f.fightStart
		if t >= 0 then
			local tc = math.min(t, outcome.duration)
			b:SetHp(RunnerSim.BossHpAt(outcome, tc))
			if not f.resolved then
				f.callbacks.onProgress(RunnerSim.AliveAt(outcome, tc), RunnerSim.BossHpAt(outcome, tc))
			end
			-- Boss shots: one per kill, timed to land when the unit dies.
			while f.nextShot <= #f.shots and t >= f.shots[f.nextShot].time do
				local shot = f.shots[f.nextShot]
				f.nextShot += 1
				local muzzle = b:Attack()
				local unitsBefore = outcome.units - (shot.killIndex - 1)
				local troopIndex = unitsBefore - 1 -- 0 = the avatar
				local target: Vector3
				if troopIndex <= 0 or not root then
					target = if root then root.Position else b:Chest()
				elseif troopIndex <= MAX_TROOP_MODELS then
					target = positions[troopIndex] + Vector3.new(0, 1.4, 0)
				else
					-- A troop beyond the drawn 40: aim at the back of the formation.
					target = positions[math.min(MAX_TROOP_MODELS, math.max(1, aliveTroops()))] + Vector3.new(0, 1.4, 2)
				end
				pool:Fire(muzzle, target, RunnerDefs.MAX_WEAPON_TIER, true)
				pool:Flash(muzzle, 3, P.EnemyRed, 0.2)
			end
			if t >= outcome.duration and not f.resolved then
				f.resolved = true
				local victory = outcome.victory
				if victory then
					b:Die()
					local chest = b:Chest()
					for i = 0, 5 do
						task.delay(i * 0.18, function()
							if not destroyed then
								pool:Flash(
									chest + Vector3.new(math.random(-30, 30) / 10, math.random(-30, 30) / 10, 0),
									6 + i,
									if i % 2 == 0 then P.CardOrange else P.Coin,
									0.4
								)
							end
						end)
					end
					-- Confetti + coins burst.
					local colors = { P.Coin, P.MoneyGreen, P.CardPink, P.CardBlue, P.CardOrange, P.White }
					for i = 1, 36 do
						local piece = RunnerModels.Part({
							Name = "Confetti",
							Size = Vector3.new(0.5, 0.08, 0.35),
							CFrame = CFrame.new(chest + Vector3.new(0, 3, 0)),
							Color = colors[(i % #colors) + 1],
							Parent = folder,
						})
						local goal = chest
							+ Vector3.new(
								math.random(-140, 140) / 10,
								math.random(-40, 60) / 10,
								math.random(-60, 160) / 10
							)
						Theme.Tween(piece, {
							CFrame = CFrame.new(goal) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
							Transparency = 1,
						}, 1.6 + math.random() * 0.6)
						task.delay(2.4, function()
							piece:Destroy()
						end)
					end
					for i = 1, 12 do
						local coin = RunnerModels.Part({
							Name = "CoinBurst",
							Shape = Enum.PartType.Cylinder,
							Size = Vector3.new(0.3, 1.6, 1.6),
							CFrame = CFrame.new(chest) * CFrame.Angles(0, 0, math.rad(90)),
							Color = P.Coin,
							Parent = folder,
						})
						local goal = (if root then root.Position else chest)
							+ Vector3.new(math.random(-60, 60) / 10, 4 + math.random() * 3, math.random(-20, 20) / 10)
						task.delay(i * 0.05, function()
							if coin.Parent then
								Theme.Tween(coin, { CFrame = CFrame.new(goal), Transparency = 0.2 }, 0.7)
							end
						end)
						task.delay(1.4, function()
							if coin.Parent then
								Theme.Tween(coin, { Transparency = 1 }, 0.3)
							end
						end)
						task.delay(1.8, function()
							coin:Destroy()
						end)
					end
					Theme.FloatText(chest + Vector3.new(0, 6, 4), "BOSS DEFEATED!", P.Coin)
				else
					knockDownAvatar()
					b:Roar()
				end
				f.callbacks.onResolved(victory)
			end
		end
		if f.resolved and not f.done and t >= outcome.duration + BOSS_OUTRO_SECONDS then
			f.done = true
			f.callbacks.onDone()
		end
		b:Update(dt)
	end

	function self.Update(_self: Visuals, dt: number, root: BasePart?, moving: boolean)
		if destroyed then
			return
		end
		bobClock += dt
		local parts: { BasePart } = {}
		local cframes: { CFrame } = {}
		local shown = math.min(aliveTroops(), MAX_TROOP_MODELS)
		local alpha = 1 - math.exp(-dt * 10)
		if root then
			lastRoot = root
			refreshAvatarGun()
			local rootPosition = root.CFrame.Position
			local base = Vector3.new(rootPosition.X, floorY, rootPosition.Z)
			-- Near a track edge the whole formation moves over by whole columns
			-- (the same shift for every troop), so no two troops share a spot and
			-- the avatar's own spot in the front row stays free.
			local shift = RunnerDefs.FormationShift(rootPosition.X - centreX)
			for i = 1, MAX_TROOP_MODELS do
				local rig = rigs[i]
				if i <= shown then
					if not active[i] or dying[i] then
						if not active[i] then
							positions[i] = base -- new troops pop out of the avatar
						end
						active[i] = true
						dying[i] = nil
					end
					local col, line = RunnerDefs.FormationSlot(i)
					col += shift
					if line == 0 and col == 0 then
						col = shift -- the avatar stands here: take the slot it left free
					end
					local target = Vector3.new(base.X + col * SPACING_X, floorY, base.Z + line * SPACING_Z)
					positions[i] = positions[i]:Lerp(target, alpha)
					local bob = if moving then math.abs(math.sin(bobClock * 13 + i * 0.7)) * 0.35 else 0
					RunnerModels.RigCFrames(rig, CFrame.new(positions[i] + Vector3.new(0, bob, 0)), parts, cframes)
				elseif active[i] then
					-- Died: fall backwards and sink, then hide.
					local d = (dying[i] or 0) + dt
					if d >= DEATH_TIME then
						active[i] = false
						dying[i] = nil
						RunnerModels.RigCFrames(rig, HIDDEN, parts, cframes)
					else
						dying[i] = d
						local a = d / DEATH_TIME
						local pivot = CFrame.new(positions[i] - Vector3.new(0, a * 1.2, 0))
							* CFrame.Angles(math.rad(85) * math.min(1, a * 1.6), 0, 0)
						RunnerModels.RigCFrames(rig, pivot, parts, cframes)
					end
				end
			end
			local distance = startZ - rootPosition.Z
			updateEngagements(dt, distance, parts, cframes)
			shoot(dt, root, shown)
		end

		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
		-- Shoot-to-grow rows slide towards their goal width (only while it changes).
		local slide = 1 - math.exp(-dt * 6)
		for _, cv in contests do
			if math.abs(cv.share - cv.goal) > 0.001 then
				cv.share += (cv.goal - cv.share) * slide
				if math.abs(cv.share - cv.goal) <= 0.001 then
					cv.share = cv.goal
				end
				layoutContest(cv)
			end
		end
		pool:Update(dt)
		updateBoss(dt, root)

		-- Avatar knock-down pose (defeat).
		local motor = knockMotor
		local original = knockOriginal
		local goal = knockTarget
		if motor and original and goal and knockT < 1 then
			knockT = math.min(1, knockT + dt / 0.5)
			local eased = 1 - (1 - knockT) * (1 - knockT)
			motor.C0 = original:Lerp(goal, eased)
		end
	end

	function self.Engage(_self: Visuals, rowIndex: number, engagement: Engagement)
		local rowVisual = rowVisuals[rowIndex]
		if
			not rowVisual
			or rowVisual.crossed
			or type(engagement) ~= "table"
			or not rowVisual.options[engagement.lane]
		then
			return
		end
		engaged[rowIndex] = {
			lane = engagement.lane,
			stance = math.max(0, math.floor(tonumber(engagement.stance) or 0)),
			across = math.max(0, math.floor(tonumber(engagement.across) or 0)),
			fights = if type(engagement.fights) == "table" then engagement.fights else {},
		}
		-- Shooting starts up to half a row before the previous row is crossed:
		-- show the "N SOLDIERS" / HP label now, before anything falls or drains.
		reveal(rowIndex, tier)
	end

	function self.RowCrossed(
		_self: Visuals,
		rowIndex: number,
		lane: number,
		outcome: RowOutcome?,
		capacityNow: number,
		rowEngagement: Engagement?
	)
		local rowVisual = rowVisuals[rowIndex]
		if not rowVisual or destroyed then
			return
		end
		rowVisual.crossed = true
		engaged[rowIndex] = nil
		-- The next row's value labels appear now; its weapon gates name the gun
		-- for the tier we have after THIS row (SetSquad updates `tier` later).
		reveal(rowIndex + 1, if outcome then outcome.weaponTier else tier)
		local optionVisual = rowVisual.options[lane]
		if not optionVisual then
			return
		end
		local kind = rowVisual.row.kind
		local fights: { [number]: Fight } = if rowEngagement and type(rowEngagement.fights) == "table"
			then rowEngagement.fights
			else {}
		local popAt = optionVisual.centre + Vector3.new(0, 7, -2)
		local troopDelta = if outcome then outcome.troopsAfter - outcome.troopsBefore else 0
		local cashDelta = if outcome then outcome.cashAfter - outcome.cashBefore else 0
		local tierBefore = tier

		if kind == "gate" then
			-- The panel you ran through vanishes at once (owner request), with
			-- its label and any toll cash behind it; the pop text below is the feedback.
			local panel = optionVisual.panel
			if panel then
				panel:Destroy()
				optionVisual.panel = nil
				optionVisual.label = nil
			end
			local tollCash = optionVisual.model
			if tollCash then
				tollCash:Destroy()
				optionVisual.model = nil
				optionVisual.valueLabel = nil
				if cashDelta > 0.001 then
					Theme.FloatText(popAt + Vector3.new(0, 2.5, 0), "+" .. Format.Money(cashDelta), P.MoneyGreen)
				end
			end
			-- Weapon gates get their own "🔫 Rifle!" pop below instead.
			if optionVisual.option.op ~= "weapon" then
				local good = toneColor(optionVisual.option) ~= P.GateNegative
				Theme.FloatText(popAt, gateText(optionVisual.option), if good then P.MoneyGreen else P.ButtonRed)
			end
		elseif kind == "cash" then
			-- The stack you took vanishes at once, like a gate.
			local model = optionVisual.model
			if model then
				model:Destroy()
				optionVisual.model = nil
				optionVisual.anchor = nil
				optionVisual.valueLabel = nil
			end
			if cashDelta > 0.001 then
				Theme.FloatText(popAt, "+" .. Format.Money(cashDelta), P.MoneyGreen)
			end
			local offered = optionVisual.option.cash or 0
			if outcome and offered > cashDelta + 0.5 and capacityNow > 0 and outcome.cashAfter >= capacityNow - 0.5 then
				Theme.FloatText(popAt + Vector3.new(0, 2.5, 0), "CAPACITY FULL!", P.Coin)
			end
		elseif kind == "squad" then
			-- Kills per lane: the outcome (exact) if we have it, else the prediction.
			local totalKills = 0
			local root = lastRoot
			for laneIndex, ov in rowVisual.options do
				local isOwn = laneIndex == lane
				local laneFight = fights[laneIndex]
				local kills = if outcome
					then (if isOwn then outcome.kills or 0 else outcome.otherKills or 0)
					else (if laneFight then laneFight.kills else 0)
				totalKills += kills
				local killed = shownKills({
					enemies = math.max(0, math.floor(ov.option.enemies or 0)),
					kills = kills,
					share = 0,
					destroyed = false,
				}, #ov.enemies)
				if isOwn then
					for i, enemy in ov.enemies do
						local rig = enemy.rig
						if i <= killed then
							task.delay(i * 0.02, function()
								if rig.model.Parent then
									killRig(rig, 0.35)
								end
							end)
						else
							-- Survivors charge into your squad (each costs one troop).
							local towards = if root then root.Position - rig.pivot.Position else Vector3.new(0, 0, 6)
							flyAway(rig.model, Vector3.new(towards.X, 0, towards.Z) * 0.8, 0.35)
						end
					end
					ov.enemies = {}
					if ov.anchor then
						ov.anchor:Destroy()
						ov.anchor = nil
					end
				else
					-- The other squad: soldiers shot down by the wide fire stay down,
					-- the rest stand back up.
					local standing: { EnemyRig } = {}
					for i, enemy in ov.enemies do
						local rig = enemy.rig
						if i <= killed then
							task.delay(i * 0.02, function()
								if rig.model.Parent then
									killRig(rig, 0.35)
								end
							end)
						else
							enemy.fall, enemy.target = 0, 0
							local parts: { BasePart } = {}
							local cframes: { CFrame } = {}
							RunnerModels.RigCFrames(rig, rig.pivot, parts, cframes)
							Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
							table.insert(standing, enemy)
						end
					end
					ov.enemies = standing
				end
			end
			if totalKills > 0 then
				Theme.FloatText(popAt + Vector3.new(0, 2, 0), "💥 " .. totalKills .. " down!", P.Coin)
			end
		elseif kind == "barricade" then
			for laneIndex, ov in rowVisual.options do
				local isOwn = laneIndex == lane
				local laneFight = fights[laneIndex]
				local broken = if outcome
					then (if isOwn then outcome.destroyed == true else outcome.otherDestroyed == true)
					else (laneFight ~= nil and laneFight.destroyed)
				local hp = ov.hp
				local at = ov.centre + Vector3.new(0, 7, -2)
				if broken then
					if hp then
						hp.set(0, 0.15)
					end
					local model = ov.model
					if model then
						task.delay(0.1, function()
							if model.Parent then
								crumble(model, 0.6)
							end
						end)
						ov.model = nil
					end
					pool:Flash(ov.centre + Vector3.new(0, 2, 0), 6, P.CardOrange, 0.35)
					Theme.FloatText(at, "SMASHED!", P.Coin)
				else
					-- Keeps the damage it took (the other one only from the wide fire).
					local maxHp = math.max(1e-6, ov.option.hp or 0)
					local dealt = if outcome then (if isOwn then outcome.damage else outcome.otherDamage) else nil
					local share = if dealt then dealt / maxHp elseif laneFight then laneFight.share else 0
					if hp then
						hp.set(1 - math.clamp(share, 0, 1), 0.15)
					end
					if isOwn then
						Theme.FloatText(at, "TOO STRONG!", P.ButtonRed)
					end
				end
			end
		elseif kind == "contest" then
			-- The side you ran through vanishes at once (like a gate); the other
			-- side keeps the number it grew to.
			local cv = rowVisual.contest
			if cv then
				for _, side in cv.sides do
					if side.lane == lane then
						side.gone = true
						local panel = side.ov.panel
						if panel then
							panel:Destroy()
						end
						side.ov.panel = nil
						side.ov.label = nil
						for _, bar in side.frame do
							bar:Destroy()
						end
						table.clear(side.frame)
					else
						local final = if outcome and outcome.otherAmount then outcome.otherAmount else side.shown
						local label = side.ov.label
						if final ~= side.shown and label then
							side.shown = final
							label.Text = contestText(side.option, final)
						end
					end
				end
			end
			local text = (if troopDelta >= 0 then "+" else "") .. troopDelta .. " 🪖"
			Theme.FloatText(popAt, "🎯 " .. text, if troopDelta >= 0 then P.MoneyGreen else P.ButtonRed)
		end

		if troopDelta ~= 0 and kind ~= "gate" and kind ~= "contest" then
			local text = if troopDelta > 0 then "+" .. troopDelta .. " 🪖" else tostring(troopDelta) .. " 🪖"
			Theme.FloatText(popAt + Vector3.new(0, -2, 0), text, if troopDelta > 0 then P.MoneyGreen else P.ButtonRed)
		end
		if outcome and outcome.weaponTier > tierBefore then
			Theme.FloatText(
				popAt + Vector3.new(0, 3, 0),
				"🔫 " .. RunnerGuns.Weapon(outcome.weaponTier).name .. "!",
				P.Coin
			)
		end
		-- A weapon gate at the top tier pays cash instead ("Weapon already maxed").
		local maxedWeapon = kind == "gate"
			and optionVisual.option.op == "weapon"
			and outcome ~= nil
			and outcome.weaponTier <= tierBefore
		if maxedWeapon and outcome and outcome.note and outcome.note ~= "" then
			Theme.FloatText(popAt + Vector3.new(0, 5, 0), outcome.note, P.Coin)
		end
	end

	local function bossPivot(distance: number): CFrame
		local p = worldAt(distance, 0, 0)
		return CFrame.lookAt(p, p + Vector3.new(0, 0, 1)) -- faces the runner (+Z)
	end

	-- Boss intro (RunnerDefs.BOSS_INTRO_SECONDS in total):
	--   0 .. BOSS_DOOR_TIME      the castle door sinks into the ground; the boss
	--                            waits hidden inside the gateway (no HP bar yet)
	--   then .. intro end        it appears, its HP bar switches on, and it walks
	--                            out to BOSS_STAND studs in front of the castle
	function self.OpenCastle(_self: Visuals, maxHp: number): number
		if destroyed then
			return 0
		end
		if castleOpen then
			return math.max(0, BOSS_INTRO_SECONDS - castleClock)
		end
		castleOpen = true
		castleClock = 0
		engaged = {}
		local sink = fortDoor:GetExtentsSize().Y + 0.2
		for _, item in fortDoor:GetDescendants() do
			if item:IsA("BasePart") then
				Theme.Tween(
					item,
					{ CFrame = item.CFrame - Vector3.new(0, sink, 0) },
					BOSS_DOOR_TIME,
					Enum.EasingStyle.Quad
				)
			end
		end
		local b = RunnerBoss.new(folder, bossPivot(fortDistance + BOSS_WAIT_DEPTH), maxHp)
		boss = b
		task.delay(BOSS_DOOR_TIME, function()
			if boss == b and not destroyed then
				b:Show()
				b:WalkTo(bossPivot(fortDistance - BOSS_STAND), math.max(0.3, BOSS_INTRO_SECONDS - BOSS_DOOR_TIME))
			end
		end)
		Theme.FloatText(worldAt(fortDistance - 2, 0, 21), "👹 THE BOSS!", P.ButtonRed)
		return BOSS_INTRO_SECONDS
	end

	-- Plays the boss fight exactly as the BossOutcome says (RunnerController
	-- passes the server's):
	--   intro (OpenCastle)       if it is still playing, the fight waits for it
	--   fight t = 0 .. duration  everyone shoots it, its bar follows BossHpAt(t);
	--                            each kill k lands at k x interval (troops from the
	--                            back rows first, the avatar last)
	--   then BOSS_OUTRO_SECONDS  victory (boss falls, confetti, coins) or defeat
	--                            (avatar knocked down, boss roars), then onDone()
	function self.StartBossFight(_self: Visuals, outcome: BossOutcome, callbacks: BossCallbacks): number
		if destroyed or fight then
			return 0
		end
		self.OpenCastle(self, outcome.hp) -- no-op when the intro already started
		local b = boss
		if b then
			b:SetMaxHp(outcome.hp)
			b:SetHp(outcome.hp)
		end

		-- One boss shot per kill, fired so it lands when the unit dies.
		local shots: { BossShot } = {}
		local speed = RunnerGuns.Weapon(RunnerDefs.MAX_WEAPON_TIER).bulletSpeed
		local travel = math.clamp((SQUAD_GAP - BOSS_STAND) / math.max(10, speed), 0.1, 0.6)
		local lastTime = -math.huge
		for k = 1, outcome.killed do
			local landing = k * outcome.interval
			local fire = math.max(0, landing - travel)
			-- Huge armies kill very fast: draw at most ~6 shots per second.
			if fire - lastTime >= 0.16 or k == outcome.killed then
				table.insert(shots, { time = fire, killIndex = k })
				lastTime = fire
			end
		end
		local wait = math.max(0, BOSS_INTRO_SECONDS - castleClock)
		fight = {
			outcome = outcome,
			callbacks = callbacks,
			clock = 0,
			fightStart = wait,
			shots = shots,
			nextShot = 1,
			resolved = false,
			done = false,
		}
		return wait + outcome.duration + BOSS_OUTRO_SECONDS
	end

	function self.BossFocus(_self: Visuals): Vector3?
		local b = boss
		return if b then b:Chest() else nil
	end

	function self.Destroy(_self: Visuals)
		if destroyed then
			return
		end
		destroyed = true
		restoreAvatar()
		local gun = avatarGun
		avatarGun = nil
		if gun then
			gun:Destroy()
		end
		local b = boss
		boss = nil
		fight = nil
		if b then
			b:Destroy()
		end
		pool:Destroy()
		fortModel:Destroy()
		folder:Destroy()
	end

	folder.Parent = Workspace
	return self
end

return RunnerVisuals
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
