      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Format
	Number / time formatting shared by every UI.
]]

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function withCommas(integer: number): string
	local s = tostring(math.floor(math.abs(integer)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

-- Short number: 950 -> "950", 1520 -> "1.52K", 2500000 -> "2.5M".
function Format.Short(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local text: string
	if n < 1000 then
		text = if n == math.floor(n) then tostring(n) else string.format("%.1f", n)
	else
		local index = math.min(math.floor(math.log10(n) / 3), #SUFFIXES)
		local scaled = n / 10 ^ (index * 3)
		local digits = if scaled < 10 then "%.2f" elseif scaled < 100 then "%.1f" else "%.0f"
		text = string.format(digits, scaled):gsub("%.?0+$", "") .. SUFFIXES[index]
	end
	return (if negative then "-" else "") .. text
end

-- Money like the reference images: "$0.00", "$1,562.50", then "$1.25M".
function Format.Money(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local text: string
	if n < 1e6 then
		local cents = math.floor(n * 100 + 0.5)
		local whole = math.floor(cents / 100)
		text = withCommas(whole) .. string.format(".%02d", cents % 100)
	else
		text = Format.Short(n)
	end
	return (if negative then "-$" else "$") .. text
end

function Format.Robux(n: number): string
	return "R$ " .. withCommas(n)
end

-- 75 -> "1:15", 3700 -> "1:01:40"
function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 90 -> "1m 30s", 7200 -> "2h", 5400 -> "1h 30m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return if m > 0 then string.format("%dh %dm", h, m) else string.format("%dh", h)
	elseif m > 0 then
		return if s > 0 then string.format("%dm %ds", m, s) else string.format("%dm", m)
	end
	return string.format("%ds", s)
end

function Format.Percent(fraction: number): string
	local p = fraction * 100
	if p == math.floor(p) then
		return string.format("%d%%", p)
	end
	return string.format("%.1f%%", p)
end

-- Round money to cents (all stored cash values go through this).
function Format.RoundCents(n: number): number
	return math.floor(n * 100 + 0.5) / 100
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Layout
	Single source of truth for world-space positions so that the server
	(validation, static map) and the client (progression visuals) agree.

	World map (top view, +X to the right, +Z towards the camera):

	   Combat arenas      z = -700   (one per player slot, x = slot * 170)
	   Home base          z = 0      (areas 1..N laid out along +X)
	   Runner tracks      z = +700 .. +1600 (one per slot, run towards -Z)
]]

local Layout = {}

-- Home base -------------------------------------------------------------------
Layout.AREA_SIZE = 160 -- each area is a 160 x 160 stud square
Layout.AREA_PITCH = 184 -- centre-to-centre distance (24-stud gate corridor)
Layout.FLOOR_Y = 0 -- top surface of all floors
Layout.PATH_WIDTH = 28 -- central cross-shaped walkway
Layout.PLOT_SIZE = 56 -- each unlock slot is a 56 x 56 plot
Layout.GATE_WIDTH = 20 -- opening in the hedge between two areas
Layout.WALL_HEIGHT = 6
Layout.INTERACT_RANGE = 16 -- server-side proximity check for base actions

-- Slot offsets from the area centre: 1 = north-west, 2 = north-east,
-- 3 = south-west, 4 = south-east.
Layout.SLOT_OFFSETS = {
	Vector3.new(-42, 0, -42),
	Vector3.new(42, 0, -42),
	Vector3.new(-42, 0, 42),
	Vector3.new(42, 0, 42),
}

function Layout.AreaCenter(area: number): Vector3
	return Vector3.new((area - 1) * Layout.AREA_PITCH, Layout.FLOOR_Y, 0)
end

-- Which area a world position belongs to (nil = outside the base).
function Layout.AreaAt(position: Vector3, areaCount: number): number?
	for area = 1, areaCount do
		local c = Layout.AreaCenter(area)
		local half = Layout.AREA_SIZE / 2
		if math.abs(position.X - c.X) <= half and math.abs(position.Z - c.Z) <= half then
			return area
		end
	end
	return nil
end

function Layout.SlotCenter(area: number, slotIndex: number): Vector3
	return Layout.AreaCenter(area) + Layout.SLOT_OFFSETS[slotIndex]
end

-- Point on the plot edge that faces the central walkway (where restock and
-- upgrade prompts sit, so the player never has to walk into the building).
function Layout.SlotFrontPosition(area: number, slotIndex: number): Vector3
	local offset = Layout.SLOT_OFFSETS[slotIndex]
	local towardsPathX = -math.sign(offset.X)
	return Layout.SlotCenter(area, slotIndex)
		+ Vector3.new(towardsPathX * (Layout.PLOT_SIZE / 2 - 6), 0, 0)
end

-- Where the "Hire me" tile / employee stands for a revenue section.
function Layout.SlotHirePosition(area: number, slotIndex: number): Vector3
	local offset = Layout.SLOT_OFFSETS[slotIndex]
	local towardsPathX = -math.sign(offset.X)
	local towardsPathZ = -math.sign(offset.Z)
	return Layout.SlotCenter(area, slotIndex)
		+ Vector3.new(towardsPathX * (Layout.PLOT_SIZE / 2 - 6), 0, towardsPathZ * (Layout.PLOT_SIZE / 2 - 8))
end

-- The gate that leads FROM `area` TO `area + 1` (on the east edge of `area`).
function Layout.GatePosition(area: number): Vector3
	return Layout.AreaCenter(area) + Vector3.new(Layout.AREA_PITCH / 2, 0, 0)
end

function Layout.SpawnPosition(): Vector3
	return Layout.AreaCenter(1) + Vector3.new(0, 0, 58)
end

-- Big "ARMY RUN" pad in area 1 that starts the runner.
function Layout.RunnerPortalPosition(): Vector3
	return Layout.AreaCenter(1) + Vector3.new(0, 0, -60)
end

-- Runner -------------------------------------------------------------------------
Layout.RUNNER_TRACK_WIDTH = 24
Layout.RUNNER_TRACK_LENGTH = 900
Layout.RUNNER_START_Z = 1600
Layout.RUNNER_SLOT_SPACING = 80

-- CFrame at the start of a player's runner track, facing down the track (-Z).
function Layout.RunnerTrackStart(slotIndex: number): CFrame
	local p = Vector3.new(slotIndex * Layout.RUNNER_SLOT_SPACING, Layout.FLOOR_Y, Layout.RUNNER_START_Z)
	return CFrame.lookAt(p, p + Vector3.new(0, 0, -1))
end

-- World position of a point on a track: `distance` studs from the start and
-- `lateral` studs to the right of the centre line (right = +X).
function Layout.RunnerPoint(slotIndex: number, distance: number, lateral: number): Vector3
	return Vector3.new(
		slotIndex * Layout.RUNNER_SLOT_SPACING + lateral,
		Layout.FLOOR_Y,
		Layout.RUNNER_START_Z - distance
	)
end

-- Combat -----------------------------------------------------------------------
Layout.ARENA_SIZE_X = 80
Layout.ARENA_SIZE_Z = 110
Layout.ARENA_SLOT_SPACING = 170
Layout.ARENA_Z = -700

function Layout.ArenaCenter(slotIndex: number): Vector3
	return Vector3.new(slotIndex * Layout.ARENA_SLOT_SPACING, Layout.FLOOR_Y, Layout.ARENA_Z)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Net
	All client <-> server traffic goes through here.

	Requests (client -> server, with a reply):
		-- server
		Net.Handle("BuyRunnerUpgrade", function(player, kind) ... return Net.Ok({ level = 3 }) end)
		-- client
		local result = Net.Request("BuyRunnerUpgrade", "troops")
		if result.ok then ... else warn(result.err) end

	Handlers return a table (Net.Ok / Net.Fail) or nil (= ok). A handler that
	errors returns { ok = false, err = "Something went wrong" } to the client.

	Push events (server -> client, or client -> server):
		Net.Fire("Notify", player, "Hello", "success")   -- server -> one client
		Net.FireAll("Notify", "Server message")          -- server -> all clients
		Net.FireServer("Name", ...)                      -- client -> server
		Net.On("Notify", function(...) end)              -- listen on either side
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Result = { ok: boolean, err: string?, [string]: any }

local Net = {}

-- Every RemoteEvent the game uses. Add new names here (server creates them).
Net.EVENTS = {
	"Sync", -- server -> client: full PlayerData snapshot
	"Notify", -- server -> client: (text, kind) toast
	"Fx", -- server -> client: (kind, payload) world effects (floating text...)
	"Runner", -- server -> client: (msg, payload)
	"Combat", -- both ways: (msg, payload) reliable combat events
	"Base", -- server -> client: (msg, payload)
	"Boost", -- server -> client: (msg, payload) random offers / timers
	"Shop", -- server -> client: (msg, payload)
	"Inventory", -- server -> client: (msg, payload)
	"Vehicle", -- server -> client: (msg, payload)
}

-- High-frequency, droppable events.
Net.UNRELIABLE = {
	"CombatSnap", -- server -> client: combat entity snapshot (~20 Hz)
}

local FOLDER_NAME = "Remotes"
local ACTION_NAME = "Action"
local IS_SERVER = RunService:IsServer()

local folder: Folder? = nil
local handlers: { [string]: (Player, ...any) -> any } = {}

-- Per-player request budget (token bucket) to stop remote spam.
local RATE_PER_SECOND = 25
local BURST = 40
local buckets: { [Player]: { tokens: number, last: number } } = {}

local function getFolder(): Folder
	local cached = folder
	if cached then
		return cached
	end
	local result: Folder
	if IS_SERVER then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing and existing:IsA("Folder") then
			result = existing
		else
			result = Instance.new("Folder")
			result.Name = FOLDER_NAME
			result.Parent = ReplicatedStorage
		end
	else
		result = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	folder = result
	return result
end

local function getRemote(name: string): Instance
	local f = getFolder()
	if IS_SERVER then
		local remote = f:FindFirstChild(name)
		if not remote then
			error(("Net: unknown remote '%s' (add it to Net.EVENTS)"):format(name))
		end
		return remote
	end
	return f:WaitForChild(name)
end

function Net.Ok(payload: { [string]: any }?): Result
	local result = (payload or {}) :: Result
	result.ok = true
	return result
end

function Net.Fail(message: string): Result
	return { ok = false, err = message }
end

-- Server: create every remote. Called once by Server/Main before services load.
function Net.Setup()
	assert(IS_SERVER, "Net.Setup is server-only")
	local f = getFolder()
	for _, name in Net.EVENTS do
		if not f:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
	end
	for _, name in Net.UNRELIABLE do
		if not f:FindFirstChild(name) then
			local remote = Instance.new("UnreliableRemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
	end
	local action = f:FindFirstChild(ACTION_NAME) :: RemoteFunction?
	if not action then
		local created = Instance.new("RemoteFunction")
		created.Name = ACTION_NAME
		created.Parent = f
		action = created
	end
	(action :: RemoteFunction).OnServerInvoke = function(player: Player, actionName: any, ...: any): Result
		if type(actionName) ~= "string" then
			return Net.Fail("Bad request")
		end
		-- rate limit
		local now = os.clock()
		local bucket = buckets[player]
		if not bucket then
			bucket = { tokens = BURST, last = now }
			buckets[player] = bucket
		end
		bucket.tokens = math.min(BURST, bucket.tokens + (now - bucket.last) * RATE_PER_SECOND)
		bucket.last = now
		if bucket.tokens < 1 then
			return Net.Fail("Slow down!")
		end
		bucket.tokens -= 1

		local handler = handlers[actionName]
		if not handler then
			return Net.Fail("Unknown action " .. actionName)
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] action %s failed for %s: %s"):format(actionName, player.Name, tostring(result)))
			return Net.Fail("Something went wrong")
		end
		if result == nil then
			return Net.Ok()
		end
		if type(result) ~= "table" then
			return Net.Ok({ value = result })
		end
		if result.ok == nil then
			result.ok = true
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Server: register a request handler.
function Net.Handle(actionName: string, handler: (Player, ...any) -> any)
	assert(IS_SERVER, "Net.Handle is server-only")
	if handlers[actionName] then
		warn("[Net] handler replaced: " .. actionName)
	end
	handlers[actionName] = handler
end

-- Client: send a request and wait for the reply. Never errors.
function Net.Request(actionName: string, ...: any): Result
	assert(not IS_SERVER, "Net.Request is client-only")
	local remote = getRemote(ACTION_NAME) :: RemoteFunction
	local args = table.pack(...)
	local ok, result = pcall(function()
		return remote:InvokeServer(actionName, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return Net.Fail("Connection problem")
	end
	if type(result) ~= "table" then
		return Net.Fail("Bad reply")
	end
	return result :: Result
end

-- Server: fire one client.
function Net.Fire(eventName: string, player: Player, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireClient(player, ...)
end

-- Server: fire every client.
function Net.FireAll(eventName: string, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireAllClients(...)
end

-- Client: fire the server.
function Net.FireServer(eventName: string, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireServer(...)
end

-- Listen to an event. Server callbacks receive (player, ...).
function Net.On(eventName: string, callback: (...any) -> ()): RBXScriptConnection
	local remote = getRemote(eventName) :: any
	if IS_SERVER then
		return remote.OnServerEvent:Connect(callback)
	end
	return remote.OnClientEvent:Connect(callback)
end

-- Server convenience: toast message for one player.
-- kind: "info" | "success" | "error" | "cash"
function Net.Notify(player: Player, text: string, kind: string?)
	Net.Fire("Notify", player, text, kind or "info")
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rng</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Rng
	Deterministic seeded random numbers (Park-Miller "minimal standard").
	Identical results in Roblox and in the Lune test runner, so the server,
	the client and the economy simulation all see the same runner course.

		local rng = Rng.new(1234)
		rng:Next()          -- [0, 1)
		rng:Int(1, 6)       -- 1..6 inclusive
		rng:Weighted(list, function(item) return item.weight end)
]]

export type Rng = {
	Next: (self: Rng) -> number,
	Int: (self: Rng, min: number, max: number) -> number,
	Range: (self: Rng, min: number, max: number) -> number,
	Chance: (self: Rng, p: number) -> boolean,
	Pick: <T>(self: Rng, list: { T }) -> T,
	Weighted: <T>(self: Rng, list: { T }, weightOf: (T) -> number) -> (T, number),
	Shuffle: <T>(self: Rng, list: { T }) -> { T },
}

local MODULUS = 2147483647
local MULTIPLIER = 48271

local Rng = {}

function Rng.new(seed: number): Rng
	local state: number = math.floor(math.abs(seed)) % MODULUS
	if state == 0 then
		state = 1
	end

	local function nextNumber(): number
		state = (state * MULTIPLIER) % MODULUS
		return (state - 1) / (MODULUS - 1)
	end

	local function int(min: number, max: number): number
		return min + math.floor(nextNumber() * (max - min + 1))
	end

	local rng = {}

	function rng.Next(_self: Rng): number
		return nextNumber()
	end

	function rng.Int(_self: Rng, min: number, max: number): number
		return int(min, max)
	end

	function rng.Range(_self: Rng, min: number, max: number): number
		return min + nextNumber() * (max - min)
	end

	function rng.Chance(_self: Rng, p: number): boolean
		return nextNumber() < p
	end

	function rng.Pick<T>(_self: Rng, list: { T }): T
		return list[int(1, #list)]
	end

	function rng.Weighted<T>(_self: Rng, list: { T }, weightOf: (T) -> number): (T, number)
		local total = 0
		for _, item in list do
			total += math.max(0, weightOf(item))
		end
		local roll = nextNumber() * total
		for index, item in list do
			roll -= math.max(0, weightOf(item))
			if roll < 0 then
				return item, index
			end
		end
		return list[#list], #list
	end

	function rng.Shuffle<T>(_self: Rng, list: { T }): { T }
		for i = #list, 2, -1 do
			local j = int(1, i)
			list[i], list[j] = list[j], list[i]
		end
		return list
	end

	-- Warm up so nearby seeds diverge quickly.
	for _ = 1, 3 do
		nextNumber()
	end
	return (rng :: any) :: Rng
end

return Rng
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Runner</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">RunnerCourse</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerCourse  (STUB written by the lead — ECON replaces the body, keeps the types/signature)
	See docs/ARCHITECTURE.md §4.2.
]]

export type Option = {
	lane: number,
	x: number,
	width: number,
	op: string?,
	amount: number?,
	label: string,
	tone: string,
	cash: number?,
	enemies: number?,
	hp: number?,
	reward: number?,
}

export type Row = { index: number, kind: string, distance: number, options: { Option } }

export type Course = {
	area: number,
	level: number,
	seed: number,
	length: number,
	rows: { Row },
	boss: { distance: number, hp: number, reward: number },
}

local RunnerCourse = {}

function RunnerCourse.Generate(area: number, level: number): Course
	return { area = area, level = level, seed = level, length = 900, rows = {}, boss = { distance = 880, hp = 100, reward = 10 } }
end

return RunnerCourse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">RunnerSim</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerSim  (STUB written by the lead — ECON replaces the bodies, keeps the types/signatures)
	See docs/ARCHITECTURE.md §4.2.
]]

local RunnerCourse = require(script.Parent.RunnerCourse)

export type Stats = { startTroops: number, damage: number, capacity: number, payoutBonus: number? }

export type RowOutcome = {
	row: number,
	lane: number,
	kind: string,
	label: string,
	troopsBefore: number,
	troopsAfter: number,
	cashBefore: number,
	cashAfter: number,
	weaponTier: number,
	damageMult: number,
	destroyed: boolean?,
	note: string?,
}

export type Line = { kind: string, label: string, detail: string, value: number }

export type Result = {
	troops: number,
	weaponTier: number,
	damageMult: number,
	collected: number,
	carried: number,
	outcomes: { RowOutcome },
	lines: { Line },
	total: number,
}

local RunnerSim = {}

function RunnerSim.Resolve(_course: RunnerCourse.Course, stats: Stats, _choices: { number }): Result
	return { troops = stats.startTroops, weaponTier = 1, damageMult = 1, collected = 0, carried = 0, outcomes = {}, lines = {}, total = 0 }
end

function RunnerSim.BestCase(course: RunnerCourse.Course, stats: Stats): (Result, { number })
	return RunnerSim.Resolve(course, stats, {}), {}
end

function RunnerSim.MinDuration(_course: RunnerCourse.Course): number
	return 30
end

return RunnerSim
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Signal
	Tiny pure-Luau signal (no BindableEvents, safe to fire with tables).

		local s = Signal.new()
		local conn = s:Connect(function(a, b) ... end)
		s:Fire(1, 2)
		conn:Disconnect()
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self = setmetatable({ _handlers = {} :: { [any]: (...any) -> () } }, Signal)
	return (self :: any) :: Signal
end

function Signal:Connect(fn: (...any) -> ()): Connection
	local handlers = self._handlers
	local connection = {} :: any
	connection.Connected = true
	function connection.Disconnect(c)
		c.Connected = false
		handlers[c] = nil
	end
	handlers[connection] = fn
	return connection :: Connection
end

function Signal:Once(fn: (...any) -> ()): Connection
	local connection: Connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...: any)
	-- Copy first so handlers may disconnect while we iterate.
	local list = {}
	for _, fn in self._handlers do
		table.insert(list, fn)
	end
	for _, fn in list do
		task.spawn(fn, ...)
	end
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types
	Saved player data schema + defaults. All dictionary keys are strings so the
	table can be stored in a DataStore and sent over remotes unchanged.
]]

export type SectionState = {
	level: number, -- upgrade level, starts at 1
	stock: number, -- sales left before a manual restock is needed
	employee: boolean, -- true = auto-restocks
}

export type Item = {
	id: string, -- EquipmentDefs item id
	rarity: number, -- 1 Common .. 5 Legendary
	level: number, -- upgrade level, starts at 1
	perks: { string }?, -- perk ids rolled when the item dropped (Rare+), see EquipmentDefs
}

export type PlayerData = {
	version: number,
	cash: number,
	lifetimeCash: number,

	runner: {
		level: number, -- run counter shown as "Level N" (image 2)
		runs: number,
		bestPayout: number,
		-- Permanent upgrade levels bought before runs. [REQUIREMENT]
		upgrades: { troops: number, damage: number, capacity: number },
	},

	base: {
		highestArea: number, -- highest unlocked area (1..#Config.Areas)
		sections: { [string]: SectionState }, -- key = slot id ("a1s2"); present = unlocked
		barriers: { [string]: boolean }, -- key = tostring(area): barrier squad on that area's exit gate defeated
		arenaUnlocked: boolean,
	},

	combat: {
		highestLevel: number, -- highest Combat Arena level cleared
		wins: number,
		games: number,
	},

	inventory: { [string]: Item }, -- key = item uid
	equipped: { weapon: string?, armour: string? },
	nextUid: number,

	vehicles: { owned: { [string]: boolean }, equipped: string? },

	boosts: {
		multiplierSeconds: number, -- remaining play-time of the 2x cash boost
	},

	employeeTokens: number, -- Robux employees bought but not yet assigned
	receipts: { [string]: boolean }, -- processed purchase ids (idempotency)
	receiptOrder: { string },

	stats: {
		playSeconds: number,
		combatKills: number,
		sectionsUnlocked: number,
	},
}

local Types = {}

Types.DATA_VERSION = 1

-- Starter loadout (ids must exist in EquipmentDefs).
Types.STARTER_WEAPON_ID = "w_pistol"
Types.STARTER_ARMOUR_ID = "a_vest"

function Types.DefaultData(): PlayerData
	return {
		version = Types.DATA_VERSION,
		cash = 0,
		lifetimeCash = 0,
		runner = {
			level = 1,
			runs = 0,
			bestPayout = 0,
			upgrades = { troops = 0, damage = 0, capacity = 0 },
		},
		base = {
			highestArea = 1,
			sections = {},
			barriers = {},
			arenaUnlocked = false,
		},
		combat = { highestLevel = 0, wins = 0, games = 0 },
		inventory = {
			["1"] = { id = Types.STARTER_WEAPON_ID, rarity = 1, level = 1 },
			["2"] = { id = Types.STARTER_ARMOUR_ID, rarity = 1, level = 1 },
		},
		equipped = { weapon = "1", armour = "2" },
		nextUid = 3,
		vehicles = { owned = {}, equipped = nil },
		boosts = { multiplierSeconds = 0 },
		employeeTokens = 0,
		receipts = {},
		receiptOrder = {},
		stats = { playSeconds = 0, combatKills = 0, sectionsUnlocked = 0 },
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end
Types.DeepCopy = deepCopy

-- Fill any keys missing from `data` with defaults (used after loading old saves).
function Types.Reconcile(data: any): PlayerData
	local function fill(target: any, template: any)
		for k, v in template do
			if target[k] == nil then
				target[k] = deepCopy(v)
			elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
				-- Only recurse into "struct" tables, not open maps such as inventory.
				local isStruct = true
				for key in v do
					if type(key) ~= "string" or tonumber(key) ~= nil then
						isStruct = false
						break
					end
				end
				if isStruct then
					fill(target[k], v)
				end
			end
		end
	end
	if type(data) ~= "table" then
		return Types.DefaultData()
	end
	local template = Types.DefaultData()
	-- Never re-add the starter items to an existing inventory.
	template.inventory = {}
	template.equipped = {}
	fill(data, template)
	return data :: PlayerData
end

return Types
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point.
	Every ModuleScript directly inside Server/Services is a service:
		Service.Priority (optional, higher = initialised first)
		Service:Init(registry)  -- create state, register Net handlers (no cross-service calls)
		Service:Start()         -- connect events, may call other services
	`registry` maps service name -> service table, e.g. registry.DataService.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
Net.Setup()

local servicesFolder = script.Parent:WaitForChild("Services")
local registry: { [string]: any } = {}
local ordered = {}

for _, module in servicesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, service = pcall(require, module)
		if ok and type(service) == "table" then
			registry[module.Name] = service
			table.insert(ordered, { name = module.Name, service = service })
		else
			warn(("[Server] failed to load %s: %s"):format(module.Name, tostring(service)))
		end
	end
end

table.sort(ordered, function(a, b)
	local pa, pb = a.service.Priority or 0, b.service.Priority or 0
	if pa ~= pb then
		return pa > pb
	end
	return a.name < b.name
end)

for _, entry in ordered do
	if type(entry.service.Init) == "function" then
		local ok, err = pcall(entry.service.Init, entry.service, registry)
		if not ok then
			warn(("[Server] %s:Init failed: %s"):format(entry.name, tostring(err)))
		end
	end
end

for _, entry in ordered do
	if type(entry.service.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(entry.service.Start, entry.service)
			if not ok then
				warn(("[Server] %s:Start failed: %s"):format(entry.name, tostring(err)))
			end
		end)
	end
end

print(("[Server] started %d services"):format(#ordered))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService
	Loads, saves and syncs PlayerData.

	API (server):
		DataService:Get(player): PlayerData?          -- live table, mutate it then MarkDirty
		DataService:WaitFor(player, timeout?): PlayerData?
		DataService:MarkDirty(player)                  -- sync to client soon + save later
		DataService:AddCash(player, amount, opts?): number
			opts.boostable = true -> multiplied by BoostService:GetCashMultiplier (2x boost)
			opts.source = "runner" | "section" | "combat" | ... (for logging)
			returns the amount actually added
		DataService:CanAfford(player, amount): boolean
		DataService:SpendCash(player, amount): boolean -- false = not enough cash
		DataService:SaveNow(player): boolean
		DataService.PlayerLoaded: Signal(player, data)
		DataService.PlayerRemoving: Signal(player, data)  -- before the final save

	Without DataStore access (e.g. an unpublished place in Studio) the game still
	runs; progress just is not saved. See README.md to enable saving in Studio.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData

local DataService = {}
DataService.Priority = 100 -- initialised first
DataService.PlayerLoaded = Signal.new()
DataService.PlayerRemoving = Signal.new()

local Services: { [string]: any } = {}
local store: DataStore? = nil
local profiles: { [Player]: PlayerData } = {}
local dirtySave: { [Player]: boolean } = {}
local dirtySync: { [Player]: boolean } = {}
local loading: { [Player]: boolean } = {}

local MAX_RECEIPTS = 60

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T?)
	local delaySeconds = 1
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(("[DataService] %s failed (attempt %d): %s"):format(label, attempt, tostring(result)))
		if attempt < 4 then
			task.wait(delaySeconds)
			delaySeconds *= 2
		end
	end
	return false, nil
end

local function openStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if not ok then
		warn("[DataService] DataStores unavailable, progress will NOT be saved: " .. tostring(result))
		return
	end
	-- In Studio, a place without "Enable Studio Access to API Services" errors here.
	local probeOk, probeErr = pcall(function()
		(result :: DataStore):GetAsync("__probe")
	end)
	if not probeOk then
		warn("[DataService] DataStores unavailable, progress will NOT be saved: " .. tostring(probeErr))
		return
	end
	store = result
end

function DataService:Init(registry: { [string]: any })
	Services = registry
	task.spawn(openStore)

	Net.Handle("RequestSync", function(player)
		if profiles[player] then
			dirtySync[player] = true
		end
		return nil
	end)
end

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:_load(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			self:_load(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		self:_release(player)
	end)

	-- Batched client sync (at most ~7 times per second per player).
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in dirtySync do
				dirtySync[player] = nil
				local data = profiles[player]
				if data and player.Parent then
					Net.Fire("Sync", player, data)
				end
			end
		end
	end)

	-- Play-time counter + autosave.
	task.spawn(function()
		local sinceSave = 0
		while true do
			task.wait(1)
			sinceSave += 1
			for _, data in profiles do
				data.stats.playSeconds += 1
			end
			if sinceSave >= Config.AutosaveInterval then
				sinceSave = 0
				for player in dirtySave do
					task.spawn(function()
						self:SaveNow(player)
					end)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				self:SaveNow(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

function DataService:_load(player: Player)
	if profiles[player] or loading[player] then
		return
	end
	loading[player] = true
	-- Give openStore a moment on server start.
	local waited = 0
	while store == nil and waited < 3 do
		task.wait(0.25)
		waited += 0.25
	end

	local data: PlayerData
	local activeStore = store
	if activeStore then
		local ok, saved = withRetries("load " .. player.Name, function()
			return activeStore:GetAsync(keyFor(player))
		end)
		if not ok then
			loading[player] = nil
			player:Kick("Could not load your save data. Please rejoin in a minute (your progress is safe).")
			return
		end
		data = if saved ~= nil then Types.Reconcile(saved) else Types.DefaultData()
	else
		data = Types.DefaultData()
	end

	loading[player] = nil
	if not player.Parent then
		return -- left while loading
	end
	profiles[player] = data
	player:SetAttribute("DataLoaded", true)
	dirtySync[player] = true
	self.PlayerLoaded:Fire(player, data)
end

function DataService:_release(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	self.PlayerRemoving:Fire(player, data)
	self:SaveNow(player)
	profiles[player] = nil
	dirtySave[player] = nil
	dirtySync[player] = nil
end

function DataService:Get(player: Player): PlayerData?
	return profiles[player]
end

function DataService:WaitFor(player: Player, timeout: number?): PlayerData?
	local limit = timeout or 30
	local started = os.clock()
	while not profiles[player] and player.Parent and os.clock() - started < limit do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService:GetLoadedPlayers(): { Player }
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

function DataService:MarkDirty(player: Player)
	if profiles[player] then
		dirtySave[player] = true
		dirtySync[player] = true
	end
end

function DataService:AddCash(player: Player, amount: number, opts: { boostable: boolean?, source: string? }?): number
	local data = profiles[player]
	if not data or amount ~= amount or amount <= 0 then
		return 0
	end
	local final = amount
	if opts and opts.boostable then
		local boostService = Services.BoostService
		if boostService and boostService.GetCashMultiplier then
			final *= boostService:GetCashMultiplier(player)
		end
	end
	final = Format.RoundCents(final)
	data.cash = Format.RoundCents(data.cash + final)
	data.lifetimeCash = Format.RoundCents(data.lifetimeCash + final)
	self:MarkDirty(player)
	return final
end

function DataService:CanAfford(player: Player, amount: number): boolean
	local data = profiles[player]
	return data ~= nil and amount == amount and data.cash + 1e-6 >= amount
end

function DataService:SpendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or amount ~= amount or amount < 0 then
		return false
	end
	if data.cash + 1e-6 < amount then
		return false
	end
	data.cash = math.max(0, Format.RoundCents(data.cash - amount))
	self:MarkDirty(player)
	return true
end

-- Remember a processed purchase (MarketplaceService receipt idempotency).
function DataService:HasReceipt(player: Player, purchaseId: string): boolean
	local data = profiles[player]
	return data ~= nil and data.receipts[purchaseId] == true
end

function DataService:AddReceipt(player: Player, purchaseId: string)
	local data = profiles[player]
	if not data then
		return
	end
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > MAX_RECEIPTS do
		local oldest = table.remove(data.receiptOrder, 1)
		if oldest then
			data.receipts[oldest] = nil
		end
	end
	self:MarkDirty(player)
end

function DataService:SaveNow(player: Player): boolean
	local data = profiles[player]
	local activeStore = store
	if not data or not activeStore then
		return false
	end
	dirtySave[player] = nil
	local ok = withRetries("save " .. player.Name, function()
		activeStore:UpdateAsync(keyFor(player), function()
			return data
		end)
		return true
	end)
	if not ok then
		dirtySave[player] = true
	end
	return ok
end

function DataService:IsSaving(): boolean
	return store ~= nil
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ModeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ModeService
	Tracks what each player is doing and moves them between the three systems.

	Modes: "Base" (home map, default) | "Runner" | "Combat"
	The current mode is mirrored to the client as the Player attribute "Mode".
	Each player also gets a stable slot number (1..Config.MaxSlots) that picks
	their personal runner track and combat arena (see Layout).

	API (server):
		ModeService:GetMode(player): string
		ModeService:SetMode(player, mode)
		ModeService:GetSlot(player): number
		ModeService:Teleport(player, cframe): boolean
		ModeService:ReturnToBase(player)
		ModeService.ModeChanged: Signal(player, newMode, oldMode)
			Services that run sessions (runner, combat) listen to this and clean
			up when a player leaves their mode for any reason (death, leaving...).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local ModeService = {}
ModeService.Priority = 90
ModeService.ModeChanged = Signal.new()

local modes: { [Player]: string } = {}
local slots: { [Player]: number } = {}
local usedSlots: { [number]: Player } = {}
local lastBaseCFrame: { [Player]: CFrame } = {}

local function allocateSlot(player: Player): number
	for i = 1, Config.MaxSlots do
		if not usedSlots[i] then
			usedSlots[i] = player
			return i
		end
	end
	-- More players than slots: share the last slot (tracks/arenas are per-client visuals anyway).
	return Config.MaxSlots
end

function ModeService:Init(_registry: { [string]: any }) end

function ModeService:Start()
	local function onPlayer(player: Player)
		slots[player] = allocateSlot(player)
		modes[player] = "Base"
		player:SetAttribute("Mode", "Base")
		player:SetAttribute("Slot", slots[player])
		player.CharacterAdded:Connect(function(character)
			-- A respawn always lands you back at the base.
			if modes[player] ~= "Base" then
				self:SetMode(player, "Base")
			end
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					if modes[player] ~= "Base" then
						self:SetMode(player, "Base")
					end
				end)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local old = modes[player]
		if old and old ~= "Base" then
			self.ModeChanged:Fire(player, "Base", old)
		end
		local slot = slots[player]
		if slot and usedSlots[slot] == player then
			usedSlots[slot] = nil
		end
		modes[player] = nil
		slots[player] = nil
		lastBaseCFrame[player] = nil
	end)
end

function ModeService:GetMode(player: Player): string
	return modes[player] or "Base"
end

function ModeService:GetSlot(player: Player): number
	return slots[player] or 1
end

function ModeService:SetMode(player: Player, mode: string)
	local old = modes[player] or "Base"
	if old == mode then
		return
	end
	if old == "Base" then
		-- Remember where the player was so we can bring them back there.
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			lastBaseCFrame[player] = root.CFrame
		end
	end
	modes[player] = mode
	player:SetAttribute("Mode", mode)
	self.ModeChanged:Fire(player, mode, old)
end

function ModeService:Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	if not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(cframe + Vector3.new(0, 3.5, 0))
	return true
end

function ModeService:ReturnToBase(player: Player)
	local target = lastBaseCFrame[player]
	if not target then
		target = CFrame.new(Layout.SpawnPosition())
	end
	self:SetMode(player, "Base")
	self:Teleport(player, target)
end

return ModeService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpHeight">7.2</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="25">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HUDController
	Always-on HUD: cash pill (top-right, like both reference images), boost /
	status chips under it, the left-hand menu of card buttons (base only) and
	server toasts.

	API (other controllers, call from Start):
		HUD:AddMenuButton({
			Id = "Run", Title = "Army Run", Icon = "🏃", Order = 1,
			HeaderColor = Color3?, HeaderDarkColor = Color3?,
			OnClick = function() end,
			Visible = function(data) return true end,  -- optional, re-checked on every Sync
		}) -> TextButton
		HUD:AddStatusChip(id, color) -> { SetText(text), SetVisible(bool), Destroy() }
		HUD:Toast(text, kind?)
		HUD:GetGui() -> ScreenGui
		HUD:SetMenuVisible(visible)   -- e.g. hide while a big panel is open
]]

local Players = game:GetService("Players")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local P = Theme.Palette
local _player = Players.LocalPlayer

type MenuSpec = {
	Id: string,
	Title: string,
	Icon: string,
	Order: number?,
	HeaderColor: Color3?,
	HeaderDarkColor: Color3?,
	OnClick: () -> (),
	Visible: ((any) -> boolean)?,
}

type Chip = {
	SetText: (string) -> (),
	SetVisible: (boolean) -> (),
	Destroy: () -> (),
}

local HUD = {}
HUD.Priority = 80

local gui: ScreenGui
local menu: Frame
local chips: Frame
local setCash: (number) -> ()
local menuEntries: { { spec: MenuSpec, button: TextButton } } = {}
local menuForcedHidden = false

local function refreshMenu()
	local data = State.Get()
	local inBase = State.Mode() == "Base"
	menu.Visible = inBase and not menuForcedHidden
	for _, entry in menuEntries do
		local visible = true
		if entry.spec.Visible and data then
			local ok, result = pcall(entry.spec.Visible, data)
			visible = ok and result == true
		end
		entry.button.Visible = visible
	end
end

function HUD:Init(_registry: { [string]: any })
	gui = Theme.ScreenGui("HUD", 5)

	local topRight = Instance.new("Frame")
	topRight.Name = "TopRight"
	topRight.BackgroundTransparency = 1
	topRight.AnchorPoint = Vector2.new(1, 0)
	topRight.Position = UDim2.new(1, -18, 0, 16)
	topRight.Size = UDim2.fromOffset(250, 400)
	topRight.Parent = gui
	Theme.ResponsiveScale(topRight)
	local layout = Theme.List(topRight, "Vertical", 8, Enum.HorizontalAlignment.Right)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local pill, setter = Theme.CashPill({ LayoutOrder = 1, Parent = topRight })
	pill.Size = UDim2.fromOffset(240, 58)
	setCash = setter

	chips = Instance.new("Frame")
	chips.Name = "Chips"
	chips.BackgroundTransparency = 1
	chips.Size = UDim2.fromOffset(240, 300)
	chips.LayoutOrder = 2
	chips.Parent = topRight
	local chipLayout = Theme.List(chips, "Vertical", 6, Enum.HorizontalAlignment.Right)
	chipLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	menu = Instance.new("Frame")
	menu.Name = "Menu"
	menu.BackgroundTransparency = 1
	menu.AnchorPoint = Vector2.new(0, 0.5)
	menu.Position = UDim2.new(0, 16, 0.5, 0)
	menu.Size = UDim2.fromOffset(124, 640)
	menu.Parent = gui
	Theme.ResponsiveScale(menu)
	local menuLayout = Theme.List(menu, "Vertical", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	menuLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
end

function HUD:Start()
	local data = State.Get()
	if data then
		setCash(data.cash)
	end
	State.Changed:Connect(function(snapshot)
		setCash(snapshot.cash)
		refreshMenu()
	end)
	State.ModeChanged:Connect(refreshMenu)
	Net.On("Notify", function(text: string, kind: string?)
		Theme.Toast(text, kind)
	end)
	refreshMenu()
end

function HUD:GetGui(): ScreenGui
	return gui
end

function HUD:Toast(text: string, kind: string?)
	Theme.Toast(text, kind)
end

function HUD:SetMenuVisible(visible: boolean)
	menuForcedHidden = not visible
	refreshMenu()
end

-- Small card button: coloured header with the title, blue body with an icon.
function HUD:AddMenuButton(spec: MenuSpec): TextButton
	local button = Instance.new("TextButton")
	button.Name = spec.Id
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.Size = UDim2.fromOffset(118, 104)
	button.LayoutOrder = spec.Order or 10
	button.Parent = menu

	local card, body = Theme.Card({
		Title = spec.Title,
		HeaderColor = spec.HeaderColor or P.CardOrange,
		HeaderDarkColor = spec.HeaderDarkColor or P.CardOrangeDark,
		HeaderHeight = 30,
		TitleSize = 20,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	card.Active = false
	Theme.Label({
		Text = spec.Icon,
		MaxTextSize = 44,
		StrokeThickness = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = card.ZIndex + 3,
		Parent = body,
	})

	button.Activated:Connect(function()
		Theme.Pop(button)
		spec.OnClick()
	end)
	table.insert(menuEntries, { spec = spec, button = button })
	refreshMenu()
	return button
end

function HUD:AddStatusChip(id: string, color: Color3?): Chip
	local chip = Instance.new("Frame")
	chip.Name = id
	chip.BackgroundColor3 = color or P.OfferPurple
	chip.Size = UDim2.fromOffset(200, 38)
	chip.Visible = false
	chip.Parent = chips
	Theme.Corner(chip, 0.5)
	Theme.Stroke(chip, P.CardOutline, 2, true)
	local label = Theme.Label({
		Text = "",
		MaxTextSize = 22,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = chip,
	})
	return {
		SetText = function(text: string)
			label.Text = text
		end,
		SetVisible = function(visible: boolean)
			chip.Visible = visible
		end,
		Destroy = function()
			chip:Destroy()
		end,
	}
end

return HUD
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="27">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point.
	Every ModuleScript directly inside Client/Controllers is a controller:
		Controller.Priority (optional, higher = initialised first)
		Controller:Init(registry)  -- build UI, local state (no cross-controller calls)
		Controller:Start()         -- connect events, may call other controllers
	`registry` maps controller name -> controller table.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local clientFolder = script.Parent

-- Wait until the server has loaded our data (first Sync arrives right after).
local State = require(clientFolder:WaitForChild("State"))
State.Wait()

local controllersFolder = clientFolder:WaitForChild("Controllers")
local registry: { [string]: any } = {}
local ordered = {}

for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, controller = pcall(require, module)
		if ok and type(controller) == "table" then
			registry[module.Name] = controller
			table.insert(ordered, { name = module.Name, controller = controller })
		else
			warn(("[Client] failed to load %s: %s"):format(module.Name, tostring(controller)))
		end
	end
end

table.sort(ordered, function(a, b)
	local pa, pb = a.controller.Priority or 0, b.controller.Priority or 0
	if pa ~= pb then
		return pa > pb
	end
	return a.name < b.name
end)

for _, entry in ordered do
	if type(entry.controller.Init) == "function" then
		local ok, err = pcall(entry.controller.Init, entry.controller, registry)
		if not ok then
			warn(("[Client] %s:Init failed: %s"):format(entry.name, tostring(err)))
		end
	end
end

for _, entry in ordered do
	if type(entry.controller.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(entry.controller.Start, entry.controller)
			if not ok then
				warn(("[Client] %s:Start failed: %s"):format(entry.name, tostring(err)))
			end
		end)
	end
end

print(("[Client] %s started %d controllers"):format(player.Name, #ordered))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
--[[
	State (client)
	Latest PlayerData snapshot pushed by the server's DataService.

		local State = require(Client.State)
		State.Get()                -- PlayerData? (read-only, never mutate)
		State.Wait()               -- yields until the first snapshot
		State.Changed:Connect(function(data) ... end)
		State.Mode()               -- "Base" | "Runner" | "Combat"
		State.ModeChanged:Connect(function(newMode, oldMode) ... end)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local player = Players.LocalPlayer

local State = {}
State.Changed = Signal.new()
State.ModeChanged = Signal.new()

local data: Types.PlayerData? = nil
local currentMode: string = (player:GetAttribute("Mode") :: string?) or "Base"

Net.On("Sync", function(snapshot: Types.PlayerData)
	data = snapshot
	State.Changed:Fire(snapshot)
end)

player:GetAttributeChangedSignal("Mode"):Connect(function()
	local old = currentMode
	currentMode = (player:GetAttribute("Mode") :: string?) or "Base"
	if old ~= currentMode then
		State.ModeChanged:Fire(currentMode, old)
	end
end)

function State.Get(): Types.PlayerData?
	return data
end

function State.Wait(): Types.PlayerData
	if not data then
		task.spawn(function()
			-- Ask again in case the first push happened before we listened.
			while not data do
				Net.Request("RequestSync")
				task.wait(2)
			end
		end)
	end
	while not data do
		State.Changed:Wait()
	end
	return data :: Types.PlayerData
end

function State.Mode(): string
	return currentMode
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
