        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Economy
	Every price and income in the game, derived from ONE measured number: the
	best-case cash of the army runner. Pure (no services, no Instances),
	deterministic and memoized, so the server, the client and the Lune tests /
	scripts/simulate.luau all see the same numbers. Tunables: Shared/EconomyDefs.

	Public API (docs/ARCHITECTURE.md §4.1). `area` = index into Config.Areas.
		Economy.RunBenchmark(area): number           R(area): average best-case payout of the 10 benchmark runs
		Economy.TenRunBenchmark(area): number        B10(area): sum of the 10 best-case runs
		Economy.BenchmarkDetails(area): { upgradeLevel, runs = { { level, payout } }, total }
		Economy.ReferenceUpgrades(area): { troops, damage, capacity }
		Economy.SlotUnlockPrice(slotId): number      revenue section or the Combat Arena slot
		Economy.GatePrice(area): number              gate from `area` into `area + 1` (strictly increasing)
		Economy.SectionStats(slotId, level): { incomePerSale, saleInterval, stockCapacity, incomePerSecond }
		Economy.SectionMaxLevel: number
		Economy.SectionUpgradePrice(slotId, currentLevel): number?   nil at max level
		Economy.EmployeeCashPrice(slotId, playerHighestArea): number
		Economy.ReferencePassiveRate(area): number   $/s of all level-1 sections in areas <= area
		Economy.RunnerUpgradeMaxLevel: number
		Economy.RunnerUpgradePrice(kind, currentLevel): number?      kind = "troops" | "damage" | "capacity"
		Economy.RunnerStats(upgrades, area): { startTroops, damage, capacity }
		Economy.RunnerUpgradeEffect(kind, level): string             "+1 troop", "+4% damage", "+6% carry", "MAX"
		Economy.BoostValue(boostId, playerArea): number
		Economy.BoostCoinPrice(boostId, playerArea): number
		Economy.VehicleCoinPrice(vehicleId, playerArea): number
		Economy.CombatLevelReward(level): number
		Economy.BarrierCombatLevel(area): number
		Economy.EquipmentUpgradePrice(rarity, currentLevel): number? nil at the rarity's max level
		Economy.RunDurationSeconds(): number
	Extras (not in the contract, handy for UIs and tools):
		Economy.SlotArea(slotId): number?            area index of a slot id
		Economy.AreaUnlockTotal(area): number        all 4 slots + the exit gate of an area
	Economy.TimeSkipPayout(sections, seconds): (total, perSlot)
	                                             what a time skip of `seconds` pays the player's
	                                             sections RIGHT NOW (data.base.sections);
	                                             perSlot[slotId] = { paid, sales, stockUsed }
	Economy.TimeSkipValue(boostId, playerArea, preview): number
	                                             min(BoostValue, preview): value used for the price
	Economy.TimeSkipCoinPrice(boostId, playerArea, preview): number
	                                             (1 - NetGainShare) x TimeSkipValue, rounded DOWN
	                                             to whole dollars (never more than 0.8 x preview)
	Economy.TimeSkipWorthOffering(boostId, playerArea, preview): boolean
	                                             random offers only show a time skip when the preview
	                                             is >= TimeSkipOfferMinShare (25%) of its reference
	Economy.TimeSkipOfferMinShare: number
		Economy._ClearCache()                        tests: forget memoized values (e.g. after
		                                             switching Config.Benchmark.Mode)

	Definitions (answers to the brief's open questions; all [PROPOSAL]):
	* 10-run benchmark (question 3): the benchmark runs of area a are the courses
	  (a, L0 .. L0+9) with L0 = 1 + 10*(a-1). Each is solved EXACTLY with
	  RunnerSim.BestCase using the reference player of that area:
	  ReferenceUpgrades(a) = every permanent upgrade at level
	  (a-1) * Config.Benchmark.ReferenceUpgradeLevelsPerArea.
	  B10(a) = sum of the 10 best-case payouts, R(a) = B10(a) / 10.
	* "Three area upgrades" = the first three revenue sections of an area,
	  following Config.Benchmark.Mode:
	    "CombinedSections" -> the three together cost B10 (split by income weight).
	    "EachSection"      -> each of the three costs B10.
	  The 4th revenue section costs the same $ per income weight as the first
	  three; the Combat Arena slot (a2s4) costs EconomyDefs.Slots.ArenaShare x B10.
	* Gate a -> a+1 costs GateShare x B10(a), and always more than the gate before.
	* Employee cash price (question 4): Config.Employee.RunsEquivalent (20) x R,
	  i.e. 20 best-case benchmark runs of the section's area ("SectionArea") or
	  of the player's highest area ("PlayerArea").
	* Sections: a full area of level-1 sections earns PassiveShare (39%) of the
	  active runner rate R / RunDurationSeconds().
	* Boost value V ("used properly", question 10): a 2x multiplier doubles your
	  earnings while you play runs for its duration -> extra = minutes*60 /
	  RunDurationSeconds() x R(area). A time skip's REFERENCE value is
	  hours*3600 x ReferencePassiveRate(area) (every shop of every area owned,
	  all with employees). Coin price = (1 - NetGainShare) x V = 0.8 V:
	  80% less net gain than the Robux route, still +25% return.
	* Time skip cash price: a skip only pays what the player's own shops
	  would earn (sections without an employee stop when their stock runs
	  out), so the price uses V = min(reference, TimeSkipPayout preview) and a
	  cash time skip ALWAYS returns +25% of what was paid.
	* Vehicles: priceFactor x GatePrice(max(playerArea, vehicle.area)).
	* Combat: the barrier of area a is combat level 3a-1. A perfect clear of a
	  combat level pays ~3 best-case runs of the area the level belongs to
	  (geometric interpolation between areas, strictly increasing).
	Money is WHOLE dollars everywhere (owner request: no cents). Every price,
	payout, income per sale and reward this module returns is a whole number:
	  * plain prices (slots, gates, upgrades, vehicles, employees) are rounded
	    to the nearest dollar (Format.RoundWhole), at least $1; the first three
	    sections of an area are split with largest-remainder rounding so they
	    still sum EXACTLY to B10, and each gate is at least ceil(5%) dearer;
	  * the 80%-rule coin prices (boosts, time skips) are rounded DOWN, so
	    value / price stays >= 1.25;
	  * a section's incomePerSale is max(1, RoundWhole(x)) and its saleInterval
	    is stretched by (rounded / x), so incomePerSecond is unchanged; its
	    stockCapacity is scaled by (x / rounded) (whole sales, at least 5), so
	    a full stock still lasts the designed StockCapacity x SaleInterval.
	Rates per second (incomePerSecond, ReferencePassiveRate) stay fractional.
]]

local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config"))
local EconomyDefs = require(Shared:WaitForChild("EconomyDefs"))
local Format = require(Shared:WaitForChild("Format"))
local Types = require(Shared:WaitForChild("Types"))
local RunnerFolder = Shared:WaitForChild("Runner")
local RunnerCourse = require(RunnerFolder:WaitForChild("RunnerCourse"))
local RunnerDefs = require(RunnerFolder:WaitForChild("RunnerDefs"))
local RunnerSim = require(RunnerFolder:WaitForChild("RunnerSim"))

export type BenchmarkRun = { level: number, payout: number }
export type BenchmarkDetails = { upgradeLevel: number, runs: { BenchmarkRun }, total: number }
export type Upgrades = { troops: number, damage: number, capacity: number }
export type RunnerStats = { startTroops: number, damage: number, capacity: number }
type SectionState = Types.SectionState
export type TimeSkipSlot = { paid: number, sales: number, stockUsed: number }
export type SectionStats =
	{ incomePerSale: number, saleInterval: number, stockCapacity: number, incomePerSecond: number }

type SlotInfo = { area: number, index: number, def: Config.SlotDef }

local Economy = {}

Economy.SectionMaxLevel = EconomyDefs.Sections.MaxLevel
Economy.RunnerUpgradeMaxLevel = EconomyDefs.Runner.MaxLevel

local AREA_COUNT = #Config.Areas
local round = Format.RoundWhole

-- A whole-dollar price of at least $1.
local function price(value: number): number
	return math.max(1, round(value))
end

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local function num(value: any, fallback: number): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return value
end

-- Any area >= 1 (benchmarks beyond the last area are extrapolated).
local function anyArea(area: any): number
	return math.max(1, math.floor(num(area, 1)))
end

-- An area that exists in Config.Areas.
local function realArea(area: any): number
	return math.clamp(math.floor(num(area, 1)), 1, AREA_COUNT)
end

-- Slot id -> where it is.
local slotLookup: { [string]: SlotInfo } = {}
for areaIndex, areaDef in Config.Areas do
	for slotIndex, slotDef in areaDef.slots do
		slotLookup[slotDef.id] = { area = areaIndex, index = slotIndex, def = slotDef }
	end
end

local boostLookup: { [string]: Config.BoostDef } = {}
for _, boost in Config.Boosts do
	boostLookup[boost.id] = boost
end

local vehicleLookup: { [string]: Config.VehicleDef } = {}
for _, vehicle in Config.Vehicles do
	vehicleLookup[vehicle.id] = vehicle
end

-- Memo tables (cleared by Economy._ClearCache).
local benchCache: { [number]: BenchmarkDetails } = {}
local gateCache: { [number]: number } = {}

function Economy._ClearCache()
	table.clear(benchCache)
	table.clear(gateCache)
end

function Economy.SlotArea(slotId: string): number?
	local info = slotLookup[slotId]
	return if info then info.area else nil
end

function Economy.RunDurationSeconds(): number
	-- Running time to the enemy base + menus / summary overhead.
	return RunnerDefs.BOSS_DISTANCE / RunnerDefs.RUN_SPEED + RunnerDefs.RUN_OVERHEAD_SECONDS
end

-------------------------------------------------------------------------------
-- Permanent runner upgrades
-------------------------------------------------------------------------------
local function referenceLevel(area: number): number
	local perArea = num(Config.Benchmark.ReferenceUpgradeLevelsPerArea, 0)
	return math.clamp(math.floor((anyArea(area) - 1) * perArea), 0, EconomyDefs.Runner.MaxLevel)
end

function Economy.ReferenceUpgrades(area: number): Upgrades
	local level = referenceLevel(area)
	return { troops = level, damage = level, capacity = level }
end

local function upgradeLevel(value: any): number
	return math.clamp(math.floor(num(value, 0)), 0, EconomyDefs.Runner.MaxLevel)
end

-- [PROPOSAL] Base capacity grows with the area (AreaScale) but is divided by
-- the reference player's capacity bonus, so a reference-upgraded player can
-- carry about BaseCapacity x AreaScale^(a-1) in every area: the bag stays a
-- real limit everywhere and capacity upgrades keep mattering.
local function baseCapacity(area: number): number
	local d = EconomyDefs.Runner
	local a = anyArea(area)
	return d.BaseCapacity * EconomyDefs.AreaScale ^ (a - 1) / (1 + d.CapacityPerLevel * referenceLevel(a))
end

function Economy.RunnerStats(upgrades: Upgrades, area: number): RunnerStats
	local d = EconomyDefs.Runner
	local u: any = if type(upgrades) == "table" then upgrades else {}
	local troops = upgradeLevel(u.troops)
	local damage = upgradeLevel(u.damage)
	local capacity = upgradeLevel(u.capacity)
	return {
		startTroops = d.BaseTroops + troops * d.TroopsPerLevel,
		damage = Format.RoundCents(d.BaseDamage * (1 + d.DamagePerLevel * damage)), -- a stat, not money
		capacity = round(baseCapacity(area) * (1 + d.CapacityPerLevel * capacity)), -- whole dollars
	}
end

function Economy.RunnerUpgradeEffect(kind: string, level: number): string
	if upgradeLevel(level) >= EconomyDefs.Runner.MaxLevel then
		return "MAX"
	end
	local d = EconomyDefs.Runner
	if kind == "troops" then
		return "+" .. d.TroopsPerLevel .. (if d.TroopsPerLevel == 1 then " troop" else " troops")
	elseif kind == "damage" then
		return "+" .. math.floor(d.DamagePerLevel * 100 + 0.5) .. "% damage"
	elseif kind == "capacity" then
		return "+" .. math.floor(d.CapacityPerLevel * 100 + 0.5) .. "% carry"
	end
	return ""
end

-------------------------------------------------------------------------------
-- The 10-run benchmark
-------------------------------------------------------------------------------
local function simulateArea(area: number): BenchmarkDetails
	local stats = Economy.RunnerStats(Economy.ReferenceUpgrades(area), area)
	local first = RunnerDefs.FirstLevelOfArea(area)
	local runs: { BenchmarkRun } = {}
	local total = 0
	for i = 0, num(Config.Benchmark.Runs, 10) - 1 do
		local course = RunnerCourse.Generate(area, first + i)
		local result = RunnerSim.BestCase(course, {
			startTroops = stats.startTroops,
			damage = stats.damage,
			capacity = stats.capacity,
		})
		table.insert(runs, { level = first + i, payout = result.total })
		total += result.total
	end
	return { upgradeLevel = referenceLevel(area), runs = runs, total = round(total) }
end

local function details(area: number): BenchmarkDetails
	local a = anyArea(area)
	local cached = benchCache[a]
	if cached then
		return cached
	end
	local result: BenchmarkDetails
	if a <= AREA_COUNT or AREA_COUNT < 2 then
		result = simulateArea(a)
	else
		-- [PROPOSAL] Beyond the last area (only combat levels reach here) grow
		-- by the same ratio as the last two real areas.
		local last = details(AREA_COUNT)
		local before = details(AREA_COUNT - 1)
		local ratio = math.max(1.05, last.total / math.max(0.01, before.total))
		local factor = ratio ^ (a - AREA_COUNT)
		local runs: { BenchmarkRun } = {}
		local total = 0
		for i, run in last.runs do
			local payout = round(run.payout * factor)
			table.insert(runs, { level = RunnerDefs.FirstLevelOfArea(a) + i - 1, payout = payout })
			total += payout
		end
		result = { upgradeLevel = referenceLevel(a), runs = runs, total = round(total) }
	end
	benchCache[a] = result
	return result
end

function Economy.BenchmarkDetails(area: number): BenchmarkDetails
	local d = details(area)
	local runs: { BenchmarkRun } = {}
	for _, run in d.runs do
		table.insert(runs, { level = run.level, payout = run.payout })
	end
	return { upgradeLevel = d.upgradeLevel, runs = runs, total = d.total }
end

function Economy.TenRunBenchmark(area: number): number
	return details(area).total
end

function Economy.RunBenchmark(area: number): number
	local d = details(area)
	return round(d.total / math.max(1, #d.runs))
end

-------------------------------------------------------------------------------
-- Slots, gates, sections
-------------------------------------------------------------------------------
-- The first three revenue slots of an area (in slot order), and the sum of
-- their income weights.
local function firstThree(area: number): ({ [string]: boolean }, number, { Config.SlotDef })
	local set: { [string]: boolean } = {}
	local list: { Config.SlotDef } = {}
	local weight = 0
	for _, slotDef in Config.Areas[area].slots do
		if slotDef.kind == "revenue" and #list < 3 then
			set[slotDef.id] = true
			table.insert(list, slotDef)
			weight += slotDef.incomeWeight
		end
	end
	return set, weight, list
end

-- Split a whole-dollar `total` over `weights` with largest-remainder rounding:
-- every share is whole and they sum EXACTLY to `total` (ties -> earlier index).
local function splitWhole(total: number, weights: { number }): { number }
	local sum = 0
	for _, w in weights do
		sum += math.max(0, w)
	end
	local out: { number } = {}
	local order: { { index: number, frac: number } } = {}
	local given = 0
	for index, w in weights do
		local exact = if sum > 0 then total * math.max(0, w) / sum else total / #weights
		local whole = math.floor(exact + 1e-9)
		out[index] = whole
		given += whole
		table.insert(order, { index = index, frac = exact - whole })
	end
	table.sort(order, function(a, b)
		if math.abs(a.frac - b.frac) > 1e-9 then
			return a.frac > b.frac
		end
		return a.index < b.index
	end)
	local left = math.floor(total - given + 0.5)
	for i = 1, math.max(0, left) do
		local entry = order[(i - 1) % #order + 1]
		out[entry.index] += 1
	end
	return out
end

function Economy.SlotUnlockPrice(slotId: string): number
	local info = slotLookup[slotId]
	if not info then
		return math.huge -- unknown slot: can never be bought
	end
	local b10 = Economy.TenRunBenchmark(info.area)
	if info.def.kind ~= "revenue" then
		return price(EconomyDefs.Slots.ArenaShare * b10)
	end
	local set, weightOfThree, three = firstThree(info.area)
	local w = info.def.incomeWeight
	if Config.Benchmark.Mode == "EachSection" then
		if set[slotId] then
			return price(b10)
		end
		-- 4th revenue section: B10 per average weight of the first three.
		return price(b10 * w / math.max(0.01, weightOfThree / 3))
	end
	-- "CombinedSections" (default): the first three cost B10 together
	-- (whole dollars that still add up to exactly B10).
	if set[slotId] then
		local weights: { number } = {}
		local mine = 1
		for index, slotDef in three do
			weights[index] = slotDef.incomeWeight
			if slotDef.id == slotId then
				mine = index
			end
		end
		return math.max(1, splitWhole(b10, weights)[mine])
	end
	return price(b10 * w / math.max(0.01, weightOfThree))
end

function Economy.GatePrice(area: number): number
	local a = anyArea(area)
	local cached = gateCache[a]
	if cached then
		return cached
	end
	local gate = price(EconomyDefs.Slots.GateShare * Economy.TenRunBenchmark(a))
	if a > 1 then
		-- Rounded UP: always at least GateMinStep dearer than the gate before.
		local previous = Economy.GatePrice(a - 1)
		gate = math.max(gate, math.ceil(previous * EconomyDefs.Slots.GateMinStep - 1e-9), previous + 1)
	end
	gateCache[a] = gate
	return gate
end

function Economy.AreaUnlockTotal(area: number): number
	local a = realArea(area)
	local total = 0
	for _, slotDef in Config.Areas[a].slots do
		total += Economy.SlotUnlockPrice(slotDef.id)
	end
	return total + Economy.GatePrice(a)
end

local NO_INCOME: SectionStats = { incomePerSale = 0, saleInterval = 5, stockCapacity = 0, incomePerSecond = 0 }
-- [PROPOSAL] A section always holds at least this many sales (safety floor;
-- the real defs never come close: the smallest stock is about 18).
local MIN_STOCK = 5

function Economy.SectionStats(slotId: string, level: number): SectionStats
	local info = slotLookup[slotId]
	if not info or info.def.kind ~= "revenue" then
		return table.clone(NO_INCOME)
	end
	local d = EconomyDefs.Sections
	local lvl = math.clamp(math.floor(num(level, 1)), 1, d.MaxLevel)
	local areaWeight = 0
	for _, slotDef in Config.Areas[info.area].slots do
		if slotDef.kind == "revenue" then
			areaWeight += slotDef.incomeWeight
		end
	end
	local activeRate = Economy.RunBenchmark(info.area) / Economy.RunDurationSeconds()
	local levelOneRate = d.PassiveShare * activeRate * info.def.incomeWeight / math.max(0.01, areaWeight)
	local designedInterval = d.SaleInterval[info.index] or d.SaleInterval[#d.SaleInterval]
	local baseStock = d.StockCapacity[info.index] or d.StockCapacity[#d.StockCapacity]
	-- Designed sales per full stock at the designed interval (+10% per level).
	local designedStock = baseStock * (1 + d.StockPerLevel * (lvl - 1))
	-- Whole dollars per sale; the interval stretches by (rounded / exact) so
	-- the income per second stays exactly the designed rate.
	local rate = levelOneRate * (1 + d.IncomePerLevel * (lvl - 1))
	local exact = rate * designedInterval
	local perSale = math.max(1, round(exact))
	local interval = designedInterval
	if exact > 0 then
		interval = designedInterval * perSale / exact
	end
	-- The number of sales in a full stock scales the other way, so a full
	-- stock still lasts the designed designedStock x designedInterval seconds
	-- (restock rhythm unchanged by the rounding; upgrades make it last longer).
	local stock = math.max(MIN_STOCK, round(designedStock * designedInterval / interval))
	return {
		incomePerSale = perSale,
		saleInterval = interval,
		stockCapacity = stock,
		incomePerSecond = perSale / interval,
	}
end

function Economy.SectionUpgradePrice(slotId: string, currentLevel: number): number?
	local info = slotLookup[slotId]
	if not info or info.def.kind ~= "revenue" then
		return nil
	end
	local d = EconomyDefs.Sections
	local lvl = math.max(1, math.floor(num(currentLevel, 1)))
	if lvl >= d.MaxLevel then
		return nil
	end
	return price(Economy.SlotUnlockPrice(slotId) * d.UpgradeBaseShare * d.UpgradeGrowth ^ (lvl - 1))
end

function Economy.ReferencePassiveRate(area: number): number
	local total = 0
	for a = 1, realArea(area) do
		for _, slotDef in Config.Areas[a].slots do
			if slotDef.kind == "revenue" then
				total += Economy.SectionStats(slotDef.id, 1).incomePerSecond
			end
		end
	end
	return total
end

function Economy.EmployeeCashPrice(slotId: string, playerHighestArea: number): number
	local info = slotLookup[slotId]
	local area: number
	if info and Config.Employee.PriceScalesWith ~= "PlayerArea" then
		area = info.area
	else
		area = realArea(playerHighestArea)
	end
	return price(num(Config.Employee.RunsEquivalent, 20) * Economy.RunBenchmark(area))
end

-------------------------------------------------------------------------------
-- Runner upgrade prices
-------------------------------------------------------------------------------
function Economy.RunnerUpgradePrice(kind: string, currentLevel: number): number?
	local d = EconomyDefs.Runner
	local factor = (d.KindPriceFactor :: { [string]: number })[kind]
	if factor == nil then
		return nil
	end
	local lvl = math.max(0, math.floor(num(currentLevel, 0)))
	if lvl >= d.MaxLevel then
		return nil
	end
	return price(d.BasePriceShare * Economy.RunBenchmark(1) * d.PriceGrowth ^ lvl * factor)
end

-------------------------------------------------------------------------------
-- Boosts and vehicles
-------------------------------------------------------------------------------
function Economy.BoostValue(boostId: string, playerArea: number): number
	local boost = boostLookup[boostId]
	if not boost then
		return 0
	end
	local area = realArea(playerArea)
	if boost.kind == "multiplier" then
		local seconds = num(boost.minutes, 0) * 60
		return round(seconds / Economy.RunDurationSeconds() * Economy.RunBenchmark(area))
	elseif boost.kind == "timeskip" then
		local seconds = num(boost.hours, 0) * 3600
		return round(seconds * Economy.ReferencePassiveRate(area))
	end
	return 0
end

function Economy.BoostCoinPrice(boostId: string, playerArea: number): number
	if not boostLookup[boostId] then
		return math.huge -- unknown boost: can never be bought
	end
	-- Rounded DOWN (value / price >= 1.25), at least $1.
	local share = 1 - num(Config.CoinRoute.NetGainShare, 0.2)
	return math.max(1, math.floor(share * Economy.BoostValue(boostId, playerArea) + 1e-6))
end

-- What a time skip of `seconds` pays the given sections right now
-- (docs/ARCHITECTURE.md §6.2). Per unlocked revenue section:
-- sales = floor(seconds / saleInterval); with an employee every sale is paid,
-- without one only min(sales, floor(stock)) (the stock runs out). Pure: the
-- caller (BaseService) applies the stock decrement. Not 2x-boosted.
function Economy.TimeSkipPayout(
	sections: { [string]: SectionState },
	seconds: number
): (number, { [string]: TimeSkipSlot })
	local perSlot: { [string]: TimeSkipSlot } = {}
	local s = num(seconds, 0)
	if s <= 0 or type(sections) ~= "table" then
		return 0, perSlot
	end
	local total = 0
	for slotId, section in sections do
		local info = slotLookup[slotId]
		if type(section) ~= "table" or not info or info.def.kind ~= "revenue" then
			continue
		end
		local stats = Economy.SectionStats(slotId, section.level)
		if stats.saleInterval <= 0 then
			continue
		end
		-- 1e-9: 3600 / 4.6 style divisions never lose a whole sale to float noise.
		local sales = math.floor(s / stats.saleInterval + 1e-9)
		local stockUsed = 0
		if section.employee ~= true then
			sales = math.min(sales, math.max(0, math.floor(num(section.stock, 0))))
			stockUsed = sales
		end
		if sales > 0 then
			local paid = sales * stats.incomePerSale -- whole: incomePerSale is whole
			total += paid
			perSlot[slotId] = { paid = paid, sales = sales, stockUsed = stockUsed }
		end
	end
	return total, perSlot
end

-- [PROPOSAL] Value of a time skip for pricing: what it would pay right now
-- (`preview`, from TimeSkipPayout), capped at the area reference.
function Economy.TimeSkipValue(boostId: string, playerArea: number, preview: number): number
	local boost = boostLookup[boostId]
	if not boost or boost.kind ~= "timeskip" then
		return 0
	end
	-- Whole dollars, rounded down (never more than the preview pays).
	return math.floor(math.min(Economy.BoostValue(boostId, playerArea), math.max(0, num(preview, 0))) + 1e-6)
end

-- [PROPOSAL] Cash price of a time skip = (1 - NetGainShare) x TimeSkipValue,
-- rounded DOWN to whole dollars so it never exceeds 0.8 x what it pays. 0 = it pays
-- (almost) nothing and must not be sold. Unknown / non-skip boost -> math.huge.
function Economy.TimeSkipCoinPrice(boostId: string, playerArea: number, preview: number): number
	local boost = boostLookup[boostId]
	if not boost or boost.kind ~= "timeskip" then
		return math.huge
	end
	local share = 1 - num(Config.CoinRoute.NetGainShare, 0.2)
	return math.floor(share * Economy.TimeSkipValue(boostId, playerArea, preview) + 1e-6)
end

-- [PROPOSAL] A random offer only shows a time skip when it would pay at
-- least this share of its reference value (so offers are worth buying).
Economy.TimeSkipOfferMinShare = 0.25

function Economy.TimeSkipWorthOffering(boostId: string, playerArea: number, preview: number): boolean
	local boost = boostLookup[boostId]
	if not boost or boost.kind ~= "timeskip" then
		return false
	end
	local reference = Economy.BoostValue(boostId, playerArea)
	local p = num(preview, 0)
	return p >= 1 and p + 1e-6 >= Economy.TimeSkipOfferMinShare * reference
end

function Economy.VehicleCoinPrice(vehicleId: string, playerArea: number): number
	local vehicle = vehicleLookup[vehicleId]
	if not vehicle then
		return math.huge -- unknown vehicle: can never be bought
	end
	local area = math.max(realArea(playerArea), realArea(vehicle.area))
	return price(vehicle.priceFactor * Economy.GatePrice(area))
end

-------------------------------------------------------------------------------
-- Combat and equipment
-------------------------------------------------------------------------------
function Economy.BarrierCombatLevel(area: number): number
	local c = EconomyDefs.Combat
	return math.max(1, c.BarrierLevelsPerArea * anyArea(area) + c.BarrierLevelOffset)
end

-- R on a continuous area scale: R(a) at whole numbers, geometric in between.
local function smoothBenchmark(x: number): number
	local lower = math.max(1, math.floor(x))
	local r1 = Economy.RunBenchmark(lower)
	local r2 = Economy.RunBenchmark(lower + 1)
	local ratio = math.max(1.05, r2 / math.max(0.01, r1))
	return r1 * ratio ^ (x - lower)
end

function Economy.CombatLevelReward(level: number): number
	local c = EconomyDefs.Combat
	local lvl = math.max(1, math.floor(num(level, 1)))
	-- Level L sits at "area position" x where the barrier level of area a maps to x = a.
	local x = (lvl - c.BarrierLevelOffset) / c.BarrierLevelsPerArea
	return math.max(1, round(c.RewardRuns * smoothBenchmark(x)))
end

function Economy.EquipmentUpgradePrice(rarity: number, currentLevel: number): number?
	local d = EconomyDefs.Equipment
	local r = math.clamp(math.floor(num(rarity, 1)), 1, #Config.Rarities)
	local lvl = math.max(1, math.floor(num(currentLevel, 1)))
	if lvl >= Config.Rarities[r].maxLevel then
		return nil
	end
	local factor = d.RarityFactor[r] or d.RarityFactor[#d.RarityFactor]
	return price(d.BaseShare * Economy.RunBenchmark(1) * d.Growth ^ (lvl - 1) * factor)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">EconomyDefs</string>
          <string name="Source"><![CDATA[--!strict
--[[
	EconomyDefs
	Every balancing number of the economy in one place: area scaling, runner
	upgrades, slot/gate price shares, section incomes, combat rewards and
	equipment upgrade prices. Shared/Economy.luau turns these into prices.

	Pure data (no services, no Instances) so it loads in the Lune test runner.
	Values marked [PROPOSAL] are design assumptions: change them here, then run
	`lune run scripts/simulate` to regenerate docs/ECONOMY_TABLES.md.

	Public API (read-only constants):
		EconomyDefs.AreaScale                    cash values grow x1.6 per area
		EconomyDefs.Runner                       permanent runner upgrade numbers
		EconomyDefs.Slots                        slot / gate price shares of B10
		EconomyDefs.Sections                     revenue section income, stock, upgrades
		EconomyDefs.Combat                       combat level rewards and barrier levels
		EconomyDefs.Equipment                    equipment upgrade prices
]]

local EconomyDefs = {}

-- [PROPOSAL] Every cash value on a runner course (troop value, cash stacks,
-- weapon values, enemy and boss rewards) is multiplied by AreaScale^(area - 1)
-- and rounded to whole dollars (no cents anywhere).
-- Prices are derived from the runner benchmark, so they follow automatically.
EconomyDefs.AreaScale = 1.6

-------------------------------------------------------------------------------
-- Permanent runner upgrades (bought before a run) [REQUIREMENT: small steps]
-------------------------------------------------------------------------------
EconomyDefs.Runner = {
	MaxLevel = 50, -- [PROPOSAL]
	BaseTroops = 3, -- [PROPOSAL] troops at level 0 (the avatar + 2)
	TroopsPerLevel = 1, -- [PROPOSAL] "+1 troop" per level
	BaseDamage = 10, -- [PROPOSAL] damage of one troop at level 0
	DamagePerLevel = 0.04, -- [PROPOSAL] +4% of base damage per level
	BaseCapacity = 60, -- [PROPOSAL] $ you can carry on the track in area 1 (x AreaScale per area, whole $)
	-- [owner request] +20% of base capacity per level (was +6%: "increase the
	-- upgrade amount of coins so it's easier to progress"). Prices do not move:
	-- Economy divides the base by the reference player's bonus, so the
	-- benchmark bag is unchanged and every bought level beats it by more.
	CapacityPerLevel = 0.2,
	-- Price of level 0 -> 1 as a share of R(1) (one best-case area-1 run),
	-- then x PriceGrowth for every further level.
	BasePriceShare = 0.4, -- [PROPOSAL]
	PriceGrowth = 1.17, -- [PROPOSAL]
	KindPriceFactor = { troops = 1.0, damage = 1.0, capacity = 0.9 }, -- [PROPOSAL]
}

-------------------------------------------------------------------------------
-- Slot (section) unlock prices and gate prices, as shares of B10
-------------------------------------------------------------------------------
-- B10(area) = best-case cash of the 10 benchmark runs of that area.
-- "CombinedSections" (Config.Benchmark.Mode default): the first three revenue
--     sections of an area cost B10 TOGETHER, split in proportion to their
--     income weights (so every section repays itself in the same time).
-- "EachSection": each of the first three revenue sections costs B10.
-- The 4th revenue section is priced at the same $ per income weight as the
-- first three. The Combat Arena (a2s4, no income weight) costs ArenaShare x B10.
EconomyDefs.Slots = {
	ArenaShare = 0.6, -- [PROPOSAL]
	GateShare = 1.3, -- [PROPOSAL] gate from area a into a+1 costs 1.3 x B10(a)
	GateMinStep = 1.05, -- each gate costs at least 5% more than the previous one
}

-------------------------------------------------------------------------------
-- Revenue sections
-------------------------------------------------------------------------------
EconomyDefs.Sections = {
	MaxLevel = 10, -- [PROPOSAL]
	-- [PROPOSAL] A full area of level-1 sections earns this share of the active
	-- runner rate R(area) / RunDurationSeconds(). With CombinedSections prices a
	-- level-1 section then repays its unlock price in ~40 minutes of stocked running.
	-- (0.32 -> 0.36 when the castle boss fight made a run ~7 s longer, -> 0.39 when
	-- the boss intro / outro (~5.4 s) were counted in RunDurationSeconds: the share
	-- grows with the run length so the section $/s and the payback stay the same.)
	PassiveShare = 0.39,
	-- Designed seconds between sales, by slot index 1..4 (bigger shops sell less
	-- often but more per sale). Economy.SectionStats stretches or shrinks this so
	-- every sale is whole dollars (income per second stays exact).
	SaleInterval = { 4, 4.6, 5.2, 5.8 }, -- [PROPOSAL]
	-- Designed sales per full stock at the designed SaleInterval, by slot index:
	-- a full level-1 stock lasts StockCapacity x SaleInterval = 100 / 133 / 172 / 215 s
	-- (about 1.7-3.6 minutes) before a manual restock. SectionStats rescales the
	-- number of sales with the real interval so a full stock still lasts that long.
	StockCapacity = { 25, 29, 33, 37 }, -- [PROPOSAL]
	IncomePerLevel = 0.2, -- [PROPOSAL] +20% of level-1 income per upgrade level
	StockPerLevel = 0.1, -- [PROPOSAL] +10% of level-1 stock duration per upgrade level
	UpgradeBaseShare = 0.35, -- [PROPOSAL] level 1 -> 2 costs 35% of the unlock price
	UpgradeGrowth = 1.5, -- [PROPOSAL] each further level costs x1.5
}

-------------------------------------------------------------------------------
-- Combat
-------------------------------------------------------------------------------
EconomyDefs.Combat = {
	-- [PROPOSAL] barrier squad on area a's exit gate = combat level 3a - 1
	-- (area 1 -> level 2, area 2 -> level 5, area 3 -> level 8, ...).
	BarrierLevelsPerArea = 3,
	BarrierLevelOffset = -1,
	-- [PROPOSAL] a perfect clear of a combat level pays about this many best-case
	-- runner runs of the area the level belongs to (it takes a few minutes).
	RewardRuns = 3,
}

-------------------------------------------------------------------------------
-- Equipment upgrades (coins spent on armour / weapons from chests)
-------------------------------------------------------------------------------
EconomyDefs.Equipment = {
	BaseShare = 0.5, -- [PROPOSAL] level 1 -> 2 of a Common item costs 0.5 x R(1)
	Growth = 1.15, -- [PROPOSAL] x1.15 per level
	RarityFactor = { 1.0, 1.5, 2.2, 3.2, 4.5 }, -- [PROPOSAL] Common .. Legendary
}

return EconomyDefs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Format
	Number / time formatting shared by every UI.
]]

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function withCommas(integer: number): string
	local s = tostring(math.floor(math.abs(integer)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

-- Short number: 950 -> "950", 1520 -> "1.52K", 2500000 -> "2.5M".
function Format.Short(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local text: string
	if n < 1000 then
		text = if n == math.floor(n) then tostring(n) else string.format("%.1f", n)
	else
		local index = math.min(math.floor(math.log10(n) / 3), #SUFFIXES)
		local scaled = n / 10 ^ (index * 3)
		local digits = if scaled < 10 then "%.2f" elseif scaled < 100 then "%.1f" else "%.0f"
		text = string.format(digits, scaled):gsub("%.?0+$", "") .. SUFFIXES[index]
	end
	return (if negative then "-" else "") .. text
end

-- Money in whole dollars (no cents, owner request): "$0", "$1,563", then "$1.25M".
function Format.Money(n: number): string
	local negative = n < 0
	n = math.abs(n)
	local text: string
	if n < 1e6 then
		text = withCommas(math.floor(n + 0.5))
	else
		text = Format.Short(n)
	end
	return (if negative then "-$" else "$") .. text
end

function Format.Robux(n: number): string
	return "R$ " .. withCommas(n)
end

-- 75 -> "1:15", 3700 -> "1:01:40"
function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 90 -> "1m 30s", 7200 -> "2h", 5400 -> "1h 30m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return if m > 0 then string.format("%dh %dm", h, m) else string.format("%dh", h)
	elseif m > 0 then
		return if s > 0 then string.format("%dm %ds", m, s) else string.format("%dm", m)
	end
	return string.format("%ds", s)
end

function Format.Percent(fraction: number): string
	local p = fraction * 100
	if p == math.floor(p) then
		return string.format("%d%%", p)
	end
	return string.format("%.1f%%", p)
end

-- Round to cents (only for intermediate maths such as rates per second).
function Format.RoundCents(n: number): number
	return math.floor(n * 100 + 0.5) / 100
end

-- Round money to whole dollars. Every price, payout and stored cash value
-- goes through this (owner request: no cents anywhere).
function Format.RoundWhole(n: number): number
	return math.floor(n + 0.5)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Layout
	Single source of truth for world-space positions so that the server
	(validation, static map) and the client (progression visuals) agree.

	World map (top view, +X to the right, +Z towards the camera):

	   Combat arenas      z = -700   (one per player slot, x = slot * 170)
	   Home base          z = 0      (areas 1..N laid out along +X)
	   Runner tracks      z = +700 .. +1600 (one per slot, run towards -Z)
]]

local Layout = {}

-- Home base -------------------------------------------------------------------
Layout.AREA_SIZE = 160 -- each area is a 160 x 160 stud square
Layout.AREA_PITCH = 184 -- centre-to-centre distance (24-stud gate corridor)
Layout.FLOOR_Y = 0 -- top surface of all floors
Layout.PATH_WIDTH = 28 -- central cross-shaped walkway
Layout.PLOT_SIZE = 56 -- each unlock slot is a 56 x 56 plot
Layout.GATE_WIDTH = 20 -- opening in the hedge between two areas
Layout.WALL_HEIGHT = 6
Layout.INTERACT_RANGE = 16 -- server-side proximity check for base actions

-- Slot offsets from the area centre: 1 = north-west, 2 = north-east,
-- 3 = south-west, 4 = south-east.
Layout.SLOT_OFFSETS = {
	Vector3.new(-42, 0, -42),
	Vector3.new(42, 0, -42),
	Vector3.new(-42, 0, 42),
	Vector3.new(42, 0, 42),
}

function Layout.AreaCenter(area: number): Vector3
	return Vector3.new((area - 1) * Layout.AREA_PITCH, Layout.FLOOR_Y, 0)
end

-- Which area a world position belongs to (nil = outside the base).
function Layout.AreaAt(position: Vector3, areaCount: number): number?
	for area = 1, areaCount do
		local c = Layout.AreaCenter(area)
		local half = Layout.AREA_SIZE / 2
		if math.abs(position.X - c.X) <= half and math.abs(position.Z - c.Z) <= half then
			return area
		end
	end
	return nil
end

function Layout.SlotCenter(area: number, slotIndex: number): Vector3
	return Layout.AreaCenter(area) + Layout.SLOT_OFFSETS[slotIndex]
end

-- Point on the plot edge that faces the central walkway (where restock and
-- upgrade prompts sit, so the player never has to walk into the building).
function Layout.SlotFrontPosition(area: number, slotIndex: number): Vector3
	local offset = Layout.SLOT_OFFSETS[slotIndex]
	local towardsPathX = -math.sign(offset.X)
	return Layout.SlotCenter(area, slotIndex) + Vector3.new(towardsPathX * (Layout.PLOT_SIZE / 2 - 6), 0, 0)
end

-- Where the "Hire me" tile / employee stands for a revenue section.
function Layout.SlotHirePosition(area: number, slotIndex: number): Vector3
	local offset = Layout.SLOT_OFFSETS[slotIndex]
	local towardsPathX = -math.sign(offset.X)
	local towardsPathZ = -math.sign(offset.Z)
	return Layout.SlotCenter(area, slotIndex)
		+ Vector3.new(towardsPathX * (Layout.PLOT_SIZE / 2 - 6), 0, towardsPathZ * (Layout.PLOT_SIZE / 2 - 8))
end

-- The gate that leads FROM `area` TO `area + 1` (on the east edge of `area`).
function Layout.GatePosition(area: number): Vector3
	return Layout.AreaCenter(area) + Vector3.new(Layout.AREA_PITCH / 2, 0, 0)
end

function Layout.SpawnPosition(): Vector3
	return Layout.AreaCenter(1) + Vector3.new(0, 0, 58)
end

-- Big "ARMY RUN" pad in area 1 that starts the runner.
function Layout.RunnerPortalPosition(): Vector3
	return Layout.AreaCenter(1) + Vector3.new(0, 0, -60)
end

-- Where a player lands after an army run: the spawn, on the far side of the
-- area from the ARMY RUN pad, facing the area's unlocks (owner request: not
-- back on the pad, and next to what the money can buy).
function Layout.RunnerReturnCFrame(): CFrame
	local at = Layout.SpawnPosition()
	return CFrame.lookAt(at, Layout.AreaCenter(1))
end

-- Runner -------------------------------------------------------------------------
Layout.RUNNER_TRACK_WIDTH = 24
Layout.RUNNER_TRACK_LENGTH = 900
Layout.RUNNER_START_Z = 1600
Layout.RUNNER_SLOT_SPACING = 80

-- CFrame at the start of a player's runner track, facing down the track (-Z).
function Layout.RunnerTrackStart(slotIndex: number): CFrame
	local p = Vector3.new(slotIndex * Layout.RUNNER_SLOT_SPACING, Layout.FLOOR_Y, Layout.RUNNER_START_Z)
	return CFrame.lookAt(p, p + Vector3.new(0, 0, -1))
end

-- World position of a point on a track: `distance` studs from the start and
-- `lateral` studs to the right of the centre line (right = +X).
function Layout.RunnerPoint(slotIndex: number, distance: number, lateral: number): Vector3
	return Vector3.new(
		slotIndex * Layout.RUNNER_SLOT_SPACING + lateral,
		Layout.FLOOR_Y,
		Layout.RUNNER_START_Z - distance
	)
end

-- Combat -----------------------------------------------------------------------
Layout.ARENA_SIZE_X = 80
Layout.ARENA_SIZE_Z = 110
Layout.ARENA_SLOT_SPACING = 170
Layout.ARENA_Z = -700

function Layout.ArenaCenter(slotIndex: number): Vector3
	return Vector3.new(slotIndex * Layout.ARENA_SLOT_SPACING, Layout.FLOOR_Y, Layout.ARENA_Z)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Net
	All client <-> server traffic goes through here.

	Requests (client -> server, with a reply):
		-- server
		Net.Handle("BuyRunnerUpgrade", function(player, kind) ... return Net.Ok({ level = 3 }) end)
		-- client
		local result = Net.Request("BuyRunnerUpgrade", "troops")
		if result.ok then ... else warn(result.err) end

	Handlers return a table (Net.Ok / Net.Fail) or nil (= ok). A handler that
	errors returns { ok = false, err = "Something went wrong" } to the client.

	Push events (server -> client, or client -> server):
		Net.Fire("Notify", player, "Hello", "success")   -- server -> one client
		Net.FireAll("Notify", "Server message")          -- server -> all clients
		Net.FireServer("Name", ...)                      -- client -> server
		Net.On("Notify", function(...) end)              -- listen on either side
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Result = { ok: boolean, err: string?, [string]: any }

local Net = {}

-- Every RemoteEvent the game uses. Add new names here (server creates them).
Net.EVENTS = {
	"Sync", -- server -> client: full PlayerData snapshot
	"Notify", -- server -> client: (text, kind) toast
	"Fx", -- server -> client: (kind, payload) world effects (floating text...)
	"Runner", -- server -> client: (msg, payload)
	"Combat", -- both ways: (msg, payload) reliable combat events
	"Base", -- server -> client: (msg, payload)
	"Boost", -- server -> client: (msg, payload) random offers / timers
	"Shop", -- server -> client: (msg, payload)
	"Inventory", -- server -> client: (msg, payload)
	"Vehicle", -- server -> client: (msg, payload)
}

-- High-frequency, droppable events.
Net.UNRELIABLE = {
	"CombatSnap", -- server -> client: combat entity snapshot (~20 Hz)
}

local FOLDER_NAME = "Remotes"
local ACTION_NAME = "Action"
local IS_SERVER = RunService:IsServer()

local folder: Folder? = nil
local handlers: { [string]: (Player, ...any) -> any } = {}

-- Per-player request budget (token bucket) to stop remote spam.
local RATE_PER_SECOND = 25
local BURST = 40
local buckets: { [Player]: { tokens: number, last: number } } = {}

local function getFolder(): Folder
	local cached = folder
	if cached then
		return cached
	end
	local result: Folder
	if IS_SERVER then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing and existing:IsA("Folder") then
			result = existing
		else
			result = Instance.new("Folder")
			result.Name = FOLDER_NAME
			result.Parent = ReplicatedStorage
		end
	else
		result = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	folder = result
	return result
end

local function getRemote(name: string): Instance
	local f = getFolder()
	if IS_SERVER then
		local remote = f:FindFirstChild(name)
		if not remote then
			error(("Net: unknown remote '%s' (add it to Net.EVENTS)"):format(name))
		end
		return remote
	end
	return f:WaitForChild(name)
end

function Net.Ok(payload: { [string]: any }?): Result
	local result = (payload or {}) :: Result
	result.ok = true
	return result
end

function Net.Fail(message: string): Result
	return { ok = false, err = message }
end

-- Server: create every remote. Called once by Server/Main before services load.
function Net.Setup()
	assert(IS_SERVER, "Net.Setup is server-only")
	local f = getFolder()
	for _, name in Net.EVENTS do
		if not f:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
	end
	for _, name in Net.UNRELIABLE do
		if not f:FindFirstChild(name) then
			local remote = Instance.new("UnreliableRemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
	end
	local action = f:FindFirstChild(ACTION_NAME) :: RemoteFunction?
	if not action then
		local created = Instance.new("RemoteFunction")
		created.Name = ACTION_NAME
		created.Parent = f
		action = created
	end
	(action :: RemoteFunction).OnServerInvoke = function(player: Player, actionName: any, ...: any): Result
		if type(actionName) ~= "string" then
			return Net.Fail("Bad request")
		end
		-- rate limit
		local now = os.clock()
		local bucket = buckets[player]
		if not bucket then
			bucket = { tokens = BURST, last = now }
			buckets[player] = bucket
		end
		bucket.tokens = math.min(BURST, bucket.tokens + (now - bucket.last) * RATE_PER_SECOND)
		bucket.last = now
		if bucket.tokens < 1 then
			return Net.Fail("Slow down!")
		end
		bucket.tokens -= 1

		local handler = handlers[actionName]
		if not handler then
			return Net.Fail("Unknown action " .. actionName)
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] action %s failed for %s: %s"):format(actionName, player.Name, tostring(result)))
			return Net.Fail("Something went wrong")
		end
		if result == nil then
			return Net.Ok()
		end
		if type(result) ~= "table" then
			return Net.Ok({ value = result })
		end
		if result.ok == nil then
			result.ok = true
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Server: register a request handler.
function Net.Handle(actionName: string, handler: (Player, ...any) -> any)
	assert(IS_SERVER, "Net.Handle is server-only")
	if handlers[actionName] then
		warn("[Net] handler replaced: " .. actionName)
	end
	handlers[actionName] = handler
end

-- Client: send a request and wait for the reply. Never errors.
function Net.Request(actionName: string, ...: any): Result
	assert(not IS_SERVER, "Net.Request is client-only")
	local remote = getRemote(ACTION_NAME) :: RemoteFunction
	local args = table.pack(...)
	local ok, result = pcall(function()
		return remote:InvokeServer(actionName, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return Net.Fail("Connection problem")
	end
	if type(result) ~= "table" then
		return Net.Fail("Bad reply")
	end
	return result :: Result
end

-- Server: fire one client.
function Net.Fire(eventName: string, player: Player, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireClient(player, ...)
end

-- Server: fire every client.
function Net.FireAll(eventName: string, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireAllClients(...)
end

-- Client: fire the server.
function Net.FireServer(eventName: string, ...: any)
	local remote = getRemote(eventName) :: any
	remote:FireServer(...)
end

-- Listen to an event. Server callbacks receive (player, ...).
function Net.On(eventName: string, callback: (...any) -> ()): RBXScriptConnection
	local remote = getRemote(eventName) :: any
	if IS_SERVER then
		return remote.OnServerEvent:Connect(callback)
	end
	return remote.OnClientEvent:Connect(callback)
end

-- Server convenience: toast message for one player.
-- kind: "info" | "success" | "error" | "cash"
function Net.Notify(player: Player, text: string, kind: string?)
	Net.Fire("Notify", player, text, kind or "info")
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Rng</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Rng
	Deterministic seeded random numbers (Park-Miller "minimal standard").
	Identical results in Roblox and in the Lune test runner, so the server,
	the client and the economy simulation all see the same runner course.

		local rng = Rng.new(1234)
		rng:Next()          -- [0, 1)
		rng:Int(1, 6)       -- 1..6 inclusive
		rng:Weighted(list, function(item) return item.weight end)
]]

export type Rng = {
	Next: (self: Rng) -> number,
	Int: (self: Rng, min: number, max: number) -> number,
	Range: (self: Rng, min: number, max: number) -> number,
	Chance: (self: Rng, p: number) -> boolean,
	Pick: <T>(self: Rng, list: { T }) -> T,
	Weighted: <T>(self: Rng, list: { T }, weightOf: (T) -> number) -> (T, number),
	Shuffle: <T>(self: Rng, list: { T }) -> { T },
}

local MODULUS = 2147483647
local MULTIPLIER = 48271

local Rng = {}

function Rng.new(seed: number): Rng
	local state: number = math.floor(math.abs(seed)) % MODULUS
	if state == 0 then
		state = 1
	end

	local function nextNumber(): number
		state = (state * MULTIPLIER) % MODULUS
		return (state - 1) / (MODULUS - 1)
	end

	local function int(min: number, max: number): number
		return min + math.floor(nextNumber() * (max - min + 1))
	end

	local rng = {}

	function rng.Next(_self: Rng): number
		return nextNumber()
	end

	function rng.Int(_self: Rng, min: number, max: number): number
		return int(min, max)
	end

	function rng.Range(_self: Rng, min: number, max: number): number
		return min + nextNumber() * (max - min)
	end

	function rng.Chance(_self: Rng, p: number): boolean
		return nextNumber() < p
	end

	function rng.Pick<T>(_self: Rng, list: { T }): T
		return list[int(1, #list)]
	end

	function rng.Weighted<T>(_self: Rng, list: { T }, weightOf: (T) -> number): (T, number)
		local total = 0
		for _, item in list do
			total += math.max(0, weightOf(item))
		end
		local roll = nextNumber() * total
		for index, item in list do
			roll -= math.max(0, weightOf(item))
			if roll < 0 then
				return item, index
			end
		end
		return list[#list], #list
	end

	function rng.Shuffle<T>(_self: Rng, list: { T }): { T }
		for i = #list, 2, -1 do
			local j = int(1, i)
			list[i], list[j] = list[j], list[i]
		end
		return list
	end

	-- Warm up so nearby seeds diverge quickly.
	for _ = 1, 3 do
		nextNumber()
	end
	return (rng :: any) :: Rng
end

return Rng
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Runner</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">RunnerCourse</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerCourse
	Builds the army-runner course for an (area, level) pair. The course is pure
	data (rows of gates, cash, enemies and a boss at the castle); the RUNNER
	system turns it into parts on the client and RunnerSim scores it on the
	server. The same (area, level) always produces exactly the same course
	(seeded Shared/Rng, never math.random), so server, client and the economy
	simulation agree.

	Public API:
		RunnerCourse.Generate(area: number, level: number): Course
		RunnerCourse.SeedFor(area: number, level: number): number
		RunnerCourse.ValueScale(area: number, level: number): number
			-- multiplier for every cash value of that course (area x level growth)

	Row kinds and their options (see RunnerDefs for every number):
		"gate"      2 lanes. Troop maths gates (the original modifiers, applied to
		            the TROOP COUNT): "+N" and "xN" are blue (tone "positive"),
		            "-N" and "÷N" are red (tone "negative"). Gold gates
		            (tone "weapon"): op "weapon" (+1 weapon tier) or op "damage"
		            (+20% damage). A gate may ALSO carry a cash stack (`cash`):
		            a red "toll" gate (lose troops, grab the money) or the
		            smaller of two blue gates (fewer troops + money vs more
		            troops) - so the money is not always behind the red gate.
		"contest"   2 lanes: "shoot to grow" gates [owner request]. A blue "+N"
		            (tone "growPositive") and a red "-N" (tone "growNegative").
		            `growHp` = damage that adds one step, `growStep` = troops
		            per step, `growMax` = the most steps. Shooting a side for the
		            engagement makes its number bigger (RunnerSim); additive only.
		"cash"      3 lanes of cash stacks (tone "cash", `cash` = value).
		"squad"     1 lane (unavoidable) or 2 lanes (pick the squad to fight).
		            `enemies` = soldiers, `hp` = hit points of EACH soldier,
		            `reward` = $ per soldier defeated. Tone "enemy".
		"barricade" 2 lanes (weak / strong). `hp` = barricade hit points,
		            `reward` = $ for destroying it. Tone "enemy".
	The course ends with the castle boss (`boss`): distance and the cash
	reward for beating it. `boss.hp` is always 0: the boss HP depends on the
	player's stats and comes from RunnerSim.BossHp(course, stats).
	Every cash value (stacks, tolls, rewards) is a whole number of dollars.

	Every row has at least one sensible option (a blue/gold gate, any cash
	lane, the smaller squad, the weaker barricade).
]]

local Shared = script.Parent.Parent
local EconomyDefs = require(Shared:WaitForChild("EconomyDefs"))
local Format = require(Shared:WaitForChild("Format"))
local Rng = require(Shared:WaitForChild("Rng"))
local RunnerDefs = require(script.Parent:WaitForChild("RunnerDefs"))

export type Option = {
	lane: number, -- 1..#row.options, left -> right
	x: number, -- lateral centre (studs, + = right of centre line)
	width: number, -- studs
	op: string?, -- gate: "add" | "mul" | "sub" | "div" | "weapon" | "damage"
	amount: number?, -- +N troops, xN, -N, /N, +tiers, +damage fraction (0.2 = +20%)
	label: string, -- what the gate panel shows: "+5", "x2", "-3", "÷2", "WEAPON +1", "+20% DMG", "$12"
	tone: string, -- "positive" (blue) | "negative" (red) | "weapon" (gold) | "cash" | "enemy"
	-- | "growPositive" / "growNegative" (contest: shoot-to-grow blue / red)
	cash: number?, -- cash row (or toll gate): value of the cash stack in this lane
	enemies: number?, -- squad row: number of enemy soldiers
	hp: number?, -- barricade row: hit points; squad row: hit points of each soldier
	reward: number?, -- cash for destroying the barricade / per enemy defeated
	growHp: number?, -- contest: damage that grows the gate by one step
	growStep: number?, -- contest: troops added to the gate's number per step
	growMax: number?, -- contest: the most steps the gate can grow
}

export type Row = { index: number, kind: string, distance: number, options: { Option } }

export type Course = {
	area: number,
	level: number,
	seed: number,
	length: number,
	rows: { Row },
	boss: { distance: number, hp: number, reward: number }, -- hp = 0 (see RunnerSim.BossHp)
}

-- An option before it is given a lane (lane/x/width are filled in later).
type Draft = {
	op: string?,
	amount: number?,
	label: string,
	tone: string,
	cash: number?,
	enemies: number?,
	hp: number?,
	reward: number?,
	growHp: number?,
	growStep: number?,
	growMax: number?,
}

local RunnerCourse = {}

-- Deterministic seed from (area, level). Different for every pair in practice.
function RunnerCourse.SeedFor(area: number, level: number): number
	local a = math.max(1, math.floor(area))
	local l = math.max(1, math.floor(level))
	return (a * 1000003 + l * 7919 + 12345) % 2147483646 + 1
end

-- Multiplier for every cash value: AreaScale^(area-1) x the gentle level factor.
function RunnerCourse.ValueScale(area: number, level: number): number
	local a = math.max(1, math.floor(area))
	return EconomyDefs.AreaScale ^ (a - 1) * RunnerDefs.LevelFactor(a, level)
end

-- Round a cash amount to whole dollars (owner request: no cents), at least $1.
local function niceMoney(v: number): number
	return math.max(1, Format.RoundWhole(v))
end

local function addLanes(laneKey: string, drafts: { Draft }, rng: Rng.Rng, shuffle: boolean): { Option }
	if shuffle then
		rng:Shuffle(drafts)
	end
	local lanes = RunnerDefs.LANES[laneKey]
	local options: { Option } = {}
	for index, d in drafts do
		local lane = lanes[index]
		table.insert(options, {
			lane = index,
			x = lane.x,
			width = lane.width,
			op = d.op,
			amount = d.amount,
			label = d.label,
			tone = d.tone,
			cash = d.cash,
			enemies = d.enemies,
			hp = d.hp,
			reward = d.reward,
			growHp = d.growHp,
			growStep = d.growStep,
			growMax = d.growMax,
		})
	end
	return options
end

function RunnerCourse.Generate(area: number, level: number): Course
	area = math.max(1, math.floor(area))
	level = math.max(1, math.floor(level))
	local seed = RunnerCourse.SeedFor(area, level)
	local rng = Rng.new(seed)

	local scale = RunnerCourse.ValueScale(area, level)
	local troopScale = RunnerDefs.TroopScale(area)
	local levelFactor = RunnerDefs.LevelFactor(area, level)
	local hpScale = RunnerDefs.EnemyHpScale(area) * levelFactor
	local armyScale = RunnerDefs.ArmyScale(area)

	-- Option builders ---------------------------------------------------------
	-- [PROPOSAL] The small random spreads below (about +-10..25%), the 15% chance
	-- of a late "÷3", the 40% chance of a single-lane squad and the 2.2x reward of
	-- a strong barricade only add variety; the big numbers live in RunnerDefs.
	local function addN(rowIndex: number): Draft
		local n = math.max(
			1,
			math.floor(
				(RunnerDefs.ADD_BASE + RunnerDefs.ADD_PER_ROW * rowIndex) * troopScale * rng:Range(0.8, 1.25) + 0.5
			)
		)
		return { op = "add", amount = n, label = "+" .. n, tone = "positive" }
	end
	local function mulN(): Draft
		return { op = "mul", amount = 2, label = "x2", tone = "positive" }
	end
	local function subN(rowIndex: number): Draft
		local n = math.max(
			1,
			math.floor(
				(RunnerDefs.SUB_BASE + RunnerDefs.SUB_PER_ROW * rowIndex) * troopScale * rng:Range(0.8, 1.2) + 0.5
			)
		)
		return { op = "sub", amount = n, label = "-" .. n, tone = "negative" }
	end
	local function divN(rowIndex: number): Draft
		local d = if rowIndex >= 10 and rng:Chance(0.15) then 3 else 2
		return { op = "div", amount = d, label = "÷" .. d, tone = "negative" }
	end
	-- Puts a cash stack behind a gate ("-4  +$20" / "+3  +$15").
	local function withCash(d: Draft, rowIndex: number, share: number): Draft
		local cash = niceMoney(
			RunnerDefs.TOLL_CASH_BASE
				* share
				* (1 + RunnerDefs.CASH_ROW_GROWTH * rowIndex)
				* scale
				* rng:Range(0.85, 1.2)
		)
		d.cash = cash
		d.label = d.label .. "  +" .. Format.Money(cash)
		return d
	end
	local function toll(rowIndex: number): Draft
		return withCash(subN(rowIndex), rowIndex, 1)
	end
	local function weapon(): Draft
		return { op = "weapon", amount = 1, label = "WEAPON +1", tone = "weapon" }
	end
	local function damage(): Draft
		local pct = math.floor(RunnerDefs.DAMAGE_GATE_AMOUNT * 100 + 0.5)
		return { op = "damage", amount = RunnerDefs.DAMAGE_GATE_AMOUNT, label = "+" .. pct .. "% DMG", tone = "weapon" }
	end

	-- Row builders --------------------------------------------------------------
	-- [PROPOSAL] Exactly MUL_ROWS troop gates per course offer a "x2" (so troop
	-- counts stay readable and every course is worth about the same); the other
	-- troop gates mix + - and toll gates. Weighted variants keep every troop
	-- gate a real decision.
	local MUL_VARIANTS = {
		{ id = "addMul", weight = 3 }, -- "+8" vs "x2": depends on how many troops you have
		{ id = "mulDiv", weight = 1 }, -- "x2" vs "÷2"
	}
	local PLAIN_VARIANTS = {
		{ id = "addSub", weight = 2 }, -- blue vs red (classic)
		{ id = "toll", weight = 1.2 }, -- "+3" vs "-4 +$20": troops or cash?
		{ id = "bonusAdd", weight = 1.2 }, -- "+3 +$15" vs "+6": the cash rides a BLUE gate
		{ id = "addAdd", weight = 1 }, -- two blue gates of different size
	}
	local UPGRADE_VARIANTS = {
		{ id = "weaponTroops", weight = 3 }, -- gold weapon gate vs more troops
		{ id = "damageTroops", weight = 2 }, -- +20% DMG vs more troops
		{ id = "weaponDamage", weight = 2 }, -- weapon vs damage
	}
	local function weightOf(v: { id: string, weight: number }): number
		return v.weight
	end

	local function troopGate(rowIndex: number, withMul: boolean): { Option }
		local variant = rng:Weighted(if withMul then MUL_VARIANTS else PLAIN_VARIANTS, weightOf)
		local drafts: { Draft }
		if variant.id == "addMul" then
			drafts = { addN(rowIndex), mulN() }
		elseif variant.id == "mulDiv" then
			drafts = { mulN(), divN(rowIndex) }
		elseif variant.id == "addSub" then
			drafts = { addN(rowIndex), subN(rowIndex) }
		elseif variant.id == "toll" then
			drafts = { addN(rowIndex), toll(rowIndex) }
		elseif variant.id == "bonusAdd" then
			-- [PROPOSAL] the cash gate gives fewer troops: the other gives ~60-100% more.
			local small, big = addN(rowIndex), addN(rowIndex)
			local smallN = small.amount :: number
			local bigN = math.max(big.amount :: number, smallN + math.max(2, math.floor(0.6 * smallN + 0.5)))
			big.amount = bigN
			big.label = "+" .. bigN
			drafts = { withCash(small, rowIndex, 0.75), big }
		else
			local a, b = addN(rowIndex), addN(rowIndex)
			if a.amount == b.amount then
				local bigger = (b.amount :: number) + math.max(1, math.floor(0.5 * (b.amount :: number)))
				b.amount = bigger
				b.label = "+" .. bigger
			end
			drafts = { a, b }
		end
		return addLanes("gate", drafts, rng, true)
	end

	local function upgradeGate(rowIndex: number): { Option }
		local variant = rng:Weighted(UPGRADE_VARIANTS, weightOf)
		local drafts: { Draft }
		if variant.id == "weaponTroops" then
			-- [PROPOSAL] 30%: the troop gate also carries cash (weapon vs troops + cash).
			local troops = addN(rowIndex)
			if rng:Chance(0.3) then
				troops = withCash(troops, rowIndex, 0.75)
			end
			drafts = { weapon(), troops }
		elseif variant.id == "damageTroops" then
			drafts = { damage(), addN(rowIndex) }
		else
			drafts = { weapon(), damage() }
		end
		return addLanes("gate", drafts, rng, true)
	end

	-- Shoot-to-grow gates (see RunnerDefs "contest"): blue starts below a "+N"
	-- gate of the row, red like a "-N"; a reference squad shooting one side for
	-- the whole engagement adds CONTEST_STEPS_AT_EXPECTED steps.
	local function contestRow(rowIndex: number): { Option }
		local blueN = math.max(
			1,
			math.floor(
				(RunnerDefs.ADD_BASE + RunnerDefs.ADD_PER_ROW * rowIndex)
						* troopScale
						* RunnerDefs.CONTEST_BLUE_START
						* rng:Range(0.9, 1.1)
					+ 0.5
			)
		)
		local redN = math.max(
			1,
			math.floor(
				(RunnerDefs.SUB_BASE + RunnerDefs.SUB_PER_ROW * rowIndex)
						* troopScale
						* RunnerDefs.CONTEST_RED_START
						* rng:Range(0.9, 1.1)
					+ 0.5
			)
		)
		local power = RunnerDefs.ExpectedFirepower(rowIndex) * hpScale * armyScale
		local growHp = math.max(1, math.floor(power / RunnerDefs.CONTEST_STEPS_AT_EXPECTED + 0.5))
		local growStep = math.max(1, math.floor(troopScale + 0.5))
		local drafts: { Draft } = {
			{
				op = "add",
				amount = blueN,
				label = "+" .. blueN,
				tone = "growPositive",
				growHp = growHp,
				growStep = growStep,
				growMax = RunnerDefs.CONTEST_MAX_STEPS,
			},
			{
				op = "sub",
				amount = redN,
				label = "-" .. redN,
				tone = "growNegative",
				growHp = growHp,
				growStep = growStep,
				growMax = RunnerDefs.CONTEST_MAX_STEPS,
			},
		}
		return addLanes("gate", drafts, rng, true)
	end

	local function cashRow(rowIndex: number): { Option }
		local base = RunnerDefs.CASH_ROW_BASE * (1 + RunnerDefs.CASH_ROW_GROWTH * rowIndex) * scale
		local drafts: { Draft } = {}
		for _, spread in RunnerDefs.CASH_LANE_SPREAD do
			local value = niceMoney(base * spread * rng:Range(0.9, 1.1))
			table.insert(drafts, { label = Format.Money(value), tone = "cash", cash = value })
		end
		return addLanes("cash", drafts, rng, true)
	end

	local function squadDraft(rowIndex: number, sizeMult: number): Draft
		local expectedTroops = RunnerDefs.EXPECTED_TROOPS_BASE + RunnerDefs.EXPECTED_TROOPS_PER_ROW * rowIndex
		local enemies = math.max(
			1,
			math.floor(expectedTroops * RunnerDefs.SQUAD_SHARE * armyScale * sizeMult * rng:Range(0.85, 1.15) + 0.5)
		)
		return {
			label = enemies .. " SOLDIERS",
			tone = "enemy",
			enemies = enemies,
			hp = math.max(1, Format.RoundWhole(RunnerDefs.ENEMY_HP * hpScale)),
			reward = niceMoney(RunnerDefs.ENEMY_REWARD * scale),
		}
	end

	local function squadRow(rowIndex: number, final: boolean): { Option }
		if final then
			return addLanes("squad1", { squadDraft(rowIndex, RunnerDefs.SQUAD_FINAL) }, rng, false)
		elseif rng:Chance(0.4) then
			return addLanes("squad1", { squadDraft(rowIndex, 1) }, rng, false)
		end
		-- [PROPOSAL] two squads: a small one and a big one that pays more.
		return addLanes(
			"squad2",
			{ squadDraft(rowIndex, RunnerDefs.SQUAD_SMALL), squadDraft(rowIndex, RunnerDefs.SQUAD_BIG) },
			rng,
			true
		)
	end

	local function barricadeRow(rowIndex: number): { Option }
		local power = RunnerDefs.ExpectedFirepower(rowIndex) * hpScale * armyScale
		local weakHp = math.floor(power * RunnerDefs.BARRICADE_WEAK * rng:Range(0.9, 1.1) + 0.5)
		local strongHp = math.floor(power * RunnerDefs.BARRICADE_STRONG * rng:Range(0.9, 1.1) + 0.5)
		local weakReward = niceMoney(RunnerDefs.BARRICADE_REWARD * (1 + RunnerDefs.CASH_ROW_GROWTH * rowIndex) * scale)
		local strongReward = niceMoney(weakReward * 2.2)
		local drafts: { Draft } = {
			{ label = "HP " .. weakHp, tone = "enemy", hp = weakHp, reward = weakReward },
			{ label = "HP " .. strongHp, tone = "enemy", hp = strongHp, reward = strongReward },
		}
		return addLanes("barricade", drafts, rng, true)
	end

	-- Course blueprint ------------------------------------------------------------
	-- [PROPOSAL] 18 rows. Row 1 is always a troop gate; rows 2-16 come in blocks
	-- of three that are shuffled for variety (two blocks hold the
	-- RunnerDefs.CONTEST_ROWS shoot-to-grow gates); rows 17-18 are a final squad
	-- and a last upgrade/troop gate before the castle boss.
	local kinds: { string } = { "troop" }
	local blocks = {
		{ "cash", "troop", "squad" },
		{ "upgrade", "contest", "troop" },
		{ "barricade", "upgrade", "squad" },
		{ "cash", "troop", "upgrade" },
		{ "barricade", "contest", "cash" },
	}
	for _, block in blocks do
		local copy = table.clone(block)
		rng:Shuffle(copy)
		for _, k in copy do
			table.insert(kinds, k)
		end
	end
	table.insert(kinds, "squadFinal")
	table.insert(kinds, if rng:Chance(0.5) then "upgrade" else "troop")

	-- Choose which troop gates (never row 1) offer the x2.
	local troopRows: { number } = {}
	for index, k in kinds do
		if k == "troop" and index > 1 then
			table.insert(troopRows, index)
		end
	end
	rng:Shuffle(troopRows)
	local mulRows: { [number]: boolean } = {}
	for i = 1, math.min(RunnerDefs.MUL_ROWS, #troopRows) do
		mulRows[troopRows[i]] = true
	end

	local rows: { Row } = {}
	for index, k in kinds do
		local options: { Option }
		local rowKind: string
		if k == "troop" then
			rowKind, options = "gate", troopGate(index, mulRows[index] == true)
		elseif k == "upgrade" then
			rowKind, options = "gate", upgradeGate(index)
		elseif k == "contest" then
			rowKind, options = "contest", contestRow(index)
		elseif k == "cash" then
			rowKind, options = "cash", cashRow(index)
		elseif k == "barricade" then
			rowKind, options = "barricade", barricadeRow(index)
		else
			rowKind, options = "squad", squadRow(index, k == "squadFinal")
		end
		table.insert(rows, {
			index = index,
			kind = rowKind,
			distance = RunnerDefs.FIRST_ROW_DISTANCE + (index - 1) * RunnerDefs.ROW_SPACING,
			options = options,
		})
	end

	local boss = {
		distance = RunnerDefs.BOSS_DISTANCE,
		hp = 0, -- not used: the boss HP comes from RunnerSim.BossHp(course, stats)
		reward = niceMoney(RunnerDefs.BOSS_REWARD * scale * armyScale ^ RunnerDefs.BOSS_REWARD_ARMY_EXP),
	}

	return {
		area = area,
		level = level,
		seed = seed,
		length = RunnerDefs.TRACK_LENGTH,
		rows = rows,
		boss = boss,
	}
end

return RunnerCourse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RunnerDefs</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerDefs
	Every tunable number of the army runner in one place (course geometry,
	speeds, weapon tiers, gate values, enemy strength). Pure data: no services,
	no Instances, so it also loads in the Lune test runner.

	Values marked [PROPOSAL] are design assumptions (the brief does not give
	them). Change them here and run `lune run scripts/simulate` to see the new
	economy tables (docs/ECONOMY_TABLES.md).

	Public API (all read-only):
		RunnerDefs.RUN_SPEED              studs per second the avatar runs down the track
		RunnerDefs.TRACK_LENGTH           = Layout.RUNNER_TRACK_LENGTH
		RunnerDefs.TRACK_WIDTH            = Layout.RUNNER_TRACK_WIDTH
		RunnerDefs.ROW_COUNT, FIRST_ROW_DISTANCE, ROW_SPACING, BOSS_DISTANCE
		RunnerDefs.LANES                  lane geometry per row kind: { gate, cash, squad1, squad2, barricade }
		RunnerDefs.WEAPONS                weapon tiers 1..6: { name, short, value, damage, fireRate,
		                                  bulletSpeed, bulletStyle } (every troop AND the avatar fire it)
		RunnerDefs.MAX_WEAPON_TIER
		RunnerDefs.GUN_RANGE              studs a gun reaches = 1.5 rows ("an option and a half")
		RunnerDefs.ENGAGE_SECONDS         seconds the squad shoots before reaching a squad / barricade
		RunnerDefs.FORMATION_WIDTH        units per formation row (2 troops, the avatar, 2 troops)
		RunnerDefs.FORMATION_SPACING_X, FORMATION_SPACING_Z   studs between units / rows
		RunnerDefs.FormationSlot(i) -> (column, row)   where troop i stands (the avatar is column 0 of row 0)
		RunnerDefs.FormationShift(lateral) -> number   whole columns the formation shifts near a track edge
		RunnerDefs.WIDE_RANGE_MIN_COMPANIONS  troops beside the avatar needed for wide shooting
		RunnerDefs.MAX_STANCE             formation columns that can reach into the other lane
		RunnerDefs.CONTEST_ROWS, CONTEST_*  "shoot to grow" gates (see RunnerCourse "contest")
		RunnerDefs.TROOP_VALUE, DAMAGE_GATE_AMOUNT, DAMAGE_GATE_VALUE, ...
		RunnerDefs.BARRICADE_TROOP_LOSS
		RunnerDefs.BOSS_KILL_INTERVAL, BOSS_MAX_FIGHT_SECONDS, BOSS_HP_SHARE, BOSS_REWARD,
		RunnerDefs.BOSS_REWARD_ARMY_EXP
		RunnerDefs.BOSS_INTRO_SECONDS     castle door opens + boss walks out (client animation, before the fight)
		RunnerDefs.BOSS_OUTRO_SECONDS     victory / defeat animation after the fight, before the summary
		RunnerDefs.RUN_OVERHEAD_SECONDS   seconds of a typical run that are not running (menus + whole boss phase)
		RunnerDefs.BossKillInterval(units) seconds between boss kills for a squad of `units`
		RunnerDefs.TroopScale(area)       growth of troop counts (gates, squads) by area
		RunnerDefs.EnemyHpScale(area)     growth of one enemy soldier's hit points by area
		RunnerDefs.ArmyScale(area)        growth of the reference army (squad sizes, barricade / base hp)
		RunnerDefs.ReferenceLevel(area)   permanent upgrade level of the benchmark player
		RunnerDefs.BaseUnitDps()          damage per second of one un-upgraded unit with the Pistol
		RunnerDefs.ExpectedFirepower(row) damage a good area-1 squad deals in one engagement at a row
		                                  (enemy sizing)
		RunnerDefs.LevelFactor(area, level) gentle growth of values with the run level
		RunnerDefs.FirstLevelOfArea(area) runner level at which an area "starts" (benchmark L0)
]]

local Shared = script.Parent.Parent
local Config = require(Shared:WaitForChild("Config"))
local EconomyDefs = require(Shared:WaitForChild("EconomyDefs"))
local Layout = require(Shared:WaitForChild("Layout"))

export type LaneDef = { x: number, width: number }

export type WeaponDef = {
	name: string, -- shown in the completion summary: "Weapon: Assault Rifle"
	short: string, -- shown on gate panels: "RIFLE"
	value: number, -- cash value (area 1 dollars) of reaching this tier in a run
	damage: number, -- hit points one bullet takes off (at base damage 10)
	fireRate: number, -- bullets per second per unit
	bulletSpeed: number, -- studs per second (visual only)
	bulletStyle: string, -- "pistol" | "rifle" | "smg" | "assault" | "minigun" | "rocket" (visual only)
}

local RunnerDefs = {}

-------------------------------------------------------------------------------
-- Speed and track
-------------------------------------------------------------------------------
RunnerDefs.RUN_SPEED = 24 -- [PROPOSAL] studs per second (Roblox default walk is 16)
RunnerDefs.TRACK_LENGTH = Layout.RUNNER_TRACK_LENGTH -- 900 studs
RunnerDefs.TRACK_WIDTH = Layout.RUNNER_TRACK_WIDTH -- 24 studs

-- Rows of gates / cash / enemies, evenly spaced down the track.
RunnerDefs.ROW_COUNT = 18 -- [PROPOSAL]
RunnerDefs.FIRST_ROW_DISTANCE = 70 -- [PROPOSAL] studs from the start line to row 1
RunnerDefs.ROW_SPACING = 45 -- [PROPOSAL] studs between rows (row 18 is at 835)
RunnerDefs.BOSS_DISTANCE = 870 -- [PROPOSAL] the enemy base stands here (track is 900 long)

-------------------------------------------------------------------------------
-- Lanes (x = lateral centre in studs, + = right of the centre line)
-------------------------------------------------------------------------------
-- All lanes fit inside the 24-stud track (edges at -12 / +12).
RunnerDefs.LANES = {
	gate = { { x = -6, width = 11 }, { x = 6, width = 11 } }, -- 2 lanes
	cash = { { x = -8, width = 7 }, { x = 0, width = 7 }, { x = 8, width = 7 } }, -- 3 lanes
	squad1 = { { x = 0, width = 22 } }, -- 1 lane across the whole track (unavoidable fight)
	squad2 = { { x = -6, width = 11 }, { x = 6, width = 11 } }, -- 2 different squads
	barricade = { { x = -6, width = 11 }, { x = 6, width = 11 } }, -- 2 barricades
} :: { [string]: { LaneDef } }

-------------------------------------------------------------------------------
-- Weapons collected during a run (gold gates, +1 tier each)
-------------------------------------------------------------------------------
-- [PROPOSAL] Tier 1 is what every run starts with. EVERY unit (the avatar and
-- each troop) holds the same gun. `value` is the cash the completion summary
-- credits for reaching that tier (scaled by area like all cash values). A
-- weapon gate collected at the top tier still pays the Rocket value ("MAX"),
-- so a gold gate is never a wasted pick.
-- Damage per second of one unit = damage x fireRate (x the player's damage
-- upgrades / base damage, x in-run damage gates). The tiers feel different
-- (SMG: weak bullets, very fast; Rocket: huge hits, slow) but the DPS always
-- rises with the tier: 30, 40.5, 52.5, 67.5, 90, 112.5 (x1, 1.35, 1.75, 2.25, 3, 3.75).
-- [owner request] "More bullets hit but a lower fire rate": every gun fires
-- half as often as before with 3x the damage per bullet (Rocket 0.75x as often,
-- 2x damage), i.e. 1.5x the old damage per second, so a small squad (5 men vs
-- 2 soldiers) wins its fights.
RunnerDefs.WEAPONS = {
	{
		name = "Pistol",
		short = "PISTOL",
		value = 0,
		damage = 30,
		fireRate = 1,
		bulletSpeed = 120,
		bulletStyle = "pistol",
	},
	{
		name = "Rifle",
		short = "RIFLE",
		value = 8,
		damage = 54,
		fireRate = 0.75,
		bulletSpeed = 180,
		bulletStyle = "rifle",
	},
	{
		name = "SMG",
		short = "SMG",
		value = 12,
		damage = 15,
		fireRate = 3.5,
		bulletSpeed = 140,
		bulletStyle = "smg",
	},
	{
		name = "Assault Rifle",
		short = "ASSAULT",
		value = 18,
		damage = 27,
		fireRate = 2.5,
		bulletSpeed = 170,
		bulletStyle = "assault",
	},
	{
		name = "Minigun",
		short = "MINIGUN",
		value = 25,
		damage = 18,
		fireRate = 5,
		bulletSpeed = 160,
		bulletStyle = "minigun",
	},
	{
		name = "Rocket",
		short = "ROCKET",
		value = 35,
		damage = 300,
		fireRate = 0.375,
		bulletSpeed = 70,
		bulletStyle = "rocket",
	},
} :: { WeaponDef }
RunnerDefs.MAX_WEAPON_TIER = #RunnerDefs.WEAPONS

-- [REQUIREMENT] Guns shoot "a distance of an option and a half": 1.5 rows.
RunnerDefs.GUN_RANGE = 1.5 * RunnerDefs.ROW_SPACING -- 67.5 studs
-- The squad starts shooting a squad / barricade when it is GUN_RANGE away and
-- keeps shooting until it reaches it: that is the damage window of a fight.
RunnerDefs.ENGAGE_SECONDS = RunnerDefs.GUN_RANGE / RunnerDefs.RUN_SPEED -- 2.8125 s

-- [REQUIREMENT] Troops stand next to the player, 5 per row (2 left, the
-- avatar in the middle, 2 right); extra rows form behind. The visuals draw it
-- and RunnerSim uses its columns for wide shooting (below).
RunnerDefs.FORMATION_WIDTH = 5
RunnerDefs.FORMATION_SPACING_X = 2.4 -- [PROPOSAL] studs between units in a row
RunnerDefs.FORMATION_SPACING_Z = 2.8 -- [PROPOSAL] studs between rows
-- A unit never stands closer than this to a track edge (the formation shifts).
RunnerDefs.FORMATION_EDGE_MARGIN = 0.8

-- Formation slot of troop i (1-based; the avatar is the centre of row 0).
-- Row 0 holds FORMATION_WIDTH - 1 troops (closest to the avatar first), every
-- later row FORMATION_WIDTH (centre first). Returns (column, row): column in
-- units of FORMATION_SPACING_X (+ = right), row in units of FORMATION_SPACING_Z
-- behind the avatar. Odd troops go left, even troops right.
function RunnerDefs.FormationSlot(i: number): (number, number)
	local width = math.max(1, math.floor(RunnerDefs.FORMATION_WIDTH))
	local half = math.floor(width / 2)
	local front = width - 1
	if i <= front then
		local k = math.ceil(i / 2)
		return if i % 2 == 1 then -k else k, 0
	end
	local j = i - front - 1 -- 0-based in the back rows
	local row = 1 + math.floor(j / width)
	local index = j % width -- 0 = centre, then left/right pairs
	if index == 0 then
		return 0, row
	end
	local k = math.min(half, math.ceil(index / 2))
	return if index % 2 == 1 then -k else k, row
end

-- Near a track edge the WHOLE formation moves over by whole columns (the
-- same shift for every troop) so no unit stands off the track; the avatar
-- stays where the player steers and a front-row troop takes the spot it left
-- free. `lateral` = the avatar's studs right of the centre line.
function RunnerDefs.FormationShift(lateral: number): number
	local width = math.max(1, math.floor(RunnerDefs.FORMATION_WIDTH))
	local half = math.floor(width / 2)
	local spacing = RunnerDefs.FORMATION_SPACING_X
	local minX = -RunnerDefs.TRACK_WIDTH / 2 + RunnerDefs.FORMATION_EDGE_MARGIN
	local maxX = RunnerDefs.TRACK_WIDTH / 2 - RunnerDefs.FORMATION_EDGE_MARGIN
	local lo = math.ceil((minX - (lateral - half * spacing)) / spacing - 1e-6)
	local hi = math.floor((maxX - (lateral + half * spacing)) / spacing + 1e-6)
	local shift = if lo <= hi then math.clamp(0, lo, hi) else 0
	return math.clamp(shift, -half, half)
end

-- [owner request] Wide shooting: with MORE than 4 troops beside the avatar,
-- every formation column shoots what stands in front of IT. Standing between
-- two squads / barricades / shoot-to-grow gates hits both (the columns over
-- the other lane shoot that one); moving to a side puts all the fire on it.
-- With fewer troops everyone shoots the lane the avatar is in.
RunnerDefs.WIDE_RANGE_MIN_COMPANIONS = 5
-- At most the 2 outer columns of the 5 can stand over the other lane (the
-- avatar's own column is always in its lane): the "stance" 0, 1 or 2.
RunnerDefs.MAX_STANCE = 2

-------------------------------------------------------------------------------
-- Payout values (area 1 dollars; multiplied by the area scale and level factor)
-------------------------------------------------------------------------------
RunnerDefs.TROOP_VALUE = 1.5 -- [PROPOSAL] $ per troop alive at the finish ("$1.50 each")
RunnerDefs.DAMAGE_GATE_AMOUNT = 0.2 -- [PROPOSAL] +20% damage per damage gate (additive)
RunnerDefs.DAMAGE_GATE_VALUE = 9 -- [PROPOSAL] $ credited per damage gate collected
RunnerDefs.CASH_ROW_BASE = 9 -- [PROPOSAL] middle cash lane of the first cash row
RunnerDefs.CASH_ROW_GROWTH = 0.06 -- [PROPOSAL] +6% cash per row further down the track
RunnerDefs.CASH_LANE_SPREAD = { 0.55, 1.0, 1.6 } -- [PROPOSAL] low / mid / high cash lanes
RunnerDefs.TOLL_CASH_BASE = 16 -- [PROPOSAL] cash behind a red "toll" gate (trade troops for cash)
RunnerDefs.ENEMY_REWARD = 1 -- [PROPOSAL] $ per enemy soldier defeated (whole dollars), either lane
RunnerDefs.BARRICADE_REWARD = 7 -- [PROPOSAL] $ for destroying a weak barricade (strong pays ~2.2x)
-- [PROPOSAL] $ for beating the boss, x the area cash scale x ArmyScale(area)^BOSS_REWARD_ARMY_EXP
-- (bigger armies guard more loot), so beating it is worth ~20-30% of a best-case run in every area.
RunnerDefs.BOSS_REWARD = 38
RunnerDefs.BOSS_REWARD_ARMY_EXP = 0.5

-------------------------------------------------------------------------------
-- Troop maths gates (the original + x - ÷ modifiers, applied to TROOP COUNT)
-------------------------------------------------------------------------------
RunnerDefs.ADD_BASE = 2 -- [PROPOSAL] "+N" at row 1 (grows with row and area)
RunnerDefs.ADD_PER_ROW = 0.25 -- [PROPOSAL] extra +N per row index
RunnerDefs.MUL_ROWS = 2 -- [PROPOSAL] troop gates per course that offer "x2"
RunnerDefs.SUB_BASE = 2 -- [PROPOSAL] "-N" at row 1
RunnerDefs.SUB_PER_ROW = 0.2 -- [PROPOSAL]
-- [owner request] The cash bonus behind a gate is not always on the red one:
-- it rides a red "-N" (troops for cash) or the SMALLER of two blue "+N"
-- gates (fewer troops + cash vs more troops), at random.

-------------------------------------------------------------------------------
-- "Shoot to grow" gates (row kind "contest") [owner request]
-------------------------------------------------------------------------------
-- A blue "+N" and a red "-N" side by side. Shooting a side makes its number
-- bigger (blue: more troops gained, red: more troops lost) and makes it wider,
-- pushing the other side aside. Additive only (no x), and capped, so they can
-- not make a player overpowered right away.
RunnerDefs.CONTEST_ROWS = 2 -- [PROPOSAL] per course (RunnerCourse puts them in two of its row blocks)
RunnerDefs.CONTEST_BLUE_START = 0.6 -- [PROPOSAL] blue starts at 60% of a "+N" gate of that row
RunnerDefs.CONTEST_RED_START = 1.0 -- [PROPOSAL] red starts like a "-N" gate of that row
-- [PROPOSAL] Growth steps (+1 troop each in area 1, x TroopScale) a reference
-- squad reaches by shooting ONE side for the whole engagement, and the cap.
RunnerDefs.CONTEST_STEPS_AT_EXPECTED = 3
RunnerDefs.CONTEST_MAX_STEPS = 6

-------------------------------------------------------------------------------
-- Enemies (squads, barricades, the enemy base)
-------------------------------------------------------------------------------
-- [PROPOSAL] Enemies are sized against the army a good area-1 player has
-- when reaching row r: about EXPECTED_TROOPS_BASE + EXPECTED_TROOPS_PER_ROW x r
-- troops, firing EXPECTED_POWER_PER_ROW better weapons/damage per row.
-- (Other areas multiply by EnemyHpScale x ArmyScale.)
RunnerDefs.EXPECTED_TROOPS_BASE = 3
RunnerDefs.EXPECTED_TROOPS_PER_ROW = 2.2
RunnerDefs.EXPECTED_POWER_PER_ROW = 0.04
-- [PROPOSAL] Hit points of one enemy soldier in area 1: one un-upgraded
-- Pistol unit deals 30 x 2.8125 = 84 damage per engagement, so a soldier
-- needs 2 units (owner request: 5 men beat a squad of 2 without losses).
RunnerDefs.ENEMY_HP = 170
RunnerDefs.SQUAD_SHARE = 0.4 -- [PROPOSAL] soldiers per expected troop (normal squad)
RunnerDefs.SQUAD_SMALL = 0.6 -- [PROPOSAL] size of the small squad in a 2-squad row
RunnerDefs.SQUAD_BIG = 1.45 -- [PROPOSAL] size of the big squad (pays more, costs more)
RunnerDefs.SQUAD_FINAL = 1.25 -- [PROPOSAL] size of the last squad before the castle
RunnerDefs.BARRICADE_WEAK = 0.75 -- [PROPOSAL] weak barricade hp = 75% of expected firepower
RunnerDefs.BARRICADE_STRONG = 1.7 -- [PROPOSAL] strong barricade hp = 170% of expected firepower
RunnerDefs.BARRICADE_TROOP_LOSS = 0.25 -- failed barricade costs 25% of troops (min 1 left)

-------------------------------------------------------------------------------
-- The boss at the castle (end of the track) [REQUIREMENT]
-------------------------------------------------------------------------------
-- The boss walks out of the castle and kills one unit every kill interval
-- (troops first, the avatar last) while every unit still alive shoots it.
-- Its HP is BOSS_HP_SHARE of the most damage ANY lane path of the course can
-- deal to it (RunnerSim.BossHp), so only the best lanes beat it.
RunnerDefs.BOSS_KILL_INTERVAL = 0.55 -- [PROPOSAL] seconds between boss kills
RunnerDefs.BOSS_MAX_FIGHT_SECONDS = 12 -- [PROPOSAL] huge armies: the fight never lasts longer
RunnerDefs.BOSS_HP_SHARE = 0.999 -- [PROPOSAL] only paths within 0.1% of the best win

-- Boss phase timing shared by the client animation (RunnerVisuals) and the
-- economy (RUN_OVERHEAD_SECONDS below), so both use the same numbers.
-- Intro: the castle door sinks (0.7 s; the boss starts walking at 60% of it,
-- 0.42 s) and the boss walks out of the gate (2.2 s) = 2.62 s.
RunnerDefs.BOSS_INTRO_SECONDS = 2.62 -- [PROPOSAL]
-- Outro: victory (boss falls, confetti, coins) or defeat moment before the summary.
RunnerDefs.BOSS_OUTRO_SECONDS = 2.8 -- [PROPOSAL]

-- Seconds a typical run takes on top of running: pre-run screen, countdown
-- and the completion summary (~11 s, [PROPOSAL] estimate of time spent in
-- menus), plus the whole boss phase: intro (BOSS_INTRO_SECONDS), the fight
-- (at most BOSS_MAX_FIGHT_SECONDS; best-lane fights take ~11-12 s) and the
-- outro (BOSS_OUTRO_SECONDS). Used by Economy.RunDurationSeconds (2x boost
-- value, section income via PassiveShare).
RunnerDefs.RUN_OVERHEAD_SECONDS = 11 -- [PROPOSAL] 11 + 2.62 + 12 + 2.8 = 28.42 s
	+ RunnerDefs.BOSS_INTRO_SECONDS
	+ RunnerDefs.BOSS_MAX_FIGHT_SECONDS
	+ RunnerDefs.BOSS_OUTRO_SECONDS

-- Seconds between boss kills for a squad of `units`:
-- min(BOSS_KILL_INTERVAL, BOSS_MAX_FIGHT_SECONDS / units).
function RunnerDefs.BossKillInterval(units: number): number
	if units <= 0 then
		return RunnerDefs.BOSS_KILL_INTERVAL
	end
	return math.min(RunnerDefs.BOSS_KILL_INTERVAL, RunnerDefs.BOSS_MAX_FIGHT_SECONDS / units)
end

-------------------------------------------------------------------------------
-- Scaling helpers
-------------------------------------------------------------------------------
-- [PROPOSAL] Troop counts on gates and in squads grow slowly with the area
-- (+12% per area) so numbers stay readable while upgraded players still face
-- meaningful choices.
function RunnerDefs.TroopScale(area: number): number
	return 1 + 0.12 * (math.max(1, area) - 1)
end

-- Permanent-upgrade level of the reference player in `area` (same rule as
-- Economy.ReferenceUpgrades: Config.Benchmark.ReferenceUpgradeLevelsPerArea per area).
function RunnerDefs.ReferenceLevel(area: number): number
	local perArea = Config.Benchmark.ReferenceUpgradeLevelsPerArea
	return math.clamp((math.max(1, area) - 1) * perArea, 0, EconomyDefs.Runner.MaxLevel)
end

-- [PROPOSAL] Hit points of ONE enemy soldier grow exactly like the damage of
-- the reference player (4 damage levels per area x 4% = +16% per area), so a
-- reference-upgraded player wins most fights in every area while an
-- un-upgraded player falls behind.
function RunnerDefs.EnemyHpScale(area: number): number
	return 1 + EconomyDefs.Runner.DamagePerLevel * RunnerDefs.ReferenceLevel(area)
end

-- [PROPOSAL] How much bigger the reference player's army is than in area 1.
-- Starting troops (base + troop upgrades) count ARMY_START_WEIGHT times
-- (they get doubled by the x2 gates), plus ARMY_GATE_TROOPS troops picked up
-- from gates (which grow with TroopScale). Squad sizes and barricade hit
-- points grow with this so fights stay fights in every area.
RunnerDefs.ARMY_START_WEIGHT = 3
RunnerDefs.ARMY_GATE_TROOPS = 30
function RunnerDefs.ArmyScale(area: number): number
	local r = EconomyDefs.Runner
	local start = r.BaseTroops + r.TroopsPerLevel * RunnerDefs.ReferenceLevel(area)
	local w, g = RunnerDefs.ARMY_START_WEIGHT, RunnerDefs.ARMY_GATE_TROOPS
	return (w * start + g * RunnerDefs.TroopScale(area)) / (w * r.BaseTroops + g)
end

-- Damage per second of one un-upgraded unit holding the Pistol.
function RunnerDefs.BaseUnitDps(): number
	local pistol = RunnerDefs.WEAPONS[1]
	return pistol.damage * pistol.fireRate
end

-- Damage a good area-1 squad deals in one engagement (ENGAGE_SECONDS of
-- shooting) when reaching row `rowIndex`.
function RunnerDefs.ExpectedFirepower(rowIndex: number): number
	local troops = RunnerDefs.EXPECTED_TROOPS_BASE + RunnerDefs.EXPECTED_TROOPS_PER_ROW * rowIndex
	return troops
		* RunnerDefs.BaseUnitDps()
		* RunnerDefs.ENGAGE_SECONDS
		* (1 + RunnerDefs.EXPECTED_POWER_PER_ROW * rowIndex)
end

-- Runner level at which an area "starts": the 10 benchmark runs of `area` are
-- levels FirstLevelOfArea(area) .. FirstLevelOfArea(area) + 9.
function RunnerDefs.FirstLevelOfArea(area: number): number
	return 1 + 10 * (math.max(1, area) - 1)
end

-- [PROPOSAL] Values grow gently (+1% per run level) after the area's first
-- level, capped at +20%, so grinding one area forever cannot inflate rewards.
RunnerDefs.LEVEL_STEP = 0.01
RunnerDefs.LEVEL_CAP = 20
function RunnerDefs.LevelFactor(area: number, level: number): number
	local inArea = math.clamp(level - RunnerDefs.FirstLevelOfArea(area), 0, RunnerDefs.LEVEL_CAP)
	return 1 + RunnerDefs.LEVEL_STEP * inArea
end

return RunnerDefs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">RunnerSim</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerSim
	Scores an army-runner course: given the lane picked in every row it works
	out the troops, weapon, damage, cash, enemies and the boss fight of the run
	and builds the completion summary lines. Pure and deterministic (no
	services, no random), so the server can re-simulate a run from the client's
	lane choices, the client can animate exactly what the server will pay, and
	the economy can compute the best possible run.

	Public API:
		RunnerSim.Resolve(course, stats, choices, stances?): Result
			choices[i] = lane picked in row i (1..#row.options). A missing,
			non-integer or out-of-range lane counts as lane 1.
			stances[i] = 0..RunnerDefs.MAX_STANCE: formation columns that stood
			over the OTHER lane of a 2-lane squad / barricade / contest row
			(wide shooting, see RunnerSim.Stance). Missing / invalid -> 0.
		RunnerSim.BestCase(course, stats): (Result, { number }, { number })
			EXACT best run and the lane choices + stances that produce it.
		RunnerSim.IsSplitRow(row): boolean
			a row whose fire can be split between its two lanes (2-lane squad,
			barricade or contest row)
		RunnerSim.Stance(row, lane, lateral): number
			stance of a squad whose avatar is `lateral` studs right of the centre
			line and passes `lane`: how many of the formation's outer columns
			(FORMATION_SPACING_X apart) reach over the line between the two lanes,
			0..2: closer than 1 column to the line -> 2, closer than 2 -> 1, else 0.
			(The edge shift of RunnerDefs.FormationShift only happens deep in a
			lane, where no column reaches across.) The server computes it from
			where it saw the avatar cross the row.
		RunnerSim.UnitsAcross(units, row, lane, stance): number
			of `units` (troops incl. the avatar) how many shoot the other lane:
			the troops in the outer `stance` columns on that side, and only with
			more than WIDE_RANGE_MIN_COMPANIONS - 1 troops beside the avatar.
		RunnerSim.MinDuration(course): number
			fastest legal completion time in seconds (running only, anti-cheat floor).
		RunnerSim.UnitDps(stats, weaponTier, damageMult): number
			damage per second of ONE unit (the avatar or a troop: all fire the same gun)
			= WEAPONS[tier].damage x WEAPONS[tier].fireRate
			  x (stats.damage / EconomyDefs.Runner.BaseDamage) x damageMult
		RunnerSim.BossHp(course, stats): number
			boss max HP = BOSS_HP_SHARE x the most damage ANY lane path could deal
			to a boss that never dies (memoized per course table + stats)
		RunnerSim.BossFight(units, unitDps, bossHp): BossOutcome   exact closed form
		RunnerSim.BossHpAt(outcome, t): number     boss HP t seconds into the fight
		RunnerSim.AliveAt(outcome, t): number      units alive t seconds into the fight
		RunnerSim.BossDamagePotential(units, unitDps): number
			damage a squad deals if the boss never dies: unitDps x interval x N(N+1)/2
		RunnerSim.LastSearch: { states: number, maxFrontier: number, capHit: boolean }
			statistics of the most recent BestCase call (tests check capHit).
		RunnerSim.STATE_CAP: number

	Rules (all numbers are in RunnerDefs):
		State during a run: troops (>= 1, the avatar always survives the rows),
		weaponTier (1 Pistol .. 6 Rocket), damageMult (in-run damage gates,
		starts at 1), carried cash (capped by stats.capacity) and banked value.
		Gate "+N" adds N troops, "xN" multiplies, "-N" subtracts, "÷N" divides
		(rounded down). Troops never drop below 1 on the track.
		Gold weapon gate: +1 weapon tier and banks that weapon's cash value
		(at the top tier it still banks the Rocket value).
		Gold damage gate: damageMult +0.2 and banks DAMAGE_GATE_VALUE.
		Cash stack: added to carried cash up to stats.capacity; the rest is
		lost and reported ("bag full"). [REQUIREMENT: coin-carrying capacity]
		Squad: the squad shoots it for ENGAGE_SECONDS (guns reach 1.5 rows):
		damage = troops x UnitDps x ENGAGE_SECONDS, kills floor(damage / soldier
		hp) soldiers (reward each); every surviving soldier costs 1 troop.
		Barricade: destroyed if troops x UnitDps x ENGAGE_SECONDS >= hp (reward
		banked), otherwise you lose 25% of your troops (min 1 left).
		Wide shooting [owner request]: in a 2-lane squad / barricade / contest
		row, UnitsAcross(...) of the units shoot the OTHER lane instead: they
		kill soldiers there (reward, no troop cost), can destroy that barricade
		(reward) or grow that contest gate. The rest shoot the lane you pass.
		Contest ("shoot to grow") gate: the damage a side takes adds
		min(growMax, floor(damage / growHp)) steps of growStep troops to its
		number; you pass one side: blue "+N" adds N troops, red "-N" removes N.
		Boss at the castle: every BossKillInterval(N) seconds it kills one unit
		(troops first, the avatar last) while all living units shoot it. Its HP
		is BossHp(course, stats), so only (near) best lane paths beat it.
		Victory: the boss reward is paid and the units still alive count as
		troops at the finish. Defeat: no boss reward and 0 troops at the finish.
		Payout = survivors x troop value + carried cash + banked upgrade values
		+ enemy rewards + boss reward, then + payoutBonus. Whole dollars.

	Boss fight closed form: with N units, unit DPS u and interval I, during
	kill interval k (time (k-1)I .. kI) N-(k-1) units are alive, so the damage
	by the end of interval k is D(k) = u I (kN - k(k-1)/2). The boss dies in
	the first interval k with D(k) >= hp; if even D(N) = u I N(N+1)/2 < hp,
	every unit dies and the boss survives.

	Why BestCase is exact: the final payout never goes down when any of
	(troops, weaponTier, damageMult, carried, banked) goes up (the boss damage
	potential, victory and the survivors all rise with troops and unit DPS),
	and every row rule keeps that order for a fixed (lane, stance): more units
	or DPS means more damage on BOTH lanes (UnitsAcross grows by at most one
	unit per extra troop). The one exception is a red contest gate, which
	takes more troops from a stronger squad - but its blue side is better in
	every state (more troops, nothing else differs), so some best run never
	passes a red contest gate and every other rule is monotone. So a partial
	run that is <= another one in all five numbers can never finish ahead of
	it, and dropping it (Pareto pruning) never loses the optimum. The same
	argument with only (troops, weaponTier, damageMult) makes BossHp's search
	exact. Each split row is searched for every lane x stance 0..MAX_STANCE.
]]

local Shared = script.Parent.Parent
local EconomyDefs = require(Shared:WaitForChild("EconomyDefs"))
local Format = require(Shared:WaitForChild("Format"))
local RunnerCourse = require(script.Parent:WaitForChild("RunnerCourse"))
local RunnerDefs = require(script.Parent:WaitForChild("RunnerDefs"))

export type Stats = { startTroops: number, damage: number, capacity: number, payoutBonus: number? }

export type RowOutcome = {
	row: number,
	lane: number,
	kind: string,
	label: string,
	troopsBefore: number,
	troopsAfter: number,
	cashBefore: number,
	cashAfter: number,
	weaponTier: number,
	damageMult: number,
	destroyed: boolean?,
	note: string?,
	-- Fights and contest gates (nil elsewhere):
	stance: number?, -- 0..MAX_STANCE used (0 when the squad was too small for wide shooting)
	across: number?, -- units that shot the other lane
	damage: number?, -- damage dealt to the lane you passed
	otherDamage: number?, -- damage dealt to the other lane
	kills: number?, -- squad: soldiers killed in the lane you passed
	otherKills: number?, -- squad: soldiers killed in the other lane
	otherDestroyed: boolean?, -- barricade: the other barricade was destroyed too
	amount: number?, -- contest: the number of the gate you passed after growing
	steps: number?, -- contest: growth steps of the gate you passed
	otherAmount: number?, -- contest: the other gate's number after growing
	otherSteps: number?,
}

export type Line = { kind: string, label: string, detail: string, value: number }

export type BossOutcome = {
	hp: number, -- boss max HP for this course + stats
	victory: boolean,
	units: number, -- units that reached the castle (troops incl. the avatar)
	unitDps: number,
	interval: number, -- seconds between boss kills
	killed: number, -- units the boss killed (troops first, the avatar last; = units on defeat)
	survivors: number, -- units alive at the end (0 on defeat)
	duration: number, -- seconds the fight lasts (boss death time on victory, units x interval on defeat)
	damageDealt: number, -- damage the squad dealt to the boss
	hpLeft: number, -- boss HP left (0 on victory)
}

export type Result = {
	troops: number, -- units alive AFTER the boss fight (0 on defeat)
	weaponTier: number,
	damageMult: number,
	collected: number,
	carried: number,
	outcomes: { RowOutcome },
	lines: { Line },
	total: number,
	boss: BossOutcome,
	unitDps: number, -- DPS of one unit at the castle
}

type Course = RunnerCourse.Course
type Row = RunnerCourse.Row
type Option = RunnerCourse.Option

-- Clean copy of the stats with safe values.
type CleanStats = { startTroops: number, damage: number, capacity: number, payoutBonus: number }

-- Result of walking through one option of one row.
type Step = {
	troops: number,
	tier: number,
	dmg: number,
	carried: number,
	bankDelta: number,
	collected: number, -- cash touched (before the capacity cap)
	overflow: number, -- cash lost because the bag was full
	kills: number,
	killReward: number,
	destroyed: boolean?,
	barricadeReward: number,
	upgradeKind: string?, -- "weapon" | "damage"
	upgradeValue: number,
	note: string?,
	barricades: number, -- barricades destroyed (yours + the other lane's)
	stance: number?,
	across: number?,
	damage: number?,
	otherDamage: number?,
	ownKills: number?,
	otherKills: number?,
	otherDestroyed: boolean?,
	amount: number?,
	steps: number?,
	otherAmount: number?,
	otherSteps: number?,
}

-- Search node for BestCase.
type Node = {
	troops: number,
	tier: number,
	dmg: number,
	carried: number,
	bank: number,
	lane: number,
	stance: number,
	parent: Node?,
}

local RunnerSim = {}

-- [PROPOSAL] Upper bound of partial runs kept per row by BestCase. Real
-- courses stay far below this (tests assert the cap is never hit).
RunnerSim.STATE_CAP = 200000
RunnerSim.LastSearch = { states = 0, maxFrontier = 0, capHit = false }

local EPS = 1e-9
local round = Format.RoundWhole

local function finite(n: any, fallback: number): number
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return fallback
	end
	return n
end

-- 12345 -> "12,345" (whole numbers for HP texts).
local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function cleanStats(stats: Stats): CleanStats
	local s: any = if type(stats) == "table" then stats else {}
	return {
		startTroops = math.max(1, math.floor(finite(s.startTroops, 1))),
		damage = math.max(0, finite(s.damage, 0)),
		-- Rounded DOWN so carried cash never exceeds the real capacity.
		capacity = math.floor(math.max(0, finite(s.capacity, 0)) + EPS),
		payoutBonus = math.clamp(finite(s.payoutBonus, 0), 0, 10),
	}
end

local function clampTier(weaponTier: number): number
	return math.clamp(math.floor(finite(weaponTier, 1)), 1, RunnerDefs.MAX_WEAPON_TIER)
end

-- UnitDps on already-clean numbers.
local function unitDps(damage: number, tier: number, dmg: number): number
	local w = RunnerDefs.WEAPONS[clampTier(tier)]
	return w.damage * w.fireRate * (damage / EconomyDefs.Runner.BaseDamage) * dmg
end

function RunnerSim.UnitDps(stats: Stats, weaponTier: number, damageMult: number): number
	local st = cleanStats(stats)
	return unitDps(st.damage, weaponTier, math.max(0, finite(damageMult, 1)))
end

-------------------------------------------------------------------------------
-- The boss fight (exact closed form)
-------------------------------------------------------------------------------
-- Damage dealt by the end of kill interval k: u I (kN - k(k-1)/2).
local function damageBy(units: number, u: number, interval: number, k: number): number
	return u * interval * (k * units - k * (k - 1) / 2)
end

function RunnerSim.BossDamagePotential(units: number, dps: number): number
	local n = math.max(0, math.floor(finite(units, 0)))
	local u = math.max(0, finite(dps, 0))
	return damageBy(n, u, RunnerDefs.BossKillInterval(n), n)
end

function RunnerSim.BossFight(units: number, dps: number, bossHp: number): BossOutcome
	local n = math.max(0, math.floor(finite(units, 0)))
	local u = math.max(0, finite(dps, 0))
	local hp = math.max(0, finite(bossHp, 0))
	local interval = RunnerDefs.BossKillInterval(n)
	local potential = damageBy(n, u, interval, n)

	if hp <= 0 then
		-- Nothing to beat (only hand-made courses): instant victory.
		return {
			hp = hp,
			victory = true,
			units = n,
			unitDps = u,
			interval = interval,
			killed = 0,
			survivors = n,
			duration = 0,
			damageDealt = 0,
			hpLeft = 0,
		}
	end
	if n <= 0 or u <= 0 or potential < hp then
		return {
			hp = hp,
			victory = false,
			units = n,
			unitDps = u,
			interval = interval,
			killed = n,
			survivors = 0,
			duration = n * interval,
			damageDealt = potential,
			hpLeft = hp - potential,
		}
	end

	-- First interval k with damageBy(k) >= hp: solve k^2 - (2N+1)k + 2h <= 0
	-- (h = hp / (u I)), then fix float noise by stepping.
	local h = hp / (u * interval)
	local b = 2 * n + 1
	local disc = math.max(0, b * b - 8 * h)
	local k = math.clamp(math.ceil((b - math.sqrt(disc)) / 2), 1, n)
	while k > 1 and damageBy(n, u, interval, k - 1) >= hp do
		k -= 1
	end
	while k < n and damageBy(n, u, interval, k) < hp do
		k += 1
	end
	local before = damageBy(n, u, interval, k - 1)
	local alive = n - (k - 1)
	local t = (k - 1) * interval + math.clamp((hp - before) / (u * alive), 0, interval)
	return {
		hp = hp,
		victory = true,
		units = n,
		unitDps = u,
		interval = interval,
		killed = k - 1,
		survivors = alive,
		duration = t,
		damageDealt = hp,
		hpLeft = 0,
	}
end

-- Boss HP `t` seconds into the fight described by `outcome`.
function RunnerSim.BossHpAt(outcome: BossOutcome, t: number): number
	local time = finite(t, 0)
	if time >= outcome.duration then
		return outcome.hpLeft
	elseif time <= 0 then
		return outcome.hp
	end
	local n, u, interval = outcome.units, outcome.unitDps, outcome.interval
	local k = math.clamp(math.floor(time / interval) + 1, 1, math.max(1, n))
	local dealt = damageBy(n, u, interval, k - 1) + u * (n - (k - 1)) * (time - (k - 1) * interval)
	return math.max(outcome.hpLeft, outcome.hp - dealt)
end

-- Units alive `t` seconds into the fight (a kill lands at the END of each interval).
function RunnerSim.AliveAt(outcome: BossOutcome, t: number): number
	local time = finite(t, 0)
	if time >= outcome.duration then
		return outcome.survivors
	elseif time <= 0 then
		return outcome.units
	end
	local killed = math.min(outcome.killed, math.floor(time / outcome.interval + EPS))
	return outcome.units - killed
end

-------------------------------------------------------------------------------
-- Rows
-------------------------------------------------------------------------------
-- Lane actually used in a row (invalid / missing -> 1).
local function laneFor(row: Row, choice: any): number
	if type(choice) == "number" and choice == math.floor(choice) and choice >= 1 and choice <= #row.options then
		return choice
	end
	return 1
end

function RunnerSim.IsSplitRow(row: Row): boolean
	return #row.options == 2 and (row.kind == "squad" or row.kind == "barricade" or row.kind == "contest")
end

-- Stance actually used (invalid / missing / not a split row -> 0).
local function stanceFor(row: Row, value: any): number
	if
		RunnerSim.IsSplitRow(row)
		and type(value) == "number"
		and value == math.floor(value)
		and value >= 0
		and value <= RunnerDefs.MAX_STANCE
	then
		return value
	end
	return 0
end

-- The other option of a 2-lane row, the x of the line between the two lanes
-- and the side the other lane is on (+1 = right of the lane you pass).
local function otherOf(row: Row, lane: number): (Option?, number, number)
	local own, other = row.options[lane], row.options[if lane == 1 then 2 else 1]
	if not own or not other then
		return nil, 0, 1
	end
	local left, right = own, other
	if other.x < own.x then
		left, right = other, own
	end
	local boundary = ((left.x + left.width / 2) + (right.x - right.width / 2)) / 2
	return other, boundary, if other.x >= own.x then 1 else -1
end

function RunnerSim.Stance(row: Row, lane: number, lateral: number): number
	if not RunnerSim.IsSplitRow(row) then
		return 0
	end
	local _, boundary, side = otherOf(row, laneFor(row, lane))
	-- How far the avatar stands inside its own lane, from the line (negative:
	-- it is over the line, e.g. a lane accepted within the edge tolerance).
	local inside = side * (boundary - finite(lateral, 0))
	local half = math.floor(math.max(1, math.floor(RunnerDefs.FORMATION_WIDTH)) / 2)
	local count = 0
	for column = 1, half do
		if column * RunnerDefs.FORMATION_SPACING_X > inside + EPS then
			count += 1
		end
	end
	return math.clamp(count, 0, RunnerDefs.MAX_STANCE)
end

-- Troops (of units - 1 beside the avatar) standing in the outer `stance`
-- formation columns on the `side` of the other lane (RunnerDefs.FormationSlot;
-- the edge shift never moves a troop into or out of the outermost columns).
local function unitsAcross(units: number, side: number, stance: number): number
	local companions = units - 1
	if stance <= 0 or companions < RunnerDefs.WIDE_RANGE_MIN_COMPANIONS then
		return 0
	end
	local half = math.floor(math.max(1, math.floor(RunnerDefs.FORMATION_WIDTH)) / 2)
	local first = half - stance + 1 -- outer columns: first .. half on that side
	local count = 0
	for i = 1, companions do
		local column = RunnerDefs.FormationSlot(i)
		if side * column >= first then
			count += 1
		end
	end
	return count
end

function RunnerSim.UnitsAcross(units: number, row: Row, lane: number, stance: number): number
	if not RunnerSim.IsSplitRow(row) then
		return 0
	end
	local _, _, side = otherOf(row, laneFor(row, lane))
	return unitsAcross(math.max(0, math.floor(finite(units, 0))), side, stanceFor(row, stance))
end

-- Growth steps and the number of a contest gate after taking `damage`.
local function contestGrowth(opt: Option, damage: number): (number, number)
	local growHp = math.max(EPS, finite(opt.growHp, math.huge))
	local maxSteps = math.max(0, math.floor(finite(opt.growMax, 0)))
	local steps = math.clamp(math.floor(damage / growHp + EPS), 0, maxSteps)
	local amount = math.max(0, math.floor(finite(opt.amount, 0))) + steps * math.max(0, math.floor(finite(opt.growStep, 0)))
	return steps, amount
end

-- Walk through one option. Pure: returns the new state numbers + what happened.
local function step(
	row: Row,
	lane: number,
	stance: number,
	stats: CleanStats,
	scale: number,
	troops: number,
	tier: number,
	dmg: number,
	carried: number
): Step
	local opt = row.options[lane]
	local s: Step = {
		troops = troops,
		tier = tier,
		dmg = dmg,
		carried = carried,
		bankDelta = 0,
		collected = 0,
		overflow = 0,
		kills = 0,
		killReward = 0,
		destroyed = nil,
		barricadeReward = 0,
		upgradeKind = nil,
		upgradeValue = 0,
		note = nil,
		barricades = 0,
	}
	local amount = finite(opt.amount, 0)

	-- 1) Troop maths / gold gates (contest gates grow first, see 3)
	local op = if row.kind == "contest" then nil else opt.op
	if op == "add" then
		s.troops = troops + math.max(0, math.floor(amount))
	elseif op == "mul" then
		s.troops = troops * math.max(1, math.floor(amount))
	elseif op == "sub" then
		s.troops = math.max(1, troops - math.max(0, math.floor(amount)))
	elseif op == "div" then
		s.troops = math.max(1, math.floor(troops / math.max(1, amount)))
	elseif op == "weapon" then
		s.tier = math.min(RunnerDefs.MAX_WEAPON_TIER, tier + math.max(1, math.floor(amount)))
		s.upgradeKind = "weapon"
		s.upgradeValue = round(RunnerDefs.WEAPONS[s.tier].value * scale)
		s.note = if tier >= RunnerDefs.MAX_WEAPON_TIER
			then "Weapon already maxed: bonus cash"
			else RunnerDefs.WEAPONS[s.tier].name .. "!"
	elseif op == "damage" then
		s.dmg = dmg + math.max(0, amount)
		s.upgradeKind = "damage"
		s.upgradeValue = round(RunnerDefs.DAMAGE_GATE_VALUE * scale)
		s.note = "+" .. math.floor(amount * 100 + 0.5) .. "% damage"
	end

	-- 2) Cash stack in this lane (cash rows and red toll gates), whole dollars
	local cash = math.max(0, round(finite(opt.cash, 0)))
	if cash > 0 then
		local room = math.max(0, stats.capacity - s.carried)
		local take = math.min(room, cash)
		s.collected = cash
		s.overflow = cash - take
		s.carried = s.carried + take
		if s.overflow > 0 then
			s.note = "Bag full: " .. Format.Money(s.overflow) .. " lost"
		end
	end

	-- 3) Fights and contest gates: the squad shoots for ENGAGE_SECONDS before
	-- it arrives; with wide shooting the outer columns over the other lane
	-- shoot that one (UnitsAcross).
	local fight = row.kind == "squad" or row.kind == "barricade" or row.kind == "contest"
	if fight then
		local other, _, side = otherOf(row, lane)
		local cleanStance = if other then stanceFor(row, stance) else 0
		local units = s.troops
		local across = if other then unitsAcross(units, side, cleanStance) else 0
		local perUnit = unitDps(stats.damage, s.tier, s.dmg) * RunnerDefs.ENGAGE_SECONDS
		local damage = (units - across) * perUnit
		local otherDamage = across * perUnit
		s.stance = if across > 0 then cleanStance else 0
		s.across = across
		s.damage = damage
		s.otherDamage = otherDamage

		if row.kind == "squad" and opt.enemies then
			local enemies = math.max(0, math.floor(finite(opt.enemies, 0)))
			local hp = math.max(EPS, finite(opt.hp, 1))
			local kills = math.min(enemies, math.floor(damage / hp + EPS))
			local survivors = enemies - kills
			local before = s.troops
			s.troops = math.max(1, s.troops - survivors)
			s.ownKills = kills
			s.kills = kills
			s.killReward = kills * math.max(0, round(finite(opt.reward, 0)))
			s.note = "Defeated " .. kills .. " of " .. enemies .. " soldiers, lost " .. (before - s.troops) .. " troops"
			if other and other.enemies and across > 0 then
				local otherEnemies = math.max(0, math.floor(finite(other.enemies, 0)))
				local otherKills =
					math.min(otherEnemies, math.floor(otherDamage / math.max(EPS, finite(other.hp, 1)) + EPS))
				s.otherKills = otherKills
				s.kills += otherKills
				s.killReward += otherKills * math.max(0, round(finite(other.reward, 0)))
				if otherKills > 0 then
					s.note = (s.note :: string) .. " (+" .. otherKills .. " in the other squad)"
				end
			end
		elseif row.kind == "barricade" and opt.hp then
			local hp = math.max(0, finite(opt.hp, 0))
			if damage + EPS >= hp then
				s.destroyed = true
				s.barricades += 1
				s.barricadeReward = math.max(0, round(finite(opt.reward, 0)))
				s.note = "Barricade destroyed! +" .. Format.Money(s.barricadeReward)
			else
				local before = s.troops
				s.destroyed = false
				s.troops = math.max(1, math.floor(s.troops * (1 - RunnerDefs.BARRICADE_TROOP_LOSS)))
				s.note = "Barricade too strong: lost " .. (before - s.troops) .. " troops"
			end
			if other and other.hp and across > 0 then
				local otherDestroyed = otherDamage + EPS >= math.max(0, finite(other.hp, 0))
				s.otherDestroyed = otherDestroyed
				if otherDestroyed then
					local reward = math.max(0, round(finite(other.reward, 0)))
					s.barricades += 1
					s.barricadeReward += reward
					s.note = (s.note :: string) .. " (other barricade too: +" .. Format.Money(reward) .. ")"
				end
			end
		elseif row.kind == "contest" then
			local steps, grown = contestGrowth(opt, damage)
			s.steps = steps
			s.amount = grown
			local before = s.troops
			if opt.op == "add" then
				s.troops = before + grown
			elseif opt.op == "sub" then
				s.troops = math.max(1, before - grown)
			end
			if other then
				s.otherSteps, s.otherAmount = contestGrowth(other, otherDamage)
			end
			local change = s.troops - before
			s.note = (if change >= 0 then "+" else "") .. change .. " troops (shot it " .. steps .. "x bigger)"
		end
	end

	s.bankDelta = s.upgradeValue + s.killReward + s.barricadeReward
	return s
end

-- `a` is at least as good as `b` in every dimension. Bank / carried are whole
-- dollars, so a 0.001 tolerance only absorbs floating-point noise.
local function dominates(a: Node, b: Node, troopsOnly: boolean): boolean
	return a.troops >= b.troops
		and a.tier >= b.tier
		and a.dmg >= b.dmg - EPS
		and (troopsOnly or (a.carried >= b.carried - 0.001 and a.bank >= b.bank - 0.001))
end

-- Sort order for pruning: biggest troops first, then the other dimensions.
local function nodeBefore(a: Node, b: Node): boolean
	if a.troops ~= b.troops then
		return a.troops > b.troops
	elseif a.tier ~= b.tier then
		return a.tier > b.tier
	elseif math.abs(a.dmg - b.dmg) > EPS then
		return a.dmg > b.dmg
	elseif math.abs(a.carried - b.carried) > EPS then
		return a.carried > b.carried
	end
	return a.bank > b.bank
end

local function prune(nodes: { Node }, troopsOnly: boolean): { Node }
	table.sort(nodes, nodeBefore)
	local kept: { Node } = {}
	for _, node in nodes do
		local dominated = false
		for _, k in kept do
			if dominates(k, node, troopsOnly) then
				dominated = true
				break
			end
		end
		if not dominated then
			table.insert(kept, node)
		end
	end
	return kept
end

-- Exact Pareto search over the whole course. troopsOnly = true ignores cash
-- and bank (enough for the boss damage maximum). Returns the final frontier.
local function search(
	course: Course,
	st: CleanStats,
	scale: number,
	troopsOnly: boolean
): ({ Node }, number, number, boolean)
	local frontier: { Node } = {
		{ troops = st.startTroops, tier = 1, dmg = 1, carried = 0, bank = 0, lane = 0, stance = 0, parent = nil },
	}
	local visited, maxFrontier, capHit = 1, 1, false

	for _, row in course.rows do
		local nextNodes: { Node } = {}
		if #row.options == 0 then
			-- Keep the same states; the lane is recorded as 1 (what Resolve uses).
			for _, node in frontier do
				table.insert(nextNodes, {
					troops = node.troops,
					tier = node.tier,
					dmg = node.dmg,
					carried = node.carried,
					bank = node.bank,
					lane = 1,
					stance = 0,
					parent = node,
				})
			end
		else
			-- Merge exact duplicates (same troops/tier/damage/cash): keep the richer bank.
			local byKey: { [string]: Node } = {}
			local split = RunnerSim.IsSplitRow(row)
			for _, node in frontier do
				-- Wide shooting only matters with enough troops beside the avatar.
				local maxStance = if split and node.troops - 1 >= RunnerDefs.WIDE_RANGE_MIN_COMPANIONS
					then RunnerDefs.MAX_STANCE
					else 0
				for lane = 1, #row.options do
					for stance = 0, maxStance do
						local s = step(row, lane, stance, st, scale, node.troops, node.tier, node.dmg, node.carried)
						local child: Node = {
							troops = s.troops,
							tier = s.tier,
							dmg = s.dmg,
							carried = if troopsOnly then 0 else s.carried,
							bank = if troopsOnly then 0 else node.bank + s.bankDelta,
							lane = lane,
							stance = stance,
							parent = node,
						}
						visited += 1
						local key = string.format("%d|%d|%.4f|%d", child.troops, child.tier, child.dmg, child.carried)
						local existing = byKey[key]
						if existing == nil then
							byKey[key] = child
							table.insert(nextNodes, child)
						elseif child.bank > existing.bank + 0.001 then
							-- Replace in place so the array order stays deterministic.
							existing.bank = child.bank
							existing.lane = child.lane
							existing.stance = child.stance
							existing.parent = child.parent
						end
					end
				end
			end
			nextNodes = prune(nextNodes, troopsOnly)
		end
		if #nextNodes > RunnerSim.STATE_CAP then
			capHit = true
			local trimmed: { Node } = table.create(RunnerSim.STATE_CAP)
			for i = 1, RunnerSim.STATE_CAP do
				trimmed[i] = nextNodes[i]
			end
			nextNodes = trimmed
		end
		maxFrontier = math.max(maxFrontier, #nextNodes)
		frontier = nextNodes
	end
	return frontier, visited, maxFrontier, capHit
end

-------------------------------------------------------------------------------
-- Boss HP (memoized per course table + the stats that matter)
-------------------------------------------------------------------------------
local bossHpMemo: { [any]: { [string]: number } } = setmetatable({}, { __mode = "k" }) :: any
local lastBossSearch = { states = 0, maxFrontier = 0, capHit = false }

local function bossHpClean(course: Course, st: CleanStats): number
	-- Capacity and the payout bonus never change troops or damage.
	local key = string.format("%d|%.6f", st.startTroops, st.damage)
	local perCourse = bossHpMemo[course]
	if perCourse == nil then
		perCourse = {}
		bossHpMemo[course] = perCourse
	end
	local cached = perCourse[key]
	if cached then
		return cached
	end
	local scale = RunnerCourse.ValueScale(course.area, course.level)
	local frontier, visited, maxFrontier, capHit = search(course, st, scale, true)
	local best = 0
	for _, node in frontier do
		best = math.max(best, RunnerSim.BossDamagePotential(node.troops, unitDps(st.damage, node.tier, node.dmg)))
	end
	lastBossSearch = { states = visited, maxFrontier = maxFrontier, capHit = capHit }
	-- Whole HP for the health bar; floor keeps it <= SHARE x best, so the best
	-- path always wins. With no damage at all the boss cannot be beaten.
	local hp = math.max(1, math.floor(RunnerDefs.BOSS_HP_SHARE * best))
	perCourse[key] = hp
	return hp
end

function RunnerSim.BossHp(course: Course, stats: Stats): number
	return bossHpClean(course, cleanStats(stats))
end

-------------------------------------------------------------------------------
-- Finish line
-------------------------------------------------------------------------------
type Finish = { boss: BossOutcome, dps: number, troopsValue: number, bossValue: number }

local function finish(course: Course, st: CleanStats, scale: number, troops: number, tier: number, dmg: number): Finish
	local dps = unitDps(st.damage, tier, dmg)
	local boss = RunnerSim.BossFight(troops, dps, bossHpClean(course, st))
	local troopsValue = if boss.victory then round(boss.survivors * RunnerDefs.TROOP_VALUE * scale) else 0
	local bossValue = if boss.victory then math.max(0, round(finite(course.boss.reward, 0))) else 0
	return { boss = boss, dps = dps, troopsValue = troopsValue, bossValue = bossValue }
end

local function withBonus(base: number, st: CleanStats): (number, number)
	local bonus = if st.payoutBonus > 0 then round(base * st.payoutBonus) else 0
	return base + bonus, bonus
end

-- Total payout of a finished state (same maths as the lines in Resolve).
local function totalOf(course: Course, st: CleanStats, scale: number, node: Node): number
	local f = finish(course, st, scale, node.troops, node.tier, node.dmg)
	local total = withBonus(node.bank + node.carried + f.troopsValue + f.bossValue, st)
	return total
end

function RunnerSim.Resolve(course: Course, stats: Stats, choices: { number }, stances: { number }?): Result
	local st = cleanStats(stats)
	local scale = RunnerCourse.ValueScale(course.area, course.level)
	local picks: { any } = if type(choices) == "table" then choices else {}
	local aims: { any } = if type(stances) == "table" then stances else {}

	local troops, tier, dmg, carried = st.startTroops, 1, 1, 0
	local collected = 0
	local overflowTotal = 0
	local kills, killValue = 0, 0
	local barricades, barricadeValue = 0, 0
	local outcomes: { RowOutcome } = {}
	local upgradeLines: { Line } = {}

	for index, row in course.rows do
		if #row.options == 0 then
			continue
		end
		local lane = laneFor(row, picks[index])
		local opt = row.options[lane]
		local s = step(row, lane, stanceFor(row, aims[index]), st, scale, troops, tier, dmg, carried)

		table.insert(outcomes, {
			row = index,
			lane = lane,
			kind = row.kind,
			label = opt.label,
			troopsBefore = troops,
			troopsAfter = s.troops,
			cashBefore = carried,
			cashAfter = s.carried,
			weaponTier = s.tier,
			damageMult = s.dmg,
			destroyed = s.destroyed,
			note = s.note,
			stance = s.stance,
			across = s.across,
			damage = s.damage,
			otherDamage = s.otherDamage,
			kills = s.ownKills,
			otherKills = s.otherKills,
			otherDestroyed = s.otherDestroyed,
			amount = s.amount,
			steps = s.steps,
			otherAmount = s.otherAmount,
			otherSteps = s.otherSteps,
		})

		if s.upgradeKind == "weapon" then
			local name = RunnerDefs.WEAPONS[s.tier].name
			table.insert(upgradeLines, {
				kind = "weapon",
				label = "Weapon: " .. name .. (if tier >= RunnerDefs.MAX_WEAPON_TIER then " (MAX)" else ""),
				detail = "Gold gate, row " .. index,
				value = s.upgradeValue,
			})
		elseif s.upgradeKind == "damage" then
			table.insert(upgradeLines, {
				kind = "damage",
				label = "Damage +" .. math.floor((s.dmg - dmg) * 100 + 0.5) .. "%",
				detail = "Gold gate, row " .. index .. " (now +" .. math.floor((s.dmg - 1) * 100 + 0.5) .. "%)",
				value = s.upgradeValue,
			})
		end

		collected += s.collected
		overflowTotal += s.overflow
		kills += s.kills
		killValue += s.killReward
		barricades += s.barricades
		barricadeValue += s.barricadeReward
		troops, tier, dmg, carried = s.troops, s.tier, s.dmg, s.carried
	end

	local f = finish(course, st, scale, troops, tier, dmg)
	local boss = f.boss

	local lines: { Line } = {}
	for _, line in upgradeLines do
		table.insert(lines, line)
	end
	-- Separate the permanent starting troops (upgrades) from what this run
	-- added or lost (gates / enemies can also lower the count) and what the
	-- boss took.
	local gained = troops - st.startTroops
	table.insert(lines, {
		kind = "troops",
		label = "Troops at finish x " .. boss.survivors,
		detail = ("started with %d from upgrades, %s%d this run, %d lost to the boss"):format(
			st.startTroops,
			if gained >= 0 then "+" else "-",
			math.abs(gained),
			boss.killed
		),
		value = f.troopsValue,
	})
	local cashDetail = Format.Money(carried) .. " of " .. Format.Money(st.capacity) .. " capacity"
	if overflowTotal > 0 then
		cashDetail ..= ", " .. Format.Money(overflowTotal) .. " lost (bag full)"
	end
	table.insert(lines, { kind = "cash", label = "Cash carried", detail = cashDetail, value = carried })
	local enemyDetail = kills .. " soldiers"
	if barricades > 0 then
		enemyDetail ..= " + " .. barricades .. (if barricades == 1 then " barricade" else " barricades")
	end
	table.insert(lines, {
		kind = "enemies",
		label = "Enemies defeated x " .. kills,
		detail = enemyDetail,
		value = killValue + barricadeValue,
	})
	if boss.victory then
		table.insert(lines, {
			kind = "boss",
			label = "Boss defeated!",
			detail = ("Boss HP %s beaten in %.1f s"):format(commas(boss.hp), boss.duration),
			value = f.bossValue,
		})
	else
		table.insert(lines, {
			kind = "boss",
			label = "Defeated by the boss",
			detail = ("Boss had %s HP left - only the best lanes beat it"):format(commas(boss.hpLeft)),
			value = 0,
		})
	end

	local base = 0
	for _, line in lines do
		base += line.value
	end
	local total, bonus = withBonus(base, st)
	if st.payoutBonus > 0 then
		table.insert(lines, {
			kind = "bonus",
			label = "Bonus +" .. Format.Percent(math.floor(st.payoutBonus * 1000 + 0.5) / 1000),
			detail = "Payout bonus",
			value = bonus,
		})
	end

	return {
		troops = boss.survivors,
		weaponTier = tier,
		damageMult = dmg,
		collected = collected,
		carried = carried,
		outcomes = outcomes,
		lines = lines,
		total = total,
		boss = boss,
		unitDps = f.dps,
	}
end

function RunnerSim.BestCase(course: Course, stats: Stats): (Result, { number }, { number })
	local st = cleanStats(stats)
	local scale = RunnerCourse.ValueScale(course.area, course.level)
	bossHpClean(course, st) -- memoized; its search is cheaper (3 dimensions)
	local bossSearch = lastBossSearch
	local frontier, visited, maxFrontier, capHit = search(course, st, scale, false)

	-- Pick the finished state with the biggest payout (first one wins ties).
	local best: Node = frontier[1]
	local bestTotal = -math.huge
	for _, node in frontier do
		local t = totalOf(course, st, scale, node)
		if t > bestTotal + 0.001 then
			best, bestTotal = node, t
		end
	end

	-- Walk back up the parents to recover the lane + stance of every row.
	local reversed: { Node } = {}
	local cursor: Node? = best
	while cursor and cursor.parent do
		table.insert(reversed, cursor)
		cursor = cursor.parent
	end
	local choices: { number } = {}
	local stances: { number } = {}
	for i = #reversed, 1, -1 do
		table.insert(choices, reversed[i].lane)
		table.insert(stances, reversed[i].stance)
	end

	RunnerSim.LastSearch = {
		states = visited,
		maxFrontier = maxFrontier,
		capHit = capHit or bossSearch.capHit,
	}
	return RunnerSim.Resolve(course, stats, choices, stances), choices, stances
end

function RunnerSim.MinDuration(course: Course): number
	return math.max(0, finite(course.boss.distance, 0)) / RunnerDefs.RUN_SPEED
end

return RunnerSim
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Signal
	Tiny pure-Luau signal (no BindableEvents, safe to fire with tables).

		local s = Signal.new()
		local conn = s:Connect(function(a, b) ... end)
		s:Fire(1, 2)
		conn:Disconnect()
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self = setmetatable({ _handlers = {} :: { [any]: (...any) -> () } }, Signal)
	return (self :: any) :: Signal
end

function Signal:Connect(fn: (...any) -> ()): Connection
	local handlers = self._handlers
	local connection = {} :: any
	connection.Connected = true
	function connection.Disconnect(c)
		c.Connected = false
		handlers[c] = nil
	end
	handlers[connection] = fn
	return connection :: Connection
end

function Signal:Once(fn: (...any) -> ()): Connection
	local connection: Connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...: any)
	-- Copy first so handlers may disconnect while we iterate.
	local list = {}
	for _, fn in self._handlers do
		table.insert(list, fn)
	end
	for _, fn in list do
		task.spawn(fn, ...)
	end
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types
	Saved player data schema + defaults. All dictionary keys are strings so the
	table can be stored in a DataStore and sent over remotes unchanged.
]]

export type SectionState = {
	level: number, -- upgrade level, starts at 1
	stock: number, -- sales left before a manual restock is needed
	employee: boolean, -- true = auto-restocks
}

export type Item = {
	id: string, -- EquipmentDefs item id
	rarity: number, -- 1 Common .. 5 Legendary
	level: number, -- upgrade level, starts at 1
	perks: { string }?, -- perk ids rolled when the item dropped (Rare+), see EquipmentDefs
}

export type PlayerData = {
	version: number,
	cash: number,
	lifetimeCash: number,

	runner: {
		level: number, -- run counter shown as "Level N" (image 2)
		runs: number,
		bestPayout: number,
		-- Permanent upgrade levels bought before runs. [REQUIREMENT]
		upgrades: { troops: number, damage: number, capacity: number },
	},

	base: {
		highestArea: number, -- highest unlocked area (1..#Config.Areas)
		sections: { [string]: SectionState }, -- key = slot id ("a1s2"); present = unlocked
		barriers: { [string]: boolean }, -- key = tostring(area): barrier squad on that area's exit gate defeated
		arenaUnlocked: boolean,
	},

	combat: {
		highestLevel: number, -- highest Combat Arena level cleared
		wins: number,
		games: number,
	},

	inventory: { [string]: Item }, -- key = item uid
	equipped: { weapon: string?, armour: string? },
	nextUid: number,

	vehicles: { owned: { [string]: boolean }, equipped: string? },

	boosts: {
		multiplierSeconds: number, -- remaining play-time of the 2x cash boost
	},

	employeeTokens: number, -- Robux employees bought but not yet assigned
	receipts: { [string]: boolean }, -- processed purchase ids (idempotency)
	receiptOrder: { string },

	stats: {
		playSeconds: number,
		combatKills: number,
		sectionsUnlocked: number,
	},
}

local Types = {}

Types.DATA_VERSION = 1

-- Starter loadout (ids must exist in EquipmentDefs).
Types.STARTER_WEAPON_ID = "w_pistol"
Types.STARTER_ARMOUR_ID = "a_vest"

function Types.DefaultData(): PlayerData
	return {
		version = Types.DATA_VERSION,
		cash = 0,
		lifetimeCash = 0,
		runner = {
			level = 1,
			runs = 0,
			bestPayout = 0,
			upgrades = { troops = 0, damage = 0, capacity = 0 },
		},
		base = {
			highestArea = 1,
			sections = {},
			barriers = {},
			arenaUnlocked = false,
		},
		combat = { highestLevel = 0, wins = 0, games = 0 },
		inventory = {
			["1"] = { id = Types.STARTER_WEAPON_ID, rarity = 1, level = 1 },
			["2"] = { id = Types.STARTER_ARMOUR_ID, rarity = 1, level = 1 },
		},
		equipped = { weapon = "1", armour = "2" },
		nextUid = 3,
		vehicles = { owned = {}, equipped = nil },
		boosts = { multiplierSeconds = 0 },
		employeeTokens = 0,
		receipts = {},
		receiptOrder = {},
		stats = { playSeconds = 0, combatKills = 0, sectionsUnlocked = 0 },
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end
Types.DeepCopy = deepCopy

-- Fill any keys missing from `data` with defaults (used after loading old saves).
function Types.Reconcile(data: any): PlayerData
	local function fill(target: any, template: any)
		for k, v in template do
			if target[k] == nil or type(target[k]) ~= type(v) then
				-- Missing, or corrupted into the wrong type: use the default.
				target[k] = deepCopy(v)
			elseif type(v) == "table" and next(v) ~= nil then
				-- Only recurse into "struct" tables, not open maps such as inventory.
				local isStruct = true
				for key in v do
					if type(key) ~= "string" or tonumber(key) ~= nil then
						isStruct = false
						break
					end
				end
				if isStruct then
					fill(target[k], v)
				end
			end
		end
	end
	if type(data) ~= "table" then
		return Types.DefaultData()
	end
	local template = Types.DefaultData()
	-- Never re-add the starter items to an existing inventory.
	template.inventory = {}
	template.equipped = {}
	fill(data, template)
	return data :: PlayerData
end

return Types
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">VehicleModels</string>
          <string name="Source"><![CDATA[--!strict
--[[
	VehicleModels (shared)
	Builds the chunky, toy-like vehicles out of plain Parts (no meshes, no
	asset ids). Used by the server's VehicleService when a player presses
	"Ride": the model is welded to the character's HumanoidRootPart.

	Public API:
		VehicleModels.Build(def: Config.VehicleDef): Model
			Returns a Model whose PrimaryPart is "Root": an invisible part that
			sits exactly where the HumanoidRootPart goes (the model is built
			around the origin, facing -Z like a character). Every other part is
			already welded to Root with a WeldConstraint and is Massless,
			CanCollide = false, CanQuery = false, CanTouch = false and
			unanchored, so the vehicle never changes how the character walks.
			The caller moves it with model:PivotTo(rootPart.CFrame) and welds
			Root to the HumanoidRootPart.
		VehicleModels.STYLES: { string }   -- every style Build understands
		VehicleModels.GROUND_OFFSET: number -- floor height relative to Root (-3)

	Styles (Config.Vehicles[*].style):
		"bike"  two wheels, frame, handlebars, headlight
		"jeep"  open-top tub, 4 wheels, windscreen, roll bar, spare tyre
		"truck" cab with roof around the driver, bonnet, olive canvas back
		"apc"   6 wheels, armoured box with a sloped front and a hatch
		"tank"  two tracks with road wheels, hull, turret + long barrel
		"hover" floating hull with glowing Neon thrusters (no wheels)
	Unknown styles fall back to "jeep".

	How the character fits: the HumanoidRootPart centre of a normal avatar is
	3 studs above the floor, so the floor is at y = -3 in model space. Every
	body is built so that the legs (floor .. 2 studs up) end up inside it and
	the upper body pokes out like a driver.

	This module does not use any services and creates Instances only when
	Build is called, so requiring it is always safe.
]]

local Config = require(script.Parent.Config)

local P = Config.Palette

local VehicleModels = {}

VehicleModels.STYLES = { "bike", "jeep", "truck", "apc", "tank", "hover" }

-- Floor height relative to the HumanoidRootPart centre.
local G = -3
VehicleModels.GROUND_OFFSET = G

local RAD90 = math.rad(90)
-- A Roblox cylinder's round axis is its X axis. These rotations turn it:
local AXIS_Z = CFrame.Angles(0, RAD90, 0) -- round axis along Z (barrels, spare tyres)
local AXIS_Y = CFrame.Angles(0, 0, RAD90) -- round axis along Y (thrusters)

-- Darker version of a colour (for trims).
local function darken(color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end

type Kit = {
	model: Model,
	root: Part,
	body: Color3,
	trim: Color3,
}

type PartOptions = {
	shape: Enum.PartType?,
	material: Enum.Material?,
	transparency: number?,
	wedge: boolean?,
}

-- Create one welded, massless, non-colliding part. `cf` is relative to Root.
local function add(kit: Kit, name: string, size: Vector3, cf: CFrame, color: Color3, options: PartOptions?): BasePart
	local part: BasePart
	if options and options.wedge then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if options and options.shape then
			p.Shape = options.shape
		end
		part = p
	end
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = if options and options.material then options.material else Enum.Material.SmoothPlastic
	part.Transparency = if options and options.transparency then options.transparency else 0
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = kit.model

	local weld = Instance.new("WeldConstraint")
	weld.Name = "VehicleWeld"
	weld.Part0 = kit.root
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function box(kit: Kit, name: string, size: Vector3, pos: Vector3, color: Color3): BasePart
	return add(kit, name, size, CFrame.new(pos), color)
end

-- A wheel standing on the floor: tyre + lighter hub. Axle runs along X.
local function wheel(kit: Kit, x: number, z: number, radius: number, width: number)
	local centre = CFrame.new(x, G + radius, z)
	add(
		kit,
		"Tyre",
		Vector3.new(width, radius * 2, radius * 2),
		centre,
		P.PillBlack,
		{ shape = Enum.PartType.Cylinder }
	)
	add(
		kit,
		"Hub",
		Vector3.new(width + 0.1, radius * 1.0, radius * 1.0),
		centre,
		P.ButtonGrey,
		{ shape = Enum.PartType.Cylinder }
	)
end

-- Small glowing light (headlights, tail lights).
local function light(kit: Kit, pos: Vector3, size: number, color: Color3)
	add(kit, "Light", Vector3.new(size, size, 0.3), CFrame.new(pos), color, { material = Enum.Material.Neon })
end

-- Thin dark bar between two points (frames, roll bars, pillars).
local function bar(kit: Kit, a: Vector3, b: Vector3, thickness: number, color: Color3)
	local length = (b - a).Magnitude
	if length < 0.01 then
		return
	end
	-- lookAt has no valid answer when the bar points straight up/down with the
	-- default up vector, so use Z as "up" for (nearly) vertical bars.
	local direction = (b - a).Unit
	local up = if math.abs(direction.Y) > 0.99 then Vector3.zAxis else Vector3.yAxis
	local cf = CFrame.lookAt((a + b) / 2, b, up)
	add(kit, "Bar", Vector3.new(thickness, thickness, length), cf, color)
end

local function glass(kit: Kit, size: Vector3, pos: Vector3)
	add(kit, "Glass", size, CFrame.new(pos), P.TrackRail, { transparency = 0.45 })
end

-------------------------------------------------------------------------------
-- Styles. Front of the vehicle = -Z (the way the character looks).
-------------------------------------------------------------------------------

local function buildBike(kit: Kit)
	-- Wheels front and back.
	wheel(kit, 0, -2.5, 1.15, 0.7)
	wheel(kit, 0, 2.5, 1.15, 0.7)
	-- Fairing that hides the legs.
	box(kit, "Body", Vector3.new(2.4, 2.4, 3.2), Vector3.new(0, G + 1.7, 0), kit.body)
	box(kit, "StripeL", Vector3.new(0.1, 0.5, 3.0), Vector3.new(-1.25, G + 2.1, 0), kit.trim)
	box(kit, "StripeR", Vector3.new(0.1, 0.5, 3.0), Vector3.new(1.25, G + 2.1, 0), kit.trim)
	-- Seat on top, tank in front of the rider.
	box(kit, "Seat", Vector3.new(2.0, 0.4, 1.8), Vector3.new(0, G + 3.05, 0.6), P.GatePost)
	box(kit, "FuelTank", Vector3.new(2.0, 0.9, 1.2), Vector3.new(0, G + 3.0, -1.0), kit.trim)
	-- Front fork + handlebars + headlight.
	bar(kit, Vector3.new(-0.45, G + 1.15, -2.5), Vector3.new(-0.45, G + 3.6, -1.9), 0.25, P.GatePost)
	bar(kit, Vector3.new(0.45, G + 1.15, -2.5), Vector3.new(0.45, G + 3.6, -1.9), 0.25, P.GatePost)
	add(
		kit,
		"Handlebar",
		Vector3.new(3.0, 0.25, 0.25),
		CFrame.new(0, G + 3.7, -1.85),
		P.GatePost,
		{ shape = Enum.PartType.Cylinder }
	)
	box(kit, "GripL", Vector3.new(0.5, 0.35, 0.35), Vector3.new(-1.45, G + 3.7, -1.85), P.PillBlack)
	box(kit, "GripR", Vector3.new(0.5, 0.35, 0.35), Vector3.new(1.45, G + 3.7, -1.85), P.PillBlack)
	box(kit, "Lamp", Vector3.new(0.9, 0.9, 0.5), Vector3.new(0, G + 3.0, -2.1), kit.trim)
	light(kit, Vector3.new(0, G + 3.0, -2.4), 0.6, P.CoinShine)
	light(kit, Vector3.new(0, G + 2.4, 1.65), 0.4, P.ButtonRed)
	-- Mudguards.
	box(kit, "GuardF", Vector3.new(0.9, 0.2, 1.6), Vector3.new(0, G + 2.45, -2.5), kit.body)
	box(kit, "GuardB", Vector3.new(0.9, 0.2, 1.6), Vector3.new(0, G + 2.45, 2.6), kit.body)
end

local function buildJeep(kit: Kit)
	-- Wheels.
	for _, x in { -2.7, 2.7 } do
		for _, z in { -3.2, 3.2 } do
			wheel(kit, x, z, 1.2, 1.0)
		end
	end
	-- Chassis + running boards (hide the lower legs from the side).
	box(kit, "Chassis", Vector3.new(4.6, 0.7, 8.6), Vector3.new(0, G + 0.75, 0.2), P.GatePost)
	box(kit, "BoardL", Vector3.new(0.5, 0.8, 3.6), Vector3.new(-2.55, G + 1.0, 0), kit.trim)
	box(kit, "BoardR", Vector3.new(0.5, 0.8, 3.6), Vector3.new(2.55, G + 1.0, 0), kit.trim)
	-- Open-top tub.
	box(kit, "Tub", Vector3.new(5.0, 1.9, 7.4), Vector3.new(0, G + 2.05, 0.9), kit.body)
	box(kit, "TubRim", Vector3.new(5.2, 0.3, 7.6), Vector3.new(0, G + 3.1, 0.9), kit.trim)
	-- Bonnet in front.
	box(kit, "Bonnet", Vector3.new(5.0, 1.6, 2.4), Vector3.new(0, G + 2.0, -4.0), kit.body)
	box(kit, "Grille", Vector3.new(4.0, 1.0, 0.2), Vector3.new(0, G + 1.9, -5.25), P.GatePost)
	light(kit, Vector3.new(-1.7, G + 2.2, -5.3), 0.6, P.CoinShine)
	light(kit, Vector3.new(1.7, G + 2.2, -5.3), 0.6, P.CoinShine)
	-- Wheel arches.
	for _, x in { -2.7, 2.7 } do
		for _, z in { -3.2, 3.2 } do
			box(kit, "Arch", Vector3.new(1.3, 0.3, 2.8), Vector3.new(x, G + 2.65, z), kit.trim)
		end
	end
	-- Windscreen frame + glass.
	bar(kit, Vector3.new(-2.35, G + 3.1, -2.8), Vector3.new(-2.35, G + 4.7, -2.6), 0.25, P.GatePost)
	bar(kit, Vector3.new(2.35, G + 3.1, -2.8), Vector3.new(2.35, G + 4.7, -2.6), 0.25, P.GatePost)
	bar(kit, Vector3.new(-2.35, G + 4.7, -2.6), Vector3.new(2.35, G + 4.7, -2.6), 0.25, P.GatePost)
	glass(kit, Vector3.new(4.5, 1.4, 0.12), Vector3.new(0, G + 3.9, -2.7))
	-- Roll bar behind the driver.
	bar(kit, Vector3.new(-2.3, G + 3.1, 2.2), Vector3.new(-2.3, G + 5.0, 2.2), 0.3, P.GatePost)
	bar(kit, Vector3.new(2.3, G + 3.1, 2.2), Vector3.new(2.3, G + 5.0, 2.2), 0.3, P.GatePost)
	bar(kit, Vector3.new(-2.3, G + 5.0, 2.2), Vector3.new(2.3, G + 5.0, 2.2), 0.3, P.GatePost)
	-- Steering wheel.
	add(
		kit,
		"Steering",
		Vector3.new(0.2, 1.1, 1.1),
		CFrame.new(-0.0, G + 3.5, -1.5) * CFrame.Angles(0, RAD90, 0) * CFrame.Angles(0, 0, math.rad(-30)),
		P.PillBlack,
		{ shape = Enum.PartType.Cylinder }
	)
	-- Spare tyre on the back.
	add(
		kit,
		"SpareTyre",
		Vector3.new(0.7, 2.0, 2.0),
		CFrame.new(0, G + 2.4, 4.95) * AXIS_Z,
		P.PillBlack,
		{ shape = Enum.PartType.Cylinder }
	)
	add(
		kit,
		"SpareHub",
		Vector3.new(0.8, 1.0, 1.0),
		CFrame.new(0, G + 2.4, 4.95) * AXIS_Z,
		P.ButtonGrey,
		{ shape = Enum.PartType.Cylinder }
	)
	light(kit, Vector3.new(-2.1, G + 2.4, 4.65), 0.45, P.ButtonRed)
	light(kit, Vector3.new(2.1, G + 2.4, 4.65), 0.45, P.ButtonRed)
end

local function buildTruck(kit: Kit)
	local canvas = P.TroopGreenDark
	-- Wheels: one front axle, two rear axles.
	for _, x in { -2.8, 2.8 } do
		wheel(kit, x, -3.0, 1.3, 1.1)
		wheel(kit, x, 4.2, 1.3, 1.1)
		wheel(kit, x, 6.9, 1.3, 1.1)
	end
	box(kit, "Chassis", Vector3.new(4.8, 0.7, 12.6), Vector3.new(0, G + 1.0, 2.0), P.GatePost)
	box(kit, "StepL", Vector3.new(0.5, 1.0, 3.4), Vector3.new(-2.6, G + 0.9, 0.1), kit.trim)
	box(kit, "StepR", Vector3.new(0.5, 1.0, 3.4), Vector3.new(2.6, G + 0.9, 0.1), kit.trim)
	-- Cab around the driver: lower body, pillars, roof, windscreen.
	box(kit, "CabLower", Vector3.new(5.4, 2.0, 4.0), Vector3.new(0, G + 2.3, 0), kit.body)
	for _, x in { -2.5, 2.5 } do
		for _, z in { -1.8, 1.8 } do
			box(kit, "Pillar", Vector3.new(0.4, 2.7, 0.4), Vector3.new(x, G + 4.65, z), kit.body)
		end
	end
	box(kit, "Roof", Vector3.new(5.6, 0.5, 4.4), Vector3.new(0, G + 6.25, 0), kit.body)
	box(kit, "RoofTrim", Vector3.new(5.7, 0.15, 4.5), Vector3.new(0, G + 6.0, 0), kit.trim)
	glass(kit, Vector3.new(4.6, 2.4, 0.12), Vector3.new(0, G + 4.6, -1.85))
	-- Bonnet + grille + headlights.
	box(kit, "Bonnet", Vector3.new(5.0, 2.0, 2.6), Vector3.new(0, G + 2.4, -3.3), kit.body)
	box(kit, "Grille", Vector3.new(3.8, 1.3, 0.2), Vector3.new(0, G + 2.3, -4.65), P.GatePost)
	light(kit, Vector3.new(-1.9, G + 2.6, -4.7), 0.7, P.CoinShine)
	light(kit, Vector3.new(1.9, G + 2.6, -4.7), 0.7, P.CoinShine)
	box(kit, "Bumper", Vector3.new(5.4, 0.5, 0.5), Vector3.new(0, G + 1.4, -4.8), P.GatePost)
	-- Canvas back: cargo bed + canvas cover with dark ribs.
	box(kit, "Bed", Vector3.new(5.6, 1.0, 7.0), Vector3.new(0, G + 1.85, 5.6), kit.trim)
	box(kit, "Canvas", Vector3.new(5.4, 3.6, 6.8), Vector3.new(0, G + 4.15, 5.6), canvas)
	for _, z in { 2.6, 4.6, 6.6, 8.6 } do
		box(kit, "Rib", Vector3.new(5.6, 0.25, 0.3), Vector3.new(0, G + 6.0, z), darken(canvas, 0.35))
		box(kit, "RibL", Vector3.new(0.12, 3.6, 0.3), Vector3.new(-2.75, G + 4.15, z), darken(canvas, 0.35))
		box(kit, "RibR", Vector3.new(0.12, 3.6, 0.3), Vector3.new(2.75, G + 4.15, z), darken(canvas, 0.35))
	end
	light(kit, Vector3.new(-2.2, G + 1.85, 9.15), 0.5, P.ButtonRed)
	light(kit, Vector3.new(2.2, G + 1.85, 9.15), 0.5, P.ButtonRed)
end

local function buildApc(kit: Kit)
	for _, x in { -3.2, 3.2 } do
		for _, z in { -3.6, 0.4, 4.4 } do
			wheel(kit, x, z, 1.25, 1.0)
		end
	end
	-- Armoured box.
	box(kit, "Hull", Vector3.new(6.0, 2.8, 10.4), Vector3.new(0, G + 2.1, 0.6), kit.body)
	box(kit, "Skirt", Vector3.new(5.2, 0.8, 10.0), Vector3.new(0, G + 0.8, 0.6), P.GatePost)
	-- Sloped front (WedgePart: tall side at the back, slope down towards -Z).
	add(kit, "Glacis", Vector3.new(6.0, 2.0, 2.6), CFrame.new(0, G + 2.5, -5.9), kit.body, { wedge = true })
	box(kit, "Nose", Vector3.new(6.0, 0.8, 2.6), Vector3.new(0, G + 1.1, -5.9), kit.trim)
	-- Side armour bands and fenders.
	box(kit, "BandL", Vector3.new(0.2, 0.5, 10.2), Vector3.new(-3.05, G + 2.7, 0.6), kit.trim)
	box(kit, "BandR", Vector3.new(0.2, 0.5, 10.2), Vector3.new(3.05, G + 2.7, 0.6), kit.trim)
	-- Hatch rim around the driver (torso pokes out of the roof).
	local top = G + 3.5
	box(kit, "HatchF", Vector3.new(2.8, 0.5, 0.4), Vector3.new(0, top + 0.25, -1.2), P.GatePost)
	box(kit, "HatchB", Vector3.new(2.8, 0.5, 0.4), Vector3.new(0, top + 0.25, 1.2), P.GatePost)
	box(kit, "HatchL", Vector3.new(0.4, 0.5, 2.8), Vector3.new(-1.2, top + 0.25, 0), P.GatePost)
	box(kit, "HatchR", Vector3.new(0.4, 0.5, 2.8), Vector3.new(1.2, top + 0.25, 0), P.GatePost)
	box(kit, "HatchLid", Vector3.new(2.4, 0.25, 2.2), Vector3.new(0, top + 1.2, 2.2), kit.trim)
	-- Roof machine gun.
	box(kit, "GunMount", Vector3.new(0.8, 0.8, 0.8), Vector3.new(1.8, top + 0.4, -2.0), P.GatePost)
	add(
		kit,
		"GunBarrel",
		Vector3.new(2.8, 0.3, 0.3),
		CFrame.new(1.8, top + 0.6, -3.4) * AXIS_Z,
		P.GatePost,
		{ shape = Enum.PartType.Cylinder }
	)
	light(kit, Vector3.new(-2.2, G + 2.0, -7.25), 0.6, P.CoinShine)
	light(kit, Vector3.new(2.2, G + 2.0, -7.25), 0.6, P.CoinShine)
	light(kit, Vector3.new(-2.4, G + 2.4, 5.85), 0.45, P.ButtonRed)
	light(kit, Vector3.new(2.4, G + 2.4, 5.85), 0.45, P.ButtonRed)
end

local function buildTank(kit: Kit)
	-- Tracks with road wheels on both sides.
	for _, x in { -3.3, 3.3 } do
		box(kit, "Track", Vector3.new(1.8, 2.0, 11.4), Vector3.new(x, G + 1.0, 0.4), P.PillBlack)
		box(kit, "TrackGuard", Vector3.new(2.0, 0.3, 11.8), Vector3.new(x, G + 2.15, 0.4), kit.trim)
		local outer = x + math.sign(x) * 0.95
		for _, z in { -4.0, -2.0, 0.0, 2.0, 4.0 } do
			add(
				kit,
				"RoadWheel",
				Vector3.new(0.2, 1.4, 1.4),
				CFrame.new(outer, G + 0.85, z + 0.4),
				P.ButtonGreyDark,
				{ shape = Enum.PartType.Cylinder }
			)
		end
	end
	-- Hull (lower part hides the legs, upper part is the deck).
	box(kit, "HullLower", Vector3.new(4.8, 1.5, 10.6), Vector3.new(0, G + 1.15, 0.4), P.GatePost)
	box(kit, "Hull", Vector3.new(5.4, 1.5, 10.4), Vector3.new(0, G + 2.65, 0.6), kit.body)
	add(kit, "Glacis", Vector3.new(5.4, 1.5, 2.0), CFrame.new(0, G + 2.65, -5.6), kit.body, { wedge = true })
	-- Turret around the driver: the head pokes out of the top like a commander.
	box(kit, "Turret", Vector3.new(4.2, 1.4, 4.6), Vector3.new(0, G + 4.1, 0.4), kit.body)
	box(kit, "TurretTrim", Vector3.new(4.3, 0.25, 4.7), Vector3.new(0, G + 3.45, 0.4), kit.trim)
	box(kit, "Mantlet", Vector3.new(1.6, 1.0, 0.8), Vector3.new(0, G + 4.1, -2.2), kit.trim)
	-- Long barrel pointing forward.
	add(
		kit,
		"Barrel",
		Vector3.new(6.4, 0.6, 0.6),
		CFrame.new(0, G + 4.15, -5.6) * AXIS_Z,
		kit.trim,
		{ shape = Enum.PartType.Cylinder }
	)
	add(
		kit,
		"Muzzle",
		Vector3.new(0.9, 0.85, 0.85),
		CFrame.new(0, G + 4.15, -8.8) * AXIS_Z,
		P.GatePost,
		{ shape = Enum.PartType.Cylinder }
	)
	-- Storage box on the back of the turret.
	box(kit, "Stowage", Vector3.new(3.6, 0.9, 0.9), Vector3.new(0, G + 4.0, 3.15), kit.trim)
	light(kit, Vector3.new(-2.0, G + 2.9, -6.65), 0.5, P.CoinShine)
	light(kit, Vector3.new(2.0, G + 2.9, -6.65), 0.5, P.CoinShine)
end

local function buildHover(kit: Kit)
	local glow = P.Sky
	-- Main hull floating above the floor.
	box(kit, "Skirt", Vector3.new(5.4, 1.0, 8.6), Vector3.new(0, G + 1.1, 0.4), P.GatePost)
	box(kit, "Hull", Vector3.new(6.0, 1.6, 9.0), Vector3.new(0, G + 2.4, 0.4), kit.body)
	add(kit, "Nose", Vector3.new(6.0, 1.6, 2.6), CFrame.new(0, G + 2.4, -5.4), kit.body, { wedge = true })
	box(kit, "Stripe", Vector3.new(6.1, 0.3, 9.1), Vector3.new(0, G + 2.0, 0.4), kit.trim)
	-- Low cockpit wall around the driver.
	box(kit, "CockpitL", Vector3.new(0.4, 0.9, 3.0), Vector3.new(-1.4, G + 3.65, 0), kit.trim)
	box(kit, "CockpitR", Vector3.new(0.4, 0.9, 3.0), Vector3.new(1.4, G + 3.65, 0), kit.trim)
	glass(kit, Vector3.new(3.2, 1.2, 0.15), Vector3.new(0, G + 3.8, -1.6))
	-- Side fins.
	add(
		kit,
		"FinL",
		Vector3.new(0.3, 1.6, 2.6),
		CFrame.new(-3.1, G + 3.6, 3.4) * CFrame.Angles(0, math.pi, 0),
		kit.trim,
		{ wedge = true }
	)
	add(
		kit,
		"FinR",
		Vector3.new(0.3, 1.6, 2.6),
		CFrame.new(3.1, G + 3.6, 3.4) * CFrame.Angles(0, math.pi, 0),
		kit.trim,
		{ wedge = true }
	)
	-- Glowing thrusters underneath (round axis pointing down) and at the back.
	for _, x in { -2.0, 2.0 } do
		for _, z in { -2.6, 3.4 } do
			add(
				kit,
				"Thruster",
				Vector3.new(0.35, 1.6, 1.6),
				CFrame.new(x, G + 0.45, z) * AXIS_Y,
				glow,
				{ shape = Enum.PartType.Cylinder, material = Enum.Material.Neon }
			)
		end
	end
	for _, x in { -1.6, 1.6 } do
		add(
			kit,
			"Engine",
			Vector3.new(0.6, 1.3, 1.3),
			CFrame.new(x, G + 2.5, 4.95) * AXIS_Z,
			P.GatePost,
			{ shape = Enum.PartType.Cylinder }
		)
		add(
			kit,
			"EngineGlow",
			Vector3.new(0.2, 1.0, 1.0),
			CFrame.new(x, G + 2.5, 5.3) * AXIS_Z,
			glow,
			{ shape = Enum.PartType.Cylinder, material = Enum.Material.Neon }
		)
	end
	-- A soft glow light under the hull.
	local pointLight = Instance.new("PointLight")
	pointLight.Color = glow
	pointLight.Range = 10
	pointLight.Brightness = 1.5
	pointLight.Parent = kit.root
end

local BUILDERS: { [string]: (Kit) -> () } = {
	bike = buildBike,
	jeep = buildJeep,
	truck = buildTruck,
	apc = buildApc,
	tank = buildTank,
	hover = buildHover,
}

-- Build a vehicle model for a Config.Vehicles entry (see header).
function VehicleModels.Build(def: Config.VehicleDef): Model
	local model = Instance.new("Model")
	model.Name = "Vehicle_" .. tostring(def.id)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = false
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root

	local bodyColor = if typeof(def.color) == "Color3" then def.color else P.TroopGreen
	local kit: Kit = {
		model = model,
		root = root,
		body = bodyColor,
		trim = darken(bodyColor, 0.4),
	}
	local builder = BUILDERS[def.style] or buildJeep
	builder(kit)
	return model
end

return VehicleModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point.
	Every ModuleScript directly inside Server/Services is a service:
		Service.Priority (optional, higher = initialised first)
		Service:Init(registry)  -- create state, register Net handlers (no cross-service calls)
		Service:Start()         -- connect events, may call other services
	`registry` maps service name -> service table, e.g. registry.DataService.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
Net.Setup()

local servicesFolder = script.Parent:WaitForChild("Services")
local registry: { [string]: any } = {}
local ordered = {}

for _, module in servicesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, service = pcall(require, module)
		if ok and type(service) == "table" then
			registry[module.Name] = service
			table.insert(ordered, { name = module.Name, service = service })
		else
			warn(("[Server] failed to load %s: %s"):format(module.Name, tostring(service)))
		end
	end
end

table.sort(ordered, function(a, b)
	local pa, pb = a.service.Priority or 0, b.service.Priority or 0
	if pa ~= pb then
		return pa > pb
	end
	return a.name < b.name
end)

for _, entry in ordered do
	if type(entry.service.Init) == "function" then
		local ok, err = pcall(entry.service.Init, entry.service, registry)
		if not ok then
			warn(("[Server] %s:Init failed: %s"):format(entry.name, tostring(err)))
		end
	end
end

for _, entry in ordered do
	if type(entry.service.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(entry.service.Start, entry.service)
			if not ok then
				warn(("[Server] %s:Start failed: %s"):format(entry.name, tostring(err)))
			end
		end)
	end
end

print(("[Server] started %d services"):format(#ordered))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BaseService (server)
	Runs the home base economy: unlocking revenue sections and the Combat
	Arena, upgrading sections, the sell/stock loop, manual restocking,
	employees (auto-restock) and the gates between areas.

	How a revenue section works (docs/ARCHITECTURE.md §6.2):
		* Every `saleInterval` seconds it makes one sale: it pays `incomePerSale`
		  (2x boost applies) and uses 1 stock.
		* At 0 stock it STOPS selling ("OUT OF STOCK!") until the player restocks
		  it by hand (hold the "Restock" prompt in front of it).
		* With an employee it restocks itself 3 seconds after reaching 0.
		Numbers come from Shared/Economy (SectionStats, prices).

	Requests the client can send (Net actions, all re-validated here):
		UnlockSlot(slotId)          buy a revenue section or the Combat Arena slot
		UpgradeSection(slotId)      raise a section's level (more income + stock)
		Restock(slotId)             refill a section's stock (free, manual work)
		HireEmployeeCash(slotId)    hire an employee for cash (20-run price)
		AssignEmployeeToken(slotId) use an employee token bought with Robux earlier
		UnlockGate(area)            open the gate from `area` into `area + 1`
	Every request checks: data loaded, Base mode, valid arguments, the area is
	unlocked, the player stands close to the right spot (Layout.INTERACT_RANGE)
	and the cost (DataService:SpendCash).

	Push events on the "Base" channel (Net.Fire("Base", player, msg, payload)):
		"Income"     { [slotId] = cashPaid }   once per second when sales happened
		"Restocked"  { slotId = string, by = "player" | "employee" }
		"Employee"   { slotId = string }        an employee was assigned

	Public API for other services (docs/ARCHITECTURE.md §4.3):
		BaseService:AssignEmployee(player, slotId): boolean
		BaseService:ApplyTimeSkip(player, seconds): number    -- cash paid (not 2x-boosted)
		BaseService:PreviewTimeSkip(player, seconds): number  -- what ApplyTimeSkip would pay now (no changes)
		  (both use Economy.TimeSkipPayout: shops without an employee stop at 0 stock)
		BaseService:MarkBarrierDefeated(player, area)
		BaseService:GetPassiveRate(player): number            -- $/s of sections that can sell
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData
type SectionState = Types.SectionState

local BaseService = {}
BaseService.Priority = 50

local Services: { [string]: any } = {}

-- Seconds an employee waits after stock reaches 0 before restocking. [REQUIREMENT §6.2]
local EMPLOYEE_RESTOCK_DELAY = 3
-- Revenue loop rate (1 Hz, well under the 30 Hz server limit).
local LOOP_INTERVAL = 1
-- [PROPOSAL] Never catch up more than 5 s of selling after a server hiccup.
local MAX_TICK = 5
-- [PROPOSAL] Safety cap for one time skip (the longest boost is 24 h).
local MAX_TIME_SKIP = 48 * 3600
-- Extra height tolerance for proximity checks (players may be jumping).
local MAX_HEIGHT_DIFF = 20

-- slot id -> where it lives
type SlotInfo = { area: number, index: number, def: Config.SlotDef }
local slotInfo: { [string]: SlotInfo } = {}
for areaIndex, areaDef in Config.Areas do
	for slotIndex, slotDef in areaDef.slots do
		slotInfo[slotDef.id] = { area = areaIndex, index = slotIndex, def = slotDef }
	end
end

-- Per-player timers that do not need saving.
type Runtime = {
	accum: { [string]: number }, -- seconds collected towards the next sale
	emptyFor: { [string]: number }, -- seconds an employee section has been at 0 stock
}
local runtime: { [Player]: Runtime } = {}
local loopStarted = false

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------
local function dataService(): any
	return Services.DataService
end

local function getData(player: Player): PlayerData?
	local ds = dataService()
	if not ds then
		return nil
	end
	return ds:Get(player)
end

local function markDirty(player: Player)
	local ds = dataService()
	if ds then
		ds:MarkDirty(player)
	end
end

local function getRuntime(player: Player): Runtime
	local rt = runtime[player]
	if not rt then
		rt = { accum = {}, emptyFor = {} }
		runtime[player] = rt
	end
	return rt
end

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function isInteger(value: any): boolean
	return isFiniteNumber(value) and value == math.floor(value)
end

local function inBaseMode(player: Player): boolean
	local modeService = Services.ModeService
	if not modeService then
		return true
	end
	return modeService:GetMode(player) == "Base"
end

-- Is the player's character standing within INTERACT_RANGE of `point`?
-- (Horizontal distance, with a generous height tolerance for jumping.)
local function isNear(player: Player, point: Vector3): boolean
	local character = player.Character
	if not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return false
	end
	local offset = root.Position - point
	local flat = Vector2.new(offset.X, offset.Z).Magnitude
	return flat <= Layout.INTERACT_RANGE and math.abs(offset.Y) <= MAX_HEIGHT_DIFF
end

-- Revenue section the player owns, or nil.
local function ownedSection(data: PlayerData, slotId: any): (SectionState?, SlotInfo?)
	if type(slotId) ~= "string" then
		return nil, nil
	end
	local info = slotInfo[slotId]
	if not info or info.def.kind ~= "revenue" then
		return nil, nil
	end
	local section = data.base.sections[slotId]
	if type(section) ~= "table" then
		return nil, info
	end
	return section, info
end

-- Repair anything odd in saved section data (old saves, bad edits).
local function sanitize(data: PlayerData)
	local base = data.base
	if type(base.sections) ~= "table" then
		base.sections = {}
	end
	if type(base.barriers) ~= "table" then
		base.barriers = {}
	end
	if not isInteger(base.highestArea) then
		base.highestArea = 1
	end
	base.highestArea = math.clamp(base.highestArea, 1, #Config.Areas)
	base.arenaUnlocked = base.arenaUnlocked == true
	for slotId, section in base.sections do
		local info = slotInfo[slotId]
		if type(section) ~= "table" or not info or info.def.kind ~= "revenue" then
			-- Unknown or broken entry: leave it alone, the loops skip it.
			continue
		end
		local level = if isFiniteNumber(section.level) then math.floor(section.level) else 1
		section.level = math.clamp(level, 1, Economy.SectionMaxLevel)
		local capacity = Economy.SectionStats(slotId, section.level).stockCapacity
		local stock = if isFiniteNumber(section.stock) then math.floor(section.stock) else capacity
		section.stock = math.clamp(stock, 0, capacity)
		section.employee = section.employee == true
	end
end

-- The last thing every action does: pay, mutate, sync.
local function fail(message: string): Net.Result
	return Net.Fail(message)
end

-- Shared first checks for every request. Returns data or an error result.
local function begin(player: Player): (PlayerData?, Net.Result?)
	local data = getData(player)
	if not data then
		return nil, fail("Your data is still loading, try again in a moment")
	end
	if not inBaseMode(player) then
		return nil, fail("You can only do that at your base")
	end
	return data, nil
end

-------------------------------------------------------------------------------
-- Public API (§4.3)
-------------------------------------------------------------------------------

-- Give an unlocked revenue section an employee. Used by HireEmployeeCash,
-- AssignEmployeeToken and the Robux receipt (ShopService). No cost, no
-- proximity check here: callers have already validated/paid.
function BaseService:AssignEmployee(player: Player, slotId: string): boolean
	local data = getData(player)
	if not data then
		return false
	end
	local section = ownedSection(data, slotId)
	if not section or section.employee then
		return false
	end
	section.employee = true
	-- If it is already empty the revenue loop restocks it 3 s from now.
	getRuntime(player).emptyFor[slotId] = 0
	markDirty(player)
	Net.Fire("Base", player, "Employee", { slotId = slotId })
	return true
end

-- Pay the revenue the player's sections would make in `seconds` seconds.
-- Rule (§6.2, maths in Economy.TimeSkipPayout): sales = floor(seconds /
-- saleInterval) per section; with an employee all sales are paid, without
-- one only min(sales, stock) and the stock goes down by that much. Clamped to
-- MAX_TIME_SKIP. Not 2x-boosted. Returns the cash paid.
function BaseService:ApplyTimeSkip(player: Player, seconds: number): number
	local data = getData(player)
	if not data or not isFiniteNumber(seconds) or seconds <= 0 then
		return 0
	end
	seconds = math.min(seconds, MAX_TIME_SKIP)
	local total, slots = Economy.TimeSkipPayout(data.base.sections, seconds)
	local perSlot: { [string]: number } = {}
	local changed = false
	for slotId, slot in slots do
		local section = data.base.sections[slotId]
		if slot.stockUsed > 0 and type(section) == "table" then
			section.stock = math.max(0, section.stock - slot.stockUsed)
			changed = true
		end
		perSlot[slotId] = slot.paid
	end
	if changed then
		markDirty(player)
	end
	if total <= 0 then
		return 0
	end
	local ds = dataService()
	local paid = if ds then ds:AddCash(player, total, { source = "timeskip" }) else 0
	if paid > 0 then
		Net.Fire("Base", player, "Income", perSlot)
	end
	return paid
end

-- What ApplyTimeSkip(player, seconds) would pay right now (same maths and
-- clamp, changes nothing). BoostService prices time skips from this.
function BaseService:PreviewTimeSkip(player: Player, seconds: number): number
	local data = getData(player)
	if not data or not isFiniteNumber(seconds) or seconds <= 0 then
		return 0
	end
	local total = Economy.TimeSkipPayout(data.base.sections, math.min(seconds, MAX_TIME_SKIP))
	return total
end

-- The barrier squad guarding `area`'s exit gate has been beaten (COMBAT).
function BaseService:MarkBarrierDefeated(player: Player, area: number)
	local data = getData(player)
	if not data or not isInteger(area) then
		return
	end
	if area < 1 or area >= #Config.Areas or area > data.base.highestArea then
		return
	end
	local key = tostring(area)
	if data.base.barriers[key] == true then
		return
	end
	data.base.barriers[key] = true
	markDirty(player)
	if area == data.base.highestArea then
		local nextArea = Config.Areas[area + 1]
		Net.Notify(
			player,
			("Barrier beaten! Unlock %s at the gate for %s"):format(
				nextArea.name,
				Format.Money(Economy.GatePrice(area))
			),
			"success"
		)
	end
end

-- Current $/s of every revenue section that can sell right now
-- (has stock, or has an employee who keeps it stocked). Not 2x-boosted.
function BaseService:GetPassiveRate(player: Player): number
	local data = getData(player)
	if not data then
		return 0
	end
	local rate = 0
	for slotId, section in data.base.sections do
		local info = slotInfo[slotId]
		if type(section) == "table" and info and info.def.kind == "revenue" then
			if section.employee or section.stock > 0 then
				rate += Economy.SectionStats(slotId, section.level).incomePerSecond
			end
		end
	end
	return rate
end

-------------------------------------------------------------------------------
-- Revenue loop (1 Hz, one loop for the whole server)
-------------------------------------------------------------------------------
-- [PROPOSAL] Sections keep selling while the player is in a run or a fight
-- (they are passive income); they only stop when the stock runs out.
local function tickPlayer(player: Player, data: PlayerData, dt: number)
	local rt = getRuntime(player)
	local ds = dataService()
	local income: { [string]: number } = {}
	local anyIncome = false
	local changed = false

	for slotId, section in data.base.sections do
		local info = slotInfo[slotId]
		if type(section) ~= "table" or not info or info.def.kind ~= "revenue" then
			continue
		end
		local stats = Economy.SectionStats(slotId, section.level)
		if stats.saleInterval <= 0 then
			continue
		end

		if section.stock > 0 then
			rt.emptyFor[slotId] = nil
			local t = (rt.accum[slotId] or 0) + dt
			local sales = 0
			-- 1e-6 tolerance so 0.1 + 0.2 style rounding never skips a sale.
			while t + 1e-6 >= stats.saleInterval and section.stock > 0 do
				t -= stats.saleInterval
				section.stock -= 1
				sales += 1
			end
			if section.stock <= 0 then
				section.stock = 0
				t = 0 -- stopped: the timer restarts after restocking
				rt.emptyFor[slotId] = 0
			end
			rt.accum[slotId] = math.max(0, t)
			if sales > 0 then
				changed = true
				local paid = if ds
					then ds:AddCash(player, sales * stats.incomePerSale, { boostable = true, source = "section" })
					else 0
				if paid > 0 then
					income[slotId] = paid
					anyIncome = true
				end
			end
		else
			-- Out of stock: no sales. An employee refills it after 3 seconds.
			rt.accum[slotId] = 0
			if section.employee then
				local waited = (rt.emptyFor[slotId] or 0) + dt
				if waited + 1e-6 >= EMPLOYEE_RESTOCK_DELAY then
					section.stock = stats.stockCapacity
					rt.emptyFor[slotId] = nil
					changed = true
					Net.Fire("Base", player, "Restocked", { slotId = slotId, by = "employee" })
				else
					rt.emptyFor[slotId] = waited
				end
			end
		end
	end

	if changed then
		markDirty(player)
	end
	if anyIncome then
		Net.Fire("Base", player, "Income", income)
	end
end

local function startLoop()
	if loopStarted then
		return -- never run two loops (that would double-pay)
	end
	loopStarted = true
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			local dt = math.clamp(now - last, 0, MAX_TICK)
			last = now
			local ds = dataService()
			if ds then
				for _, player in ds:GetLoadedPlayers() do
					local data = ds:Get(player)
					if data and player.Parent then
						-- xpcall: one broken save can never stop everyone's income.
						xpcall(tickPlayer, function(err: any)
							warn(("[BaseService] revenue tick failed for %s: %s"):format(player.Name, tostring(err)))
						end, player, data, dt)
					end
				end
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Request handlers
-------------------------------------------------------------------------------
local function registerHandlers()
	Net.Handle("UnlockSlot", function(player: Player, slotId: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		if type(slotId) ~= "string" or not slotInfo[slotId] then
			return fail("Unknown section")
		end
		local info = slotInfo[slotId]
		if info.area > data.base.highestArea then
			return fail("Unlock " .. Config.Areas[info.area].name .. " first")
		end
		local isArena = info.def.kind == "arena"
		if isArena then
			if data.base.arenaUnlocked then
				return fail("Already unlocked")
			end
		elseif data.base.sections[slotId] ~= nil then
			return fail("Already unlocked")
		end
		if not isNear(player, Layout.SlotCenter(info.area, info.index)) then
			return fail("Walk onto the unlock pad first")
		end
		local price = Economy.SlotUnlockPrice(slotId)
		if not isFiniteNumber(price) or price < 0 then
			return fail("This cannot be bought")
		end
		if not dataService():SpendCash(player, price) then
			return fail("Not enough cash! You need " .. Format.Money(price))
		end
		if isArena then
			data.base.arenaUnlocked = true
		else
			local stats = Economy.SectionStats(slotId, 1)
			data.base.sections[slotId] = { level = 1, stock = stats.stockCapacity, employee = false }
			data.stats.sectionsUnlocked += 1
			local rt = getRuntime(player)
			rt.accum[slotId] = 0
			rt.emptyFor[slotId] = nil
		end
		markDirty(player)
		return Net.Ok({ slotId = slotId })
	end)

	Net.Handle("UpgradeSection", function(player: Player, slotId: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		local section, info = ownedSection(data, slotId)
		if not section or not info then
			return fail("Unlock this section first")
		end
		local price = Economy.SectionUpgradePrice(info.def.id, section.level)
		if price == nil then
			return fail("Already at max level")
		end
		if not isNear(player, Layout.SlotFrontPosition(info.area, info.index)) then
			return fail("Walk up to the front of the shop first")
		end
		if not dataService():SpendCash(player, price) then
			return fail("Not enough cash! You need " .. Format.Money(price))
		end
		-- [PROPOSAL] Upgrading raises income and stock capacity but does not
		-- refill the current stock (restocking stays a separate action).
		section.level = math.min(section.level + 1, Economy.SectionMaxLevel)
		markDirty(player)
		return Net.Ok({ slotId = info.def.id, level = section.level })
	end)

	Net.Handle("Restock", function(player: Player, slotId: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		local section, info = ownedSection(data, slotId)
		if not section or not info then
			return fail("Unlock this section first")
		end
		local capacity = Economy.SectionStats(info.def.id, section.level).stockCapacity
		if section.stock >= capacity then
			return fail("Already fully stocked")
		end
		if not isNear(player, Layout.SlotFrontPosition(info.area, info.index)) then
			return fail("Walk up to the front of the shop first")
		end
		-- [PROPOSAL] Restocking is free: it is manual work, not a purchase.
		section.stock = capacity
		local rt = getRuntime(player)
		rt.emptyFor[info.def.id] = nil
		markDirty(player)
		Net.Fire("Base", player, "Restocked", { slotId = info.def.id, by = "player" })
		return Net.Ok({ slotId = info.def.id, stock = capacity })
	end)

	Net.Handle("HireEmployeeCash", function(player: Player, slotId: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		local section, info = ownedSection(data, slotId)
		if not section or not info then
			return fail("Unlock this section first")
		end
		if section.employee then
			return fail("This section already has an employee")
		end
		if not isNear(player, Layout.SlotHirePosition(info.area, info.index)) then
			return fail("Walk up to the Hire me tile first")
		end
		local price = Economy.EmployeeCashPrice(info.def.id, data.base.highestArea)
		if not isFiniteNumber(price) or price < 0 then
			return fail("This cannot be bought")
		end
		if not dataService():SpendCash(player, price) then
			return fail("Not enough cash! You need " .. Format.Money(price))
		end
		if not BaseService:AssignEmployee(player, info.def.id) then
			-- Should never happen (checked above), but never take cash for nothing.
			dataService():AddCash(player, price, { source = "refund" })
			return fail("Could not hire, your cash was refunded")
		end
		return Net.Ok({ slotId = info.def.id })
	end)

	Net.Handle("AssignEmployeeToken", function(player: Player, slotId: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		local tokens = data.employeeTokens
		if not isFiniteNumber(tokens) or tokens < 1 then
			return fail("You have no employee tokens")
		end
		local section, info = ownedSection(data, slotId)
		if not section or not info then
			return fail("Unlock this section first")
		end
		if section.employee then
			return fail("This section already has an employee")
		end
		if not isNear(player, Layout.SlotHirePosition(info.area, info.index)) then
			return fail("Walk up to the Hire me tile first")
		end
		data.employeeTokens = math.max(0, math.floor(tokens) - 1)
		if not BaseService:AssignEmployee(player, info.def.id) then
			data.employeeTokens += 1
			markDirty(player)
			return fail("Could not assign the employee")
		end
		markDirty(player)
		return Net.Ok({ slotId = info.def.id })
	end)

	Net.Handle("UnlockGate", function(player: Player, area: any)
		local data, err = begin(player)
		if not data then
			return err
		end
		if not isInteger(area) or area < 1 or area >= #Config.Areas then
			return fail("Unknown gate")
		end
		if area < data.base.highestArea then
			return fail("This gate is already open")
		end
		if area > data.base.highestArea then
			return fail("Open the gates before this one first")
		end
		if data.base.barriers[tostring(area)] ~= true then
			return fail("Defeat the barrier squad first!")
		end
		if not isNear(player, Layout.GatePosition(area)) then
			return fail("Walk up to the gate first")
		end
		local price = Economy.GatePrice(area)
		if not isFiniteNumber(price) or price < 0 then
			return fail("This gate cannot be opened")
		end
		if not dataService():SpendCash(player, price) then
			return fail("Not enough cash! You need " .. Format.Money(price))
		end
		data.base.highestArea = area + 1
		markDirty(player)
		local name = Config.Areas[area + 1].name
		Net.Notify(player, ("Area unlocked: %s!"):format(name), "success")
		return Net.Ok({ area = area + 1 })
	end)
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function BaseService:Init(registry: { [string]: any })
	Services = registry
	registerHandlers()
end

function BaseService:Start()
	local ds = dataService()
	if not ds then
		warn("[BaseService] DataService missing, base economy disabled")
		return
	end
	ds.PlayerLoaded:Connect(function(player: Player, data: PlayerData)
		sanitize(data)
		runtime[player] = nil
		markDirty(player)
	end)
	-- Players whose data loaded before we connected.
	for _, player in ds:GetLoadedPlayers() do
		local data = ds:Get(player)
		if data then
			sanitize(data)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		runtime[player] = nil
	end)
	startLoop()
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BoostService (server)
	Runs the two kinds of boosts from the brief:
		* 2x cash multiplier: doubles every "boostable" cash payout (runner,
		  shops, combat) while data.boosts.multiplierSeconds > 0. The timer only
		  goes down while the player is in the game (play-time). Buying more
		  adds more TIME; the multiplier itself is never more than 2x.
		* Time skip: instantly pays what the player's shops would earn in that
		  many hours (BaseService:ApplyTimeSkip does the maths). Shops without
		  an employee only pay until their stock runs out.
		  [PROPOSAL] Cash price = (1 - NetGainShare) x V with
		  V = min(Economy.BoostValue (area reference), BaseService:PreviewTimeSkip)
		  = Economy.TimeSkipCoinPrice, computed here at purchase time, so a
		  cash time skip always returns +25% of what was paid. A skip that would
		  pay less than $1 is never sold (cash or Robux).

	It also spawns the random boost OFFERS on the home map (Config.BoostOffers):
		* Per player, every MinInterval..MaxInterval seconds (only while the
		  player is in "Base" mode), at most MaxActive at a time.
		* Which boost appears is a weighted random pick using
		  Config.Boosts[i].weight, so cheap boosts show up much more often than
		  valuable ones (the brief's "luck" rule). Time skips are only in the
		  draw when they would pay >= 25% of their reference value right now
		  (Economy.TimeSkipWorthOffering); otherwise only 2x boosts appear.
		* The offer sits on a walkway of a random unlocked area and lives for
		  Lifetime seconds. Walking into it (client) opens a Robux-or-cash dialog.

	Requests (Net actions):
		BuyBoostOffer(offerId: string, route: "cash" | "robux", shownPrice: number?)
			Offer must be alive and the player within OFFER_RANGE studs.
			"cash"  -> pays BoostService:GetCashPrice(player, boostId), applies it.
			"robux" -> reserves the offer for 60 s and opens the Roblox purchase
			           window; ShopService's receipt applies the boost and calls
			           RemoveReservedOffer.

	Push events on the "Boost" channel (Net.Fire("Boost", player, msg, payload)):
		"Offer"     { id, boostId, position: Vector3, expiresAt: number }  (server time)
		"OfferGone" { id }
		"Timer"     { seconds }  2x seconds left (sent when it changes a lot)
	Client -> server on the same channel: "Ready" (the client asks for every
	live offer + the timer again, e.g. after its UI loaded).

	Public API (docs/ARCHITECTURE.md §4.4 + helpers for ShopService/DevService):
		BoostService:GetCashMultiplier(player): number            -- 2 while 2x is active, else 1
		BoostService:AddMultiplierMinutes(player, minutes)
		BoostService:ApplyBoost(player, boostId): boolean         -- true = applied
		BoostService:CanApplyBoost(player, boostId): (boolean, string?)  -- e.g. time skip that pays < $1
		BoostService:GetTimeSkipPreview(player, boostId): number  -- what a time skip pays now (0 for 2x)
		BoostService:GetCashPrice(player, boostId): number        -- cash price right now (math.huge = not for sale)
		BoostService:RemoveReservedOffer(player, boostId)         -- receipt finished
		BoostService:GetBoostDef(boostId): Config.BoostDef?
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)

local BoostService = {}
BoostService.Priority = 55

local Services: { [string]: any } = {}

-- Studs: how close the player must be to buy an offer (client opens at ~6).
local OFFER_RANGE = 12
-- Allowed height difference for the proximity check (jumping players).
local OFFER_HEIGHT = 20
-- Seconds a Robux purchase window keeps an offer alive.
local RESERVE_SECONDS = 60
-- [PROPOSAL] The very first offer after joining appears 45..75 s in, so new
-- players see the feature quickly; later ones use Config.BoostOffers.
local FIRST_OFFER_MIN = 45
local FIRST_OFFER_MAX = 75
-- [PROPOSAL] After returning to the base from a run/fight, wait at least
-- this long before a new offer appears.
local BACK_IN_BASE_DELAY = 10
-- Walkway placement (studs from the area centre along one arm of the
-- cross-shaped path). Plots start 14 studs from the centre line, the path is
-- 28 wide, so |lateral| <= 5 always stays on the walkway. [PROPOSAL]
local ARM_MIN = 22
local ARM_MAX = 46
local LATERAL_MAX = 5
local MIN_OFFER_SPACING = 14
-- Save the 2x timer at least this often (seconds) while it runs.
local TIMER_DIRTY_EVERY = 10
-- Safety cap for one AddMultiplierMinutes call (24 h).
local MAX_MINUTES_PER_CALL = 24 * 60

type Offer = {
	id: string,
	boostId: string,
	position: Vector3,
	expiresAt: number, -- workspace:GetServerTimeNow() based
	reservedUntil: number, -- os.clock(); 0 = not reserved
}

type PlayerState = {
	offers: { [string]: Offer },
	nextOfferAt: number, -- os.clock()
	sinceDirty: number,
	lastReady: number,
}

local states: { [Player]: PlayerState } = {}
local boostById: { [string]: Config.BoostDef } = {}
for _, def in Config.Boosts do
	boostById[def.id] = def
end

-- slot ids of every revenue section (not the Combat Arena)
local revenueSlots: { [string]: boolean } = {}
for _, area in Config.Areas do
	for _, slot in area.slots do
		if slot.kind == "revenue" then
			revenueSlots[slot.id] = true
		end
	end
end

local offerCounter = 0
local random = Random.new()

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function dataService(): any
	return Services.DataService
end

local function getData(player: Player): any
	local ds = dataService()
	return if ds then ds:Get(player) else nil
end

local function getMode(player: Player): string
	local modeService = Services.ModeService
	if modeService then
		return modeService:GetMode(player)
	end
	return (player:GetAttribute("Mode") :: string?) or "Base"
end

local function markDirty(player: Player)
	local ds = dataService()
	if ds then
		ds:MarkDirty(player)
	end
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function getState(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = {
			offers = {},
			nextOfferAt = os.clock() + random:NextNumber(FIRST_OFFER_MIN, FIRST_OFFER_MAX),
			sinceDirty = 0,
			lastReady = 0,
		}
		states[player] = state
	end
	return state
end

local function countOffers(state: PlayerState): number
	local n = 0
	for _ in state.offers do
		n += 1
	end
	return n
end

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function hasRevenueSection(data: any): boolean
	for slotId, section in data.base.sections do
		if type(section) == "table" and revenueSlots[slotId] then
			return true
		end
	end
	return false
end

-- What the time skip `def` would pay the player right now (0 if it is not a
-- time skip or BaseService is missing).
local function timeSkipPreview(player: Player, def: Config.BoostDef): number
	if def.kind ~= "timeskip" then
		return 0
	end
	local base = Services.BaseService
	if not base or type(base.PreviewTimeSkip) ~= "function" then
		return 0
	end
	local preview = base:PreviewTimeSkip(player, (def.hours or 0) * 3600)
	return if isFiniteNumber(preview) then math.max(0, preview) else 0
end

local function sendOffer(player: Player, offer: Offer)
	Net.Fire("Boost", player, "Offer", {
		id = offer.id,
		boostId = offer.boostId,
		position = offer.position,
		expiresAt = offer.expiresAt,
	})
end

local function removeOffer(player: Player, offerId: string)
	local state = states[player]
	if not state or not state.offers[offerId] then
		return
	end
	state.offers[offerId] = nil
	if player.Parent then
		Net.Fire("Boost", player, "OfferGone", { id = offerId })
	end
end

local function sendTimer(player: Player)
	local data = getData(player)
	if data and player.Parent then
		Net.Fire("Boost", player, "Timer", { seconds = math.max(0, data.boosts.multiplierSeconds or 0) })
	end
end

-- A random point on the walkway of one of the player's unlocked areas.
local function pickOfferPosition(data: any, state: PlayerState): Vector3
	local areaCount = #Config.Areas
	local highest = math.clamp(math.floor(tonumber(data.base.highestArea) or 1), 1, areaCount)
	local best: Vector3? = nil
	for _ = 1, 10 do
		local area = random:NextInteger(1, highest)
		local centre = Layout.AreaCenter(area)
		local along = random:NextNumber(ARM_MIN, ARM_MAX)
		local lateral = random:NextNumber(-LATERAL_MAX, LATERAL_MAX)
		local arm = random:NextInteger(1, 4)
		local offset: Vector3
		if arm == 1 then
			offset = Vector3.new(along, 0, lateral) -- east arm
		elseif arm == 2 then
			offset = Vector3.new(-along, 0, lateral) -- west arm
		elseif arm == 3 then
			offset = Vector3.new(lateral, 0, along) -- south arm
		else
			offset = Vector3.new(lateral, 0, -along) -- north arm
		end
		local candidate = Vector3.new(centre.X + offset.X, Layout.FLOOR_Y, centre.Z + offset.Z)
		local tooClose = false
		for _, other in state.offers do
			if (other.position - candidate).Magnitude < MIN_OFFER_SPACING then
				tooClose = true
				break
			end
		end
		best = candidate
		if not tooClose then
			break
		end
	end
	return best or (Layout.AreaCenter(1) + Vector3.new(ARM_MIN, 0, 0))
end

local function spawnOffer(player: Player, data: any, state: PlayerState)
	-- [PROPOSAL] Time skips only appear when they would pay at least 25% of
	-- their reference value right now (Economy.TimeSkipWorthOffering), so
	-- an offer is always worth buying. ShopUI shows chances from the same rule.
	local candidates: { Config.BoostDef } = {}
	for _, boost in Config.Boosts do
		if
			boost.kind ~= "timeskip"
			or Economy.TimeSkipWorthOffering(boost.id, data.base.highestArea, timeSkipPreview(player, boost))
		then
			table.insert(candidates, boost)
		end
	end
	-- Weighted pick: cheaper boosts (higher weight) appear more often.
	local total = 0
	for _, boost in candidates do
		total += math.max(0, boost.weight)
	end
	if total <= 0 or #candidates == 0 then
		return
	end
	local roll = random:NextNumber() * total
	local chosen = candidates[#candidates]
	for _, boost in candidates do
		roll -= math.max(0, boost.weight)
		if roll < 0 then
			chosen = boost
			break
		end
	end

	offerCounter += 1
	local offer: Offer = {
		id = "offer" .. offerCounter,
		boostId = chosen.id,
		position = pickOfferPosition(data, state),
		expiresAt = serverNow() + Config.BoostOffers.Lifetime,
		reservedUntil = 0,
	}
	state.offers[offer.id] = offer
	sendOffer(player, offer)
end

-------------------------------------------------------------------------------
-- 1 Hz loop: 2x timer + offers
-------------------------------------------------------------------------------

local function tickPlayer(player: Player, dt: number)
	local data = getData(player)
	if not data or not player.Parent then
		return
	end
	local state = getState(player)

	-- 2x timer (play-time only: this loop only sees players in the server).
	local seconds = tonumber(data.boosts.multiplierSeconds) or 0
	if seconds > 0 then
		seconds = math.max(0, seconds - dt)
		data.boosts.multiplierSeconds = seconds
		state.sinceDirty += dt
		if seconds <= 0 then
			state.sinceDirty = 0
			markDirty(player)
			sendTimer(player)
			Net.Notify(player, "⏱️ Your 2x cash boost has ended", "info")
		elseif state.sinceDirty >= TIMER_DIRTY_EVERY then
			state.sinceDirty = 0
			markDirty(player)
		end
	end

	-- Expire old offers (a reserved offer waits for its Robux window).
	local nowServer = serverNow()
	local nowClock = os.clock()
	for id, offer in state.offers do
		if nowServer >= offer.expiresAt and offer.reservedUntil <= nowClock then
			removeOffer(player, id)
		end
	end

	-- Spawn new offers only while the player is on the home map.
	if getMode(player) ~= "Base" then
		state.nextOfferAt = math.max(state.nextOfferAt, nowClock + BACK_IN_BASE_DELAY)
		return
	end
	if nowClock >= state.nextOfferAt then
		local interval = random:NextNumber(
			Config.BoostOffers.MinInterval,
			math.max(Config.BoostOffers.MinInterval, Config.BoostOffers.MaxInterval)
		)
		state.nextOfferAt = nowClock + interval
		if countOffers(state) < Config.BoostOffers.MaxActive then
			spawnOffer(player, data, state)
		end
	end
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------

function BoostService:GetBoostDef(boostId: string): Config.BoostDef?
	return boostById[boostId]
end

function BoostService:GetCashMultiplier(player: Player): number
	local data = getData(player)
	if data and (tonumber(data.boosts.multiplierSeconds) or 0) > 0 then
		return 2
	end
	return 1
end

function BoostService:AddMultiplierMinutes(player: Player, minutes: number)
	local data = getData(player)
	if not data or not isFiniteNumber(minutes) or minutes <= 0 then
		return
	end
	minutes = math.min(minutes, MAX_MINUTES_PER_CALL)
	local current = tonumber(data.boosts.multiplierSeconds) or 0
	data.boosts.multiplierSeconds = math.max(0, current) + minutes * 60
	markDirty(player)
	sendTimer(player)
end

function BoostService:GetTimeSkipPreview(player: Player, boostId: string): number
	local def = boostById[boostId]
	return if def then timeSkipPreview(player, def) else 0
end

-- Cash price right now. 2x: Economy.BoostCoinPrice. Time skip: 80% of what it
-- would pay now, capped at the area reference (Economy.TimeSkipCoinPrice).
function BoostService:GetCashPrice(player: Player, boostId: string): number
	local def = boostById[boostId]
	local data = getData(player)
	if not def or not data then
		return math.huge
	end
	if def.kind == "timeskip" then
		return Economy.TimeSkipCoinPrice(def.id, data.base.highestArea, timeSkipPreview(player, def))
	end
	return Economy.BoostCoinPrice(def.id, data.base.highestArea)
end

-- Can this boost do anything for the player right now? (A time skip that
-- would pay less than $1 is refused, for cash AND Robux.) [PROPOSAL]
function BoostService:CanApplyBoost(player: Player, boostId: string): (boolean, string?)
	local def = boostById[boostId]
	if not def then
		return false, "Unknown boost"
	end
	local data = getData(player)
	if not data then
		return false, "Your data is still loading"
	end
	if def.kind == "timeskip" then
		if not hasRevenueSection(data) then
			return false, "Unlock a revenue section first: time skips pay your shops' earnings"
		end
		if timeSkipPreview(player, def) < 1 then
			return false, "Your shops are out of stock: restock them or hire employees first"
		end
	end
	return true, nil
end

-- Give the player a boost (already paid for). Returns true when applied.
function BoostService:ApplyBoost(player: Player, boostId: string): boolean
	local def = boostById[boostId]
	local data = getData(player)
	if not def or not data then
		return false
	end
	if def.kind == "multiplier" then
		local minutes = def.minutes or 0
		if minutes <= 0 then
			return false
		end
		self:AddMultiplierMinutes(player, minutes)
		Net.Notify(player, ("⚡ 2x CASH for %d more minutes!"):format(minutes), "success")
		return true
	elseif def.kind == "timeskip" then
		local base = Services.BaseService
		if not base or type(base.ApplyTimeSkip) ~= "function" then
			return false
		end
		local hours = def.hours or 0
		local paid = base:ApplyTimeSkip(player, hours * 3600)
		paid = if isFiniteNumber(paid) then paid else 0
		Net.Notify(player, ("⏩ Time skip: +%s"):format(Format.Money(paid)), "cash")
		return true
	end
	return false
end

-- Called by ShopService after a Robux receipt for `boostId`: remove the offer
-- this player reserved for it (if it is still there).
function BoostService:RemoveReservedOffer(player: Player, boostId: string)
	local state = states[player]
	if not state then
		return
	end
	local bestId: string? = nil
	local bestReserve = 0
	for id, offer in state.offers do
		if offer.boostId == boostId and offer.reservedUntil > bestReserve then
			bestId = id
			bestReserve = offer.reservedUntil
		end
	end
	if bestId then
		removeOffer(player, bestId)
	end
end

-------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------

-- shownPrice (optional): the cash price the client's dialog displayed. The
-- server never charges more than that; if the price went up in the meantime
-- (stock restocked, new area) the purchase is refused so the player can look again.
local function buyBoostOffer(player: Player, offerId: any, route: any, shownPrice: any): Net.Result
	if type(offerId) ~= "string" or #offerId > 40 then
		return Net.Fail("Bad offer")
	end
	if route ~= "cash" and route ~= "robux" then
		return Net.Fail("Bad payment option")
	end
	local data = getData(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	if getMode(player) ~= "Base" then
		return Net.Fail("Go back to your base first")
	end
	local state = getState(player)
	local offer = state.offers[offerId]
	if not offer then
		return Net.Fail("That offer is gone")
	end
	local nowClock = os.clock()
	if serverNow() >= offer.expiresAt and offer.reservedUntil <= nowClock then
		removeOffer(player, offerId)
		return Net.Fail("That offer is gone")
	end
	local position = rootPosition(player)
	if not position then
		return Net.Fail("Your character is not ready")
	end
	local flat = Vector3.new(position.X - offer.position.X, 0, position.Z - offer.position.Z)
	if flat.Magnitude > OFFER_RANGE or math.abs(position.Y - offer.position.Y) > OFFER_HEIGHT then
		return Net.Fail("Walk closer to the offer")
	end
	local def = boostById[offer.boostId]
	if not def then
		removeOffer(player, offerId)
		return Net.Fail("That offer is gone")
	end
	local canApply, reason = BoostService:CanApplyBoost(player, def.id)
	if not canApply then
		return Net.Fail(reason or "You cannot use this boost yet")
	end

	if route == "cash" then
		-- Priced on the server right now (never trust a client price).
		local price = BoostService:GetCashPrice(player, def.id)
		if not isFiniteNumber(price) or price <= 0 then
			return Net.Fail("This boost cannot be bought with cash")
		end
		if isFiniteNumber(shownPrice) and price > (shownPrice :: number) + 0.01 then
			return Net.Fail("The price just changed, please check it again")
		end
		local ds = dataService()
		if not ds or not ds:SpendCash(player, price) then
			return Net.Fail("Not enough cash")
		end
		-- Remove first so a double click can never buy the same offer twice.
		removeOffer(player, offerId)
		if not BoostService:ApplyBoost(player, def.id) then
			-- Could not apply (service missing): give the money back.
			ds:AddCash(player, price, { source = "refund" })
			return Net.Fail("Boosts are not available right now")
		end
		return Net.Ok({ boostId = def.id, price = price })
	end

	-- Robux route. A time skip is only sold for Robux while it is worth buying
	-- (same rule as offering it), so a Robux skip never pays (almost) nothing.
	if def.kind == "timeskip" then
		local preview = BoostService:GetTimeSkipPreview(player, def.id)
		if not Economy.TimeSkipWorthOffering(def.id, data.base.highestArea, preview) then
			return Net.Fail("Your shops would earn too little right now. Hire employees or restock first!")
		end
	end
	local productId = Config.ProductIds[def.id] or 0
	if productId == 0 then
		return Net.Fail("Robux purchases are not set up yet")
	end
	offer.reservedUntil = nowClock + RESERVE_SECONDS
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, productId)
	end)
	if not ok then
		warn("[BoostService] PromptProductPurchase failed: " .. tostring(err))
		return Net.Fail("Could not open the Robux purchase window")
	end
	return Net.Ok({ prompted = true })
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------

function BoostService:Init(registry: { [string]: any })
	Services = registry
	Net.Handle("BuyBoostOffer", buyBoostOffer)
end

function BoostService:Start()
	-- The client asks for its offers + timer again once its visuals are ready.
	Net.On("Boost", function(player: Player, msg: any)
		if msg ~= "Ready" or not player.Parent then
			return
		end
		local state = getState(player)
		local nowClock = os.clock()
		if nowClock - state.lastReady < 2 then
			return
		end
		state.lastReady = nowClock
		for _, offer in state.offers do
			sendOffer(player, offer)
		end
		sendTimer(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			-- Clamp so a long server hiccup cannot eat minutes of boost time.
			local dt = math.clamp(now - last, 0, 2)
			last = now
			local ds = dataService()
			if ds then
				for _, player in ds:GetLoadedPlayers() do
					local ok, err = pcall(tickPlayer :: any, player, dt)
					if not ok then
						warn("[BoostService] tick failed for " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
end

return BoostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CombatService (server)
	The server half of the Archero-2-inspired COMBAT mode (docs/ARCHITECTURE.md §6.3).

	What it does:
	  1. At Start it builds the static arenas in workspace.Arenas: one per player
	     slot (Layout.ArenaCenter(slot)), a blue tiled floor like the base, green
	     Lego-stud hedge walls, crate / Lego-brick cover blocks (CombatDefs.COVER)
	     and tall invisible walls so nobody can leave.
	  2. It runs one fight "session" per player. Enemies, bullets, grenades and
	     cash pickups are plain DATA tables simulated here at 30 Hz (no server
	     parts). The client draws them from the "Combat" events and the 20 Hz
	     "CombatSnap" snapshot (see CombatController / CombatVisuals).

	Net actions (client -> server):
		CombatPrepare(mode, param)          mode "arena" (param = level) | "barrier" (param = area)
			-> { sessionId, mode, level, area, waveCount, reward, centerX, centerZ, ... }
		CombatStart(sessionId)              -> { stats, hp, maxHp, startsAt }
		CombatChooseAbility(sessionId, id)  -> { id, stacks }
		CombatLeave()                       -> { left = true } or { ended = true } (mid-fight = defeat)

	Push channel "Combat" (reliable). Server -> client messages:
		"Wave"            { wave, waveCount, startsAt, boss }      banner + countdown
		"AbilityChoice"   { wave, timeout, options = { { id, name, icon, description, stacks, maxStacks } } }
		"AbilityPicked"   { id, stacks, auto }
		"ProjectileBatch" { list = { { id, ownerKind, x, z, vx, vz, kind, born, life, radius } } }
		"ProjectileGone"  { ids = { id } }
		"Telegraph"       { id, kind = "grenade" | "laser", x, z, radius?, dx?, dz?, fromX?, fromZ?, start, duration }
		"EnemyDied"       { list = { { id, type, x, z, boss } } }
		"Damage"          { list = { { x, z, amount, kind, crit } } }  kind "enemy"|"player"|"dodge"|"shield"|"heal"|"boom"
		"Collected"       { list = { { id, x, z, value } } }
		"Result"          { victory, mode, level, kills, fightSeconds, collected, paid, chest = { tier, uid, item }?, ... }
		                  chest: gold/silver on a win; wood on a defeat or retreat if you killed
		                  at least 1 enemy or fought >= CombatDefs.CHEST_MIN_SECONDS (else none)
		"Ended"           { sessionId, reason }                    session is gone (back to base)
	Client -> server on "Combat":
		"Hit", { id = projectileId }   an enemy bullet touched my character (validated)
	Push channel "CombatSnap" (unreliable, 20 Hz): a buffer, see CombatDefs.EncodeSnap
		{ t, cash, enemies = { id, type, x, z, hp, maxHp, state }, pickups = { id, x, z, value } }

	Player attributes: CombatActive (true from CombatStart until the fight ends),
	CombatHP, CombatMaxHP, CombatShield.

	Public API (other services): CombatService:IsInFight(player): boolean

	All positions in messages are ARENA-LOCAL (x, z relative to the arena centre).
	Server time = workspace:GetServerTimeNow() on both sides.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatDefs = require(Shared.Combat.CombatDefs)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local EquipmentDefs = require(Shared.Combat.EquipmentDefs)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)
local Rng = require(Shared.Rng)

type CombatStats = EquipmentDefs.CombatStats
type RunStats = CombatDefs.RunStats
type LevelPlan = CombatDefs.LevelPlan
type EnemyDef = CombatDefs.EnemyDef

local P = Config.Palette

local CombatService = {}
CombatService.Priority = 10

-------------------------------------------------------------------------------
-- Tunables (rules shared with the client live in CombatDefs)
-------------------------------------------------------------------------------
local STEP = 1 / CombatDefs.TICK_RATE
local SNAP_INTERVAL = 1 / CombatDefs.SNAP_RATE
local HALF_X = CombatDefs.HALF_X
local HALF_Z = CombatDefs.HALF_Z
local ENEMY_BULLET_RADIUS = 0.5
local PLAYER_BULLET_RADIUS = 0.45
local SPAWN_MIN_PLAYER_DISTANCE = 18 -- [PROPOSAL] enemies never appear right next to you
local MULTISHOT_FAN_DEG = 10 -- [PROPOSAL] degrees between extra bullets when the weapon has no spread
local MAX_HITS_PER_SECOND = 20 -- client "Hit" reports processed per second (anti-spam)
local REPORT_LOOKBACK = 0.5 -- seconds of a bullet's path checked against a reported hit
local NO_ROOT_TIMEOUT = 5 -- end the session if the character has no root this long
local ARENA_WALL_HEIGHT = 5
local BOUNDARY_HEIGHT = 100 -- above the top-down camera (~60 studs up)
local TILE = 10

-------------------------------------------------------------------------------
-- Types
-------------------------------------------------------------------------------
type Enemy = {
	id: number,
	type: string,
	def: EnemyDef,
	boss: boolean,
	x: number,
	z: number,
	hp: number,
	maxHp: number,
	damage: number,
	cash: number,
	speed: number,
	interval: number,
	windup: number,
	bulletSpeed: number,
	state: string,
	timer: number,
	cooldown: number,
	aimX: number,
	aimZ: number,
	strafe: number,
	strafeTimer: number,
	attackCount: number,
	contactCooldown: number,
	dashHit: boolean,
}

type Projectile = {
	id: number,
	owner: string, -- "enemy" | "player"
	kind: string, -- "bullet" | "sniper" | "ring" | "player"
	x: number,
	z: number,
	prevX: number,
	prevZ: number,
	vx: number,
	vz: number,
	speed: number,
	age: number,
	life: number,
	damage: number,
	radius: number,
	crit: boolean,
	pierce: number,
	ricochet: number,
	hits: { [number]: boolean },
}

type Grenade = { id: number, x: number, z: number, radius: number, damage: number, explodeAt: number }
type Pickup = { id: number, x: number, z: number, value: number }

type Outbox = {
	projectiles: { { [string]: any } },
	gone: { number },
	damage: { { [string]: any } },
	died: { { [string]: any } },
	collected: { { [string]: any } },
}

type Session = {
	id: string,
	player: Player,
	character: Model,
	humanoid: Humanoid,
	mode: string,
	level: number,
	area: number,
	plan: LevelPlan,
	slot: number,
	center: Vector3,
	state: string, -- "lobby" | "countdown" | "fighting" | "choosing" | "break" | "ended"
	stateEnds: number,
	clock: number,
	started: boolean,
	fightStartsAt: number, -- s.clock when the 3-2-1 countdown ends (chest rule)
	settled: boolean,
	base: CombatStats?,
	stats: RunStats?,
	abilityStacks: { [string]: number },
	hp: number,
	shield: number,
	wave: number,
	waveCount: number,
	enemies: { [number]: Enemy },
	projectiles: { [number]: Projectile },
	grenades: { [number]: Grenade },
	pickups: { [number]: Pickup },
	nextEnemyId: number,
	nextProjectileId: number,
	nextPickupId: number,
	nextTelegraphId: number,
	fireCooldown: number,
	cash: number,
	kills: number,
	choice: { string }?,
	rng: Random,
	abilityRng: any, -- Rng.Rng (typed as any: generic method types confuse the checker)
	px: number,
	pz: number,
	pSpeed: number,
	noRootTime: number,
	snapTimer: number,
	outbox: Outbox,
	resolvedHits: { [number]: boolean },
	hitBudget: number,
	pendingDefeat: boolean,
	lastHpSent: number,
	lastShieldSent: number,
	lastMaxSent: number,
}

local registry: { [string]: any } = {}
local sessions: { [Player]: Session } = {}
local sessionCounter = 0

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local function isFinite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function isInteger(value: any): boolean
	return isFinite(value) and math.floor(value) == value
end

local function getHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function round1(n: number): number
	return math.floor(n * 10 + 0.5) / 10
end

-- Shortest distance from point (px, pz) to the segment (ax, az) -> (bx, bz).
local function segmentDistance(ax: number, az: number, bx: number, bz: number, px: number, pz: number): number
	local dx, dz = bx - ax, bz - az
	local lengthSq = dx * dx + dz * dz
	local t = 0
	if lengthSq > 1e-9 then
		t = math.clamp(((px - ax) * dx + (pz - az) * dz) / lengthSq, 0, 1)
	end
	local cx, cz = ax + dx * t - px, az + dz * t - pz
	return math.sqrt(cx * cx + cz * cz)
end

local function rotate(x: number, z: number, degrees: number): (number, number)
	local r = math.rad(degrees)
	local c, s = math.cos(r), math.sin(r)
	return x * c - z * s, x * s + z * c
end

-- Runs fn and reports whether it worked (never errors).
local function try(fn: () -> ()): (boolean, any)
	return pcall(function(): any
		fn()
		return nil
	end)
end

local function safeFire(player: Player, channel: string, msg: string, payload: any)
	if player.Parent == nil then
		return
	end
	local ok, err = try(function()
		Net.Fire(channel, player, msg, payload)
	end)
	if not ok then
		warn("[CombatService] could not send " .. msg .. ": " .. tostring(err))
	end
end

-- Calls registry.<service>:<method>(...) if it exists; never errors.
local function callService(serviceName: string, method: string, ...: any): (boolean, ...any)
	local service = registry[serviceName]
	if type(service) ~= "table" or type(service[method]) ~= "function" then
		return false
	end
	local results = table.pack(pcall(service[method], service, ...))
	if not results[1] then
		warn(("[CombatService] %s:%s failed: %s"):format(serviceName, method, tostring(results[2])))
		return false
	end
	return true, table.unpack(results, 2, results.n)
end

local function nextAreaName(area: number): string
	local def = Config.Areas[area + 1]
	return if def then def.name else "the next area"
end

-------------------------------------------------------------------------------
-- Static arenas (workspace.Arenas)
-------------------------------------------------------------------------------
local function makePart(props: {
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	shape: Enum.PartType?,
	transparency: number?,
	collide: boolean?,
}): Part
	local part = Instance.new("Part")
	part.Name = props.name
	part.Anchored = true
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.shape then
		part.Shape = props.shape
	end
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = props.color
	part.Transparency = props.transparency or 0
	part.CanCollide = props.collide ~= false
	part.Parent = props.parent
	return part
end

-- Round Lego studs along the top of a block (size x/z along its top face).
local function addStuds(parent: Instance, topCenter: Vector3, lengthX: number, lengthZ: number, color: Color3)
	local spacing = 4
	local countX = math.max(1, math.floor(lengthX / spacing))
	local countZ = math.max(1, math.floor(lengthZ / spacing))
	for ix = 1, countX do
		for iz = 1, countZ do
			local ox = (ix - 0.5) * (lengthX / countX) - lengthX / 2
			local oz = (iz - 0.5) * (lengthZ / countZ) - lengthZ / 2
			local stud = makePart({
				name = "Stud",
				size = Vector3.new(0.7, 1.7, 1.7),
				cframe = CFrame.new(topCenter + Vector3.new(ox, 0.35, oz)) * CFrame.Angles(0, 0, math.rad(90)),
				color = color,
				parent = parent,
				shape = Enum.PartType.Cylinder,
				collide = false,
			})
			stud.CastShadow = false
		end
	end
end

local function buildArena(slot: number, folder: Instance)
	local center = Layout.ArenaCenter(slot)
	local model = Instance.new("Model")
	model.Name = "Arena" .. slot

	local floorY = Layout.FLOOR_Y
	-- Rim slab under everything (visible outside the hedges).
	makePart({
		name = "Rim",
		size = Vector3.new(Layout.ARENA_SIZE_X + 20, 2, Layout.ARENA_SIZE_Z + 20),
		cframe = CFrame.new(center + Vector3.new(0, floorY - 2, 0)),
		color = P.BasePath,
		parent = model,
	})
	-- Checkerboard floor: BaseFloor tiles with lighter BasePath tiles (image 1 colours).
	local tilesX = math.ceil(Layout.ARENA_SIZE_X / TILE)
	local tilesZ = math.ceil(Layout.ARENA_SIZE_Z / TILE)
	local sizeX = Layout.ARENA_SIZE_X / tilesX
	local sizeZ = Layout.ARENA_SIZE_Z / tilesZ
	for ix = 1, tilesX do
		for iz = 1, tilesZ do
			local x = -HALF_X + (ix - 0.5) * sizeX
			local z = -HALF_Z + (iz - 0.5) * sizeZ
			makePart({
				name = "Tile",
				size = Vector3.new(sizeX, 1, sizeZ),
				cframe = CFrame.new(center + Vector3.new(x, floorY - 0.5, z)),
				color = if (ix + iz) % 2 == 0 then P.BaseFloor else P.BasePath,
				parent = model,
			})
		end
	end
	-- White start line where the player enters (south side).
	makePart({
		name = "StartLine",
		size = Vector3.new(16, 0.1, 0.8),
		cframe = CFrame.new(center + Vector3.new(0, floorY + 0.05, CombatDefs.PLAYER_START.z + 4)),
		color = P.BaseLine,
		parent = model,
		collide = false,
	})

	-- Green Lego hedges around the arena, with studs on top.
	local wallThickness = 3
	local walls = {
		{ x = 0, z = -HALF_Z - wallThickness / 2, lx = Layout.ARENA_SIZE_X + wallThickness * 2, lz = wallThickness },
		{ x = 0, z = HALF_Z + wallThickness / 2, lx = Layout.ARENA_SIZE_X + wallThickness * 2, lz = wallThickness },
		{ x = -HALF_X - wallThickness / 2, z = 0, lx = wallThickness, lz = Layout.ARENA_SIZE_Z },
		{ x = HALF_X + wallThickness / 2, z = 0, lx = wallThickness, lz = Layout.ARENA_SIZE_Z },
	}
	for index, w in walls do
		makePart({
			name = "Hedge" .. index,
			size = Vector3.new(w.lx, ARENA_WALL_HEIGHT, w.lz),
			cframe = CFrame.new(center + Vector3.new(w.x, floorY + ARENA_WALL_HEIGHT / 2, w.z)),
			color = P.Hedge,
			parent = model,
		})
		addStuds(model, center + Vector3.new(w.x, floorY + ARENA_WALL_HEIGHT, w.z), w.lx, w.lz, P.Hedge)
		-- Tall invisible wall on the same line: nobody leaves the arena.
		makePart({
			name = "Boundary" .. index,
			size = Vector3.new(w.lx, BOUNDARY_HEIGHT, w.lz),
			cframe = CFrame.new(center + Vector3.new(w.x, floorY + BOUNDARY_HEIGHT / 2, w.z)),
			color = P.Hedge,
			parent = model,
			transparency = 1,
		})
	end
	-- Invisible ceiling (just in case something flings the character upwards).
	makePart({
		name = "Ceiling",
		size = Vector3.new(Layout.ARENA_SIZE_X + 6, 2, Layout.ARENA_SIZE_Z + 6),
		cframe = CFrame.new(center + Vector3.new(0, floorY + BOUNDARY_HEIGHT, 0)),
		color = P.Hedge,
		parent = model,
		transparency = 1,
	})

	-- Cover blocks (same rectangles the simulation uses).
	for index, c in CombatDefs.COVER do
		local color = if c.kind == "crate" then P.Wood elseif c.kind == "sandbag" then P.WallYellow else P.WallRed
		local blockCenter = center + Vector3.new(c.x, floorY + c.height / 2, c.z)
		makePart({
			name = "Cover" .. index,
			size = Vector3.new(c.sx, c.height, c.sz),
			cframe = CFrame.new(blockCenter),
			color = color,
			parent = model,
		})
		if c.kind == "crate" then
			-- darker frame strips on the crate faces
			for _, offset in { -1, 1 } do
				makePart({
					name = "Plank",
					size = Vector3.new(c.sx + 0.2, 0.6, 0.6),
					cframe = CFrame.new(blockCenter + Vector3.new(0, offset * (c.height / 2 - 0.3), c.sz / 2)),
					color = P.CoinDark,
					parent = model,
					collide = false,
				})
				makePart({
					name = "Plank",
					size = Vector3.new(c.sx + 0.2, 0.6, 0.6),
					cframe = CFrame.new(blockCenter + Vector3.new(0, offset * (c.height / 2 - 0.3), -c.sz / 2)),
					color = P.CoinDark,
					parent = model,
					collide = false,
				})
			end
		end
		addStuds(model, center + Vector3.new(c.x, floorY + c.height, c.z), c.sx, c.sz, color)
	end

	model.Parent = folder
end

local function buildArenas()
	local existing = Workspace:FindFirstChild("Arenas")
	local folder: Instance
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = "Arenas"
		created.Parent = Workspace
		folder = created
	end
	for slot = 1, Config.MaxSlots do
		if not folder:FindFirstChild("Arena" .. slot) then
			local ok, err = try(function()
				buildArena(slot, folder)
			end)
			if not ok then
				warn("[CombatService] building arena " .. slot .. " failed: " .. tostring(err))
			end
		end
	end
end

-------------------------------------------------------------------------------
-- Player attributes + humanoid
-------------------------------------------------------------------------------
local function sendVitals(s: Session, force: boolean?)
	local maxHp = if s.stats then s.stats.maxHp else 0
	local hp = round1(math.max(0, s.hp))
	if force or hp ~= s.lastHpSent then
		s.lastHpSent = hp
		s.player:SetAttribute("CombatHP", hp)
	end
	local maxRounded = round1(maxHp)
	if force or maxRounded ~= s.lastMaxSent then
		s.lastMaxSent = maxRounded
		s.player:SetAttribute("CombatMaxHP", maxRounded)
	end
	if force or s.shield ~= s.lastShieldSent then
		s.lastShieldSent = s.shield
		s.player:SetAttribute("CombatShield", s.shield)
	end
end

local function clearAttributes(player: Player)
	player:SetAttribute("CombatActive", false)
	player:SetAttribute("CombatHP", nil)
	player:SetAttribute("CombatMaxHP", nil)
	player:SetAttribute("CombatShield", nil)
end

-- Back to the normal base values from StarterPlayer (what a player has on foot).
local function restoreHumanoid(s: Session)
	local humanoid = s.humanoid
	if humanoid.Parent and humanoid.Health > 0 then
		humanoid.WalkSpeed = StarterPlayer.CharacterWalkSpeed
		humanoid.JumpHeight = StarterPlayer.CharacterJumpHeight
		humanoid.JumpPower = StarterPlayer.CharacterJumpPower
	end
end

-------------------------------------------------------------------------------
-- Outbox (batched events, flushed once per tick)
-------------------------------------------------------------------------------
local function newOutbox(): Outbox
	return { projectiles = {}, gone = {}, damage = {}, died = {}, collected = {} }
end

local function pushDamage(s: Session, x: number, z: number, amount: number, kind: string, crit: boolean?)
	if #s.outbox.damage < 60 then
		table.insert(s.outbox.damage, { x = x, z = z, amount = round1(amount), kind = kind, crit = crit == true })
	end
end

local function flush(s: Session)
	local o = s.outbox
	if #o.projectiles > 0 then
		safeFire(s.player, "Combat", "ProjectileBatch", { list = o.projectiles })
	end
	if #o.gone > 0 then
		safeFire(s.player, "Combat", "ProjectileGone", { ids = o.gone })
	end
	if #o.damage > 0 then
		safeFire(s.player, "Combat", "Damage", { list = o.damage })
	end
	if #o.died > 0 then
		safeFire(s.player, "Combat", "EnemyDied", { list = o.died })
	end
	if #o.collected > 0 then
		safeFire(s.player, "Combat", "Collected", { list = o.collected })
	end
	s.outbox = newOutbox()
end

local function describeProjectile(p: Projectile): { [string]: any }
	return {
		id = p.id,
		ownerKind = p.owner,
		x = p.x,
		z = p.z,
		vx = p.vx,
		vz = p.vz,
		kind = p.kind,
		born = serverNow(),
		life = p.life - p.age,
		radius = p.radius,
	}
end

local function removeProjectile(s: Session, id: number)
	if s.projectiles[id] then
		s.projectiles[id] = nil
		table.insert(s.outbox.gone, id)
	end
end

local function clearEnemyAttacks(s: Session)
	for id, p in s.projectiles do
		if p.owner == "enemy" then
			removeProjectile(s, id)
		end
	end
	table.clear(s.grenades)
end

-------------------------------------------------------------------------------
-- Spawning
-------------------------------------------------------------------------------
local function spawnProjectile(
	s: Session,
	owner: string,
	kind: string,
	x: number,
	z: number,
	dirX: number,
	dirZ: number,
	speed: number,
	damage: number,
	radius: number,
	life: number
): Projectile
	s.nextProjectileId += 1
	local p: Projectile = {
		id = s.nextProjectileId,
		owner = owner,
		kind = kind,
		x = x,
		z = z,
		prevX = x,
		prevZ = z,
		vx = dirX * speed,
		vz = dirZ * speed,
		speed = speed,
		age = 0,
		life = life,
		damage = damage,
		radius = radius,
		crit = false,
		pierce = 0,
		ricochet = 0,
		hits = {},
	}
	s.projectiles[p.id] = p
	table.insert(s.outbox.projectiles, describeProjectile(p))
	return p
end

local function enemyBullet(s: Session, e: Enemy, dirX: number, dirZ: number, speed: number, kind: string)
	local startX = e.x + dirX * (e.def.radius + 0.6)
	local startZ = e.z + dirZ * (e.def.radius + 0.6)
	spawnProjectile(s, "enemy", kind, startX, startZ, dirX, dirZ, speed, e.damage, ENEMY_BULLET_RADIUS, 160 / speed)
end

-- A free spot in a zone that is not inside cover (and optionally far from the player).
local function freeSpot(
	s: Session,
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
	pad: number,
	awayFromPlayer: number
): (number, number)
	local x, z = 0, minZ
	for _ = 1, 30 do
		x = minX + s.rng:NextNumber() * (maxX - minX)
		z = minZ + s.rng:NextNumber() * (maxZ - minZ)
		local dx, dz = x - s.px, z - s.pz
		if not CombatDefs.CoverAt(x, z, pad) and (dx * dx + dz * dz) >= awayFromPlayer * awayFromPlayer then
			return x, z
		end
	end
	return x, z
end

local function spawnPickup(s: Session, x: number, z: number, value: number)
	if value <= 0 then
		return
	end
	-- never inside cover (could not be reached)
	local cover = CombatDefs.CoverAt(x, z, 1)
	if cover then
		z = cover.z + (if z >= cover.z then 1 else -1) * (cover.sz / 2 + 1.5)
	end
	s.nextPickupId += 1
	s.pickups[s.nextPickupId] = {
		id = s.nextPickupId,
		x = math.clamp(x, -HALF_X + 1.5, HALF_X - 1.5),
		z = math.clamp(z, -HALF_Z + 1.5, HALF_Z - 1.5),
		value = value,
	}
end

local function startWave(s: Session, wave: number)
	local planWave = s.plan.waves[wave]
	if not planWave then
		return
	end
	s.wave = wave
	s.state = "fighting"
	local stats = s.stats
	s.shield = if stats then stats.shieldPerWave else 0
	sendVitals(s)

	local zone = CombatDefs.ENEMY_ZONE
	for index, pe in planWave.enemies do
		local def = CombatDefs.ENEMIES[pe.type]
		if def then
			local scaled = CombatDefs.EnemyStats(pe.type, s.level)
			local x, z
			if pe.boss then
				x, z = 0, -HALF_Z + 14
			else
				x, z = freeSpot(
					s,
					-HALF_X + 4,
					HALF_X - 4,
					zone.minZ,
					zone.maxZ,
					def.radius + 1,
					SPAWN_MIN_PLAYER_DISTANCE
				)
			end
			s.nextEnemyId += 1
			local e: Enemy = {
				id = s.nextEnemyId,
				type = pe.type,
				def = def,
				boss = pe.boss,
				x = x,
				z = z,
				hp = pe.hp,
				maxHp = pe.hp,
				damage = pe.damage,
				cash = pe.cash,
				speed = scaled.speed,
				interval = scaled.interval,
				windup = scaled.windup,
				bulletSpeed = scaled.bulletSpeed,
				state = "spawn",
				timer = CombatDefs.SPAWN_TIME + (index - 1) * 0.08,
				cooldown = scaled.interval * (0.4 + 0.6 * s.rng:NextNumber()),
				aimX = 0,
				aimZ = 1,
				strafe = if s.rng:NextNumber() < 0.5 then 1 else -1,
				strafeTimer = 2 + s.rng:NextNumber() * 3,
				attackCount = 0,
				contactCooldown = 0,
				dashHit = false,
			}
			s.enemies[e.id] = e
		end
	end
	-- Cash piles lying on the ground (30% of the level reward).
	for _, value in planWave.piles do
		local x, z = freeSpot(s, -HALF_X + 4, HALF_X - 4, -HALF_Z + 5, HALF_Z - 14, 1.5, 6)
		spawnPickup(s, x, z, value)
	end
end

-------------------------------------------------------------------------------
-- Damage
-------------------------------------------------------------------------------
local finish: (s: Session, victory: boolean, reason: string) -> ()

local function killEnemy(s: Session, e: Enemy)
	if not s.enemies[e.id] then
		return
	end
	s.enemies[e.id] = nil
	s.kills += 1
	table.insert(s.outbox.died, { id = e.id, type = e.type, x = e.x, z = e.z, boss = e.boss })
	spawnPickup(s, e.x, e.z, e.cash)
	local stats = s.stats
	if stats and stats.vampire > 0 and s.hp > 0 then
		local heal = stats.maxHp * stats.vampire
		s.hp = math.min(stats.maxHp, s.hp + heal)
		pushDamage(s, s.px, s.pz, heal, "heal")
	end
end

local function damageEnemy(s: Session, e: Enemy, amount: number, crit: boolean)
	if e.hp <= 0 or not s.enemies[e.id] then
		return
	end
	e.hp -= amount
	pushDamage(s, e.x, e.z, amount, "enemy", crit)
	if e.hp <= 0 then
		killEnemy(s, e)
	end
end

-- Something hit the player. source: "bullet" | "grenade" | "melee"
local function hitPlayer(s: Session, amount: number, source: string, attacker: Enemy?)
	local stats = s.stats
	if s.state ~= "fighting" or not stats or s.hp <= 0 then
		return
	end
	if stats.dodge > 0 and s.rng:NextNumber() < stats.dodge then
		pushDamage(s, s.px, s.pz, 0, "dodge")
		return
	end
	if s.shield > 0 then
		s.shield -= 1
		pushDamage(s, s.px, s.pz, 0, "shield")
		sendVitals(s)
		return
	end
	local damage = amount * (1 - stats.damageReduction)
	s.hp = math.max(0, s.hp - damage)
	pushDamage(s, s.px, s.pz, damage, "player")
	if source == "melee" and attacker and stats.thorns > 0 then
		damageEnemy(s, attacker, amount * stats.thorns, false)
	end
	sendVitals(s)
	if s.hp <= 0 then
		s.pendingDefeat = true
	end
end

-------------------------------------------------------------------------------
-- Enemy AI
-------------------------------------------------------------------------------
-- Warns the client about an attack (red grenade circle / sniper laser). Returns its id.
local function startTelegraph(s: Session, payload: { [string]: any }): number
	s.nextTelegraphId += 1
	payload.id = s.nextTelegraphId
	payload.start = serverNow()
	safeFire(s.player, "Combat", "Telegraph", payload)
	return s.nextTelegraphId
end

local function fireAttack(s: Session, e: Enemy, dirX: number, dirZ: number)
	local def = e.def
	if def.attack == "rifle" then
		enemyBullet(s, e, dirX, dirZ, e.bulletSpeed, "bullet")
	elseif def.attack == "spread" then
		local count = s.rng:NextInteger(def.bullets, def.bulletsMax)
		for i = 1, count do
			local angle = if count > 1 then -def.spreadDeg / 2 + def.spreadDeg * (i - 1) / (count - 1) else 0
			local x, z = rotate(dirX, dirZ, angle)
			enemyBullet(s, e, x, z, e.bulletSpeed, "bullet")
		end
	elseif def.attack == "sniper" then
		-- along the laser line shown during the windup (locked direction)
		enemyBullet(s, e, e.aimX, e.aimZ, e.bulletSpeed, "sniper")
	elseif def.attack == "grenade" then
		local fuse = def.fuse or 0.9
		local radius = def.blastRadius or 5
		local offset = s.rng:NextNumber() * 1.5
		local angle = s.rng:NextNumber() * math.pi * 2
		local gx = math.clamp(s.px + math.cos(angle) * offset, -HALF_X + 1, HALF_X - 1)
		local gz = math.clamp(s.pz + math.sin(angle) * offset, -HALF_Z + 1, HALF_Z - 1)
		local id = startTelegraph(s, {
			kind = "grenade",
			x = gx,
			z = gz,
			radius = radius,
			fromX = e.x,
			fromZ = e.z,
			duration = fuse,
		})
		s.grenades[id] = { id = id, x = gx, z = gz, radius = radius, damage = e.damage, explodeAt = s.clock + fuse }
	elseif def.attack == "rings" then
		e.attackCount += 1
		if e.attackCount % 3 == 0 then
			-- aimed burst of 5
			for i = 1, 5 do
				local angle = -def.spreadDeg / 2 + def.spreadDeg * (i - 1) / 4
				local x, z = rotate(dirX, dirZ, angle)
				enemyBullet(s, e, x, z, e.bulletSpeed * 1.2, "bullet")
			end
		else
			local count = def.bullets
			local offset = e.attackCount * 13
			for i = 1, count do
				local x, z = rotate(1, 0, offset + 360 * (i - 1) / count)
				enemyBullet(s, e, x, z, e.bulletSpeed, "ring")
			end
		end
	end
end

local function updateEnemy(s: Session, e: Enemy, dt: number)
	local def = e.def
	local dx, dz = s.px - e.x, s.pz - e.z
	local dist = math.sqrt(dx * dx + dz * dz)
	local ux, uz = 0, 1
	if dist > 1e-3 then
		ux, uz = dx / dist, dz / dist
	end
	e.timer -= dt
	e.cooldown -= dt
	e.contactCooldown -= dt

	if e.state == "spawn" then
		if e.timer <= 0 then
			e.state = "move"
		end
		return
	end

	local moveX, moveZ, speed = 0, 0, e.speed
	local touching = dist <= def.radius + CombatDefs.PLAYER_RADIUS + 0.3

	if def.attack == "melee" then
		if e.state == "move" then
			moveX, moveZ = ux, uz
			if touching and e.contactCooldown <= 0 then
				e.contactCooldown = 1
				hitPlayer(s, e.damage * 0.5, "melee", e)
			end
			if dist <= (def.triggerRange or 15) and e.cooldown <= 0 then
				e.state = "charge"
				e.timer = e.windup
				e.aimX, e.aimZ = ux, uz
			end
		elseif e.state == "charge" then
			-- crouch / flash (telegraph), keep turning towards the player a little
			e.aimX, e.aimZ = ux, uz
			if e.timer <= 0 then
				e.state = "dash"
				e.timer = def.dashTime or 0.6
				e.dashHit = false
			end
		elseif e.state == "dash" then
			moveX, moveZ, speed = e.aimX, e.aimZ, def.dashSpeed or 30
			if not e.dashHit and dist <= def.radius + CombatDefs.PLAYER_RADIUS + 0.5 then
				e.dashHit = true
				hitPlayer(s, e.damage, "melee", e)
			end
			if e.timer <= 0 then
				e.state = "cool"
				e.timer = 0.8
				e.cooldown = e.interval * (0.85 + 0.3 * s.rng:NextNumber())
			end
		else -- "cool"
			if e.timer <= 0 then
				e.state = "move"
			end
		end
	else
		if e.state == "move" then
			local preferred = def.preferredRange
			if dist > preferred + 4 then
				moveX, moveZ = ux, uz
			elseif dist < preferred - 6 then
				moveX, moveZ = -ux, -uz
			else
				moveX, moveZ = -uz * e.strafe * 0.6, ux * e.strafe * 0.6
			end
			e.strafeTimer -= dt
			if e.strafeTimer <= 0 then
				e.strafe = -e.strafe
				e.strafeTimer = 2 + s.rng:NextNumber() * 3
			end
			if e.cooldown <= 0 and dist <= 70 then
				e.timer = e.windup
				e.aimX, e.aimZ = ux, uz
				if def.attack == "sniper" then
					e.state = "laser"
					startTelegraph(s, {
						kind = "laser",
						enemyId = e.id,
						x = e.x,
						z = e.z,
						dx = ux,
						dz = uz,
						duration = e.windup,
					})
				elseif def.attack == "grenade" then
					e.state = "throw"
				else
					e.state = "aim"
				end
			end
		elseif e.state == "aim" or e.state == "laser" or e.state == "throw" then
			if e.timer <= 0 then
				-- rifles / gunners / the boss aim at where you are NOW (no lead):
				-- keep moving and the bullet misses.
				fireAttack(s, e, ux, uz)
				e.state = "move"
				e.cooldown = e.interval * (0.85 + 0.3 * s.rng:NextNumber())
			end
		else
			e.state = "move"
		end
	end

	if moveX ~= 0 or moveZ ~= 0 then
		e.x += moveX * speed * dt
		e.z += moveZ * speed * dt
	end
end

-- Keep enemies apart, off the player, out of cover and inside the arena.
local function separateEnemies(s: Session)
	local list: { Enemy } = {}
	for _, e in s.enemies do
		table.insert(list, e)
	end
	for i = 1, #list do
		local a = list[i]
		for j = i + 1, #list do
			local b = list[j]
			local dx, dz = b.x - a.x, b.z - a.z
			local minDist = a.def.radius + b.def.radius
			local distSq = dx * dx + dz * dz
			if distSq < minDist * minDist then
				local dist = math.sqrt(distSq)
				if dist < 1e-3 then
					dx, dz, dist = 1, 0, 1
				end
				local push = (minDist - dist) / 2
				a.x -= dx / dist * push
				a.z -= dz / dist * push
				b.x += dx / dist * push
				b.z += dz / dist * push
			end
		end
	end
	for _, e in list do
		local r = e.def.radius
		-- not on top of the player (dashing chargers may pass through)
		if e.state ~= "dash" then
			local dx, dz = e.x - s.px, e.z - s.pz
			local minDist = r + CombatDefs.PLAYER_RADIUS
			local distSq = dx * dx + dz * dz
			if distSq < minDist * minDist and distSq > 1e-6 then
				local dist = math.sqrt(distSq)
				e.x = s.px + dx / dist * minDist
				e.z = s.pz + dz / dist * minDist
			end
		end
		-- out of cover: push along the shallowest side
		local cover = CombatDefs.CoverAt(e.x, e.z, r)
		if cover then
			local penLeft = (e.x - (cover.x - cover.sx / 2 - r))
			local penRight = ((cover.x + cover.sx / 2 + r) - e.x)
			local penTop = (e.z - (cover.z - cover.sz / 2 - r))
			local penBottom = ((cover.z + cover.sz / 2 + r) - e.z)
			local least = math.min(penLeft, penRight, penTop, penBottom)
			if least == penLeft then
				e.x -= penLeft
			elseif least == penRight then
				e.x += penRight
			elseif least == penTop then
				e.z -= penTop
			else
				e.z += penBottom
			end
			e.strafe = -e.strafe
		end
		local clampedX = math.clamp(e.x, -HALF_X + r, HALF_X - r)
		local clampedZ = math.clamp(e.z, -HALF_Z + r, HALF_Z - r)
		if clampedX ~= e.x or clampedZ ~= e.z then
			e.strafe = -e.strafe
		end
		e.x, e.z = clampedX, clampedZ
	end
end

-------------------------------------------------------------------------------
-- Player shooting + projectiles
-------------------------------------------------------------------------------
local function nearestEnemy(s: Session, x: number, z: number, maxRange: number, exclude: { [number]: boolean }?): Enemy?
	local best: Enemy? = nil
	local bestSq = maxRange * maxRange
	for id, e in s.enemies do
		if e.state ~= "spawn" and e.hp > 0 and not (exclude and exclude[id]) then
			local dx, dz = e.x - x, e.z - z
			local d = dx * dx + dz * dz
			if d <= bestSq then
				best, bestSq = e, d
			end
		end
	end
	return best
end

-- Archero rule: you only shoot while standing still.
local function playerFire(s: Session, dt: number)
	local stats = s.stats
	if not stats then
		return
	end
	s.fireCooldown = math.max(0, s.fireCooldown - dt)
	if s.pSpeed >= CombatDefs.STILL_SPEED or s.fireCooldown > 0 then
		return
	end
	local target = nearestEnemy(s, s.px, s.pz, stats.range, nil)
	if not target then
		return
	end
	s.fireCooldown = 1 / stats.fireRate
	local dx, dz = target.x - s.px, target.z - s.pz
	local dist = math.sqrt(dx * dx + dz * dz)
	if dist < 1e-3 then
		dx, dz, dist = 0, -1, 1
	end
	dx, dz = dx / dist, dz / dist
	local count = math.max(1, stats.projectiles)
	local fan = if count > 1 then math.min(60, math.max(stats.spreadDeg, MULTISHOT_FAN_DEG * (count - 1))) else 0
	for i = 1, count do
		local angle = if count > 1 then -fan / 2 + fan * (i - 1) / (count - 1) else 0
		-- a single bullet still gets a little random spread from the weapon
		if count == 1 and stats.spreadDeg > 0 then
			angle = (s.rng:NextNumber() - 0.5) * stats.spreadDeg
		end
		local bx, bz = rotate(dx, dz, angle)
		local crit = s.rng:NextNumber() < stats.critChance
		local damage = stats.damage * (if crit then stats.critMult else 1)
		s.nextProjectileId += 1
		local p: Projectile = {
			id = s.nextProjectileId,
			owner = "player",
			kind = "player",
			x = s.px + bx * 1.5,
			z = s.pz + bz * 1.5,
			prevX = s.px,
			prevZ = s.pz,
			vx = bx * stats.projectileSpeed,
			vz = bz * stats.projectileSpeed,
			speed = stats.projectileSpeed,
			age = 0,
			life = stats.range / stats.projectileSpeed + 0.1,
			damage = damage,
			radius = PLAYER_BULLET_RADIUS,
			crit = crit,
			pierce = stats.pierce,
			ricochet = stats.ricochet,
			hits = {},
		}
		s.projectiles[p.id] = p
		table.insert(s.outbox.projectiles, describeProjectile(p))
	end
end

local function playerBulletHit(s: Session, p: Projectile, e: Enemy)
	local stats = s.stats
	p.hits[e.id] = true
	local hitX, hitZ = e.x, e.z
	damageEnemy(s, e, p.damage, p.crit)
	-- Explosive: splash damage around the target.
	if stats and stats.explosive > 0 then
		pushDamage(s, hitX, hitZ, 0, "boom")
		local r2 = CombatDefs.EXPLOSIVE_RADIUS * CombatDefs.EXPLOSIVE_RADIUS
		for id, other in s.enemies do
			if id ~= e.id and other.state ~= "spawn" then
				local dx, dz = other.x - hitX, other.z - hitZ
				if dx * dx + dz * dz <= r2 then
					damageEnemy(s, other, p.damage * stats.explosive, false)
				end
			end
		end
	end
	if p.pierce > 0 then
		p.pierce -= 1
		return
	end
	if p.ricochet > 0 then
		local nextTarget = nearestEnemy(s, hitX, hitZ, CombatDefs.RICOCHET_RANGE, p.hits)
		if nextTarget then
			p.ricochet -= 1
			local dx, dz = nextTarget.x - hitX, nextTarget.z - hitZ
			local dist = math.max(1e-3, math.sqrt(dx * dx + dz * dz))
			p.x, p.z = hitX, hitZ
			p.prevX, p.prevZ = hitX, hitZ
			p.vx, p.vz = dx / dist * p.speed, dz / dist * p.speed
			p.age = 0
			p.life = CombatDefs.RICOCHET_RANGE / p.speed + 0.2
			-- same id: the client replaces its copy of this bullet
			table.insert(s.outbox.projectiles, describeProjectile(p))
			return
		end
	end
	removeProjectile(s, p.id)
end

local function updateProjectiles(s: Session, dt: number)
	for id, p in s.projectiles do
		p.prevX, p.prevZ = p.x, p.z
		p.x += p.vx * dt
		p.z += p.vz * dt
		p.age += dt
		local outside = math.abs(p.x) > HALF_X + 1 or math.abs(p.z) > HALF_Z + 1
		if p.age > p.life or outside or CombatDefs.CoverAt(p.x, p.z, 0) then
			removeProjectile(s, id)
		elseif p.owner == "enemy" then
			-- anti-cheat floor: the server applies hits it sees itself
			if segmentDistance(p.prevX, p.prevZ, p.x, p.z, s.px, s.pz) <= CombatDefs.SERVER_HIT_RADIUS then
				s.resolvedHits[id] = true
				removeProjectile(s, id)
				hitPlayer(s, p.damage, "bullet", nil)
			end
		else
			for enemyId, e in s.enemies do
				if not p.hits[enemyId] and e.state ~= "spawn" then
					local reach = e.def.radius + p.radius
					if segmentDistance(p.prevX, p.prevZ, p.x, p.z, e.x, e.z) <= reach then
						playerBulletHit(s, p, e)
						break
					end
				end
			end
		end
	end
end

local function updateGrenades(s: Session)
	for id, g in s.grenades do
		if s.clock >= g.explodeAt then
			s.grenades[id] = nil
			local dx, dz = s.px - g.x, s.pz - g.z
			if math.sqrt(dx * dx + dz * dz) <= g.radius then
				hitPlayer(s, g.damage, "grenade", nil)
			end
		end
	end
end

local function collectPickups(s: Session, everything: boolean?)
	local r2 = CombatDefs.MAGNET_RADIUS * CombatDefs.MAGNET_RADIUS
	for id, pickup in s.pickups do
		local dx, dz = pickup.x - s.px, pickup.z - s.pz
		if everything or dx * dx + dz * dz <= r2 then
			s.pickups[id] = nil
			s.cash = Format.RoundCents(s.cash + pickup.value)
			table.insert(s.outbox.collected, { id = id, x = pickup.x, z = pickup.z, value = pickup.value })
		end
	end
end

-------------------------------------------------------------------------------
-- Snapshots
-------------------------------------------------------------------------------
local function sendSnapshot(s: Session)
	local enemies = {}
	for _, e in s.enemies do
		table.insert(enemies, {
			id = e.id,
			type = e.type,
			x = e.x,
			z = e.z,
			hp = math.max(0, e.hp),
			maxHp = e.maxHp,
			state = e.state,
		})
	end
	local pickups = {}
	for _, p in s.pickups do
		table.insert(pickups, { id = p.id, x = p.x, z = p.z, value = p.value })
	end
	if #pickups > CombatDefs.SNAP_MAX_PICKUPS then
		-- send the ones nearest to the player
		table.sort(pickups, function(a, b)
			local da = (a.x - s.px) ^ 2 + (a.z - s.pz) ^ 2
			local db = (b.x - s.px) ^ 2 + (b.z - s.pz) ^ 2
			return da < db
		end)
	end
	local buf = CombatDefs.EncodeSnap({ t = serverNow(), cash = s.cash, enemies = enemies, pickups = pickups })
	if s.player.Parent then
		local ok, err = try(function()
			Net.Fire("CombatSnap", s.player, buf)
		end)
		if not ok then
			warn("[CombatService] snapshot failed: " .. tostring(err))
		end
	end
end

-------------------------------------------------------------------------------
-- Waves, abilities, results
-------------------------------------------------------------------------------
local function announceWave(s: Session, wave: number, delay: number)
	local planWave = s.plan.waves[wave]
	local boss = false
	if planWave then
		for _, e in planWave.enemies do
			boss = boss or e.boss
		end
	end
	safeFire(s.player, "Combat", "Wave", {
		wave = wave,
		waveCount = s.waveCount,
		startsAt = serverNow() + delay,
		boss = boss,
	})
end

local function abilityInfo(s: Session, id: string): { [string]: any }?
	local a = CombatDefs.AbilityById[id]
	if not a then
		return nil
	end
	return {
		id = a.id,
		name = a.name,
		icon = a.icon,
		description = a.description,
		stacks = s.abilityStacks[a.id] or 0,
		maxStacks = a.maxStacks,
	}
end

local function goToBreak(s: Session)
	s.state = "break"
	s.stateEnds = s.clock + CombatDefs.WAVE_BREAK
	announceWave(s, s.wave + 1, CombatDefs.WAVE_BREAK)
end

local function applyAbility(s: Session, id: string, auto: boolean)
	local a = CombatDefs.AbilityById[id]
	local base = s.base
	local old = s.stats
	if not a or not base or not old then
		return
	end
	s.abilityStacks[id] = (s.abilityStacks[id] or 0) + 1
	local stats = CombatDefs.DeriveStats(base, s.abilityStacks)
	s.stats = stats
	-- HP changes: Max HP+ heals the gain, Heal heals a share of max HP.
	if stats.maxHp > old.maxHp then
		s.hp += stats.maxHp - old.maxHp
	end
	if a.effect.kind == "heal" then
		s.hp += stats.maxHp * (a.effect.amount or 0)
	end
	s.hp = math.min(stats.maxHp, s.hp)
	if a.effect.kind == "perk" and a.effect.perk == "shield" then
		s.shield += 1 -- [PROPOSAL] the new shield is ready right away
	end
	if s.humanoid.Parent then
		s.humanoid.WalkSpeed = stats.moveSpeed
	end
	sendVitals(s)
	safeFire(s.player, "Combat", "AbilityPicked", { id = id, stacks = s.abilityStacks[id], auto = auto })
end

local function chooseAbility(s: Session, id: string, auto: boolean)
	s.choice = nil
	applyAbility(s, id, auto)
	goToBreak(s)
end

local function waveCleared(s: Session)
	clearEnemyAttacks(s)
	if s.wave >= s.waveCount then
		-- [PROPOSAL] a full clear vacuums up every coin still on the floor
		collectPickups(s, true)
		finish(s, true, "victory")
		return
	end
	local options = CombatDefs.RollAbilities(s.abilityStacks, s.abilityRng, 3)
	if #options == 0 then
		goToBreak(s)
		return
	end
	s.choice = options
	s.state = "choosing"
	s.stateEnds = s.clock + CombatDefs.ABILITY_TIMEOUT
	local list = {}
	for _, id in options do
		local info = abilityInfo(s, id)
		if info then
			table.insert(list, info)
		end
	end
	safeFire(s.player, "Combat", "AbilityChoice", {
		wave = s.wave,
		timeout = CombatDefs.ABILITY_TIMEOUT,
		options = list,
	})
end

-- Pays cash, awards the chest and records progress. Runs at most once per
-- session (also for forced endings like resetting or leaving the game).
local function settle(s: Session, victory: boolean): { [string]: any }
	s.settled = true
	local player = s.player
	local dataService = registry.DataService
	local data = if dataService then dataService:Get(player) else nil

	local collected = Format.RoundCents(s.cash)
	local paid = 0
	if collected > 0 and dataService then
		-- [PROPOSAL] collected cash is paid even on defeat (boostable gameplay income)
		paid = dataService:AddCash(player, collected, { boostable = true, source = "combat" })
	end

	local chest = nil
	-- seconds fought after the countdown: a defeat with 0 kills still earns a
	-- wooden chest after CombatDefs.CHEST_MIN_SECONDS ([PROPOSAL])
	local fightSeconds = if s.started then math.max(0, s.clock - s.fightStartsAt) else 0
	local tier = CombatDefs.ChestTier(s.mode, s.level, victory, s.kills, fightSeconds)
	if tier and data then
		local ok, uid, item = callService("InventoryService", "AwardChest", player, tier)
		if ok and item ~= nil then
			chest = { tier = tier, uid = uid, item = item }
		end
	end

	local newBest = false
	if data then
		data.combat.games += 1
		if victory then
			data.combat.wins += 1
		end
		data.stats.combatKills += s.kills
		if victory and s.mode == "arena" and s.level > data.combat.highestLevel then
			data.combat.highestLevel = s.level
			newBest = true
		end
		dataService:MarkDirty(player)
	end

	local barrierDefeated = false
	if victory and s.mode == "barrier" then
		local ok = callService("BaseService", "MarkBarrierDefeated", player, s.area)
		if not ok and data then
			-- ASSUMPTION: BaseService missing -> record the win directly in the
			-- documented data field so the gate can still be opened.
			data.base.barriers[tostring(s.area)] = true
			dataService:MarkDirty(player)
		end
		barrierDefeated = true
	end

	return {
		sessionId = s.id,
		victory = victory,
		mode = s.mode,
		level = s.level,
		area = s.area,
		nextAreaName = nextAreaName(s.area),
		wavesCleared = if victory then s.waveCount else math.max(0, s.wave - 1),
		waveCount = s.waveCount,
		kills = s.kills,
		fightSeconds = math.floor(fightSeconds),
		collected = collected,
		paid = paid,
		boosted = paid > collected + 0.001,
		chest = chest,
		newBest = newBest,
		barrierDefeated = barrierDefeated,
	}
end

finish = function(s: Session, victory: boolean, reason: string)
	if s.state == "ended" then
		return
	end
	s.state = "ended"
	s.stateEnds = s.clock + CombatDefs.RESULT_TIMEOUT
	s.choice = nil
	-- clear the battlefield
	for id in s.projectiles do
		removeProjectile(s, id)
	end
	table.clear(s.grenades)
	table.clear(s.enemies)
	s.player:SetAttribute("CombatActive", false)
	restoreHumanoid(s)
	s.humanoid.JumpHeight = 0 -- still no jumping until you leave the arena
	s.humanoid.JumpPower = 0
	local result: { [string]: any } = if s.settled then { sessionId = s.id, victory = victory } else settle(s, victory)
	result.reason = reason
	flush(s)
	safeFire(s.player, "Combat", "Result", result)
end

-------------------------------------------------------------------------------
-- Session lifecycle
-------------------------------------------------------------------------------
-- Ends a session for good (any reason). Safe to call more than once.
local function endSession(s: Session, reason: string)
	if sessions[s.player] ~= s then
		return
	end
	sessions[s.player] = nil
	if s.started and not s.settled and s.state ~= "ended" then
		-- forced ending mid-fight (reset, death, left the game): counts as a defeat
		local ok, result = pcall(settle, s, false)
		if ok and s.player.Parent and type(result) == "table" and (result.paid or 0) > 0 then
			Net.Notify(s.player, "Fight ended: +" .. Format.Money(result.paid), "cash")
		end
	end
	s.state = "ended"
	table.clear(s.enemies)
	table.clear(s.projectiles)
	table.clear(s.pickups)
	table.clear(s.grenades)
	try(function()
		clearAttributes(s.player)
	end)
	try(function()
		restoreHumanoid(s)
	end)
	safeFire(s.player, "Combat", "Ended", { sessionId = s.id, reason = reason })
end

local function returnToBase(s: Session, reason: string)
	endSession(s, reason)
	local modeService = registry.ModeService
	if modeService and s.player.Parent then
		modeService:ReturnToBase(s.player)
	end
end

local function updatePlayerPosition(s: Session, dt: number): boolean
	local character = s.player.Character
	local root = getRoot(character)
	if not root or character ~= s.character then
		s.noRootTime += dt
		return false
	end
	s.noRootTime = 0
	local local3 = root.Position - s.center
	s.px, s.pz = local3.X, local3.Z
	local v = root.AssemblyLinearVelocity
	s.pSpeed = math.sqrt(v.X * v.X + v.Z * v.Z)
	-- Safety net: if the avatar somehow left the arena, put it back on the start line.
	if math.abs(s.px) > HALF_X + 8 or math.abs(s.pz) > HALF_Z + 8 or local3.Y < -25 then
		local start = s.center + Vector3.new(CombatDefs.PLAYER_START.x, 0, CombatDefs.PLAYER_START.z)
		local modeService = registry.ModeService
		if modeService then
			modeService:Teleport(s.player, CFrame.lookAt(start, start + Vector3.new(0, 0, -1)))
		end
		s.px, s.pz = CombatDefs.PLAYER_START.x, CombatDefs.PLAYER_START.z
	end
	return true
end

local function tick(s: Session, dt: number)
	s.clock += dt
	s.hitBudget = math.min(MAX_HITS_PER_SECOND, s.hitBudget + MAX_HITS_PER_SECOND * dt)
	if s.state == "lobby" then
		return
	end
	if not updatePlayerPosition(s, dt) then
		if s.noRootTime > NO_ROOT_TIMEOUT then
			returnToBase(s, "no character")
		end
		return
	end
	local stats = s.stats

	if s.state == "countdown" then
		if s.clock >= s.stateEnds then
			startWave(s, 1)
		end
	elseif s.state == "fighting" then
		if stats and stats.regen > 0 and s.hp > 0 then
			s.hp = math.min(stats.maxHp, s.hp + stats.maxHp * stats.regen * dt)
		end
		for _, e in s.enemies do
			updateEnemy(s, e, dt)
		end
		separateEnemies(s)
		playerFire(s, dt)
		updateProjectiles(s, dt)
		updateGrenades(s)
		collectPickups(s)
		sendVitals(s)
		if s.pendingDefeat then
			finish(s, false, "defeated")
		elseif next(s.enemies) == nil then
			waveCleared(s)
		end
	elseif s.state == "choosing" then
		updateProjectiles(s, dt) -- your own bullets finish flying
		collectPickups(s)
		if s.clock >= s.stateEnds then
			local choice = s.choice
			if choice and choice[1] then
				chooseAbility(s, choice[1], true)
			else
				goToBreak(s)
			end
		end
	elseif s.state == "break" then
		updateProjectiles(s, dt)
		collectPickups(s)
		if s.clock >= s.stateEnds then
			startWave(s, s.wave + 1)
		end
	elseif s.state == "ended" then
		if s.clock >= s.stateEnds then
			returnToBase(s, "timeout")
			return
		end
	end

	if sessions[s.player] ~= s then
		return
	end
	flush(s)
	if s.state ~= "ended" then
		s.snapTimer -= dt
		if s.snapTimer <= 0 then
			s.snapTimer += SNAP_INTERVAL
			sendSnapshot(s)
		end
	end
end

local function lockedStats(player: Player): CombatStats
	local ok, stats = callService("InventoryService", "GetLoadoutStats", player)
	if ok and type(stats) == "table" then
		return stats
	end
	local dataService = registry.DataService
	local data = if dataService then dataService:Get(player) else nil
	if data then
		local fromDefs, defsStats = pcall(EquipmentDefs.LoadoutStats, data)
		if fromDefs and type(defsStats) == "table" then
			return defsStats
		end
	end
	return CombatDefs.DefaultStats()
end

-------------------------------------------------------------------------------
-- Net handlers
-------------------------------------------------------------------------------
local function handlePrepare(player: Player, mode: any, param: any): Net.Result
	if mode ~= "arena" and mode ~= "barrier" then
		return Net.Fail("Unknown fight")
	end
	if sessions[player] then
		return Net.Fail("You are already in a fight")
	end
	local modeService = registry.ModeService
	local dataService = registry.DataService
	if not modeService or not dataService then
		return Net.Fail("Still loading, try again")
	end
	if modeService:GetMode(player) ~= "Base" then
		return Net.Fail("Finish what you are doing first")
	end
	local data = dataService:Get(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	local character = player.Character
	local humanoid = getHumanoid(character)
	if not character or not humanoid or humanoid.Health <= 0 or not getRoot(character) then
		return Net.Fail("Wait until you have respawned")
	end

	local level: number
	local area = data.base.highestArea
	if mode == "arena" then
		if not data.base.arenaUnlocked then
			return Net.Fail("Unlock the Combat Arena first")
		end
		if not isInteger(param) or param < 1 or param > data.combat.highestLevel + 1 then
			return Net.Fail("That level is locked")
		end
		level = param
	else
		if not isInteger(param) or param ~= data.base.highestArea then
			return Net.Fail("That barrier is not in front of you")
		end
		if param >= #Config.Areas then
			return Net.Fail("There is no area after this one")
		end
		if data.base.barriers[tostring(param)] then
			return Net.Fail("You already beat this barrier")
		end
		area = param
		level = Economy.BarrierCombatLevel(area)
	end

	local plan = CombatDefs.LevelPlan(level, mode)
	local slot = modeService:GetSlot(player)
	local center = Layout.ArenaCenter(slot)

	callService("VehicleService", "Dismount", player)
	modeService:SetMode(player, "Combat")

	sessionCounter += 1
	local seed = (player.UserId % 100000) * 7 + sessionCounter * 131 + math.floor(os.clock() * 1000)
	local s: Session = {
		id = ("%d_%d"):format(player.UserId, sessionCounter),
		player = player,
		character = character,
		humanoid = humanoid,
		mode = mode,
		level = level,
		area = area,
		plan = plan,
		slot = slot,
		center = center,
		state = "lobby",
		stateEnds = 0,
		clock = 0,
		started = false,
		fightStartsAt = 0,
		settled = false,
		base = nil,
		stats = nil,
		abilityStacks = {},
		hp = 0,
		shield = 0,
		wave = 0,
		waveCount = plan.waveCount,
		enemies = {},
		projectiles = {},
		grenades = {},
		pickups = {},
		nextEnemyId = 0,
		nextProjectileId = 0,
		nextPickupId = 0,
		nextTelegraphId = 0,
		fireCooldown = 0,
		cash = 0,
		kills = 0,
		choice = nil,
		rng = Random.new(seed),
		abilityRng = Rng.new(seed),
		px = CombatDefs.PLAYER_START.x,
		pz = CombatDefs.PLAYER_START.z,
		pSpeed = 0,
		noRootTime = 0,
		snapTimer = 0,
		outbox = newOutbox(),
		resolvedHits = {},
		hitBudget = MAX_HITS_PER_SECOND,
		pendingDefeat = false,
		lastHpSent = -1,
		lastShieldSent = -1,
		lastMaxSent = -1,
	}
	sessions[player] = s

	local start = center + Vector3.new(CombatDefs.PLAYER_START.x, 0, CombatDefs.PLAYER_START.z)
	if not modeService:Teleport(player, CFrame.lookAt(start, start + Vector3.new(0, 0, -1))) then
		returnToBase(s, "teleport failed")
		return Net.Fail("Could not reach the arena")
	end
	humanoid.JumpHeight = 0 -- jumping is disabled in combat
	humanoid.JumpPower = 0
	player:SetAttribute("CombatActive", false) -- the lobby is not "active": equipping works

	return Net.Ok({
		sessionId = s.id,
		mode = mode,
		level = level,
		area = area,
		areaName = (Config.Areas[area] and Config.Areas[area].name) or "",
		nextAreaName = nextAreaName(area),
		waveCount = plan.waveCount,
		reward = plan.reward,
		boss = plan.hasBoss,
		slot = slot,
		centerX = center.X,
		centerY = center.Y,
		centerZ = center.Z,
	})
end

local function handleStart(player: Player, sessionId: any): Net.Result
	local s = sessions[player]
	if not s or type(sessionId) ~= "string" or s.id ~= sessionId then
		return Net.Fail("No fight to start")
	end
	if s.state ~= "lobby" then
		-- double click: the fight is already running
		return Net.Ok({ already = true, stats = s.stats, hp = s.hp })
	end
	local modeService = registry.ModeService
	if not modeService or modeService:GetMode(player) ~= "Combat" then
		return Net.Fail("You are not in the arena")
	end
	if not s.humanoid.Parent or s.humanoid.Health <= 0 then
		return Net.Fail("Wait until you have respawned")
	end
	local base = lockedStats(player)
	s.base = base
	local stats = CombatDefs.DeriveStats(base, s.abilityStacks)
	s.stats = stats
	s.hp = stats.maxHp
	s.shield = 0
	s.started = true
	s.state = "countdown"
	s.stateEnds = s.clock + CombatDefs.COUNTDOWN
	s.fightStartsAt = s.stateEnds
	s.humanoid.WalkSpeed = stats.moveSpeed
	player:SetAttribute("CombatActive", true)
	sendVitals(s, true)
	announceWave(s, 1, CombatDefs.COUNTDOWN)
	return Net.Ok({
		stats = stats,
		hp = s.hp,
		maxHp = stats.maxHp,
		startsAt = serverNow() + CombatDefs.COUNTDOWN,
	})
end

local function handleChoose(player: Player, sessionId: any, abilityId: any): Net.Result
	local s = sessions[player]
	if not s or type(sessionId) ~= "string" or s.id ~= sessionId then
		return Net.Fail("No fight running")
	end
	if s.state ~= "choosing" or not s.choice then
		return Net.Fail("Nothing to choose right now")
	end
	if type(abilityId) ~= "string" or not table.find(s.choice, abilityId) then
		return Net.Fail("That ability is not on offer")
	end
	chooseAbility(s, abilityId, false)
	return Net.Ok({ id = abilityId, stacks = s.abilityStacks[abilityId] or 0 })
end

local function handleLeave(player: Player): Net.Result
	local s = sessions[player]
	if not s then
		-- stuck in Combat mode without a session (should not happen): go home
		local modeService = registry.ModeService
		if modeService and modeService:GetMode(player) == "Combat" then
			modeService:ReturnToBase(player)
		end
		return Net.Ok({ left = true })
	end
	if s.state == "lobby" or s.state == "ended" then
		returnToBase(s, "left")
		return Net.Ok({ left = true })
	end
	-- leaving mid-fight = retreat = defeat (you keep the cash you collected)
	finish(s, false, "retreat")
	return Net.Ok({ ended = true })
end

-- Client says an enemy bullet touched it. Validate and apply once.
local function handleHitReport(player: Player, msg: any, payload: any)
	if msg ~= "Hit" or type(payload) ~= "table" then
		return
	end
	local s = sessions[player]
	if not s or s.state ~= "fighting" then
		return
	end
	local id = payload.id
	if not isInteger(id) then
		return
	end
	if s.hitBudget < 1 then
		return
	end
	s.hitBudget -= 1
	if s.resolvedHits[id] then
		return
	end
	local p = s.projectiles[id]
	if not p or p.owner ~= "enemy" then
		return
	end
	-- the bullet's recent path must pass close to where the server sees the player
	local backX = p.x - p.vx * math.min(REPORT_LOOKBACK, p.age)
	local backZ = p.z - p.vz * math.min(REPORT_LOOKBACK, p.age)
	if segmentDistance(backX, backZ, p.x, p.z, s.px, s.pz) > CombatDefs.REPORT_TOLERANCE then
		return
	end
	s.resolvedHits[id] = true
	removeProjectile(s, id)
	hitPlayer(s, p.damage, "bullet", nil)
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function CombatService:Init(reg: { [string]: any })
	registry = reg
	Net.Handle("CombatPrepare", handlePrepare)
	Net.Handle("CombatStart", handleStart)
	Net.Handle("CombatChooseAbility", handleChoose)
	Net.Handle("CombatLeave", handleLeave)
end

function CombatService:Start()
	buildArenas()

	Net.On("Combat", function(player: Player, msg: any, payload: any)
		local ok, err = try(function()
			handleHitReport(player, msg, payload)
		end)
		if not ok then
			warn("[CombatService] hit report failed: " .. tostring(err))
		end
	end)

	-- Any mode change away from Combat (death, respawn, other systems) ends the session.
	local modeService = registry.ModeService
	if modeService and modeService.ModeChanged then
		modeService.ModeChanged:Connect(function(player: Player, newMode: string)
			local s = sessions[player]
			if s and newMode ~= "Combat" then
				endSession(s, "mode changed")
			end
		end)
	end
	-- Pay out before the final save when someone leaves mid-fight.
	local dataService = registry.DataService
	if dataService and dataService.PlayerRemoving then
		dataService.PlayerRemoving:Connect(function(player: Player)
			local s = sessions[player]
			if s then
				endSession(s, "left the game")
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		local s = sessions[player]
		if s then
			endSession(s, "left the game")
		end
	end)

	-- Fixed 30 Hz simulation on Heartbeat (at most 3 steps per frame).
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt: number)
		accumulator = math.min(accumulator + dt, STEP * 3)
		while accumulator >= STEP do
			accumulator -= STEP
			for _, s in sessions do
				local ok, err = try(function()
					tick(s, STEP)
				end)
				if not ok then
					warn("[CombatService] fight crashed, sending player home: " .. tostring(err))
					try(function()
						returnToBase(s, "error")
					end)
				end
			end
		end
	end)
end

function CombatService:IsInFight(player: Player): boolean
	return sessions[player] ~= nil
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService
	Loads, saves and syncs PlayerData.

	API (server):
		DataService:Get(player): PlayerData?          -- live table, mutate it then MarkDirty
		DataService:WaitFor(player, timeout?): PlayerData?
		DataService:MarkDirty(player)                  -- sync to client soon + save later
		DataService:AddCash(player, amount, opts?): number   -- rounded to whole dollars
			opts.boostable = true -> multiplied by BoostService:GetCashMultiplier (2x boost)
			opts.source = "runner" | "section" | "combat" | ... (for logging)
			returns the amount actually added
		DataService:CanAfford(player, amount): boolean
		DataService:SpendCash(player, amount): boolean -- false = not enough cash
		DataService:SaveNow(player): boolean           -- true only when the save really reached the DataStore
		DataService:IsSaving(): boolean                -- false = running without saving (Studio without API access)
		DataService:HasReceipt(player, purchaseId) / AddReceipt(player, purchaseId)
		DataService.PlayerLoaded: Signal(player, data)
		DataService.PlayerRemoving: Signal(player, data)  -- before the final save

	How saving stays safe:
	  * A live server never hands out a blank save. Until the DataStore answers,
	    joining players wait (and are asked to rejoin after a minute) instead of
	    getting a fresh profile that could later overwrite their real one.
	  * Session lock: every save record carries `_lock = { jobId, t }`. A server
	    loads a player only when no OTHER live server holds the lock (it waits up
	    to ~20 s for the previous server's final save, then takes over a stale
	    lock). A server that lost the lock never writes again, so an old session
	    can never roll back a newer one.
	  * Only profiles that were loaded from the DataStore are ever written back.

	Without DataStore access in Studio (an unpublished place, or "Enable Studio
	Access to API Services" off) the game still runs; progress just is not
	saved. See README.md to turn saving on.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData

local DataService = {}
DataService.Priority = 100 -- initialised first
DataService.PlayerLoaded = Signal.new()
DataService.PlayerRemoving = Signal.new()

local IS_STUDIO = RunService:IsStudio()

local Services: { [string]: any } = {}
local store: DataStore? = nil
-- "pending" until the DataStore answered, then "ready" or (Studio only) "unavailable".
local storeState = "pending"
local profiles: { [Player]: PlayerData } = {}
local dirtySave: { [Player]: boolean } = {}
local dirtySync: { [Player]: boolean } = {}
local loading: { [Player]: boolean } = {}
local loadedFromStore: { [Player]: boolean } = {}
local lockLost: { [Player]: boolean } = {}
-- Set while a player's final (lock-releasing) save runs: no other save may
-- start for them, so a late autosave can never take the lock back.
local releasing: { [Player]: boolean } = {}

local MAX_RECEIPTS = 60
local LOAD_WAIT_LIMIT = 60 -- live servers: seconds to wait for the DataStore before asking to rejoin
local LOCK_WAIT = 20 -- seconds to wait for another server's final save before taking over its lock
-- A lock not refreshed for this long belongs to a server that stopped (crash).
-- Locks are refreshed on every save (autosave every Config.AutosaveInterval s).
local LOCK_STALE = math.max(180, Config.AutosaveInterval * 3)

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T?)
	local delaySeconds = 1
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(("[DataService] %s failed (attempt %d): %s"):format(label, attempt, tostring(result)))
		if attempt < 4 then
			task.wait(delaySeconds)
			delaySeconds *= 2
		end
	end
	return false, nil
end

local function openStore()
	local attempt = 0
	while true do
		attempt += 1
		local lastError: any = nil
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			-- In Studio, a place without "Enable Studio Access to API Services" errors here.
			local probeOk, probeErr = pcall(function()
				(result :: DataStore):GetAsync("__probe")
			end)
			if probeOk then
				store = result
				storeState = "ready"
				return
			end
			lastError = probeErr
		else
			lastError = result
		end

		if IS_STUDIO and attempt >= 2 then
			warn("[DataService] DataStores unavailable in Studio, progress will NOT be saved: " .. tostring(lastError))
			storeState = "unavailable"
			return
		end
		-- Live server: never give up (players wait instead of getting a blank save).
		warn(("[DataService] DataStore not ready yet (attempt %d): %s"):format(attempt, tostring(lastError)))
		task.wait(math.min(30, 2 ^ attempt))
	end
end

-- True when `lock` belongs to another server that is still alive.
local function lockedByOther(lock: any): boolean
	if type(lock) ~= "table" then
		return false
	end
	if lock.jobId == game.JobId then
		return false
	end
	local t = tonumber(lock.t)
	return t ~= nil and os.time() - t < LOCK_STALE
end

-- Loads the record and takes the session lock in one atomic UpdateAsync.
-- Returns the data, or nil when the DataStore kept failing.
local function loadWithLock(activeStore: DataStore, player: Player): PlayerData?
	local key = keyFor(player)
	local started = os.clock()
	local forceTakeover = false
	while player.Parent do
		local loaded: PlayerData? = nil
		local blocked = false
		local ok = withRetries("load " .. player.Name, function()
			loaded = nil
			blocked = false
			activeStore:UpdateAsync(key, function(old: any)
				-- UpdateAsync may run this callback more than once (write
				-- conflicts): only the LAST run decides the outcome.
				loaded = nil
				blocked = false
				if old ~= nil and not forceTakeover and lockedByOther(old._lock) then
					blocked = true
					return nil -- cancel the write: another server still owns this save
				end
				local record = if old ~= nil then Types.Reconcile(old) else Types.DefaultData()
				-- Saves from before whole-dollar money may hold cents.
				record.cash = math.floor(record.cash)
				record.lifetimeCash = math.floor(record.lifetimeCash);
				(record :: any)._lock = { jobId = game.JobId, t = os.time() }
				loaded = record
				return record
			end)
			return true
		end)
		if not ok then
			return nil
		end
		if loaded then
			return loaded
		end
		if blocked then
			if os.clock() - started >= LOCK_WAIT then
				-- The other server never released the save (e.g. it is shutting
				-- down slowly). Take over; that server can no longer write.
				warn(("[DataService] taking over the save lock for %s"):format(player.Name))
				forceTakeover = true
			else
				task.wait(3)
			end
		end
	end
	return nil
end

function DataService:Init(registry: { [string]: any })
	Services = registry
	task.spawn(openStore)

	Net.Handle("RequestSync", function(player)
		if profiles[player] then
			dirtySync[player] = true
		end
		return nil
	end)
end

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:_load(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			self:_load(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		self:_release(player)
	end)

	-- Batched client sync (at most ~7 times per second per player).
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in dirtySync do
				dirtySync[player] = nil
				local data = profiles[player]
				if data and player.Parent then
					local ok, err = pcall(function()
						Net.Fire("Sync", player, data)
					end)
					if not ok then
						warn(("[DataService] sync to %s failed: %s"):format(player.Name, tostring(err)))
					end
				end
			end
		end
	end)

	-- Play-time counter + autosave.
	task.spawn(function()
		local sinceSave = 0
		while true do
			task.wait(1)
			sinceSave += 1
			for player, data in profiles do
				local ok = pcall(function()
					data.stats.playSeconds += 1
				end)
				if not ok then
					warn("[DataService] bad stats table for " .. player.Name)
				end
			end
			if sinceSave >= Config.AutosaveInterval then
				sinceSave = 0
				-- Save every loaded profile (not only changed ones) so each
				-- session lock is refreshed and never looks abandoned.
				for player in profiles do
					if not releasing[player] then
						task.spawn(function()
							self:SaveNow(player)
						end)
					end
				end
			end
		end
	end)

	game:BindToClose(function()
		if storeState ~= "ready" then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				releasing[player] = true
				self:_saveRecord(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

function DataService:_load(player: Player)
	if profiles[player] or loading[player] then
		return
	end
	loading[player] = true

	-- Wait for the DataStore decision. A live server never falls back to a
	-- blank profile: that blank profile could later overwrite the real save.
	local started = os.clock()
	while storeState == "pending" and player.Parent do
		if not IS_STUDIO and os.clock() - started > LOAD_WAIT_LIMIT then
			loading[player] = nil
			player:Kick("Our save servers are busy. Please rejoin in a minute (your progress is safe).")
			return
		end
		task.wait(0.25)
	end
	if not player.Parent then
		loading[player] = nil
		return
	end

	local data: PlayerData
	local activeStore = store
	if storeState == "ready" and activeStore then
		local loaded = loadWithLock(activeStore, player)
		if not loaded then
			loading[player] = nil
			if player.Parent then
				player:Kick("Could not load your save data. Please rejoin in a minute (your progress is safe).")
			end
			return
		end
		data = loaded
		loadedFromStore[player] = true
	else
		-- Studio without DataStore access: play with a fresh profile, never saved.
		data = Types.DefaultData()
	end

	loading[player] = nil
	if not player.Parent then
		-- Left while loading: give the lock back so the next server is not delayed.
		if loadedFromStore[player] then
			profiles[player] = data
			releasing[player] = true
			self:_saveRecord(player, true)
			releasing[player] = nil
			profiles[player] = nil
			loadedFromStore[player] = nil
			dirtySave[player] = nil
		end
		return
	end
	profiles[player] = data
	player:SetAttribute("DataLoaded", true)
	dirtySync[player] = true
	self.PlayerLoaded:Fire(player, data)
end

function DataService:_release(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	self.PlayerRemoving:Fire(player, data)
	releasing[player] = true
	self:_saveRecord(player, true)
	releasing[player] = nil
	profiles[player] = nil
	dirtySave[player] = nil
	dirtySync[player] = nil
	loadedFromStore[player] = nil
	lockLost[player] = nil
end

function DataService:Get(player: Player): PlayerData?
	return profiles[player]
end

function DataService:WaitFor(player: Player, timeout: number?): PlayerData?
	local limit = timeout or 30
	local started = os.clock()
	while not profiles[player] and player.Parent and os.clock() - started < limit do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService:GetLoadedPlayers(): { Player }
	local list = {}
	for player in profiles do
		if not releasing[player] then
			table.insert(list, player)
		end
	end
	return list
end

function DataService:MarkDirty(player: Player)
	if profiles[player] then
		dirtySave[player] = true
		dirtySync[player] = true
	end
end

function DataService:AddCash(player: Player, amount: number, opts: { boostable: boolean?, source: string? }?): number
	local data = profiles[player]
	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
		return 0
	end
	local final = amount
	if opts and opts.boostable then
		local boostService = Services.BoostService
		if boostService and boostService.GetCashMultiplier then
			final *= boostService:GetCashMultiplier(player)
		end
	end
	final = Format.RoundWhole(final)
	if final <= 0 then
		return 0
	end
	data.cash = Format.RoundWhole(data.cash + final)
	data.lifetimeCash = Format.RoundWhole(data.lifetimeCash + final)
	self:MarkDirty(player)
	return final
end

function DataService:CanAfford(player: Player, amount: number): boolean
	local data = profiles[player]
	return data ~= nil and amount == amount and data.cash + 1e-6 >= amount
end

function DataService:SpendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or amount ~= amount or amount < 0 or amount == math.huge then
		return false
	end
	if data.cash + 1e-6 < amount then
		return false
	end
	data.cash = math.max(0, Format.RoundWhole(data.cash - amount))
	self:MarkDirty(player)
	return true
end

-- Remember a processed purchase (MarketplaceService receipt idempotency).
function DataService:HasReceipt(player: Player, purchaseId: string): boolean
	local data = profiles[player]
	return data ~= nil and data.receipts[purchaseId] == true
end

function DataService:AddReceipt(player: Player, purchaseId: string)
	local data = profiles[player]
	if not data then
		return
	end
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > MAX_RECEIPTS do
		local oldest = table.remove(data.receiptOrder, 1)
		if oldest then
			data.receipts[oldest] = nil
		end
	end
	self:MarkDirty(player)
end

-- Writes the profile. `release` = true drops the session lock (final save).
-- Returns true only when the record really reached the DataStore.
function DataService:_saveRecord(player: Player, release: boolean): boolean
	local data = profiles[player]
	local activeStore = store
	if not data or not activeStore or not loadedFromStore[player] or lockLost[player] then
		return false
	end
	if releasing[player] and not release then
		return false -- the final save is running; nothing may be written after it
	end
	dirtySave[player] = nil
	local cancelled = false
	local ok = withRetries("save " .. player.Name, function()
		cancelled = false
		activeStore:UpdateAsync(keyFor(player), function(old: any)
			cancelled = false
			if type(old) == "table" and lockedByOther(old._lock) then
				cancelled = true
				return nil -- another server owns this save now: never overwrite it
			end
			if releasing[player] and not release then
				return nil -- the player started leaving while this save waited
			end
			(data :: any)._lock = if release then nil else { jobId = game.JobId, t = os.time() }
			return data
		end)
		return true
	end)
	if cancelled then
		lockLost[player] = true
		warn(("[DataService] %s's save is owned by another server; this server stops saving it"):format(player.Name))
		return false
	end
	if not ok and profiles[player] and not releasing[player] then
		dirtySave[player] = true
	end
	return ok
end

function DataService:SaveNow(player: Player): boolean
	return self:_saveRecord(player, false)
end

function DataService:IsSaving(): boolean
	return storeState == "ready"
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DevService (Studio only)
	Test tools so the owner can try every system quickly in Roblox Studio
	without grinding: give cash, beat the current barrier, open a chest,
	start a boost, reset progress.

	SAFETY: does nothing at all in a live (published, non-Studio) server —
	the request handlers are only registered when RunService:IsStudio().

	Actions (client DevController):
		DevGiveCash(amount)      -- amount from a fixed list
		DevBeatBarrier()         -- marks the barrier on your current area's exit gate as defeated
		DevChest(tier)           -- "wood" | "silver" | "gold"
		DevBoost(boostId)        -- applies a Config.Boosts entry for free
		DevReset()               -- wipes your progress back to a new player
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local DevService = {}

local Services: { [string]: any } = {}

local CASH_AMOUNTS = { [1000] = true, [100000] = true, [10000000] = true }
local CHEST_TIERS = { wood = true, silver = true, gold = true }

function DevService:Init(registry: { [string]: any })
	Services = registry
	if not RunService:IsStudio() then
		return
	end

	Net.Handle("DevGiveCash", function(player, amount)
		if type(amount) ~= "number" or not CASH_AMOUNTS[amount] then
			return Net.Fail("Bad amount")
		end
		Services.DataService:AddCash(player, amount, { source = "dev" })
		return Net.Ok()
	end)

	Net.Handle("DevBeatBarrier", function(player)
		local data = Services.DataService:Get(player)
		local base = Services.BaseService
		if not data or not base or not base.MarkBarrierDefeated then
			return Net.Fail("Base service not ready")
		end
		local area = data.base.highestArea
		if area >= #Config.Areas then
			return Net.Fail("Already at the last area")
		end
		base:MarkBarrierDefeated(player, area)
		return Net.Ok({ area = area })
	end)

	Net.Handle("DevChest", function(player, tier)
		local inventory = Services.InventoryService
		if type(tier) ~= "string" or not CHEST_TIERS[tier] then
			return Net.Fail("Bad chest tier")
		end
		if not inventory or not inventory.AwardChest then
			return Net.Fail("Inventory service not ready")
		end
		if player:GetAttribute("CombatActive") then
			return Net.Fail("Not during a fight")
		end
		local uid, item = inventory:AwardChest(player, tier)
		return Net.Ok({ uid = uid, item = item, tier = tier })
	end)

	Net.Handle("DevBoost", function(player, boostId)
		local boosts = Services.BoostService
		if type(boostId) ~= "string" then
			return Net.Fail("Bad boost")
		end
		local known = false
		for _, def in Config.Boosts do
			if def.id == boostId then
				known = true
			end
		end
		if not known then
			return Net.Fail("Unknown boost")
		end
		if not boosts or not boosts.ApplyBoost then
			return Net.Fail("Boost service not ready")
		end
		boosts:ApplyBoost(player, boostId)
		return Net.Ok()
	end)

	Net.Handle("DevReset", function(player)
		local data = Services.DataService:Get(player)
		if not data then
			return Net.Fail("Data not loaded")
		end
		if Services.ModeService:GetMode(player) ~= "Base" then
			return Net.Fail("Go back to the base first")
		end
		local fresh = Types.DefaultData() :: any
		local live = data :: any
		for key in live do
			live[key] = nil
		end
		for key, value in fresh do
			live[key] = value
		end
		Services.DataService:MarkDirty(player)
		return Net.Ok()
	end)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	InventoryService (server)
	Owns the player's combat equipment: inventory, equipped items and chest
	rewards. All item maths lives in Shared/Combat/EquipmentDefs.

	Requests (client -> server, via Net.Request):
		"EquipItem"(uid)    put an item you own in its slot (weapon / armour)
		"UpgradeItem"(uid)  pay Economy.EquipmentUpgradePrice(rarity, level), level + 1
		"ScrapItem"(uid)    destroy an item that is NOT equipped for EquipmentDefs.ScrapValue cash
		All three are refused while the player attribute CombatActive is true
		(the loadout is locked mid-fight; the lobby before round 1 is fine).

	Push channel "Inventory" (server -> client):
		"Granted",   { uid: string, item: Item, tier: string }   a chest item was added
		"Converted", { item: Item, value: number, tier: string } inventory was full: item paid out as cash

	Server API (other services, from Start or later):
		InventoryService:GetLoadoutStats(player): CombatStats
		InventoryService:AwardChest(player, chestTier): (string?, Item?)
			chestTier = "wood" | "silver" | "gold". Returns the new uid + item.
			[PROPOSAL] If the inventory is full (EquipmentDefs.MAX_INVENTORY) the
			item is converted to its scrap value in cash; then the uid is nil but
			the item is still returned so the chest animation can show it.
			Returns (nil, nil) if the player's data is not loaded or the tier is bad.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local EquipmentDefs = require(Shared.Combat.EquipmentDefs)
local Net = require(Shared.Net)
local Rng = require(Shared.Rng)
local Types = require(Shared.Types)

type Item = Types.Item
type PlayerData = Types.PlayerData
type CombatStats = EquipmentDefs.CombatStats

local InventoryService = {}
InventoryService.Priority = 40

local registry: { [string]: any } = {}
local rollCounter = 0

local VALID_TIERS = { wood = true, silver = true, gold = true }
local MAX_UID_LENGTH = 16

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------
local function getData(player: Player): PlayerData?
	local dataService = registry.DataService
	if not dataService then
		return nil
	end
	return dataService:Get(player)
end

local function markDirty(player: Player)
	local dataService = registry.DataService
	if dataService then
		dataService:MarkDirty(player)
	end
end

local function countItems(data: PlayerData): number
	local n = 0
	for _ in data.inventory do
		n += 1
	end
	return n
end

-- Shared checks for the three requests. Returns the data + item, or an error text.
local function validate(player: Player, uid: any): (PlayerData?, Item?, string?)
	if player:GetAttribute("CombatActive") == true then
		return nil, nil, "You can't change gear during a fight!"
	end
	if type(uid) ~= "string" or #uid == 0 or #uid > MAX_UID_LENGTH then
		return nil, nil, "Bad item"
	end
	local data = getData(player)
	if not data then
		return nil, nil, "Your data is still loading"
	end
	local item = data.inventory[uid]
	if type(item) ~= "table" or not EquipmentDefs.GetDef(item) then
		return nil, nil, "You don't have that item"
	end
	return data, item, nil
end

-- A brand-new uid that is not in use (normally just tostring(nextUid)).
local function takeUid(data: PlayerData): string
	local nextUid = math.max(1, math.floor(tonumber(data.nextUid) or 1))
	while data.inventory[tostring(nextUid)] ~= nil do
		nextUid += 1
	end
	data.nextUid = nextUid + 1
	return tostring(nextUid)
end

-- The best owned item of a slot (by power), or nil.
local function bestOfSlot(data: PlayerData, slot: string): string?
	local bestUid: string? = nil
	local bestPower = -1
	for uid, item in data.inventory do
		local d = EquipmentDefs.GetDef(item)
		if d and d.slot == slot then
			local power = EquipmentDefs.ItemPower(item)
			if power > bestPower then
				bestUid, bestPower = uid, power
			end
		end
	end
	return bestUid
end

-- Repairs a save after loading: nextUid above every numeric uid, equipped
-- slots pointing at real items of the right slot, and a starter item if a
-- slot has nothing at all (so nobody is ever stuck without gear).
local function repairData(player: Player, data: PlayerData)
	if type(data.inventory) ~= "table" then
		data.inventory = {}
	end
	if type(data.equipped) ~= "table" then
		data.equipped = {}
	end
	local highest = 0
	for uid, item in data.inventory do
		local n = tonumber(uid)
		if n and n > highest then
			highest = math.floor(n)
		end
		-- clean numbers in place (keeps unknown ids untouched for safety)
		local clean = EquipmentDefs.SanitizeItem(item)
		if clean then
			data.inventory[uid] = clean
		end
	end
	if type(data.nextUid) ~= "number" or data.nextUid <= highest then
		data.nextUid = highest + 1
	end

	for _, entry in
		{
			{ slot = "weapon", starter = Types.STARTER_WEAPON_ID },
			{ slot = "armour", starter = Types.STARTER_ARMOUR_ID },
		}
	do
		local slot = entry.slot
		local uid = (data.equipped :: any)[slot]
		local item = if type(uid) == "string" then data.inventory[uid] else nil
		local d = EquipmentDefs.GetDef(item)
		if not d or d.slot ~= slot then
			local replacement = bestOfSlot(data, slot)
			if replacement then
				(data.equipped :: any)[slot] = replacement
			else
				local newUid = takeUid(data)
				data.inventory[newUid] = { id = entry.starter, rarity = 1, level = 1 }
				(data.equipped :: any)[slot] = newUid
			end
		end
	end
	markDirty(player)
end

-------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------
local function onEquip(player: Player, uid: any)
	local data, item, err = validate(player, uid)
	if not data or not item then
		return Net.Fail(err or "Bad item")
	end
	local d = EquipmentDefs.GetDef(item)
	if not d then
		return Net.Fail("Unknown item")
	end
	local key = uid :: string
	if d.slot == "weapon" then
		data.equipped.weapon = key
	else
		data.equipped.armour = key
	end
	markDirty(player)
	return Net.Ok({ slot = d.slot, uid = key })
end

local function onUpgrade(player: Player, uid: any)
	local data, item, err = validate(player, uid)
	if not data or not item then
		return Net.Fail(err or "Bad item")
	end
	local clean = EquipmentDefs.SanitizeItem(item)
	if not clean then
		return Net.Fail("Unknown item")
	end
	local price = Economy.EquipmentUpgradePrice(clean.rarity, clean.level)
	if price == nil then
		return Net.Fail("Max level")
	end
	local dataService = registry.DataService
	if not dataService or not dataService:SpendCash(player, price) then
		return Net.Fail("Not enough cash")
	end
	item.rarity = clean.rarity
	item.level = clean.level + 1
	markDirty(player)
	return Net.Ok({ uid = uid, level = item.level, price = price })
end

local function onScrap(player: Player, uid: any)
	local data, item, err = validate(player, uid)
	if not data or not item then
		return Net.Fail(err or "Bad item")
	end
	if data.equipped.weapon == uid or data.equipped.armour == uid then
		return Net.Fail("Equip something else first")
	end
	local value = EquipmentDefs.ScrapValue(item)
	data.inventory[uid :: string] = nil
	local paid = 0
	local dataService = registry.DataService
	if dataService then
		-- A refund, not gameplay income: never boosted by 2x.
		paid = dataService:AddCash(player, value, { boostable = false, source = "scrap" })
	end
	markDirty(player)
	return Net.Ok({ uid = uid, value = paid })
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function InventoryService:Init(reg: { [string]: any })
	registry = reg
	Net.Handle("EquipItem", onEquip)
	Net.Handle("UpgradeItem", onUpgrade)
	Net.Handle("ScrapItem", onScrap)
end

function InventoryService:Start()
	local dataService = registry.DataService
	if not dataService then
		warn("[InventoryService] DataService missing")
		return
	end
	dataService.PlayerLoaded:Connect(function(player: Player, data: PlayerData)
		local ok, err = pcall(function()
			repairData(player, data)
		end)
		if not ok then
			warn("[InventoryService] repair failed for " .. player.Name .. ": " .. tostring(err))
		end
	end)
	-- Players that finished loading before we connected.
	for _, player in dataService:GetLoadedPlayers() do
		local data = dataService:Get(player)
		if data then
			pcall(function()
				repairData(player, data)
			end)
		end
	end
end

-------------------------------------------------------------------------------
-- Server API
-------------------------------------------------------------------------------
function InventoryService:GetLoadoutStats(player: Player): CombatStats
	local data = getData(player)
	local ok, result = pcall(function(): CombatStats
		return EquipmentDefs.LoadoutStats(data :: any)
	end)
	if ok and type(result) == "table" then
		return result
	end
	warn("[InventoryService] LoadoutStats failed: " .. tostring(result))
	return EquipmentDefs.LoadoutStats({} :: any)
end

function InventoryService:AwardChest(player: Player, chestTier: string): (string?, Item?)
	if type(chestTier) ~= "string" or not VALID_TIERS[chestTier] then
		warn("[InventoryService] bad chest tier " .. tostring(chestTier))
		return nil, nil
	end
	local data = getData(player)
	if not data then
		return nil, nil
	end
	-- Fresh, unpredictable seed per roll: clock + time + UserId + a counter.
	rollCounter += 1
	local seed = math.floor(os.clock() * 1e6) + os.time() * 7 + player.UserId * 7919 + rollCounter * 104729
	local item = EquipmentDefs.RollChest(chestTier, Rng.new(seed))

	if countItems(data) >= EquipmentDefs.MAX_INVENTORY then
		-- [PROPOSAL] full inventory: the drop is paid out as its scrap value.
		local value = EquipmentDefs.ScrapValue(item)
		local paid = 0
		local dataService = registry.DataService
		if dataService then
			paid = dataService:AddCash(player, value, { boostable = false, source = "scrap" })
		end
		Net.Fire("Inventory", player, "Converted", { item = item, value = paid, tier = chestTier })
		return nil, item
	end

	local uid = takeUid(data)
	data.inventory[uid] = item
	markDirty(player)
	Net.Fire("Inventory", player, "Granted", { uid = uid, item = item, tier = chestTier })
	return uid, item
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MapBuilder (server service, Priority 70)
	Builds the STATIC home base that every player shares, in the look of
	reference image 1 (docs/reference/1_base_tycoon.png):

		workspace.Map
			Area1 .. AreaN   sky-blue floor slab, a lighter cross-shaped walkway
			                 with thin white edge lines, 4 rounded plot outlines,
			                 chunky Lego walls with round studs on top (hedge
			                 green / yellow / red per area), walkway fillers in the
			                 gate openings, an area name sign at
			                 the west entrance, grass strips with low-poly trees,
			                 benches, street lamps (and a red phone box in area 1)
			Corridor1 ..     short walled bridge between two neighbouring areas
			                 (the black iron gate itself is drawn by each client,
			                 see client/World/BaseVisuals.luau)
			SpawnLocation    where players appear (Layout.SpawnPosition)
			RunnerPortal     the big orange "ARMY RUN ▶" pad (Layout.RunnerPortalPosition);
			                 the RUNNER client code detects players standing on it

	It also fills the sea (Terrain water) around the base island, the runner
	tracks and the combat arenas, and sets up colour correction + bloom so the
	game keeps the bright, saturated toy look of the reference images, plus a
	light cyan Atmosphere ("BaseAtmosphere") and a texture-free Sky ("BaseSky")
	so the sky is bright cyan instead of Roblox's default clouds.

	If workspace.Map already exists (for example a pre-baked map saved in the
	place file) the parts are NOT rebuilt, but terrain water and lighting are
	always applied.

	Public API:
		MapBuilder.Priority = 70
		MapBuilder:Init(registry)     -- builds the map (runs before players spawn)
		MapBuilder:Start()            -- nothing extra
		MapBuilder:GetPartCount(): number  -- how many parts were built (debug)

	Everything is positioned with Shared/Layout and coloured with Config.Palette.
	All parts are Anchored SmoothPlastic (Neon only for glowing lamp bulbs and
	the portal border). Thin "overlay" parts (walkways, lines, plot outlines)
	are raised by at least 0.02 studs above what is under them so they never
	flicker (z-fighting).
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)

local MapBuilder = {}
MapBuilder.Priority = 70

local P = Config.Palette
local PaletteByName = Config.Palette :: any

local FLOOR_Y = Layout.FLOOR_Y
local HALF = Layout.AREA_SIZE / 2 -- 80
local PATH_HALF = Layout.PATH_WIDTH / 2 -- 14
local GATE_HALF = Layout.GATE_WIDTH / 2 -- 10
local WALL_T = 3 -- wall thickness (studs)
local WALL_H = Layout.WALL_HEIGHT -- 6
local WALL_INNER = HALF - WALL_T -- 77: inside face of the perimeter wall
local STUD_SPACING = 4 -- one round Lego stud every 4 studs
local BRICK_LENGTH = 16 -- wall runs are split into bricks of about this length
local BARRIER_TOP = 18 -- invisible wall caps stop players jumping over walls
local RING = (HALF - WALL_T + Layout.PLOT_SIZE / 2 + 42) / 2 -- 73.5: centre of the free strip between plots and walls

-- Overlay heights (top surface above FLOOR_Y). Each layer is >= 0.02 higher.
local TOP_PATH_NS = 0.1
local TOP_PATH_EW = 0.12
local TOP_LINES = 0.16
local TOP_PLOTS = 0.2
local TOP_GRASS = 0.3

local partCount = 0

-------------------------------------------------------------------------------
-- Small part helpers
-------------------------------------------------------------------------------
type PartSpec = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Shape: Enum.PartType?,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	CastShadow: boolean?,
}

local function makePart(parent: Instance, spec: PartSpec): Part
	local part = Instance.new("Part")
	part.Name = spec.Name or "Part"
	part.Anchored = true
	part.Shape = spec.Shape or Enum.PartType.Block
	part.Size = spec.Size
	part.CFrame = spec.CFrame
	part.Color = spec.Color
	part.Material = spec.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = spec.Transparency or 0
	part.CanCollide = if spec.CanCollide == nil then true else spec.CanCollide
	part.CanTouch = false
	part.CastShadow = if spec.CastShadow == nil then true else spec.CastShadow
	part.Parent = parent
	partCount += 1
	return part
end

-- Box whose TOP surface is `top` studs above the floor, centred at (x, z).
local function slab(
	parent: Instance,
	name: string,
	x: number,
	z: number,
	sizeX: number,
	sizeZ: number,
	thickness: number,
	top: number,
	color: Color3
): Part
	return makePart(parent, {
		Name = name,
		Size = Vector3.new(sizeX, thickness, sizeZ),
		CFrame = CFrame.new(x, FLOOR_Y + top - thickness / 2, z),
		Color = color,
		CastShadow = false,
	})
end

-- Upright cylinder (Roblox cylinders lie along X, so we roll them 90 degrees).
local function cylinder(
	parent: Instance,
	name: string,
	centre: Vector3,
	diameter: number,
	height: number,
	color: Color3,
	collide: boolean?
): Part
	return makePart(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(centre) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		CanCollide = collide,
	})
end

local function ball(
	parent: Instance,
	name: string,
	centre: Vector3,
	diameter: number,
	color: Color3,
	collide: boolean?
): Part
	return makePart(parent, {
		Name = name,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = CFrame.new(centre),
		Color = color,
		CanCollide = collide,
	})
end

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

-- Text on one face of a part (signs). Text is white with a dark outline like
-- every label in the reference images.
local function faceText(part: BasePart, face: Enum.NormalId, text: string, background: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = background or P.PillBlack
	label.BackgroundTransparency = if background then 0 else 1
	label.Font = Config.Font
	label.Text = text
	label.TextColor3 = P.White
	label.TextScaled = true
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Color = P.TextStroke
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
end

-------------------------------------------------------------------------------
-- Lego walls
-------------------------------------------------------------------------------
-- A straight wall from (x1, z1) to (x2, z2) (axis aligned), split into bricks,
-- with a row of round studs on top and an invisible cap so nobody can jump
-- over it into the sea.
local function wallRun(parent: Instance, x1: number, z1: number, x2: number, z2: number, color: Color3)
	local alongX = math.abs(x2 - x1) >= math.abs(z2 - z1)
	local length = if alongX then math.abs(x2 - x1) else math.abs(z2 - z1)
	if length < 0.5 then
		return
	end
	local startX, startZ = math.min(x1, x2), math.min(z1, z2)
	local studColor = darker(color, 0.12)

	local bricks = math.max(1, math.floor(length / BRICK_LENGTH + 0.5))
	local brickLength = length / bricks
	for i = 0, bricks - 1 do
		local offset = (i + 0.5) * brickLength
		local cx = if alongX then startX + offset else x1
		local cz = if alongX then z1 else startZ + offset
		makePart(parent, {
			Name = "WallBrick",
			-- alternate a very slightly darker shade so the bricks read as Lego blocks
			Color = if i % 2 == 0 then color else darker(color, 0.05),
			Size = if alongX
				then Vector3.new(brickLength, WALL_H, WALL_T)
				else Vector3.new(WALL_T, WALL_H, brickLength),
			CFrame = CFrame.new(cx, FLOOR_Y + WALL_H / 2, cz),
		})
	end

	local studs = math.max(1, math.floor(length / STUD_SPACING))
	local spacing = length / studs
	for i = 0, studs - 1 do
		local offset = (i + 0.5) * spacing
		local cx = if alongX then startX + offset else x1
		local cz = if alongX then z1 else startZ + offset
		cylinder(parent, "Stud", Vector3.new(cx, FLOOR_Y + WALL_H + 0.35, cz), 1.9, 0.7, studColor, false)
	end

	-- Invisible cap (players can jump ~7 studs high; walls are 6).
	local capHeight = BARRIER_TOP - WALL_H
	makePart(parent, {
		Name = "WallCap",
		Size = if alongX then Vector3.new(length, capHeight, WALL_T) else Vector3.new(WALL_T, capHeight, length),
		CFrame = CFrame.new(
			if alongX then startX + length / 2 else x1,
			FLOOR_Y + WALL_H + capHeight / 2,
			if alongX then z1 else startZ + length / 2
		),
		Color = color,
		Transparency = 1,
		CastShadow = false,
	})
end

-------------------------------------------------------------------------------
-- Decorations (all inside the free strip between the plots and the walls)
-------------------------------------------------------------------------------
local function tree(parent: Instance, x: number, z: number, scale: number)
	local base = Vector3.new(x, FLOOR_Y + TOP_GRASS, z)
	makePart(parent, {
		Name = "TreeTrunk",
		Size = Vector3.new(1.4, 5 * scale, 1.4),
		CFrame = CFrame.new(base + Vector3.new(0, 2.5 * scale, 0)),
		Color = P.Wood,
	})
	-- Chunky low-poly leaves: two blobs and one tilted block.
	ball(parent, "Leaves", base + Vector3.new(0, 6.2 * scale, 0), 5.6 * scale, P.Hedge, false)
	ball(parent, "Leaves", base + Vector3.new(1.3 * scale, 7.9 * scale, 0.5 * scale), 3.8 * scale, P.HedgeDark, false)
	makePart(parent, {
		Name = "Leaves",
		Size = Vector3.new(3.4, 3.4, 3.4) * scale,
		CFrame = CFrame.new(base + Vector3.new(-1.2 * scale, 7.3 * scale, -0.6 * scale))
			* CFrame.Angles(math.rad(35), math.rad(45), 0),
		Color = P.Grass,
		CanCollide = false,
	})
end

-- Wooden bench. `facing` is the direction a person sitting on it looks.
local function bench(parent: Instance, x: number, z: number, facing: Vector3)
	local origin = Vector3.new(x, FLOOR_Y + TOP_GRASS, z)
	local cf = CFrame.lookAt(origin, origin + facing)
	makePart(
		parent,
		{ Name = "BenchSeat", Size = Vector3.new(5, 0.4, 1.6), CFrame = cf * CFrame.new(0, 1.6, 0), Color = P.Wood }
	)
	makePart(
		parent,
		{ Name = "BenchBack", Size = Vector3.new(5, 1.3, 0.3), CFrame = cf * CFrame.new(0, 2.6, 0.75), Color = P.Wood }
	)
	for _, side in { -2, 2 } do
		makePart(parent, {
			Name = "BenchLeg",
			Size = Vector3.new(0.4, 1.4, 1.4),
			CFrame = cf * CFrame.new(side, 0.7, 0),
			Color = P.GateIron,
		})
	end
end

local function lamp(parent: Instance, x: number, z: number)
	local base = Vector3.new(x, FLOOR_Y, z)
	cylinder(parent, "LampPole", base + Vector3.new(0, 4.5, 0), 0.6, 9, P.GateIron, true)
	makePart(parent, {
		Name = "LampCap",
		Size = Vector3.new(1.8, 0.5, 1.8),
		CFrame = CFrame.new(base + Vector3.new(0, 10.5, 0)),
		Color = P.GateIron,
	})
	ball(parent, "LampBulb", base + Vector3.new(0, 9.7, 0), 1.6, P.CoinShine, false).Material = Enum.Material.Neon
end

local function bush(parent: Instance, x: number, z: number)
	ball(parent, "Bush", Vector3.new(x, FLOOR_Y + 1.6, z), 4.4, P.Hedge, true)
	ball(parent, "Bush", Vector3.new(x + 1.2, FLOOR_Y + 2.4, z - 0.6), 3, P.HedgeDark, false)
end

-- Red phone box (image 1, top-left). Area 1 only.
local function phoneBox(parent: Instance, x: number, z: number)
	local base = Vector3.new(x, FLOOR_Y, z)
	makePart(parent, {
		Name = "PhoneBox",
		Size = Vector3.new(4, 8.4, 4),
		CFrame = CFrame.new(base + Vector3.new(0, 4.2, 0)),
		Color = P.WallRed,
	})
	makePart(parent, {
		Name = "PhoneRoof",
		Size = Vector3.new(4.6, 0.8, 4.6),
		CFrame = CFrame.new(base + Vector3.new(0, 8.8, 0)),
		Color = P.WallRed,
	})
	makePart(parent, {
		Name = "PhoneCrown",
		Size = Vector3.new(2.2, 0.7, 2.2),
		CFrame = CFrame.new(base + Vector3.new(0, 9.55, 0)),
		Color = P.WallRed,
	})
	-- Glass panes on all four sides.
	local glass = P.PanelBlue:Lerp(P.White, 0.45)
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local centre = base + Vector3.new(0, 4.4, 0) + dir * 2.03
		local size = if dir.X ~= 0 then Vector3.new(0.1, 5.4, 2.8) else Vector3.new(2.8, 5.4, 0.1)
		makePart(parent, {
			Name = "PhoneGlass",
			Size = size,
			CFrame = CFrame.new(centre),
			Color = glass,
			CanCollide = false,
			CastShadow = false,
		})
	end
	-- White "TELEPHONE" strip above the door (facing +Z, towards the walkway).
	local strip = makePart(parent, {
		Name = "PhoneSign",
		Size = Vector3.new(3.2, 0.7, 0.1),
		CFrame = CFrame.new(base + Vector3.new(0, 7.75, 2.06)),
		Color = P.PillBlack,
		CanCollide = false,
	})
	faceText(strip, Enum.NormalId.Back, "TELEPHONE")
end

-------------------------------------------------------------------------------
-- One area
-------------------------------------------------------------------------------
local function buildArea(map: Instance, areaIndex: number)
	local areaDef = Config.Areas[areaIndex]
	local areaCount = #Config.Areas
	local c = Layout.AreaCenter(areaIndex)
	local cx, cz = c.X, c.Z

	local folder = Instance.new("Folder")
	folder.Name = "Area" .. areaIndex
	folder.Parent = map

	local wallColor: Color3 = PaletteByName[areaDef.wall] or P.Hedge

	-- Floor slab (top surface at FLOOR_Y).
	slab(folder, "Floor", cx, cz, Layout.AREA_SIZE, Layout.AREA_SIZE, 4, 0, P.BaseFloor)

	-- Cross-shaped walkway (two arms, the east-west one 0.02 higher).
	local armLength = WALL_INNER * 2
	slab(folder, "PathNS", cx, cz, Layout.PATH_WIDTH, armLength, 0.1, TOP_PATH_NS, P.BasePath)
	slab(folder, "PathEW", cx, cz, armLength, Layout.PATH_WIDTH, 0.12, TOP_PATH_EW, P.BasePath)

	-- Thin white edge lines along both arms (not across the crossing).
	local lineW = 0.5
	local segLength = WALL_INNER - PATH_HALF
	local segMid = (WALL_INNER + PATH_HALF) / 2
	for _, sideSign in { -1, 1 } do
		for _, endSign in { -1, 1 } do
			local edge = sideSign * (PATH_HALF - lineW / 2)
			-- lines of the north-south arm
			slab(folder, "PathLine", cx + edge, cz + endSign * segMid, lineW, segLength, 0.04, TOP_LINES, P.BaseLine)
			-- lines of the east-west arm
			slab(folder, "PathLine", cx + endSign * segMid, cz + edge, segLength, lineW, 0.04, TOP_LINES, P.BaseLine)
		end
	end

	-- Plot outlines: a rounded light band around a floor-coloured inside,
	-- drawn with a SurfaceGui on an invisible thin part (crisp rounded corners).
	for slotIndex = 1, Config.SlotsPerArea do
		local plotCentre = Layout.SlotCenter(areaIndex, slotIndex)
		local plot = slab(
			folder,
			"PlotOutline",
			plotCentre.X,
			plotCentre.Z,
			Layout.PLOT_SIZE,
			Layout.PLOT_SIZE,
			0.05,
			TOP_PLOTS,
			P.PlotOutline
		)
		plot.Transparency = 1
		plot.CanCollide = false
		plot.CanQuery = false
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Outline"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 10
		gui.LightInfluence = 1
		gui.Parent = plot
		local band = 3 -- studs
		local frame = Instance.new("Frame")
		frame.BackgroundTransparency = 1
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.new(1, -band * 2 * 10, 1, -band * 2 * 10)
		frame.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 60)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = P.PlotOutline
		stroke.Thickness = band * 10
		stroke.Parent = frame
	end

	-- Perimeter walls (openings of GATE_WIDTH at z = 0 towards the neighbours).
	local north, south = cz - HALF + WALL_T / 2, cz + HALF - WALL_T / 2
	local west, east = cx - HALF + WALL_T / 2, cx + HALF - WALL_T / 2
	wallRun(folder, cx - HALF, north, cx + HALF, north, wallColor)
	wallRun(folder, cx - HALF, south, cx + HALF, south, wallColor)
	local function sideWall(x: number, hasOpening: boolean)
		local zMin, zMax = cz - HALF + WALL_T, cz + HALF - WALL_T
		if hasOpening then
			wallRun(folder, x, zMin, x, cz - GATE_HALF, wallColor)
			wallRun(folder, x, cz + GATE_HALF, x, zMax, wallColor)
		else
			wallRun(folder, x, zMin, x, zMax, wallColor)
		end
	end
	sideWall(west, areaIndex > 1)
	sideWall(east, areaIndex < areaCount)
	-- Walkway filler inside each wall opening, so the east-west walkway runs
	-- straight into the corridor (no darker strip / step at the gate).
	for _, side in { -1, 1 } do
		local hasOpening = if side < 0 then areaIndex > 1 else areaIndex < areaCount
		if hasOpening then
			slab(
				folder,
				"GatewayPath",
				cx + side * (WALL_INNER + WALL_T / 2),
				cz,
				WALL_T,
				Layout.GATE_WIDTH,
				0.12,
				TOP_PATH_EW,
				P.BasePath
			)
		end
	end

	-- Area name sign: an arch over the west entrance (a wall sign in area 1).
	-- The board is exactly as wide as the opening, so it fits BETWEEN the two
	-- pillars and they never cover the first / last letters.
	local signX = west
	for _, side in { -1, 1 } do
		makePart(folder, {
			Name = "SignPillar",
			Size = Vector3.new(WALL_T + 0.6, 15, 3.4),
			CFrame = CFrame.new(signX, FLOOR_Y + 7.5, cz + side * (GATE_HALF + 1.7)),
			Color = darker(wallColor, 0.1),
		})
	end
	local board = makePart(folder, {
		Name = "AreaSign",
		Size = Vector3.new(1.6, 4, Layout.GATE_WIDTH),
		CFrame = CFrame.new(signX, FLOOR_Y + 13, cz),
		Color = P.CardBlue,
	})
	local title = ("AREA %d: %s"):format(areaIndex, string.upper(areaDef.name))
	faceText(board, Enum.NormalId.Right, title, P.CardBlue) -- readable from inside the area
	if areaIndex > 1 then
		faceText(board, Enum.NormalId.Left, title, P.CardBlue) -- readable when arriving from the west
	end

	-- Decorations in the free strip between the plots and the walls.
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder
	local mirror = if areaIndex % 2 == 0 then -1 else 1 -- vary the layout between areas
	local stripLength = Layout.PLOT_SIZE - 4
	-- North strip (west half) and south strip (east half): grass + trees + bench.
	for _, strip in { { x = -42 * mirror, z = -RING, face = 1 }, { x = 42 * mirror, z = RING, face = -1 } } do
		slab(decor, "Grass", cx + strip.x, cz + strip.z, stripLength, 6, 0.3, TOP_GRASS, P.Grass)
		tree(decor, cx + strip.x - 17, cz + strip.z, 1)
		tree(decor, cx + strip.x + 17, cz + strip.z, 0.85)
		bench(decor, cx + strip.x, cz + strip.z, Vector3.new(0, 0, strip.face))
	end
	-- West strip (south half) and east strip (north half): grass + one tree.
	for _, strip in { { x = -RING, z = 42 * mirror }, { x = RING, z = -42 * mirror } } do
		slab(decor, "Grass", cx + strip.x, cz + strip.z, 6, stripLength, 0.3, TOP_GRASS, P.Grass)
		tree(decor, cx + strip.x, cz + strip.z + 12, 0.9)
		bush(decor, cx + strip.x, cz + strip.z - 12)
	end
	-- Street lamps where the walkway meets the strips.
	for _, pos in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		lamp(decor, cx + pos[1] * (PATH_HALF + 3), cz + pos[2] * RING)
	end
	-- Corner bushes / phone box.
	if areaIndex == 1 then
		phoneBox(decor, cx - RING, cz - RING)
	else
		bush(decor, cx - RING, cz - RING)
	end
	bush(decor, cx + RING, cz + RING)
end

-- Walled bridge between area `areaIndex` and the next one.
local function buildCorridor(map: Instance, areaIndex: number)
	local areaDef = Config.Areas[areaIndex]
	local wallColor: Color3 = PaletteByName[areaDef.wall] or P.Hedge
	local c = Layout.AreaCenter(areaIndex)
	local x0 = c.X + HALF
	local x1 = Layout.AreaCenter(areaIndex + 1).X - HALF
	local folder = Instance.new("Folder")
	folder.Name = "Corridor" .. areaIndex
	folder.Parent = map
	local width = Layout.GATE_WIDTH + WALL_T * 2
	slab(folder, "CorridorFloor", (x0 + x1) / 2, c.Z, x1 - x0, width, 4 + TOP_PATH_EW, TOP_PATH_EW, P.BasePath)
	for _, side in { -1, 1 } do
		local z = c.Z + side * (GATE_HALF + WALL_T / 2)
		wallRun(folder, x0, z, x1, z, wallColor)
	end
end

-------------------------------------------------------------------------------
-- Spawn + ARMY RUN portal
-------------------------------------------------------------------------------
local function buildSpawn(map: Instance)
	local spawnPos = Layout.SpawnPosition()
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	-- Top surface 0.04 above the walkway so it does not flicker.
	spawn.CFrame = CFrame.new(spawnPos.X, FLOOR_Y + TOP_PATH_NS + 0.06 - 0.5, spawnPos.Z)
	spawn.Color = P.PadBorder
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Neutral = true
	spawn.Duration = 0 -- no force field bubble
	spawn.AllowTeamChangeOnTouch = false
	spawn.Parent = map
	partCount += 1
end

local function buildPortal(map: Instance)
	local pos = Layout.RunnerPortalPosition()
	local folder = Instance.new("Folder")
	folder.Name = "RunnerPortal"
	folder.Parent = map

	local size = 15
	local base = slab(folder, "PortalPad", pos.X, pos.Z, size, size, 0.3, 0.3, P.CardOrange)
	-- Glowing neon border.
	local border = 1
	local borderTop = 0.34
	for _, side in { -1, 1 } do
		slab(
			folder,
			"PortalGlow",
			pos.X + side * (size / 2 - border / 2),
			pos.Z,
			border,
			size,
			0.1,
			borderTop,
			P.CardOrange
		).Material =
			Enum.Material.Neon
		slab(
			folder,
			"PortalGlow",
			pos.X,
			pos.Z + side * (size / 2 - border / 2),
			size - border * 2,
			border,
			0.1,
			borderTop,
			P.CardOrange
		).Material =
			Enum.Material.Neon
	end

	-- "ARMY RUN ▶" painted on top, reading the same way as the arch sign
	-- behind it: left to right along +X, its top towards the arch (-Z), so it
	-- is upright for players walking up from the spawn (+Z). The top edge of a
	-- SurfaceGui on a Top face points to the part's Left (-X) side, so an
	-- unrotated label reads sideways from the walkway (owner feedback); Rotation
	-- 90 turns it to face the spawn. The pad is square, so the canvas is too.
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PortalText"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = base
	local inner = Instance.new("Frame")
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	inner.Size = UDim2.fromScale(0.82, 0.82)
	inner.BackgroundColor3 = P.White
	inner.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.12, 0)
	corner.Parent = inner
	local label = Instance.new("TextLabel")
	label.Name = "PortalLabel"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.94, 0.5)
	label.Rotation = 90
	label.Font = Config.Font
	label.Text = "ARMY RUN ▶"
	label.TextScaled = true
	label.TextColor3 = P.CardOrange
	label.Parent = inner
	local stroke = Instance.new("UIStroke")
	stroke.Color = P.TextStroke
	stroke.Thickness = 5
	stroke.Parent = label

	-- Standing arch behind the pad, readable while walking up from the spawn.
	-- The posts stand just OUTSIDE the sign beam so they never cover its text.
	local archZ = pos.Z - size / 2 - 1.5
	local beamWidth = 20
	local postSize = 1.6
	for _, side in { -1, 1 } do
		makePart(folder, {
			Name = "ArchPost",
			Size = Vector3.new(postSize, 13, postSize),
			CFrame = CFrame.new(pos.X + side * (beamWidth / 2 + postSize / 2), FLOOR_Y + 6.5, archZ),
			Color = P.CardOrangeDark,
		})
	end
	local beam = makePart(folder, {
		Name = "ArchSign",
		Size = Vector3.new(beamWidth, 3.6, 1.2),
		CFrame = CFrame.new(pos.X, FLOOR_Y + 12, archZ),
		Color = P.CardOrange,
	})
	faceText(beam, Enum.NormalId.Back, "🏃 ARMY RUN ▶", P.CardOrange) -- Back face points +Z (towards the spawn)
end

-------------------------------------------------------------------------------
-- Terrain water + lighting (always applied)
-------------------------------------------------------------------------------
local function fillWater()
	local terrain = Workspace.Terrain
	terrain.WaterColor = P.Sea
	terrain.WaterTransparency = 0.3
	terrain.WaterReflectance = 0.3
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8

	-- One big sea covering the base island, the runner-track zone
	-- (x 0..(MaxSlots+1)*RUNNER_SLOT_SPACING, z ~600..1700) and the arena zone
	-- (x 0..(MaxSlots+1)*ARENA_SLOT_SPACING, z ~-800..-600), with a margin.
	local lastArea = Layout.AreaCenter(#Config.Areas)
	local minX = -HALF - 240
	local maxX = math.max(
		lastArea.X + HALF + 240,
		(Config.MaxSlots + 1) * Layout.RUNNER_SLOT_SPACING + 200,
		(Config.MaxSlots + 1) * Layout.ARENA_SLOT_SPACING + 200
	)
	local minZ = Layout.ARENA_Z - 100 - 200
	local maxZ = Layout.RUNNER_START_Z + 100 + 200

	local surface = FLOOR_Y - 1.5 -- just below the floor
	local depth = 16
	local chunk = 512 -- fill in chunks so no single call is huge
	local x = minX
	while x < maxX do
		local sizeX = math.min(chunk, maxX - x)
		local z = minZ
		while z < maxZ do
			local sizeZ = math.min(chunk, maxZ - z)
			local ok, err = pcall(function()
				terrain:FillBlock(
					CFrame.new(x + sizeX / 2, surface - depth / 2, z + sizeZ / 2),
					Vector3.new(sizeX, depth, sizeZ),
					Enum.Material.Water
				)
			end)
			if not ok then
				warn("[MapBuilder] water fill failed: " .. tostring(err))
				return
			end
			z += sizeZ
		end
		x += sizeX
	end
end

local function applyLighting()
	local cc = Lighting:FindFirstChild("BaseColorCorrection")
	if not (cc and cc:IsA("ColorCorrectionEffect")) then
		local created = Instance.new("ColorCorrectionEffect")
		created.Name = "BaseColorCorrection"
		created.Parent = Lighting
		cc = created
	end
	local colorCorrection = cc :: ColorCorrectionEffect
	colorCorrection.Saturation = 0.25
	colorCorrection.Contrast = 0.08
	colorCorrection.Brightness = 0.02
	colorCorrection.TintColor = Color3.new(1, 1, 1)
	colorCorrection.Enabled = true

	local bl = Lighting:FindFirstChild("BaseBloom")
	if not (bl and bl:IsA("BloomEffect")) then
		local created = Instance.new("BloomEffect")
		created.Name = "BaseBloom"
		created.Parent = Lighting
		bl = created
	end
	local bloom = bl :: BloomEffect
	bloom.Intensity = 0.35 -- subtle: only neon parts glow
	bloom.Size = 20
	bloom.Threshold = 1.6
	bloom.Enabled = true

	-- Keep the air clear and bright (no heavy fog), like both reference images.
	Lighting.FogEnd = 100000

	-- Cyan sky like the runner reference (image 2). Custom skybox images would
	-- need uploaded assets, so Roblox's built-in sky textures stay and a cyan
	-- Atmosphere tints them (strong Haze colours the sky and the far horizon,
	-- like the track fading into light cyan in image 2). Density stays low so
	-- the base and the arenas keep their saturated toy colours up close.
	local atmo = Lighting:FindFirstChild("BaseAtmosphere")
	if not (atmo and atmo:IsA("Atmosphere")) then
		local created = Instance.new("Atmosphere")
		created.Name = "BaseAtmosphere"
		created.Parent = Lighting
		atmo = created
	end
	local atmosphere = atmo :: Atmosphere
	atmosphere.Density = 0.2 -- [PROPOSAL]
	atmosphere.Offset = 0.25 -- [PROPOSAL]
	atmosphere.Color = P.Sky
	atmosphere.Decay = P.Sea
	atmosphere.Glare = 0
	atmosphere.Haze = 1.4 -- [PROPOSAL] (lower it if the far track looks too faded)

	-- Built-in sky textures (no uploads), with no sun / moon / stars, which the
	-- reference images do not show.
	local sk = Lighting:FindFirstChild("BaseSky")
	if not (sk and sk:IsA("Sky")) then
		local created = Instance.new("Sky")
		created.Name = "BaseSky"
		created.Parent = Lighting
		sk = created
	end
	local sky = sk :: Sky
	sky.CelestialBodiesShown = false
	sky.StarCount = 0
end

-------------------------------------------------------------------------------
-- Service
-------------------------------------------------------------------------------
function MapBuilder:Init(_registry: { [string]: any })
	local existing = Workspace:FindFirstChild("Map")
	if existing then
		print("[MapBuilder] workspace.Map already exists, keeping it (terrain + lighting still applied)")
	else
		local map = Instance.new("Folder")
		map.Name = "Map"
		for areaIndex = 1, #Config.Areas do
			buildArea(map, areaIndex)
			if areaIndex < #Config.Areas then
				buildCorridor(map, areaIndex)
			end
		end
		buildSpawn(map)
		buildPortal(map)
		-- Parent last: one replication burst instead of thousands of small ones.
		map.Parent = Workspace
		print(("[MapBuilder] built the base map (%d parts)"):format(partCount))
	end

	applyLighting()
	-- Terrain filling can take a moment; do it without delaying other services.
	task.spawn(fillWater)
end

function MapBuilder:Start() end

function MapBuilder:GetPartCount(): number
	return partCount
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ModeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ModeService
	Tracks what each player is doing and moves them between the three systems.

	Modes: "Base" (home map, default) | "Runner" | "Combat"
	The current mode is mirrored to the client as the Player attribute "Mode".
	Each player also gets a stable slot number (1..Config.MaxSlots) that picks
	their personal runner track and combat arena (see Layout).

	API (server):
		ModeService:GetMode(player): string
		ModeService:SetMode(player, mode)
		ModeService:GetSlot(player): number
		ModeService:Teleport(player, cframe): boolean
		ModeService:ReturnToBase(player, target: CFrame?)
			back to Base mode at `target`, or where the player stood before leaving the base
		ModeService.ModeChanged: Signal(player, newMode, oldMode)
			Services that run sessions (runner, combat) listen to this and clean
			up when a player leaves their mode for any reason (death, leaving...).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local ModeService = {}
ModeService.Priority = 90
ModeService.ModeChanged = Signal.new()

local modes: { [Player]: string } = {}
local slots: { [Player]: number } = {}
local usedSlots: { [number]: Player } = {}
local lastBaseCFrame: { [Player]: CFrame } = {}

local function allocateSlot(player: Player): number
	for i = 1, Config.MaxSlots do
		if not usedSlots[i] then
			usedSlots[i] = player
			return i
		end
	end
	-- More players than slots: share the last slot (tracks/arenas are per-client visuals anyway).
	return Config.MaxSlots
end

function ModeService:Init(_registry: { [string]: any }) end

function ModeService:Start()
	local function onPlayer(player: Player)
		slots[player] = allocateSlot(player)
		modes[player] = "Base"
		player:SetAttribute("Mode", "Base")
		player:SetAttribute("Slot", slots[player])
		player.CharacterAdded:Connect(function(character)
			-- A respawn always lands you back at the base.
			if modes[player] ~= "Base" then
				self:SetMode(player, "Base")
			end
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					if modes[player] ~= "Base" then
						self:SetMode(player, "Base")
					end
				end)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local old = modes[player]
		if old and old ~= "Base" then
			self.ModeChanged:Fire(player, "Base", old)
		end
		local slot = slots[player]
		if slot and usedSlots[slot] == player then
			usedSlots[slot] = nil
		end
		modes[player] = nil
		slots[player] = nil
		lastBaseCFrame[player] = nil
	end)
end

function ModeService:GetMode(player: Player): string
	return modes[player] or "Base"
end

function ModeService:GetSlot(player: Player): number
	return slots[player] or 1
end

function ModeService:SetMode(player: Player, mode: string)
	local old = modes[player] or "Base"
	if old == mode then
		return
	end
	if old == "Base" then
		-- Remember where the player was so we can bring them back there.
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			lastBaseCFrame[player] = root.CFrame
		end
	end
	modes[player] = mode
	player:SetAttribute("Mode", mode)
	self.ModeChanged:Fire(player, mode, old)
end

function ModeService:Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	if not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(cframe + Vector3.new(0, 3.5, 0))
	return true
end

function ModeService:ReturnToBase(player: Player, place: CFrame?)
	local target = place or lastBaseCFrame[player]
	if not target then
		target = CFrame.new(Layout.SpawnPosition())
	end
	self:SetMode(player, "Base")
	self:Teleport(player, target)
end

return ModeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RunnerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RunnerService (server)
	The server half of the ARMY RUNNER game mode (docs/ARCHITECTURE.md §6.1).

	What it does:
	  1. At Start it builds the static runner tracks in workspace.RunnerTracks:
	     one long white track per player slot (Layout.RunnerTrackStart(slot)),
	     with light-blue cross stripes, low side rails, tall INVISIBLE walls so
	     nobody can fall into the sea, a start platform and a finish plaza where
	     the client draws the enemy base.
	  2. It runs one run "session" per player and is the authority on money:
	     the client only reports which lane it picked in each row, the server
	     re-simulates the whole run with RunnerSim.Resolve and pays the result.
	  3. While a run is going it watches the avatar every Heartbeat and notes
	     which lane it was really in (and where across the track) as it crossed
	     each row. RunnerFinish only believes the client's lane when it matches
	     what the server saw (or is the next lane over and the avatar was within
	     LANE_EDGE_TOLERANCE studs of it - the server sees the avatar 0.1-0.3 s
	     late), so a cheater can not simply send the best lanes. The wide-shooting
	     stance of a split row (RunnerSim.Stance) comes from the same position:
	     the client's lateral when it is within LANE_EDGE_TOLERANCE of the
	     server's, else the server's.

	Net actions (client -> server, see ARCHITECTURE §3):
		RunnerPrepare()               -> { runId, course, level, area, slot, stats, runSpeed }
		BuyRunnerUpgrade(kind)        -> { kind, level, stats }   kind = "troops" | "damage" | "capacity"
		RunnerGo(runId)               -> { stats, runSpeed, bossHp }
		RunnerFinish(runId, choices, laterals) -> { result, paid, boosted, level, victory }
			laterals[i] = studs right of the centre line where the client crossed row i
		RunnerRetry(runId)            -> same as RunnerPrepare: a new run on the same track,
		                                 after a finished one (the defeat screen's TRY AGAIN)
		RunnerLeave()                 -> {}   back to the base, at Layout.RunnerReturnCFrame

	Push channel "Runner" (server -> client):
		"Ended", { runId }   -- the server ended the session (death, mode change)

	Public API (other services): none needed. The session table is private.

	Flow of one run:
		RunnerPrepare  - player must be in Base mode with loaded data. Generates the
		                 course, sets mode "Runner", teleports to the track start and
		                 freezes the avatar (WalkSpeed 0, no jumping).
		BuyRunnerUpgrade - permanent upgrades; allowed in Base mode, or in Runner
		                 mode before the run has started.
		RunnerGo       - locks the stats (plus the vehicle bonus) and the start time,
		                 sets WalkSpeed = RUN_SPEED, starts watching the lanes and
		                 puts the "RunnerGun" Tool in the avatar's hand (an invisible
		                 Handle the client welds the weapon model to; the standard
		                 tool-hold arm pose comes from the default Animate script).
		                 bossHp = RunnerSim.BossHp(course, stats) for the client.
		RunnerFinish   - sent ONCE by the client as soon as the squad reaches the
		                 castle, during the boss intro, and never before
		                 RunnerSim.MinDuration + a little slack on the client's
		                 clock (which starts later than ours), so the
		                 elapsed >= MinDuration x 0.9 check passes. The client then
		                 plays the boss fight from reply.result.boss, so the fight
		                 on screen is the one that is paid.
		                 anti-cheat time + position checks (fails if the avatar
		                 is missing), picks the lanes (client's if plausible, else
		                 the ones the server saw) and stances, re-simulates, pays
		                 boostable cash, and raises runner.level ONLY when the boss
		                 was beaten (owner request: a lost level is played again
		                 until it is won; the same level = the same course). A
		                 repeated request gets the same reply again (never pays twice).
		RunnerRetry    - after RunnerFinish: ends that session and starts a new one
		                 at the player's current level without leaving the track.
		RunnerLeave    - restores the avatar and returns to the base at the spawn,
		                 on the far side from the ARMY RUN pad (owner request: not
		                 back on the pad; the base's unlocks are right there).

	Every way a session ends (RunnerLeave, death / respawn / any mode change,
	leaving the game, a failed teleport) goes through endSession, which stops
	the lane watcher, restores the avatar and destroys the RunnerGun Tool.
	Money: RunnerSim pays whole dollars; DataService:AddCash rounds as well.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)
local RunnerCourse = require(Shared.Runner.RunnerCourse)
local RunnerDefs = require(Shared.Runner.RunnerDefs)
local RunnerSim = require(Shared.Runner.RunnerSim)

type Course = RunnerCourse.Course
type Row = RunnerCourse.Row
type Option = RunnerCourse.Option
type Stats = RunnerSim.Stats
type Result = RunnerSim.Result

local P = Config.Palette

local RunnerService = {}
RunnerService.Priority = 10

-------------------------------------------------------------------------------
-- Tunables
-------------------------------------------------------------------------------
local DEFAULT_RUN_SPEED = 24 -- used only if RunnerDefs.RUN_SPEED is missing
local MIN_DURATION_SLACK = 0.9 -- [REQUIREMENT ARCH §6.1] reject runs faster than MinDuration x 0.9
local FINISH_DISTANCE_SHARE = 0.6 -- [PROPOSAL] must have run at least 60% of the way to the boss
local TRACK_LATERAL_LIMIT = 45 -- [PROPOSAL] studs from the track centre still counted "on the track"
-- [PROPOSAL] The server sees the avatar 0.1-0.3 s late. A lane the client
-- reports is still accepted when it is next to the lane the server saw and
-- the avatar was at most this many studs outside it (sideways speed is at
-- most ~0.9 x RUN_SPEED, so 3 studs covers ~0.15 s of steering at full tilt,
-- plus the 1-stud gaps between lanes).
local LANE_EDGE_TOLERANCE = 3
local STRIPE_SPACING = 20 -- light-blue cross stripe every 20 studs (image 2)
local STRIPE_LENGTH = 9
local START_PLATFORM_LENGTH = 26
local PLAZA_LENGTH = 80
local PLAZA_WIDTH = 60
local WALL_HEIGHT = 40
local UPGRADE_KINDS = { troops = true, damage = true, capacity = true }
local GUN_NAME = "RunnerGun" -- RunnerVisuals looks for this Tool in the character

-- RUN_SPEED comes from ECON's RunnerDefs (fallback if the value is missing).
local function loadRunSpeed(): number
	local speed = (RunnerDefs :: any).RUN_SPEED
	if type(speed) == "number" and speed > 0 then
		return speed
	end
	return DEFAULT_RUN_SPEED
end
local RUN_SPEED = loadRunSpeed()

-------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------
type Session = {
	runId: string,
	course: Course,
	level: number,
	area: number,
	slot: number,
	character: Model,
	started: boolean,
	startTime: number,
	stats: Stats?, -- locked at RunnerGo
	bossHp: number?, -- RunnerSim.BossHp(course, stats), computed at RunnerGo
	finished: boolean,
	reply: { [string]: any }?, -- cached RunnerFinish reply (safe to resend)
	sampler: RBXScriptConnection?, -- Heartbeat lane watcher (RunnerGo .. endSession / finish)
	serverChoices: { [number]: number }, -- row index -> lane the server saw the avatar in
	serverLaterals: { [number]: number }, -- row index -> lateral offset (studs) at that moment
	nextSampleRow: number, -- first row the avatar has not crossed yet (server view)
	lastTravelled: number?, -- latest sample: studs down the track
	lastLateral: number?, -- latest sample: studs right of the centre line
	originalWalkSpeed: number,
	originalJumpHeight: number,
	originalJumpPower: number,
	gun: Tool?, -- the RunnerGun in the avatar's hand (RunnerGo .. endSession)
	gunWatch: RBXScriptConnection?,
}

local registry: { [string]: any } = {}
local sessions: { [Player]: Session } = {}
local runCounter = 0

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------
local function getHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Copy the stats table so later upgrades never change a run in progress.
local function copyStats(stats: { startTroops: number, damage: number, capacity: number }, bonus: number?): Stats
	return {
		startTroops = stats.startTroops,
		damage = stats.damage,
		capacity = stats.capacity,
		payoutBonus = bonus,
	}
end

local function currentStats(data: any): { startTroops: number, damage: number, capacity: number }
	return Economy.RunnerStats(data.runner.upgrades, data.base.highestArea)
end

-- Vehicle runner bonus (SHOP). Missing service / bad value -> 0.
local function vehicleBonus(player: Player): number
	local vehicles = registry.VehicleService
	if not vehicles or type(vehicles.GetRunnerBonus) ~= "function" then
		return 0
	end
	local ok, bonus = pcall(vehicles.GetRunnerBonus, vehicles, player)
	if ok and isFiniteNumber(bonus) then
		return math.clamp(bonus :: number, 0, 1)
	end
	return 0
end

-- Put the avatar's movement settings back the way they were before the run.
local function restoreHumanoid(session: Session)
	local humanoid = getHumanoid(session.character)
	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = session.originalWalkSpeed
		humanoid.JumpHeight = session.originalJumpHeight
		humanoid.JumpPower = session.originalJumpPower
	end
end

-- The gun the avatar holds during the run: a Tool with an invisible Handle.
-- Parenting a Tool to the character equips it (RightGrip weld + the default
-- tool-hold arm pose). The client welds the part-built gun model to the Handle.
local function destroyGun(session: Session)
	local watch = session.gunWatch
	session.gunWatch = nil
	if watch then
		watch:Disconnect()
	end
	local gun = session.gun
	session.gun = nil
	if gun then
		gun:Destroy()
	end
end

local function giveGun(player: Player, session: Session)
	destroyGun(session)
	local character = session.character
	local humanoid = getHumanoid(character)
	if not humanoid or not character.Parent then
		return
	end
	-- Anything else in the hand goes back to the backpack first.
	humanoid:UnequipTools()
	local stale = character:FindFirstChild(GUN_NAME)
	if stale then
		stale:Destroy()
	end
	local tool = Instance.new("Tool")
	tool.Name = GUN_NAME
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ManualActivationOnly = true
	tool.ToolTip = ""
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 1)
	handle.Transparency = 1
	handle.Massless = true
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.CastShadow = false
	handle.Parent = tool
	tool.Parent = character
	session.gun = tool
	-- If the tool ever lands in the backpack (unequipped), put it back in
	-- the hand while the run lasts. (HUD hides the hotbar, so this is rare.)
	session.gunWatch = tool.AncestryChanged:Connect(function()
		task.defer(function()
			if sessions[player] ~= session or session.gun ~= tool then
				return
			end
			if tool.Parent and tool.Parent:IsA("Backpack") and session.character.Parent then
				tool.Parent = session.character
			end
		end)
	end)
end

local function stopSampling(session: Session)
	local sampler = session.sampler
	if sampler then
		session.sampler = nil
		sampler:Disconnect()
	end
end

-- Ends a session without touching the player's mode. Safe to call twice.
local function endSession(player: Player, notifyClient: boolean)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	stopSampling(session)
	destroyGun(session)
	restoreHumanoid(session)
	if notifyClient and player.Parent then
		Net.Fire("Runner", player, "Ended", { runId = session.runId })
	end
end

-- Distance along the track of the enemy base, used by the "did you really
-- get there" check. (The client draws the fort on the finish plaza, at this
-- distance or a little further.)
local function bossDistance(course: Course): number
	return math.min(course.boss.distance, Layout.RUNNER_TRACK_LENGTH + 30)
end

-------------------------------------------------------------------------------
-- Lane watching (anti-cheat for the lane choices)
-------------------------------------------------------------------------------
-- Which lane (option) of a row a lateral position is in; between lanes or
-- off the edge -> the nearest lane. Same rule as RunnerController's laneAt.
local function laneAt(row: Row, lateral: number): number
	local best, bestDistance = 1, math.huge
	for index, option in row.options do
		local lane = if type(option.lane) == "number" then option.lane else index
		local half = option.width / 2
		if lateral >= option.x - half and lateral <= option.x + half then
			return lane
		end
		local d = math.abs(lateral - option.x)
		if d < bestDistance then
			best, bestDistance = lane, d
		end
	end
	return best
end

local function optionForLane(row: Row, lane: number): Option?
	for index, option in row.options do
		if (if type(option.lane) == "number" then option.lane else index) == lane then
			return option
		end
	end
	return nil
end

-- Studs the lateral position lies outside an option's [x - width/2, x + width/2].
local function outsideLane(option: Option, lateral: number): number
	return math.max(0, math.abs(lateral - option.x) - option.width / 2)
end

-- One sample of the avatar: records the lane of every row it has newly
-- crossed. Between two samples the position is interpolated, so the lane is
-- taken exactly where the avatar passed the row's distance.
local function sampleRows(session: Session)
	local root = getRoot(session.character)
	if not root then
		return
	end
	local start = Layout.RunnerPoint(session.slot, 0, 0)
	local position = root.CFrame.Position
	local travelled = start.Z - position.Z
	local lateral = position.X - start.X
	if not isFiniteNumber(travelled) or not isFiniteNumber(lateral) then
		return
	end
	local prevTravelled, prevLateral = session.lastTravelled, session.lastLateral
	local rows = session.course.rows
	while session.nextSampleRow <= #rows do
		local index = session.nextSampleRow
		local row = rows[index]
		if travelled < row.distance then
			break
		end
		local at = lateral
		if prevTravelled and prevLateral and prevTravelled < row.distance and travelled > prevTravelled then
			local t = (row.distance - prevTravelled) / (travelled - prevTravelled)
			at = prevLateral + (lateral - prevLateral) * t
		end
		session.serverChoices[index] = laneAt(row, at)
		session.serverLaterals[index] = at
		session.nextSampleRow = index + 1
	end
	session.lastTravelled = travelled
	session.lastLateral = lateral
end

-- The lanes that are paid. Per row: the client's lane if it is the lane the
-- server saw, or the lane next to it while the avatar was within
-- LANE_EDGE_TOLERANCE studs of it; otherwise the lane the server saw. Rows
-- the server never saw crossed -> the lane nearest to the latest sample.
local function chooseLanes(session: Session, choices: any): { number }
	local clean: { number } = {}
	local source = if type(choices) == "table" then choices else {}
	local fallbackLateral = session.lastLateral or 0
	for i, row in session.course.rows do
		local observed = session.serverChoices[i]
		if observed == nil then
			clean[i] = laneAt(row, fallbackLateral)
			continue
		end
		local lane = observed
		local claimed = rawget(source, i)
		local at = session.serverLaterals[i]
		if type(claimed) == "number" and claimed ~= observed and math.abs(claimed - observed) == 1 and at then
			local option = optionForLane(row, claimed)
			if option and outsideLane(option, at) <= LANE_EDGE_TOLERANCE then
				lane = claimed
			end
		end
		clean[i] = lane
	end
	return clean
end

-- Wide-shooting stance per row (RunnerSim.Stance) for the lanes that are
-- paid: from the client's lateral when it is within LANE_EDGE_TOLERANCE of
-- where the server saw the avatar cross, else from the server's own sample.
local function chooseStances(session: Session, lanes: { number }, laterals: any): { number }
	local clean: { number } = {}
	local source = if type(laterals) == "table" then laterals else {}
	for i, row in session.course.rows do
		if not RunnerSim.IsSplitRow(row) then
			clean[i] = 0
			continue
		end
		local at = session.serverLaterals[i] or session.lastLateral or 0
		local claimed = rawget(source, i)
		if isFiniteNumber(claimed) and math.abs((claimed :: number) - at) <= LANE_EDGE_TOLERANCE then
			at = claimed :: number
		end
		clean[i] = RunnerSim.Stance(row, lanes[i], at)
	end
	return clean
end

-------------------------------------------------------------------------------
-- Static track building
-------------------------------------------------------------------------------
local function makePart(props: {
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	transparency: number?,
	canCollide: boolean?,
})
	local part = Instance.new("Part")
	part.Name = props.name
	part.Anchored = true
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = props.color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = props.transparency or 0
	part.CanCollide = if props.canCollide == nil then true else props.canCollide
	part.CastShadow = (props.transparency or 0) < 1
	if props.canCollide == false then
		part.CanQuery = false
		part.CanTouch = false
	end
	part.Parent = props.parent
	return part
end

-- Centre of a box on a track, `fromDist`..`toDist` studs from the start,
-- `lateral` studs right of the centre line, with its TOP at `topY`.
local function boxCFrame(
	slot: number,
	fromDist: number,
	toDist: number,
	lateral: number,
	topY: number,
	height: number
): CFrame
	local mid = Layout.RunnerPoint(slot, (fromDist + toDist) / 2, lateral)
	return CFrame.new(mid.X, topY - height / 2, mid.Z)
end

local function buildTrack(slot: number, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Track_" .. slot
	folder:SetAttribute("Slot", slot)

	local width = Layout.RUNNER_TRACK_WIDTH
	local length = Layout.RUNNER_TRACK_LENGTH
	local floorY = Layout.FLOOR_Y
	local floorThickness = 4
	local halfW = width / 2

	-- Start platform (behind the start line) + main track floor.
	makePart({
		name = "StartPlatform",
		size = Vector3.new(width, floorThickness, START_PLATFORM_LENGTH),
		cframe = boxCFrame(slot, -START_PLATFORM_LENGTH, 0, 0, floorY, floorThickness),
		color = P.TrackWhite,
		parent = folder,
	})
	makePart({
		name = "Floor",
		size = Vector3.new(width, floorThickness, length),
		cframe = boxCFrame(slot, 0, length, 0, floorY, floorThickness),
		color = P.TrackWhite,
		parent = folder,
	})

	-- Very light blue cross stripes (decoration only, no collision).
	local stripes = Instance.new("Folder")
	stripes.Name = "Stripes"
	stripes.Parent = folder
	local d = STRIPE_SPACING / 2
	while d + STRIPE_LENGTH < length do
		makePart({
			name = "Stripe",
			size = Vector3.new(width - 0.2, 0.1, STRIPE_LENGTH),
			cframe = boxCFrame(slot, d, d + STRIPE_LENGTH, 0, floorY + 0.06, 0.1),
			color = P.TrackStripe,
			parent = stripes,
			canCollide = false,
		})
		d += STRIPE_SPACING
	end

	-- Low side rails along both edges (from the start platform to the plaza).
	local railFrom = -START_PLATFORM_LENGTH
	for _, side in { -1, 1 } do
		makePart({
			name = "Rail",
			size = Vector3.new(1, 1.2 + floorThickness, length - railFrom),
			cframe = boxCFrame(slot, railFrom, length, side * (halfW + 0.5), floorY + 1.2, 1.2 + floorThickness),
			color = P.TrackRail,
			parent = folder,
		})
		-- Tall invisible wall so the player can never fall into the sea.
		makePart({
			name = "InvisibleWall",
			size = Vector3.new(1, WALL_HEIGHT, length - railFrom),
			cframe = boxCFrame(slot, railFrom, length, side * (halfW + 1.5), floorY + WALL_HEIGHT, WALL_HEIGHT),
			color = P.TrackRail,
			parent = folder,
			transparency = 1,
		})
	end
	-- Rail + invisible wall behind the start platform.
	makePart({
		name = "BackRail",
		size = Vector3.new(width + 2, 1.2 + floorThickness, 1),
		cframe = boxCFrame(slot, railFrom - 1, railFrom, 0, floorY + 1.2, 1.2 + floorThickness),
		color = P.TrackRail,
		parent = folder,
	})
	makePart({
		name = "InvisibleBackWall",
		size = Vector3.new(width + 4, WALL_HEIGHT, 1),
		cframe = boxCFrame(slot, railFrom - 2, railFrom - 1, 0, floorY + WALL_HEIGHT, WALL_HEIGHT),
		color = P.TrackRail,
		parent = folder,
		transparency = 1,
	})

	-- Finish plaza (the client builds the enemy base on top of it).
	local plazaFrom = length
	local plazaTo = length + PLAZA_LENGTH
	local halfP = PLAZA_WIDTH / 2
	makePart({
		name = "FinishPlaza",
		size = Vector3.new(PLAZA_WIDTH, floorThickness, PLAZA_LENGTH),
		cframe = boxCFrame(slot, plazaFrom, plazaTo, 0, floorY, floorThickness),
		color = P.TrackWhite,
		parent = folder,
	})
	-- Plaza rails + invisible walls: left, right, far end and the two short
	-- front pieces either side of where the track joins.
	local frontPiece = halfP - (halfW + 2)
	local walls = {
		{ size = Vector3.new(1, 0, PLAZA_LENGTH), from = plazaFrom, to = plazaTo, lateral = -(halfP + 0.5) },
		{ size = Vector3.new(1, 0, PLAZA_LENGTH), from = plazaFrom, to = plazaTo, lateral = halfP + 0.5 },
		{ size = Vector3.new(PLAZA_WIDTH + 2, 0, 1), from = plazaTo, to = plazaTo + 1, lateral = 0 },
		{
			size = Vector3.new(frontPiece, 0, 1),
			from = plazaFrom - 1,
			to = plazaFrom,
			lateral = -(halfW + 2 + frontPiece / 2),
		},
		{
			size = Vector3.new(frontPiece, 0, 1),
			from = plazaFrom - 1,
			to = plazaFrom,
			lateral = halfW + 2 + frontPiece / 2,
		},
	}
	for _, w in walls do
		makePart({
			name = "PlazaRail",
			size = Vector3.new(w.size.X, 1.2 + floorThickness, w.size.Z),
			cframe = boxCFrame(slot, w.from, w.to, w.lateral, floorY + 1.2, 1.2 + floorThickness),
			color = P.TrackRail,
			parent = folder,
		})
		makePart({
			name = "InvisibleWall",
			size = Vector3.new(w.size.X, WALL_HEIGHT, w.size.Z),
			cframe = boxCFrame(slot, w.from, w.to, w.lateral, floorY + WALL_HEIGHT, WALL_HEIGHT),
			color = P.TrackRail,
			parent = folder,
			transparency = 1,
		})
	end

	folder.Parent = parent
end

local function buildTracks()
	if Workspace:FindFirstChild("RunnerTracks") then
		return -- pre-baked into the place file already
	end
	local root = Instance.new("Folder")
	root.Name = "RunnerTracks"
	for slot = 1, Config.MaxSlots do
		buildTrack(slot, root)
	end
	root.Parent = Workspace
end

-------------------------------------------------------------------------------
-- Request handlers
-------------------------------------------------------------------------------
local function modeService(): any
	return registry.ModeService
end

local function dataService(): any
	return registry.DataService
end

-- Creates a session at the player's current level and puts the avatar at
-- the start of its track, frozen. `fromBase` = coming from the base (switch
-- the mode to Runner first); false = a retry on the track (already Runner).
local function startRun(player: Player, data: any, character: Model, humanoid: Humanoid, fromBase: boolean)
	local Mode = modeService()
	local area = math.clamp(math.floor(data.base.highestArea), 1, #Config.Areas)
	local level = math.max(1, math.floor(data.runner.level))
	local course = RunnerCourse.Generate(area, level)
	local slot = Mode:GetSlot(player)

	-- Get off any vehicle before teleporting (SHOP also does this on mode change).
	local vehicles = registry.VehicleService
	if vehicles and type(vehicles.Dismount) == "function" then
		pcall(vehicles.Dismount, vehicles, player)
	end

	runCounter += 1
	local session: Session = {
		runId = ("%d-%d-%d"):format(player.UserId, runCounter, math.floor(os.clock() * 1000) % 100000),
		course = course,
		level = level,
		area = area,
		slot = slot,
		character = character,
		started = false,
		startTime = 0,
		stats = nil,
		bossHp = nil,
		finished = false,
		reply = nil,
		sampler = nil,
		serverChoices = {},
		serverLaterals = {},
		nextSampleRow = 1,
		lastTravelled = nil,
		lastLateral = nil,
		originalWalkSpeed = if humanoid.WalkSpeed > 0 then humanoid.WalkSpeed else StarterPlayer.CharacterWalkSpeed,
		originalJumpHeight = if humanoid.JumpHeight > 0 then humanoid.JumpHeight else StarterPlayer.CharacterJumpHeight,
		originalJumpPower = if humanoid.JumpPower > 0 then humanoid.JumpPower else StarterPlayer.CharacterJumpPower,
		gun = nil,
		gunWatch = nil,
	}

	-- Mode first (ModeService remembers where you stood in the base), then teleport.
	if fromBase then
		Mode:SetMode(player, "Runner")
	end
	sessions[player] = session
	local startCFrame = Layout.RunnerTrackStart(slot) * CFrame.new(0, 0, 4)
	if not Mode:Teleport(player, startCFrame) then
		endSession(player, false)
		if fromBase then
			Mode:SetMode(player, "Base") -- never left the base
		else
			Mode:ReturnToBase(player, Layout.RunnerReturnCFrame())
		end
		return Net.Fail("Could not reach the track, try again")
	end
	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	humanoid.JumpPower = 0

	return Net.Ok({
		runId = session.runId,
		course = course,
		level = level,
		area = area,
		slot = slot,
		stats = currentStats(data),
		runSpeed = RUN_SPEED,
	})
end

-- The checks every new run needs; returns (data, character, humanoid) or a failure reply.
local function readyToRun(player: Player): (any, Model?, Humanoid?, any)
	local Data = dataService()
	local data = Data:Get(player)
	if not data then
		return nil, nil, nil, Net.Fail("Your data is still loading")
	end
	local character = player.Character
	local humanoid = getHumanoid(character)
	local root = getRoot(character)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil, nil, Net.Fail("Your character is not ready")
	end
	return data, character, humanoid, nil
end

local function onPrepare(player: Player)
	local Mode = modeService()
	local Data = dataService()
	if not Mode or not Data then
		return Net.Fail("The game is still starting, try again")
	end
	if sessions[player] then
		return Net.Fail("You are already on a run")
	end
	if Mode:GetMode(player) ~= "Base" then
		return Net.Fail("Finish what you are doing first")
	end
	local data, character, humanoid, failure = readyToRun(player)
	if failure or not character or not humanoid then
		return failure
	end
	return startRun(player, data, character, humanoid, true)
end

-- TRY AGAIN on the defeat screen: a new run at the current level (a lost
-- level did not go up) without the trip back to the base.
local function onRetry(player: Player, runId: any)
	local Mode = modeService()
	local Data = dataService()
	if not Mode or not Data then
		return Net.Fail("The game is still starting, try again")
	end
	local old = sessions[player]
	if not old or type(runId) ~= "string" or runId ~= old.runId then
		return Net.Fail("This run has ended")
	end
	if not old.finished then
		return Net.Fail("Finish the run first")
	end
	if Mode:GetMode(player) ~= "Runner" then
		return Net.Fail("This run has ended")
	end
	local data, character, humanoid, failure = readyToRun(player)
	if failure or not character or not humanoid then
		return failure
	end
	endSession(player, false) -- restores the avatar and removes the gun first
	return startRun(player, data, character, humanoid, false)
end

local function onBuyUpgrade(player: Player, kind: any)
	local Mode = modeService()
	local Data = dataService()
	if not Mode or not Data then
		return Net.Fail("The game is still starting, try again")
	end
	if type(kind) ~= "string" or not UPGRADE_KINDS[kind] then
		return Net.Fail("Unknown upgrade")
	end
	local mode = Mode:GetMode(player)
	local session = sessions[player]
	local allowed = mode == "Base" or (mode == "Runner" and session ~= nil and not session.started)
	if not allowed then
		return Net.Fail("Upgrades can only be bought before a run starts")
	end
	local data = Data:Get(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	local upgrades = data.runner.upgrades :: { [string]: number }
	local level = upgrades[kind] or 0
	if level >= Economy.RunnerUpgradeMaxLevel then
		return Net.Fail("Already at max level")
	end
	local price = Economy.RunnerUpgradePrice(kind, level)
	if price == nil or not isFiniteNumber(price) or price < 0 then
		return Net.Fail("Already at max level")
	end
	if not Data:SpendCash(player, price) then
		return Net.Fail("Not enough cash")
	end
	upgrades[kind] = level + 1
	Data:MarkDirty(player)
	return Net.Ok({ kind = kind, level = level + 1, stats = currentStats(data) })
end

local function onGo(player: Player, runId: any)
	local Mode = modeService()
	local Data = dataService()
	local session = sessions[player]
	if not session or type(runId) ~= "string" or runId ~= session.runId then
		return Net.Fail("This run has ended")
	end
	if session.started then
		-- Repeated request (double input): answer the same thing again.
		return Net.Ok({ stats = session.stats, runSpeed = RUN_SPEED, bossHp = session.bossHp })
	end
	if not Mode or Mode:GetMode(player) ~= "Runner" then
		return Net.Fail("This run has ended")
	end
	local data = Data and Data:Get(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	local humanoid = getHumanoid(session.character)
	if not humanoid or humanoid.Health <= 0 or player.Character ~= session.character then
		return Net.Fail("Your character is not ready")
	end

	local bonus = vehicleBonus(player)
	local stats = copyStats(currentStats(data), if bonus > 0 then bonus else nil)
	session.stats = stats
	session.started = true
	session.startTime = os.clock()
	humanoid.WalkSpeed = RUN_SPEED
	-- Boss max HP for this course + stats (memoized; RunnerFinish's Resolve reuses it).
	local okHp, bossHp = pcall(RunnerSim.BossHp, session.course, stats)
	session.bossHp = if okHp and isFiniteNumber(bossHp) then bossHp else nil
	giveGun(player, session)

	-- Watch which lane the avatar is really in as it crosses each row.
	-- ASSUMPTION: this runs every Heartbeat (faster than the 30 Hz loop rule)
	-- on purpose - it is one position read per running player, and a finer
	-- sample keeps honest players' lanes exact.
	sampleRows(session)
	stopSampling(session)
	session.sampler = RunService.Heartbeat:Connect(function()
		if sessions[player] ~= session then
			stopSampling(session)
			return
		end
		sampleRows(session)
	end)
	return Net.Ok({ stats = session.stats, runSpeed = RUN_SPEED, bossHp = session.bossHp })
end

-- Make sure the vehicle bonus shows up exactly once in the result.
-- RunnerSim is expected to apply Stats.payoutBonus itself (a "bonus" line).
-- If it did not, apply it here so the player still gets it.
local function ensureBonus(result: Result, bonus: number?)
	if not bonus or bonus <= 0 then
		return
	end
	for _, line in result.lines do
		if line.kind == "bonus" then
			return
		end
	end
	local extra = Format.RoundWhole(result.total * bonus)
	if extra <= 0 then
		return
	end
	table.insert(result.lines, {
		kind = "bonus",
		label = "Vehicle bonus",
		detail = "+" .. Format.Percent(bonus) .. " payout",
		value = extra,
	})
	result.total = Format.RoundWhole(result.total + extra)
end

local function onFinish(player: Player, runId: any, choices: any, laterals: any)
	local Data = dataService()
	local session = sessions[player]
	if not session or type(runId) ~= "string" or runId ~= session.runId then
		return Net.Fail("This run has ended")
	end
	if session.finished and session.reply then
		return Net.Ok(session.reply) -- the reply got lost, send it again (no double pay)
	end
	if not session.started or not session.stats then
		return Net.Fail("The run has not started")
	end
	local data = Data and Data:Get(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end

	-- Anti-cheat: time and position.
	local elapsed = os.clock() - session.startTime
	if elapsed < RunnerSim.MinDuration(session.course) * MIN_DURATION_SLACK then
		return Net.Fail("That was too fast!")
	end
	local root = getRoot(session.character)
	if not root then
		return Net.Fail("Your character is not ready")
	end
	local start = Layout.RunnerPoint(session.slot, 0, 0)
	local position = root.CFrame.Position
	local travelled = start.Z - position.Z
	local lateral = math.abs(position.X - start.X)
	if travelled < bossDistance(session.course) * FINISH_DISTANCE_SHARE or lateral > TRACK_LATERAL_LIMIT then
		return Net.Fail("You did not reach the enemy base")
	end
	-- Last sample: rows still ahead of the avatar count with the lane it stands in now.
	sampleRows(session)

	local stats = session.stats :: Stats
	local clean = chooseLanes(session, choices)
	local stances = chooseStances(session, clean, laterals)
	local result = RunnerSim.Resolve(session.course, stats, clean, stances)
	ensureBonus(result, stats.payoutBonus)
	local victory = type(result.boss) == "table" and result.boss.victory == true

	local total = if isFiniteNumber(result.total) then math.max(0, Format.RoundWhole(result.total)) else 0
	local paid = if total > 0 then Data:AddCash(player, total, { boostable = true, source = "runner" }) else 0

	local runner = data.runner
	-- Owner request: a lost level is played again until the boss is beaten.
	runner.level = math.max(1, math.floor(runner.level)) + (if victory then 1 else 0)
	runner.runs += 1
	runner.bestPayout = math.max(runner.bestPayout, paid)
	Data:MarkDirty(player)

	local reply = {
		result = result,
		paid = paid,
		boosted = paid > total + 0.001,
		level = runner.level, -- the level of the NEXT run
		victory = victory,
	}
	session.finished = true
	session.reply = reply
	stopSampling(session) -- the lanes are final now
	return Net.Ok(reply)
end

local function onLeave(player: Player)
	local Mode = modeService()
	endSession(player, false)
	if Mode and Mode:GetMode(player) == "Runner" then
		Mode:ReturnToBase(player, Layout.RunnerReturnCFrame())
	end
	return Net.Ok()
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function RunnerService:Init(reg: { [string]: any })
	registry = reg
	Net.Handle("RunnerPrepare", onPrepare)
	Net.Handle("BuyRunnerUpgrade", onBuyUpgrade)
	Net.Handle("RunnerGo", onGo)
	Net.Handle("RunnerFinish", onFinish)
	Net.Handle("RunnerRetry", onRetry)
	Net.Handle("RunnerLeave", onLeave)
end

function RunnerService:Start()
	local ok, err = pcall(function(): any
		buildTracks()
		return nil
	end)
	if not ok then
		warn("[RunnerService] building the runner tracks failed: " .. tostring(err))
	end

	local Mode = modeService()
	if Mode and Mode.ModeChanged then
		-- Death, respawn, leaving the game or any other mode change ends the run.
		Mode.ModeChanged:Connect(function(player: Player, newMode: string, oldMode: string)
			if oldMode == "Runner" and newMode ~= "Runner" then
				endSession(player, true)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		endSession(player, false) -- also stops the lane watcher
	end)
end

return RunnerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ShopService (server)
	The ONE MarketplaceService.ProcessReceipt for the whole game (Roblox only
	allows one). Every Robux developer product is granted here.

	Products (Config.ProductIds, 0 = not set up and ignored):
		"Employee"         -> an employee for the section the player picked with
		                      HireEmployeeRobux (BaseService:AssignEmployee). If that
		                      section can no longer take one, the player gets an
		                      employee token instead (data.employeeTokens += 1),
		                      to use later on any "Hire me" tile.
		"x2_15" ... "skip_24" (boost ids) -> BoostService:ApplyBoost
		"vehicle_<id>"     -> VehicleService:Grant

	Receipt rules (Roblox requirements):
		* Player not in this server, or data not loaded -> NotProcessedYet
		  (Roblox retries later, e.g. when they rejoin).
		* Already processed (DataService:HasReceipt) -> PurchaseGranted, but
		  only once it is saved: when saving is on (DataService:IsSaving) we
		  SaveNow again and answer NotProcessedYet if that save fails.
		* Grant -> DataService:AddReceipt -> DataService:SaveNow ->
		  PurchaseGranted. If the grant fails or errors -> NotProcessedYet.
		  If saving is on and SaveNow fails -> NotProcessedYet: the grant and
		  the receipt stay in memory, so Roblox's retry takes the HasReceipt
		  branch (saves again) and never grants twice. Without DataStore access
		  (IsSaving() == false, e.g. Studio) a granted purchase is
		  PurchaseGranted right away.

	Requests (Net actions):
		HireEmployeeRobux(slotId)
			slot must be an unlocked revenue section without an employee and the
			Employee product must be set up; remembers the slot and opens the
			Roblox purchase window.

	Push events on the "Shop" channel:
		"Purchased" { key }   a Robux product was granted (client can refresh)

	Public API:
		ShopService:GetProductKey(productId: number): string?
		ShopService:GrantProduct(player, key): boolean   -- used by the receipt
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local ShopService = {}
ShopService.Priority = 60

local Services: { [string]: any } = {}

-- [PROPOSAL] A pending "hire for Robux" target is remembered for 10 minutes.
local PENDING_EMPLOYEE_SECONDS = 600

-- productId -> key in Config.ProductIds
local productToKey: { [number]: string } = {}
for key, productId in Config.ProductIds do
	if type(productId) == "number" and productId ~= 0 then
		if productToKey[productId] then
			warn(
				("[ShopService] product id %d is used for both %s and %s"):format(
					productId,
					productToKey[productId],
					key
				)
			)
		end
		productToKey[productId] = key
	end
end

local boostIds: { [string]: boolean } = {}
for _, def in Config.Boosts do
	boostIds[def.id] = true
end

-- slot id -> definition + area (for validation)
local slotDefs: { [string]: Config.SlotDef } = {}
for _, area in Config.Areas do
	for _, slot in area.slots do
		slotDefs[slot.id] = slot
	end
end

type Pending = { slotId: string, at: number }
local pendingEmployee: { [Player]: Pending } = {}
local processing: { [string]: boolean } = {}

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------

local function dataService(): any
	return Services.DataService
end

local function getData(player: Player): any
	local ds = dataService()
	return if ds then ds:Get(player) else nil
end

local function getMode(player: Player): string
	local modeService = Services.ModeService
	if modeService then
		return modeService:GetMode(player)
	end
	return (player:GetAttribute("Mode") :: string?) or "Base"
end

-- Can `slotId` take an employee right now?
local function canTakeEmployee(data: any, slotId: string): boolean
	local def = slotDefs[slotId]
	if not def or def.kind ~= "revenue" then
		return false
	end
	local section = data.base.sections[slotId]
	return type(section) == "table" and section.employee ~= true
end

local function grantEmployee(player: Player, data: any): boolean
	local pending = pendingEmployee[player]
	pendingEmployee[player] = nil
	local base = Services.BaseService
	if
		pending
		and os.clock() - pending.at <= PENDING_EMPLOYEE_SECONDS
		and base
		and type(base.AssignEmployee) == "function"
		and canTakeEmployee(data, pending.slotId)
	then
		if base:AssignEmployee(player, pending.slotId) then
			local def = slotDefs[pending.slotId]
			Net.Notify(
				player,
				("🧑‍💼 Employee hired for %s! It restocks by itself now."):format(
					if def then def.name else "your shop"
				),
				"success"
			)
			return true
		end
	end
	-- No valid target: keep the employee as a token for later.
	data.employeeTokens = (tonumber(data.employeeTokens) or 0) + 1
	local ds = dataService()
	if ds then
		ds:MarkDirty(player)
	end
	Net.Notify(
		player,
		'🧑‍💼 Employee token added! Walk to any "Hire me" tile and choose "Use employee token".',
		"success"
	)
	return true
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------

function ShopService:GetProductKey(productId: number): string?
	return productToKey[productId]
end

-- Apply the reward for one product key. Returns true only when it was applied.
function ShopService:GrantProduct(player: Player, key: string): boolean
	local data = getData(player)
	if not data then
		return false
	end
	if key == "Employee" then
		return grantEmployee(player, data)
	end
	if boostIds[key] then
		local boosts = Services.BoostService
		if not boosts or type(boosts.ApplyBoost) ~= "function" then
			return false
		end
		if not boosts:ApplyBoost(player, key) then
			return false
		end
		if type(boosts.RemoveReservedOffer) == "function" then
			boosts:RemoveReservedOffer(player, key)
		end
		return true
	end
	local vehicleId = string.match(key, "^vehicle_(.+)$")
	if vehicleId then
		local vehicles = Services.VehicleService
		if not vehicles or type(vehicles.Grant) ~= "function" then
			return false
		end
		return vehicles:Grant(player, vehicleId) == true
	end
	warn("[ShopService] no grant rule for product key " .. key)
	return false
end

-------------------------------------------------------------------------------
-- Receipt
-------------------------------------------------------------------------------

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local playerId = receiptInfo.PlayerId
	local productId = receiptInfo.ProductId
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if type(playerId) ~= "number" or type(productId) ~= "number" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(playerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ds = dataService()
	if not ds then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Roblox re-delivers unfinished purchases right as the player joins, while
	-- their save may still be loading (up to ~20 s if another server is still
	-- finishing its save). Wait for it instead of failing straight away.
	if not ds:Get(player) and not ds:WaitFor(player, 45) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if ds:HasReceipt(player, purchaseId) then
		-- Granted earlier; tell Roblox only once that is actually saved.
		if ds:IsSaving() then
			local ok, saved = pcall(function()
				return ds:SaveNow(player)
			end)
			if not ok or saved ~= true then
				warn("[ShopService] save of an earlier purchase failed, will retry: " .. tostring(saved))
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if processing[purchaseId] then
		-- The same receipt is being granted right now (Roblox retried early).
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local key = productToKey[productId]
	if not key then
		warn(("[ShopService] unknown product id %d (check Config.ProductIds)"):format(productId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	processing[purchaseId] = true
	local ok, granted = pcall(function()
		return ShopService:GrantProduct(player, key)
	end)
	if not ok or granted ~= true then
		processing[purchaseId] = nil
		if not ok then
			warn("[ShopService] grant failed: " .. tostring(granted))
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	ds:AddReceipt(player, purchaseId)
	processing[purchaseId] = nil
	local saveOk, saved = pcall(function()
		return ds:SaveNow(player)
	end)
	if player.Parent then
		Net.Fire("Shop", player, "Purchased", { key = key })
	end
	if ds:IsSaving() and (not saveOk or saved ~= true) then
		-- The grant + receipt stay in memory: the retry takes the HasReceipt
		-- branch above, saves again and never grants twice.
		warn("[ShopService] save after purchase failed, Roblox will retry: " .. tostring(saved))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------

local function hireEmployeeRobux(player: Player, slotId: any): Net.Result
	if type(slotId) ~= "string" or not slotDefs[slotId] then
		return Net.Fail("Unknown section")
	end
	local data = getData(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	if getMode(player) ~= "Base" then
		return Net.Fail("Go back to your base first")
	end
	local def = slotDefs[slotId]
	if def.kind ~= "revenue" then
		return Net.Fail("Only shops can have employees")
	end
	local section = data.base.sections[slotId]
	if type(section) ~= "table" then
		return Net.Fail("Unlock this section first")
	end
	if section.employee == true then
		return Net.Fail("This section already has an employee")
	end
	local productId = Config.ProductIds.Employee or 0
	if productId == 0 then
		return Net.Fail("Robux purchases are not set up yet")
	end
	pendingEmployee[player] = { slotId = slotId, at = os.clock() }
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, productId)
	end)
	if not ok then
		warn("[ShopService] PromptProductPurchase failed: " .. tostring(err))
		return Net.Fail("Could not open the Robux purchase window")
	end
	return Net.Ok({ prompted = true })
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------

function ShopService:Init(registry: { [string]: any })
	Services = registry
	Net.Handle("HireEmployeeRobux", hireEmployeeRobux)

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local ok, decision = pcall(processReceipt, receiptInfo :: any)
		if ok then
			return decision
		end
		warn("[ShopService] ProcessReceipt error: " .. tostring(decision))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

function ShopService:Start()
	Players.PlayerRemoving:Connect(function(player)
		pendingEmployee[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	VehicleService (server)
	Vehicles from Config.Vehicles: buying (Robux or cash), equipping, and
	riding them around the home base.

	How riding works:
		"Ride" builds the equipped vehicle out of parts (Shared/VehicleModels),
		puts it around the character and welds it to the HumanoidRootPart with
		a WeldConstraint. All vehicle parts are Massless and do not collide, so
		the character still walks normally - only faster: Humanoid.WalkSpeed is
		set to the vehicle's speed (the old speed is remembered and restored).
		You get off automatically when you leave Base mode (runner / combat),
		die, respawn or leave the game.
		The Player attribute "Riding" (boolean) tells the client.

	Requests (Net actions, all re-validated here):
		BuyVehicle(vehicleId, route)  route = "cash" | "robux"
			needs data.base.highestArea >= def.area and not owned yet.
			"cash"  -> Economy.VehicleCoinPrice(id, highestArea)
			"robux" -> Config.ProductIds["vehicle_" .. id] -> Roblox purchase
			           window; ShopService's receipt calls Grant.
		EquipVehicle(vehicleId | nil) must own it (nil = unequip)
		ToggleRide()                  Base mode only, needs an equipped vehicle

	Public API (docs/ARCHITECTURE.md §4.4 + helpers):
		VehicleService:GetRunnerBonus(player): number   -- e.g. 0.06 = +6% runner payout
		VehicleService:Dismount(player)
		VehicleService:Grant(player, vehicleId): boolean  -- give a vehicle (paid already)
		VehicleService:IsRiding(player): boolean
		VehicleService:GetVehicleDef(vehicleId): Config.VehicleDef?

	Push events on the "Vehicle" channel:
		"Granted" { vehicleId }   a vehicle was added to the garage
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local VehicleModels = require(Shared.VehicleModels)

local VehicleService = {}
VehicleService.Priority = 55

local Services: { [string]: any } = {}

type Ride = {
	vehicleId: string,
	model: Model,
	humanoid: Humanoid,
	originalSpeed: number,
	rideSpeed: number,
	connections: { RBXScriptConnection },
}

local rides: { [Player]: Ride } = {}
local playerConnections: { [Player]: { RBXScriptConnection } } = {}

local vehicleById: { [string]: Config.VehicleDef } = {}
for _, def in Config.Vehicles do
	vehicleById[def.id] = def
end

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function dataService(): any
	return Services.DataService
end

local function getData(player: Player): any
	local ds = dataService()
	return if ds then ds:Get(player) else nil
end

local function getMode(player: Player): string
	local modeService = Services.ModeService
	if modeService then
		return modeService:GetMode(player)
	end
	return (player:GetAttribute("Mode") :: string?) or "Base"
end

local function markDirty(player: Player)
	local ds = dataService()
	if ds then
		ds:MarkDirty(player)
	end
end

local function owns(data: any, vehicleId: string): boolean
	return type(data.vehicles.owned) == "table" and data.vehicles.owned[vehicleId] == true
end

-------------------------------------------------------------------------------
-- Riding
-------------------------------------------------------------------------------

local function dismount(player: Player)
	local ride = rides[player]
	if not ride then
		if player.Parent then
			player:SetAttribute("Riding", false)
		end
		return
	end
	rides[player] = nil
	for _, connection in ride.connections do
		connection:Disconnect()
	end
	-- Only put the old speed back if nobody else changed it meanwhile
	-- (e.g. combat sets its own move speed).
	local humanoid = ride.humanoid
	if humanoid.Parent and math.abs(humanoid.WalkSpeed - ride.rideSpeed) < 0.01 then
		humanoid.WalkSpeed = ride.originalSpeed
	end
	ride.model:Destroy()
	if player.Parent then
		player:SetAttribute("Riding", false)
	end
end

-- Returns (true) or (false, reason).
local function mount(player: Player, def: Config.VehicleDef): (boolean, string?)
	dismount(player)
	local character = player.Character
	if not character then
		return false, "Your character is not ready"
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return false, "Your character is not ready"
	end
	if humanoid.Sit then
		humanoid.Sit = false
	end

	local model = VehicleModels.Build(def)
	local vehicleRoot = model.PrimaryPart
	if not vehicleRoot then
		model:Destroy()
		return false, "Could not build the vehicle"
	end
	model:PivotTo(root.CFrame)
	local weld = Instance.new("WeldConstraint")
	weld.Name = "VehicleMount"
	weld.Part0 = vehicleRoot
	weld.Part1 = root
	weld.Parent = vehicleRoot
	model.Parent = character

	local ride: Ride = {
		vehicleId = def.id,
		model = model,
		humanoid = humanoid,
		originalSpeed = humanoid.WalkSpeed,
		rideSpeed = def.speed,
		connections = {},
	}
	humanoid.WalkSpeed = def.speed
	rides[player] = ride
	player:SetAttribute("Riding", true)

	-- Get off on death, or if the model / character disappears.
	table.insert(
		ride.connections,
		humanoid.Died:Connect(function()
			if rides[player] == ride then
				dismount(player)
			end
		end)
	)
	table.insert(
		ride.connections,
		model.AncestryChanged:Connect(function()
			if rides[player] == ride and not model:IsDescendantOf(workspace) then
				dismount(player)
			end
		end)
	)
	return true, nil
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------

function VehicleService:GetVehicleDef(vehicleId: string): Config.VehicleDef?
	return vehicleById[vehicleId]
end

function VehicleService:GetRunnerBonus(player: Player): number
	local data = getData(player)
	if not data then
		return 0
	end
	local equipped = data.vehicles.equipped
	if type(equipped) ~= "string" or not owns(data, equipped) then
		return 0
	end
	local def = vehicleById[equipped]
	if not def or not isFiniteNumber(def.runnerBonus) then
		return 0
	end
	return math.max(0, def.runnerBonus)
end

function VehicleService:Dismount(player: Player)
	dismount(player)
end

function VehicleService:IsRiding(player: Player): boolean
	return rides[player] ~= nil
end

-- Give a vehicle that has been paid for. Newly bought vehicles are equipped
-- straight away. [PROPOSAL] (newer vehicles are always better)
function VehicleService:Grant(player: Player, vehicleId: string): boolean
	local def = vehicleById[vehicleId]
	local data = getData(player)
	if not def or not data then
		return false
	end
	if type(data.vehicles.owned) ~= "table" then
		data.vehicles.owned = {}
	end
	data.vehicles.owned[vehicleId] = true
	data.vehicles.equipped = vehicleId
	markDirty(player)
	-- Riding something else? Swap to the new vehicle.
	local ride = rides[player]
	if ride and ride.vehicleId ~= vehicleId and getMode(player) == "Base" then
		mount(player, def)
	end
	if player.Parent then
		Net.Fire("Vehicle", player, "Granted", { vehicleId = vehicleId })
		Net.Notify(player, ("🚙 You got the %s! Press Ride to drive it."):format(def.name), "success")
	end
	return true
end

-------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------

local function buyVehicle(player: Player, vehicleId: any, route: any): Net.Result
	if type(vehicleId) ~= "string" then
		return Net.Fail("Bad vehicle")
	end
	local def = vehicleById[vehicleId]
	if not def then
		return Net.Fail("Unknown vehicle")
	end
	if route ~= "cash" and route ~= "robux" then
		return Net.Fail("Bad payment option")
	end
	local data = getData(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	if getMode(player) ~= "Base" then
		return Net.Fail("Go back to your base first")
	end
	if owns(data, vehicleId) then
		return Net.Fail("You already own this vehicle")
	end
	local highest = tonumber(data.base.highestArea) or 1
	if highest < def.area then
		return Net.Fail(("Unlocks in Area %d"):format(def.area))
	end

	if route == "cash" then
		local price = Economy.VehicleCoinPrice(vehicleId, highest)
		if not isFiniteNumber(price) or price <= 0 then
			return Net.Fail("This vehicle cannot be bought with cash")
		end
		local ds = dataService()
		if not ds or not ds:SpendCash(player, price) then
			return Net.Fail(("Not enough cash (%s)"):format(Format.Money(price)))
		end
		if not VehicleService:Grant(player, vehicleId) then
			ds:AddCash(player, price, { source = "refund" })
			return Net.Fail("Something went wrong, your cash was refunded")
		end
		return Net.Ok({ vehicleId = vehicleId, price = price })
	end

	local productId = Config.ProductIds["vehicle_" .. vehicleId] or 0
	if productId == 0 then
		return Net.Fail("Robux purchases are not set up yet")
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, productId)
	end)
	if not ok then
		warn("[VehicleService] PromptProductPurchase failed: " .. tostring(err))
		return Net.Fail("Could not open the Robux purchase window")
	end
	return Net.Ok({ prompted = true })
end

local function equipVehicle(player: Player, vehicleId: any): Net.Result
	if vehicleId ~= nil and type(vehicleId) ~= "string" then
		return Net.Fail("Bad vehicle")
	end
	local data = getData(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	if getMode(player) ~= "Base" then
		return Net.Fail("Go back to your base first")
	end
	if vehicleId == nil then
		data.vehicles.equipped = nil
		markDirty(player)
		dismount(player)
		return Net.Ok({ equipped = nil })
	end
	local def = vehicleById[vehicleId]
	if not def then
		return Net.Fail("Unknown vehicle")
	end
	if not owns(data, vehicleId) then
		return Net.Fail("You do not own this vehicle")
	end
	data.vehicles.equipped = vehicleId
	markDirty(player)
	local ride = rides[player]
	if ride and ride.vehicleId ~= vehicleId then
		mount(player, def)
	end
	return Net.Ok({ equipped = vehicleId })
end

local function toggleRide(player: Player): Net.Result
	local data = getData(player)
	if not data then
		return Net.Fail("Your data is still loading")
	end
	if rides[player] then
		dismount(player)
		return Net.Ok({ riding = false })
	end
	if getMode(player) ~= "Base" then
		return Net.Fail("You can only ride vehicles in your base")
	end
	local equipped = data.vehicles.equipped
	if type(equipped) ~= "string" or not owns(data, equipped) then
		return Net.Fail("Equip a vehicle in the Shop first")
	end
	local def = vehicleById[equipped]
	if not def then
		return Net.Fail("Equip a vehicle in the Shop first")
	end
	local ok, reason = mount(player, def)
	if not ok then
		return Net.Fail(reason or "Could not get on the vehicle")
	end
	return Net.Ok({ riding = true })
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------

function VehicleService:Init(registry: { [string]: any })
	Services = registry
	Net.Handle("BuyVehicle", buyVehicle)
	Net.Handle("EquipVehicle", equipVehicle)
	Net.Handle("ToggleRide", toggleRide)
end

function VehicleService:Start()
	local modeService = Services.ModeService
	if modeService and modeService.ModeChanged then
		modeService.ModeChanged:Connect(function(player: Player, newMode: string)
			if newMode ~= "Base" then
				dismount(player)
			end
		end)
	end

	local function onPlayer(player: Player)
		if playerConnections[player] then
			return
		end
		player:SetAttribute("Riding", false)
		playerConnections[player] = {
			player.CharacterRemoving:Connect(function()
				dismount(player)
			end),
		}
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		dismount(player)
		local list = playerConnections[player]
		playerConnections[player] = nil
		if list then
			for _, connection in list do
				connection:Disconnect()
			end
		end
	end)
end

return VehicleService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpHeight">7.2</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">BaseController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BaseController (client)
	Connects the home-base visuals (World/BaseVisuals) to the server
	(Server/Services/BaseService) and to the other controllers.

	What it does:
		* builds the local player's base visuals and keeps them in sync with
		  every data update (State.Changed) - only changed parts are rebuilt
		* turns ProximityPrompt presses into server requests:
			Unlock pad      -> Net.Request("UnlockSlot", slotId)
			Restock (E)     -> Net.Request("Restock", slotId)
			Upgrade (F)     -> Net.Request("UpgradeSection", slotId)
			"Hire me" tile  -> Theme.PurchaseDialog: R$ 200 (SHOP: "HireEmployeeRobux")
			                   or cash (Net.Request("HireEmployeeCash", slotId));
			                   with an employee token: Theme.Confirm -> "AssignEmployeeToken"
			                   (both are "Base" dialogs: closed when you leave the base)
			Arena prompt    -> registry.CombatController:OpenArenaMenu()
			Gate prompt     -> barrier not beaten: registry.CombatController:StartBarrier(area)
			                   beaten: Net.Request("UnlockGate", area)
		* shows server "Base" events: floating "+$12.50" income text, employee
		  restock hops
		* errors become red toasts; successes pop the billboard / show a toast

	Public API (other controllers):
		BaseController.Priority = 20
		BaseController:Init(registry)
		BaseController:Start()
	(No other methods: everything else happens through prompts and events.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local BaseVisuals = require(Client.World.BaseVisuals)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local P = Config.Palette

local BaseController = {}
BaseController.Priority = 20

local registry: { [string]: any } = {}

-- Requests that are still waiting for the server (stops double clicks).
local pending: { [string]: boolean } = {}
local dialogOpen = false

-- slot id -> its definition
local slotDefs: { [string]: Config.SlotDef } = {}
for _, areaDef in Config.Areas do
	for _, slotDef in areaDef.slots do
		slotDefs[slotDef.id] = slotDef
	end
end

-- Send a request once at a time per `key`. Shows the error as a toast.
local function request(key: string, action: string, ...: any): Net.Result?
	if pending[key] then
		return nil
	end
	pending[key] = true
	local result = Net.Request(action, ...)
	pending[key] = nil
	if not result.ok then
		Theme.Toast(tostring(result.err or "Something went wrong"), "error")
	end
	return result
end

local function inBase(): boolean
	return State.Mode() == "Base"
end

-------------------------------------------------------------------------------
-- Prompt handlers
-------------------------------------------------------------------------------
local function onUnlock(slotId: string)
	if not inBase() then
		return
	end
	local def = slotDefs[slotId]
	local result = request("unlock:" .. slotId, "UnlockSlot", slotId)
	if result and result.ok and def then
		Theme.Toast(("Unlocked %s %s!"):format(def.icon, def.name), "success")
		BaseVisuals.FloatAt(slotId, "UNLOCKED!", P.PriceGold)
	end
end

local function onRestock(slotId: string)
	if not inBase() then
		return
	end
	local result = request("restock:" .. slotId, "Restock", slotId)
	if result and result.ok then
		BaseVisuals.FloatAt(slotId, "Restocked!", P.MoneyGreen)
		BaseVisuals.Pop(slotId)
	end
end

local function onUpgrade(slotId: string)
	if not inBase() then
		return
	end
	local data = State.Get()
	local section = data and data.base.sections[slotId]
	if section and Economy.SectionUpgradePrice(slotId, section.level) == nil then
		Theme.Toast("Already at max level!", "info")
		return
	end
	local result = request("upgrade:" .. slotId, "UpgradeSection", slotId)
	if result and result.ok then
		local def = slotDefs[slotId]
		local level = tonumber(result.level) or 0
		Theme.Toast(("%s upgraded to level %d!"):format(if def then def.name else "Section", level), "success")
		BaseVisuals.FloatAt(slotId, "LEVEL UP!", P.PriceGold)
		BaseVisuals.Pop(slotId)
	end
end

local function hired(slotId: string)
	local def = slotDefs[slotId]
	Theme.Toast(("Employee hired! %s now restocks itself."):format(if def then def.name else "This section"), "success")
	BaseVisuals.Pop(slotId)
end

local function onHire(slotId: string)
	if not inBase() or dialogOpen then
		return
	end
	local data = State.Get()
	if not data then
		return
	end
	local section = data.base.sections[slotId]
	if type(section) ~= "table" or section.employee then
		return
	end
	local def = slotDefs[slotId]
	local name = if def then def.name else "this section"

	-- An employee token (bought with Robux earlier) can be used for free.
	local tokens = tonumber(data.employeeTokens) or 0
	if tokens > 0 then
		dialogOpen = true
		Theme.Confirm({
			Name = "HireTokenConfirm",
			Context = "Base", -- the HUD closes it when you leave the base (OnClose resets dialogOpen)
			Title = "Use employee token",
			Body = ("You have %d employee token%s. Use one to hire an employee for %s for free?"):format(
				tokens,
				if tokens == 1 then "" else "s",
				name
			),
			ConfirmText = "Use token",
			OnClose = function()
				dialogOpen = false
			end,
			OnConfirm = function()
				local result = request("hire:" .. slotId, "AssignEmployeeToken", slotId)
				if result and result.ok then
					hired(slotId)
				end
			end,
		})
		return
	end

	local price = Economy.EmployeeCashPrice(slotId, data.base.highestArea)
	dialogOpen = true
	Theme.PurchaseDialog({
		Context = "Base", -- the HUD closes it when you leave the base (OnClose resets dialogOpen)
		Title = "Hire employee",
		Description = ("Restocks %s automatically so it never stops selling."):format(name),
		RobuxPrice = Config.Employee.Robux,
		RobuxEnabled = Config.ProductIds.Employee ~= 0,
		CashPrice = price,
		CashAffordable = data.cash + 1e-6 >= price,
		Footnote = ("= the earnings of %d Army Runs"):format(Config.Employee.RunsEquivalent),
		OnClose = function()
			dialogOpen = false
		end,
		OnRobux = function()
			-- SHOP shows the Robux purchase window; the receipt assigns the employee.
			request("hire:" .. slotId, "HireEmployeeRobux", slotId)
		end,
		OnCash = function()
			local result = request("hire:" .. slotId, "HireEmployeeCash", slotId)
			if result and result.ok then
				hired(slotId)
			end
		end,
	})
end

local function combat(): any
	return registry.CombatController
end

local function onArena()
	if not inBase() then
		return
	end
	local controller = combat()
	if not controller or type(controller.OpenArenaMenu) ~= "function" then
		Theme.Toast("The Combat Arena is not ready yet", "error")
		return
	end
	local ok, err = pcall(controller.OpenArenaMenu, controller)
	if not ok then
		warn("[BaseController] OpenArenaMenu failed: " .. tostring(err))
		Theme.Toast("Could not open the arena", "error")
	end
end

local function onGate(area: number)
	if not inBase() then
		return
	end
	local data = State.Get()
	if not data then
		return
	end
	if area ~= data.base.highestArea then
		Theme.Toast("Open the earlier gates first", "error")
		return
	end
	if data.base.barriers[tostring(area)] ~= true then
		local controller = combat()
		if not controller or type(controller.StartBarrier) ~= "function" then
			Theme.Toast("Combat is not ready yet", "error")
			return
		end
		local ok, err = pcall(controller.StartBarrier, controller, area)
		if not ok then
			warn("[BaseController] StartBarrier failed: " .. tostring(err))
			Theme.Toast("Could not start the barrier fight", "error")
		end
		return
	end
	local price = Economy.GatePrice(area)
	if data.cash + 1e-6 < price then
		Theme.Toast("Not enough cash! You need " .. Format.Money(price), "error")
		return
	end
	request("gate:" .. area, "UnlockGate", area)
	-- The server sends the "Area unlocked" toast; the gate opens on the next sync.
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function BaseController:Init(reg: { [string]: any })
	registry = reg
end

function BaseController:Start()
	BaseVisuals.Start({
		OnUnlock = onUnlock,
		OnRestock = onRestock,
		OnUpgrade = onUpgrade,
		OnHire = onHire,
		OnArena = onArena,
		OnGate = onGate,
	})

	local data = State.Get()
	if data then
		BaseVisuals.Update(data)
	end
	State.Changed:Connect(function(snapshot)
		BaseVisuals.Update(snapshot)
	end)

	Net.On("Base", function(msg: any, payload: any)
		if type(payload) ~= "table" then
			return
		end
		if msg == "Income" then
			if not inBase() then
				return
			end
			for slotId, amount in payload do
				if type(slotId) == "string" and type(amount) == "number" then
					BaseVisuals.ShowIncome(slotId, amount)
				end
			end
		elseif msg == "Restocked" then
			if type(payload.slotId) == "string" and payload.by == "employee" then
				BaseVisuals.EmployeeHop(payload.slotId)
			end
		elseif msg == "Employee" then
			if type(payload.slotId) == "string" then
				BaseVisuals.EmployeeHop(payload.slotId)
			end
		end
	end)
end

return BaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CameraController
	Frames the home base like reference image 1: a high camera looking down at
	the island at roughly 45-50 degrees, instead of Roblox's close
	over-the-shoulder default. Applied when the character spawns and every time
	the player comes back to the base from a run or a fight. The player can
	still zoom and rotate freely afterwards (normal Roblox camera).

	No public API.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local State = require(Client.State)

local player = Players.LocalPlayer

local CameraController = {}

local BASE_OFFSET = Vector3.new(0, 36, 32) -- [PROPOSAL] ~48 degrees down, ~48 studs away

local framing = false

local function frameBase()
	if framing then
		return
	end
	framing = true
	task.spawn(function()
		-- Let runner/combat code restore the normal camera first.
		task.wait(0.25)
		local character = player.Character
		local root = character and character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		local camera = Workspace.CurrentCamera
		if root and camera and State.Mode() == "Base" and camera.CameraType == Enum.CameraType.Custom then
			-- Forcing the minimum zoom for one frame makes the camera scripts
			-- adopt that distance; then the normal range is restored.
			local normalMin = StarterPlayer.CameraMinZoomDistance
			player.CameraMinZoomDistance = BASE_OFFSET.Magnitude
			RunService.RenderStepped:Wait()
			camera.CFrame = CFrame.lookAt(root.Position + BASE_OFFSET, root.Position)
			RunService.RenderStepped:Wait()
			player.CameraMinZoomDistance = normalMin
		end
		framing = false
	end)
end

function CameraController:Init(_registry: { [string]: any }) end

function CameraController:Start()
	player.CharacterAdded:Connect(frameBase)
	if player.Character then
		frameBase()
	end
	State.ModeChanged:Connect(function(newMode: string)
		if newMode == "Base" then
			frameBase()
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CombatController (client)
	The client half of the Archero-2-inspired combat mode (docs/ARCHITECTURE.md §6.3).
	It talks to CombatService, moves the top-down camera, draws the fight with
	CombatVisuals and shows every screen with CombatUI.

	Public API (ARCHITECTURE §4.6, call from other controllers' Start or later):
		CombatController:OpenArenaMenu()            level select for the repeatable Combat Arena
		CombatController:StartBarrier(area: number) fight the barrier squad on `area`'s exit gate
		CombatController:IsActive(): boolean        true while a fight (or its lobby) is open
		OpenArenaMenu / StartBarrier do nothing while a fight (or its lobby) is open
		or a CombatPrepare request is on its way. Their dialogs are "Base" dialogs:
		opening one again replaces the old copy, and the HUD closes them when you
		leave the base. The lobby inventory has no Context, so it stays open when
		the mode changes to "Combat".

	Flow of one fight:
		1. OpenArenaMenu / StartBarrier -> CombatPrepare (server teleports you to your arena)
		2. LOBBY before round 1: the inventory opens ("Prepare for battle") so you
		   can review and equip armour and weapons [REQUIREMENT]. Closing it shows
		   a small bar: [Inventory] [Start] [Leave].
		3. START BATTLE -> CombatStart -> 3-2-1 -> waves. Move with WASD / thumbstick,
		   stand still to shoot automatically, dodge the slow bullets and red circles.
		4. After each wave (except the last): pick 1 of 3 abilities (this attempt only).
		5. Result screen -> chest -> CONTINUE -> CombatLeave -> back to base.
		Camera, controls (jump) and every visual are restored / removed when the
		fight ends for ANY reason (death, respawn, leaving, server timeout).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local ChestUI = require(Client.UI.ChestUI)
local CombatUI = require(Client.UI.CombatUI)
local CombatVisuals = require(Client.World.CombatVisuals)
local InventoryUI = require(Client.UI.InventoryUI)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatDefs = require(Shared.Combat.CombatDefs)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Net = require(Shared.Net)

local player = Players.LocalPlayer

local CombatController = {}

local RENDER_NAME = "CombatCamera"
local CAMERA_HEIGHT = 58 -- studs above the player
local CAMERA_BACK = 32 -- studs to the south -> about 61 degrees looking down
local CAMERA_SMOOTHING = 8
local CAMERA_CLAMP_X = CombatDefs.HALF_X - 16 -- keep the arena nicely framed
local CAMERA_CLAMP_Z = CombatDefs.HALF_Z - 14

type Session = {
	id: string,
	mode: string,
	level: number,
	area: number,
	waveCount: number,
	reward: number,
	nextAreaName: string,
	center: Vector3,
	phase: string, -- "lobby" | "fighting" | "result"
	visuals: CombatVisuals.Visuals,
	hud: CombatUI.Hud,
	lobbyBar: { Destroy: () -> () }?,
	closeInventory: (() -> ())?,
	inventoryOpen: boolean,
	closeChoice: (() -> ())?,
	closeResult: (() -> ())?,
	closeConfirm: (() -> ())?,
	starting: boolean,
	leaving: boolean,
	connections: { RBXScriptConnection },
	humanoid: Humanoid?,
	camPos: Vector3?,
	lastHp: number,
}

local registry: { [string]: any } = {}
local session: Session? = nil
local busy = false -- a CombatPrepare request is on its way

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------
local function getRoot(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function getHumanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function try(label: string, fn: () -> ())
	local ok, err = pcall(function(): any
		fn()
		return nil
	end)
	if not ok then
		warn("[CombatController] " .. label .. " failed: " .. tostring(err))
	end
end

local function setMenuVisible(visible: boolean)
	local hud = registry.HUDController
	if hud and hud.SetMenuVisible then
		try("SetMenuVisible", function()
			hud:SetMenuVisible(visible)
		end)
	end
end

local function restoreCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = getHumanoid()
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-------------------------------------------------------------------------------
-- Cleanup (safe to call many times)
-------------------------------------------------------------------------------
local function cleanup()
	local s = session
	if not s then
		return
	end
	session = nil
	RunService:UnbindFromRenderStep(RENDER_NAME)
	for _, connection in s.connections do
		connection:Disconnect()
	end
	table.clear(s.connections)
	try("close confirm", function()
		if s.closeConfirm then
			s.closeConfirm()
		end
	end)
	try("close inventory", function()
		if s.closeInventory then
			s.closeInventory()
		end
	end)
	try("close lobby", function()
		if s.lobbyBar then
			s.lobbyBar.Destroy()
		end
	end)
	try("close choice", function()
		if s.closeChoice then
			s.closeChoice()
		end
	end)
	try("close result", function()
		if s.closeResult then
			s.closeResult()
		end
	end)
	try("hud", s.hud.Destroy)
	try("visuals", s.visuals.Destroy)
	try("humanoid", function()
		local humanoid = s.humanoid
		if humanoid and humanoid.Parent then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
	end)
	try("camera", restoreCamera)
	setMenuVisible(true)
end

-------------------------------------------------------------------------------
-- Leaving
-------------------------------------------------------------------------------
local function requestLeave(s: Session)
	if s.leaving then
		return
	end
	s.leaving = true
	task.spawn(function()
		local result = Net.Request("CombatLeave")
		if session ~= s then
			return
		end
		s.leaving = false
		if not result.ok then
			Theme.Toast(result.err or "Could not leave", "error")
		elseif result.left then
			cleanup() -- the server is sending us home
		end
		-- result.ended: mid-fight retreat -> the "Result" event shows the result screen
	end)
end

-------------------------------------------------------------------------------
-- Lobby (before the first round)
-------------------------------------------------------------------------------
local showLobbyBar: (s: Session) -> ()
local openInventory: (s: Session) -> ()

local function startBattle(s: Session)
	if s.starting or s.phase ~= "lobby" or session ~= s then
		return
	end
	s.starting = true
	if s.lobbyBar then
		s.lobbyBar.Destroy()
		s.lobbyBar = nil
	end
	local closeInventory = s.closeInventory
	s.closeInventory = nil
	s.inventoryOpen = false
	if closeInventory then
		try("close inventory", closeInventory)
	end
	task.spawn(function()
		local result = Net.Request("CombatStart", s.id)
		if session ~= s then
			return
		end
		s.starting = false
		if not result.ok then
			Theme.Toast(result.err or "Could not start the fight", "error")
			showLobbyBar(s)
			return
		end
		s.phase = "fighting"
		s.hud.SetFightVisible(true)
		s.hud.Hint("Stand still to shoot! Move to dodge bullets and red circles.", 6)
	end)
end

showLobbyBar = function(s: Session)
	if session ~= s or s.phase ~= "lobby" or s.lobbyBar or s.starting then
		return
	end
	s.lobbyBar = CombatUI.LobbyBar({
		onInventory = function()
			openInventory(s)
		end,
		onStart = function()
			startBattle(s)
		end,
		onLeave = function()
			requestLeave(s)
		end,
	})
end

openInventory = function(s: Session)
	if session ~= s or s.phase ~= "lobby" or s.inventoryOpen or s.starting then
		return
	end
	if s.lobbyBar then
		s.lobbyBar.Destroy()
		s.lobbyBar = nil
	end
	s.inventoryOpen = true
	local startPressed = false
	local ok, closeOrErr = pcall(InventoryUI.Open, {
		Title = "Prepare for battle",
		ActionText = "START BATTLE",
		OnAction = function()
			startPressed = true
			-- deferred: InventoryUI.Open may call this before it has returned
			task.defer(function()
				startBattle(s)
			end)
		end,
		OnClose = function()
			s.inventoryOpen = false
			s.closeInventory = nil
			if not startPressed then
				task.defer(function()
					showLobbyBar(s)
				end)
			end
		end,
	})
	if ok and type(closeOrErr) == "function" then
		if s.inventoryOpen and not startPressed then
			s.closeInventory = closeOrErr
		elseif startPressed then
			try("close inventory", closeOrErr)
		end
	else
		warn("[CombatController] InventoryUI.Open failed: " .. tostring(closeOrErr))
		s.inventoryOpen = false
		showLobbyBar(s)
	end
end

-------------------------------------------------------------------------------
-- Per-frame: camera + visuals + reporting hits on myself
-------------------------------------------------------------------------------
local function step(s: Session, dt: number)
	local root = getRoot()
	local camera = Workspace.CurrentCamera
	if camera and root then
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		local localPos = root.Position - s.center
		local focus = s.center
			+ Vector3.new(
				math.clamp(localPos.X, -CAMERA_CLAMP_X, CAMERA_CLAMP_X),
				localPos.Y,
				math.clamp(localPos.Z, -CAMERA_CLAMP_Z, CAMERA_CLAMP_Z)
			)
		local offset = Vector3.new(0, CAMERA_HEIGHT, CAMERA_BACK)
		local desired = focus + offset
		local current = s.camPos or desired
		current = current:Lerp(desired, 1 - math.exp(-CAMERA_SMOOTHING * dt))
		s.camPos = current
		camera.CFrame = CFrame.lookAt(current, current - offset)
	end

	local hits = s.visuals.Update(dt, if root then root.Position else nil)
	if s.phase == "fighting" and player:GetAttribute("CombatActive") == true then
		for _, id in hits do
			Net.FireServer("Combat", "Hit", { id = id })
		end
	end

	local hp = player:GetAttribute("CombatHP")
	local maxHp = player:GetAttribute("CombatMaxHP")
	local shield = player:GetAttribute("CombatShield")
	if type(hp) == "number" and type(maxHp) == "number" then
		s.hud.SetVitals(hp, maxHp, if type(shield) == "number" then shield else 0)
		if hp < s.lastHp - 0.05 then
			s.hud.Hurt()
		end
		s.lastHp = hp
	end
end

-------------------------------------------------------------------------------
-- Server events
-------------------------------------------------------------------------------
local function onResult(s: Session, result: { [string]: any })
	s.phase = "result"
	try("close choice", function()
		if s.closeChoice then
			s.closeChoice()
			s.closeChoice = nil
		end
	end)
	try("close confirm", function()
		if s.closeConfirm then
			s.closeConfirm()
			s.closeConfirm = nil
		end
	end)
	s.visuals.ClearCombat()
	s.hud.SetFightVisible(false)
	if s.closeResult then
		return
	end
	s.closeResult = CombatUI.Result({
		result = result,
		onChest = function(done: () -> ())
			local chest = result.chest
			if type(chest) == "table" and type(chest.tier) == "string" and type(chest.item) == "table" then
				local finished = false
				local function finishOnce()
					if not finished then
						finished = true
						done()
					end
				end
				local ok, err = pcall(function(): any
					ChestUI.Play(chest.tier, chest.item, finishOnce)
					return nil
				end)
				if not ok then
					warn("[CombatController] ChestUI.Play failed: " .. tostring(err))
					finishOnce()
				end
			else
				done()
			end
		end,
		onContinue = function()
			s.closeResult = nil
			requestLeave(s)
		end,
	})
end

local function onCombatEvent(msg: any, payload: any)
	local s = session
	if not s or type(msg) ~= "string" or type(payload) ~= "table" then
		return
	end
	if msg == "Ended" then
		if payload.sessionId == s.id then
			cleanup()
		end
	elseif msg == "Wave" then
		local wave = tonumber(payload.wave) or 1
		local startsAt = tonumber(payload.startsAt) or Workspace:GetServerTimeNow()
		s.hud.Countdown(startsAt, wave, payload.boss == true)
	elseif msg == "AbilityChoice" then
		if s.closeChoice then
			s.closeChoice()
		end
		local options = if type(payload.options) == "table" then payload.options else {}
		s.closeChoice = CombatUI.AbilityChoice({
			options = options,
			timeout = tonumber(payload.timeout) or CombatDefs.ABILITY_TIMEOUT,
			onPick = function(id: string)
				s.closeChoice = nil
				task.spawn(function()
					-- a failure only means the server auto-picked first ("AbilityPicked" tells us what)
					local result = Net.Request("CombatChooseAbility", s.id, id)
					if not result.ok then
						warn("[CombatController] ability pick refused: " .. tostring(result.err))
					end
				end)
			end,
		})
	elseif msg == "AbilityPicked" then
		if s.closeChoice then
			s.closeChoice()
			s.closeChoice = nil
		end
		local ability = CombatDefs.AbilityById[tostring(payload.id)]
		if ability then
			s.hud.Hint(
				("%s %s%s"):format(ability.icon, ability.name, if payload.auto then " (auto-picked)" else "!"),
				3
			)
		end
	elseif msg == "ProjectileBatch" then
		s.visuals.AddProjectiles(payload.list)
	elseif msg == "ProjectileGone" then
		s.visuals.RemoveProjectiles(payload.ids)
	elseif msg == "Telegraph" then
		s.visuals.Telegraph(payload)
	elseif msg == "EnemyDied" then
		s.visuals.EnemyDied(payload.list)
	elseif msg == "Damage" then
		s.visuals.Damage(payload.list)
	elseif msg == "Collected" then
		s.visuals.Collected(payload.list)
	elseif msg == "Result" then
		onResult(s, payload)
	end
end

local function onSnapshot(buf: any)
	local s = session
	if not s or s.phase == "result" then
		return
	end
	local snap = CombatDefs.DecodeSnap(buf)
	if snap then
		s.visuals.ApplySnapshot(snap)
		s.hud.SetCash(snap.cash)
	end
end

-------------------------------------------------------------------------------
-- Entering a fight
-------------------------------------------------------------------------------
local function enter(reply: { [string]: any })
	cleanup() -- never two sessions at once
	local center = Vector3.new(tonumber(reply.centerX) or 0, tonumber(reply.centerY) or 0, tonumber(reply.centerZ) or 0)
	local mode = if reply.mode == "barrier" then "barrier" else "arena"
	local level = tonumber(reply.level) or 1
	local waveCount = tonumber(reply.waveCount) or 3
	local s: Session
	local hud = CombatUI.Hud({
		level = level,
		mode = mode,
		nextAreaName = tostring(reply.nextAreaName or ""),
		waveCount = waveCount,
		onLeave = function()
			local current = session
			if not current or current.phase == "result" then
				return
			end
			if current.phase == "lobby" then
				requestLeave(current)
				return
			end
			if current.closeConfirm then
				return
			end
			current.closeConfirm = Theme.Confirm({
				Name = "RetreatConfirm",
				Title = "Retreat?",
				Body = "Leaving now counts as a defeat. You keep the cash you collected.",
				ConfirmText = "Retreat",
				ConfirmColor = Theme.Palette.ButtonRed,
				OnConfirm = function()
					current.closeConfirm = nil
					requestLeave(current)
				end,
				OnClose = function()
					current.closeConfirm = nil
				end,
			})
		end,
	})
	s = {
		id = tostring(reply.sessionId),
		mode = mode,
		level = level,
		area = tonumber(reply.area) or 1,
		waveCount = waveCount,
		reward = tonumber(reply.reward) or 0,
		nextAreaName = tostring(reply.nextAreaName or ""),
		center = center,
		phase = "lobby",
		visuals = CombatVisuals.new(center),
		hud = hud,
		lobbyBar = nil,
		closeInventory = nil,
		inventoryOpen = false,
		closeChoice = nil,
		closeResult = nil,
		closeConfirm = nil,
		starting = false,
		leaving = false,
		connections = {},
		humanoid = getHumanoid(),
		camPos = nil,
		lastHp = math.huge,
	}
	session = s
	hud.SetWave(0, waveCount)
	hud.SetFightVisible(true)
	hud.SetCharacter(player.Character)
	hud.SetCash(0)
	setMenuVisible(false)

	local humanoid = s.humanoid
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		if session == s then
			step(s, dt)
		end
	end)
	-- The lobby: review and equip armour and weapons before round 1.
	openInventory(s)
end

local function prepare(mode: string, param: number)
	if busy or session then
		return -- already fighting (or about to)
	end
	if State.Mode() ~= "Base" then
		Theme.Toast("Finish what you are doing first", "error")
		return
	end
	busy = true
	task.spawn(function()
		local result = Net.Request("CombatPrepare", mode, param)
		busy = false
		if not result.ok then
			Theme.Toast(result.err or "Could not start the fight", "error")
			return
		end
		enter(result)
	end)
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------
function CombatController:OpenArenaMenu()
	local data = State.Get()
	if not data or busy or session then
		return -- ignored while a fight (or its lobby) is open
	end
	if not data.base.arenaUnlocked then
		Theme.Toast(
			"Unlock the Combat Arena in " .. (Config.Areas[Config.ArenaArea].name or "area 2") .. " first",
			"info"
		)
		return
	end
	if State.Mode() ~= "Base" then
		return
	end
	CombatUI.OpenArenaMenu({
		highestLevel = data.combat.highestLevel,
		onFight = function(level: number)
			prepare("arena", level)
		end,
	})
end

function CombatController:StartBarrier(area: number)
	local data = State.Get()
	if not data or busy or session or type(area) ~= "number" then
		return -- ignored while a fight (or its lobby) is open
	end
	if State.Mode() ~= "Base" then
		return
	end
	if data.base.barriers[tostring(area)] then
		Theme.Toast("You already beat this barrier squad", "info")
		return
	end
	if area >= #Config.Areas then
		return
	end
	local level = Economy.BarrierCombatLevel(area)
	local nextArea = Config.Areas[area + 1]
	CombatUI.ConfirmBarrier({
		level = level,
		nextAreaName = if nextArea then nextArea.name else "the next area",
		reward = Economy.CombatLevelReward(level),
		onConfirm = function()
			prepare("barrier", area)
		end,
	})
end

function CombatController:IsActive(): boolean
	return session ~= nil
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function CombatController:Init(reg: { [string]: any })
	registry = reg
end

function CombatController:Start()
	local hud = registry.HUDController
	if hud and hud.AddMenuButton then
		hud:AddMenuButton({
			Id = "Battle",
			Title = "Battle",
			Icon = "⚔️",
			Order = 2,
			HeaderColor = Theme.Palette.ButtonRed,
			HeaderDarkColor = Theme.Palette.ButtonRedDark,
			OnClick = function()
				CombatController:OpenArenaMenu()
			end,
			Visible = function(data: any): boolean
				return type(data) == "table" and type(data.base) == "table" and data.base.arenaUnlocked == true
			end,
		})
	end

	Net.On("Combat", function(msg: any, payload: any)
		try("combat event " .. tostring(msg), function()
			onCombatEvent(msg, payload)
		end)
	end)
	Net.On("CombatSnap", function(buf: any)
		try("snapshot", function()
			onSnapshot(buf)
		end)
	end)

	-- Leaving Combat mode for any reason ends the local session.
	State.ModeChanged:Connect(function(newMode: string)
		if session and newMode ~= "Combat" then
			cleanup()
		end
	end)
	-- Respawned: the old character is gone, so is the fight.
	player.CharacterAdded:Connect(function()
		if session then
			cleanup()
		end
	end)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">DevController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DevController (Studio only)
	Adds a "DEV" button to the HUD while testing in Roblox Studio. It opens a
	panel of shortcuts handled by server/Services/DevService. Nothing is shown
	in the live game.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local P = Theme.Palette

local DevController = {}
DevController.Priority = -10

local registry: { [string]: any } = {}

local function run(action: string, ...: any)
	local result = Net.Request(action, ...)
	if result.ok then
		Theme.Toast("DEV: done", "success")
	else
		Theme.Toast("DEV: " .. tostring(result.err), "error")
	end
	return result
end

local function openPanel()
	local _, content, close = Theme.Panel({
		Name = "DevPanel",
		Context = "Base",
		Title = "Studio test tools",
		HeaderColor = P.ButtonGrey,
		HeaderDarkColor = P.ButtonGreyDark,
		Size = UDim2.fromOffset(560, 470),
	})
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(250, 58)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = content

	type DevButton = { text: string, color: Color3, onClick: () -> () }
	local buttons: { DevButton } = {
		{
			text = "+ $1,000",
			color = P.ButtonGreen,
			onClick = function()
				run("DevGiveCash", 1000)
			end,
		},
		{
			text = "+ $100,000",
			color = P.ButtonGreen,
			onClick = function()
				run("DevGiveCash", 100000)
			end,
		},
		{
			text = "+ $10,000,000",
			color = P.ButtonGreen,
			onClick = function()
				run("DevGiveCash", 10000000)
			end,
		},
		{
			text = "Beat current barrier",
			color = P.ButtonRed,
			onClick = function()
				run("DevBeatBarrier")
			end,
		},
		{
			text = "Wood chest",
			color = P.Wood,
			onClick = function()
				local result = run("DevChest", "wood")
				if result.ok and result.item then
					close()
					require(Client.UI.ChestUI).Play("wood", result.item)
				end
			end,
		},
		{
			text = "Gold chest",
			color = P.Coin,
			onClick = function()
				local result = run("DevChest", "gold")
				if result.ok and result.item then
					close()
					require(Client.UI.ChestUI).Play("gold", result.item)
				end
			end,
		},
		{
			text = "2x cash 15 min",
			color = P.OfferPurple,
			onClick = function()
				run("DevBoost", "x2_15")
			end,
		},
		{
			text = "Time skip 4h",
			color = P.OfferPurple,
			onClick = function()
				run("DevBoost", "skip_4")
			end,
		},
		{
			text = "Start a run",
			color = P.CardOrange,
			onClick = function()
				close()
				local runner = registry.RunnerController
				if runner and runner.OpenPrepare then
					runner:OpenPrepare()
				end
			end,
		},
		{
			text = "Reset my progress",
			color = P.ButtonGreyDark,
			onClick = function()
				close()
				Theme.Confirm({
					Title = "Reset progress?",
					Body = "Wipes your test save back to a brand-new player.",
					ConfirmText = "Reset",
					ConfirmColor = P.ButtonRed,
					OnConfirm = function()
						run("DevReset")
					end,
				})
			end,
		},
	}
	for index, spec in buttons do
		Theme.Button({
			Text = spec.text,
			Color = spec.color,
			LayoutOrder = index,
			MaxTextSize = 22,
			ZIndex = 14,
			OnClick = spec.onClick,
			Parent = content,
		})
	end
end

function DevController:Init(reg: { [string]: any })
	registry = reg
end

function DevController:Start()
	if not RunService:IsStudio() then
		return
	end
	local hud = registry.HUDController
	if hud then
		hud:AddMenuButton({
			Id = "Dev",
			Title = "DEV",
			Icon = "🛠️",
			Order = 99,
			HeaderColor = P.ButtonGrey,
			HeaderDarkColor = P.ButtonGreyDark,
			OnClick = openPanel,
		})
	end
end

return DevController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HUDController
	Always-on HUD: cash pill (top-right, like both reference images), boost /
	status chips under it, the left-hand menu of card buttons (base only) and
	server toasts.

	API (other controllers, call from Start):
		HUD:AddMenuButton({
			Id = "Run", Title = "Army Run", Icon = "🏃", Order = 1,
			HeaderColor = Color3?, HeaderDarkColor = Color3?,
			OnClick = function() end,
			Visible = function(data) return true end,  -- optional, re-checked on every Sync
		}) -> TextButton
		HUD:AddStatusChip(id, color) -> { SetText(text), SetVisible(bool), Destroy() }
		HUD:Toast(text, kind?)
		HUD:GetGui() -> ScreenGui
		HUD:SetMenuVisible(visible)   -- e.g. hide while a big panel is open
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local P = Theme.Palette
local _player = Players.LocalPlayer

type MenuSpec = {
	Id: string,
	Title: string,
	Icon: string,
	Order: number?,
	HeaderColor: Color3?,
	HeaderDarkColor: Color3?,
	OnClick: () -> (),
	Visible: ((any) -> boolean)?,
}

type Chip = {
	SetText: (string) -> (),
	SetVisible: (boolean) -> (),
	Destroy: () -> (),
}

local HUD = {}
HUD.Priority = 80

local gui: ScreenGui
local menu: Frame
local chips: Frame
local setCash: (number) -> ()
local menuEntries: { { spec: MenuSpec, button: TextButton } } = {}
local menuForcedHidden = false

local function refreshMenu()
	local data = State.Get()
	local inBase = State.Mode() == "Base"
	menu.Visible = inBase and not menuForcedHidden
	for _, entry in menuEntries do
		local visible = true
		if entry.spec.Visible and data then
			local ok, result = pcall(entry.spec.Visible, data)
			visible = ok and result == true
		end
		entry.button.Visible = visible
	end
end

function HUD:Init(_registry: { [string]: any })
	gui = Theme.ScreenGui("HUD", 5)
	-- [PROPOSAL] Roblox's player list sits in the top-right corner, exactly where
	-- the reference images put the cash pill. The game has no leaderboard stats,
	-- so hide the list (players can still be seen in the Roblox menu).
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
		-- No tools to pick in this game; hiding the hotbar also stops players
		-- from unequipping the runner gun with the number keys.
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	local topRight = Instance.new("Frame")
	topRight.Name = "TopRight"
	topRight.BackgroundTransparency = 1
	topRight.AnchorPoint = Vector2.new(1, 0)
	-- Below Roblox's top bar (the HUD gui ignores the inset).
	topRight.Position = UDim2.new(1, -18, 0, Theme.TopInset() + 8)
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
		topRight.Position = UDim2.new(1, -18, 0, Theme.TopInset() + 8)
	end)
	topRight.Size = UDim2.fromOffset(250, 400)
	topRight.Parent = gui
	Theme.ResponsiveScale(topRight)
	local layout = Theme.List(topRight, "Vertical", 8, Enum.HorizontalAlignment.Right)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local pill, setter = Theme.CashPill({ LayoutOrder = 1, Parent = topRight })
	pill.Size = UDim2.fromOffset(240, 58)
	setCash = setter

	chips = Instance.new("Frame")
	chips.Name = "Chips"
	chips.BackgroundTransparency = 1
	chips.Size = UDim2.fromOffset(240, 300)
	chips.LayoutOrder = 2
	chips.Parent = topRight
	local chipLayout = Theme.List(chips, "Vertical", 6, Enum.HorizontalAlignment.Right)
	chipLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	menu = Instance.new("Frame")
	menu.Name = "Menu"
	menu.BackgroundTransparency = 1
	menu.AnchorPoint = Vector2.new(0, 0.5)
	menu.Position = UDim2.new(0, 16, 0.5, 0)
	menu.Size = UDim2.fromOffset(124, 640)
	menu.Parent = gui
	Theme.ResponsiveScale(menu)
	local menuLayout = Theme.List(menu, "Vertical", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	menuLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
end

function HUD:Start()
	local data = State.Get()
	if data then
		setCash(data.cash)
	end
	State.Changed:Connect(function(snapshot)
		setCash(snapshot.cash)
		refreshMenu()
	end)
	State.ModeChanged:Connect(function(newMode: string)
		-- Dialogs opened in the base (hire, shop, arena menu, ...) must not stay
		-- over the run / fight screens.
		if newMode ~= "Base" then
			Theme.CloseModals("Base")
		end
		refreshMenu()
	end)
	Net.On("Notify", function(text: string, kind: string?)
		Theme.Toast(text, kind)
	end)
	refreshMenu()
end

function HUD:GetGui(): ScreenGui
	return gui
end

function HUD:Toast(text: string, kind: string?)
	Theme.Toast(text, kind)
end

function HUD:SetMenuVisible(visible: boolean)
	menuForcedHidden = not visible
	refreshMenu()
end

-- Small card button: coloured header with the title, blue body with an icon.
function HUD:AddMenuButton(spec: MenuSpec): TextButton
	local button = Instance.new("TextButton")
	button.Name = spec.Id
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.Size = UDim2.fromOffset(118, 104)
	button.LayoutOrder = spec.Order or 10
	button.Parent = menu

	local card, body = Theme.Card({
		Title = spec.Title,
		HeaderColor = spec.HeaderColor or P.CardOrange,
		HeaderDarkColor = spec.HeaderDarkColor or P.CardOrangeDark,
		HeaderHeight = 30,
		TitleSize = 20,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	card.Active = false
	Theme.Label({
		Text = spec.Icon,
		MaxTextSize = 44,
		StrokeThickness = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = card.ZIndex + 3,
		Parent = body,
	})

	button.Activated:Connect(function()
		Theme.Pop(button)
		spec.OnClick()
	end)
	table.insert(menuEntries, { spec = spec, button = button })
	refreshMenu()
	return button
end

function HUD:AddStatusChip(id: string, color: Color3?): Chip
	local chip = Instance.new("Frame")
	chip.Name = id
	chip.BackgroundColor3 = color or P.OfferPurple
	chip.Size = UDim2.fromOffset(200, 38)
	chip.Visible = false
	chip.Parent = chips
	Theme.Corner(chip, 0.5)
	Theme.Stroke(chip, P.CardOutline, 2, true)
	local label = Theme.Label({
		Text = "",
		MaxTextSize = 22,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = chip,
	})
	return {
		SetText = function(text: string)
			label.Text = text
		end,
		SetVisible = function(visible: boolean)
			chip.Visible = visible
		end,
		Destroy = function()
			chip:Destroy()
		end,
	}
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InventoryController (client)
	Adds the "Gear" card to the HUD menu (base only) that opens the Armoury
	(InventoryUI), and listens to the server's "Inventory" channel.

	API (other controllers, from Start or later):
		InventoryController:Open()    -- open the Armoury (only in Base mode)
		InventoryController:Close()   -- close it if this controller opened it

	Behaviour:
		* The Armoury opened from the HUD is a "Base" dialog (Theme Context) and
		  closes itself when you leave Base mode (the Combat lobby opens its own
		  copy, without a Context, through CombatController).
		* "Granted"   -> the new item gets a "NEW" badge in the Armoury.
		* "Converted" -> toast: your inventory was full, the drop became cash.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local InventoryUI = require(Client.UI.InventoryUI)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EquipmentDefs = require(Shared.Combat.EquipmentDefs)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local InventoryController = {}

local registry: { [string]: any } = {}
local closeArmoury: (() -> ())? = nil

function InventoryController:Init(reg: { [string]: any })
	registry = reg
end

function InventoryController:Open()
	if State.Mode() ~= "Base" then
		return
	end
	if closeArmoury then
		return -- already open (double click)
	end
	closeArmoury = InventoryUI.Open({
		Title = "Armoury",
		Context = "Base", -- the HUD closes it when you leave the base
		OnClose = function()
			closeArmoury = nil
		end,
	})
end

function InventoryController:Close()
	local close = closeArmoury
	if close then
		closeArmoury = nil
		close()
	end
end

function InventoryController:Start()
	local hud = registry.HUDController
	if hud and hud.AddMenuButton then
		hud:AddMenuButton({
			Id = "Gear",
			Title = "Gear",
			Icon = "🎒",
			Order = 3,
			OnClick = function()
				self:Open()
			end,
		})
	else
		warn("[InventoryController] HUDController missing: no Gear button")
	end

	State.ModeChanged:Connect(function(newMode: string)
		if newMode ~= "Base" then
			self:Close()
		end
	end)

	Net.On("Inventory", function(msg: any, payload: any)
		if type(payload) ~= "table" then
			return
		end
		if msg == "Granted" then
			if type(payload.uid) == "string" then
				InventoryUI.MarkNew(payload.uid)
			end
		elseif msg == "Converted" then
			local def = EquipmentDefs.GetDef(payload.item)
			local name = if def then def.name else "item"
			local value = tonumber(payload.value) or 0
			Theme.Toast(("Inventory full! %s scrapped for +%s"):format(name, Format.Money(value)), "cash")
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">RunnerController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerController (client)
	Runs the ARMY RUNNER game mode on the player's screen (ARCHITECTURE §6.1).

	Public API (§4.7):
		RunnerController:OpenPrepare()
			Same as stepping on the ARMY RUN portal pad: asks the server for a
			run (RunnerPrepare), which teleports you to your track, then shows
			the pre-run screen. Safe to call repeatedly (double clicks ignored).

	How a run goes:
	  1. PREPARE  - the avatar stands at the track start, camera high behind it
	                (like reference image 2). Left: permanent upgrade cards.
	                Right: bonuses. Bottom: tutorial hand. The first left/right
	                input (A/D, arrow keys, mouse or touch drag, gamepad stick or
	                d-pad) asks the server to start (RunnerGo).
	  2. RUNNING  - default controls are disabled; every frame we call
	                humanoid:Move() forward (-Z) and steer towards a target lane.
	                The server put a "RunnerGun" Tool in the avatar's hand;
	                RunnerVisuals welds the gun model of the current weapon to it.
	                Squads / barricades / shoot-to-grow gates within
	                RunnerDefs.GUN_RANGE (1.5 rows) are shot at: we predict that
	                row with RunnerSim.Resolve (lanes + wide-shooting stances so far
	                + the lane and RunnerSim.Stance we are in now) so enemies fall,
	                HP drains and gates grow in BOTH lanes exactly as the sim says.
	                When the avatar crosses a row we record its lane and lateral
	                position (the stance) and replay the run so far.
	                Live stats sit in the BOTTOM-LEFT panel (RunnerUI HUD), clear
	                of Roblox's chat window (top-left).
	  3. BOSS     - the avatar stops before the castle. Right away we send our
	                lanes + laterals to the server (RunnerFinish, ONE request, never
	                before RunnerSim.MinDuration + FINISH_SLACK); the server
	                re-simulates and pays. Meanwhile the castle door opens and
	                the boss walks out (RunnerDefs.BOSS_INTRO_SECONDS), which
	                covers the round trip. The fight then plays the SERVER's
	                BossOutcome (reply.result.boss) exactly (its HP bar follows
	                BossHpAt, a unit dies every interval: troops first, the
	                avatar last), so what you see always matches what is paid.
	                Only if the request fails (or has no reply FINISH_REPLY_WAIT s
	                after the intro) do we play our own RunnerSim.Resolve.
	  4. SUMMARY  - "RUN COMPLETE!" panel from the reply; COLLECT returns to the
	                base (the server puts us at the spawn, away from the ARMY RUN
	                pad). After a LOST run the level stays (owner request) and the
	                panel offers TRY AGAIN: RunnerRetry starts the same level on
	                the track right away.

	Cleanup (camera, controls, jump, visuals incl. guns / boss / bullets /
	avatar pose, HUD panel, messages, input) happens on COLLECT, Back, any
	failed request, death/respawn, or the server leaving Runner mode. The
	server destroys the RunnerGun Tool when its session ends.

	Portal pad: walking onto it starts OpenPrepare, but never while a Theme
	dialog is open (Theme.IsModalOpen) - step off and back on after closing it.
	When the run starts, HUDController closes the open "Base" dialogs
	(Theme.CloseModals("Base")); the run's own screens are not "Base" dialogs
	(the pre-run screen is not a panel, the summary panel has no Context), so
	they are never closed by that.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)
local RunnerCourse = require(Shared.Runner.RunnerCourse)
local RunnerDefs = require(Shared.Runner.RunnerDefs)
local RunnerSim = require(Shared.Runner.RunnerSim)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local RunnerUI = require(Client.UI.RunnerUI)
local RunnerVisuals = require(Client.World.RunnerVisuals)

type Course = RunnerCourse.Course
type Row = RunnerCourse.Row
type Stats = RunnerSim.Stats
type Result = RunnerSim.Result
type RowOutcome = RunnerSim.RowOutcome
type BossOutcome = RunnerSim.BossOutcome
type Option = RunnerCourse.Option
type Fight = RunnerVisuals.Fight
type Engagement = RunnerVisuals.Engagement
type PlayerData = Types.PlayerData

local player = Players.LocalPlayer
local P = Config.Palette

-------------------------------------------------------------------------------
-- Tunables
-------------------------------------------------------------------------------
local PORTAL_RADIUS = 7 -- studs from Layout.RunnerPortalPosition()
local PORTAL_COOLDOWN = 4 -- [PROPOSAL] seconds between portal triggers
local KEY_STEER_SPEED = 26 -- [PROPOSAL] how fast keys / stick move the target lane (studs/s)
local STEER_GAIN = 7 -- [PROPOSAL] how hard the avatar chases the target lane
local LATERAL_LIMIT = Layout.RUNNER_TRACK_WIDTH / 2 - 2
local DRAG_START_PIXELS = 14 -- [PROPOSAL] drag this far to start the run
local CAMERA_OFFSET = Vector3.new(0, 17, 22) -- high behind the runner (image 2)
local BOSS_CAMERA_OFFSET = Vector3.new(0, 26, 48) -- pulled back: 8 troop rows + the boss + its HP bar
local CAMERA_LOOK_AHEAD = 20
local GUN_RANGE = RunnerDefs.GUN_RANGE -- guns reach 1.5 rows: squads/barricades are shot from here
local FINISH_SLACK = 0.75 -- seconds past RunnerSim.MinDuration before we report the finish
local FINISH_REPLY_WAIT = 6 -- [PROPOSAL] seconds after the boss intro we wait for RunnerFinish before playing our own prediction
local FINISH_GIVE_UP = 15 -- [PROPOSAL] seconds after the fight with still no RunnerFinish reply: end the run
local BOSS_SAFETY = 4 -- [PROPOSAL] seconds past the planned boss fight before we finish anyway
local STUCK_TIME = 6 -- [PROPOSAL] no forward progress for this long = give up the run
local MODE_GRACE = 3 -- seconds we tolerate "not in Runner mode" before cleaning up
local RENDER_NAME = "ArmyRunnerStep"
local DEFAULT_RUN_SPEED = 24

-------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------
type Live = { troops: number, cash: number, tier: number, dmg: number }

type Session = {
	runId: string,
	course: Course,
	level: number,
	slot: number,
	centreX: number,
	startZ: number,
	stats: Stats,
	previewStats: { startTroops: number, damage: number, capacity: number },
	runSpeed: number,
	phase: string, -- "prepare" | "running" | "boss" | "summary" | "ended"
	choices: { number },
	laterals: { number }, -- row index -> studs right of the centre line where we crossed it
	stances: { number }, -- row index -> RunnerSim.Stance at that crossing
	nextRow: number,
	engageKeys: { [number]: string }, -- row index -> prediction key last sent to the visuals
	live: Live,
	targetLateral: number,
	camLateral: number,
	camOffset: Vector3,
	camFocus: Vector3?,
	startClock: number,
	lastDistance: number,
	lastProgressClock: number,
	notRunnerSince: number?,
	character: Model,
	humanoid: Humanoid,
	connections: { any }, -- RBXScriptConnections and Signal connections (both have :Disconnect())
	visuals: RunnerVisuals.Visuals?,
	hud: RunnerUI.Hud?,
	prepare: RunnerUI.Prepare?,
	closeSummary: (() -> ())?,
	closeMessage: (() -> ())?,
	goPending: boolean,
	buying: { [string]: boolean },
	levelOverrides: { [string]: number },
	dragInput: InputObject?,
	dragLastX: number,
	dragTotal: number,
	held: { [Enum.KeyCode]: boolean },
	thumbX: number,
	-- Boss phase: one RunnerFinish request, sent on arrival at the castle.
	localResult: Result?, -- our own RunnerSim.Resolve (fallback only)
	finishSent: boolean,
	finishDone: boolean, -- the request returned (ok or not)
	finishReply: { [string]: any }?, -- ok reply: { result, paid, boosted, level }
	finishError: string?,
	fightStarted: boolean,
	fightDone: boolean,
}

local RunnerController = {}

local registry: { [string]: any } = {}
local session: Session? = nil
local opening = false
local portalArmed = false
local portalCooldownUntil = 0
local controlsCache: any = nil
local startSessionRef: ((reply: { [string]: any }) -> ())? = nil -- startSession (defined further down)

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local function toast(text: string, kind: string?)
	Theme.Toast(text, kind)
end

local function getRoot(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Roblox's default PlayerModule -> ControlModule (keyboard/touch/gamepad movement).
local function getControls(): any
	if controlsCache then
		return controlsCache
	end
	local playerScripts = player:FindFirstChild("PlayerScripts") or player:WaitForChild("PlayerScripts", 5)
	local module = playerScripts and playerScripts:WaitForChild("PlayerModule", 5)
	if module and module:IsA("ModuleScript") then
		local ok, playerModule = pcall(require, module)
		if ok and type(playerModule) == "table" and type((playerModule :: any).GetControls) == "function" then
			local gotOk, controls = pcall((playerModule :: any).GetControls, playerModule)
			if gotOk and controls then
				controlsCache = controls
			end
		end
	end
	return controlsCache
end

local function setControlsEnabled(enabled: boolean)
	local controls = getControls()
	if not controls then
		return
	end
	if enabled then
		pcall(function()
			controls:Enable()
		end)
	else
		pcall(function()
			controls:Disable()
		end)
	end
end

local function numberOr(value: any, fallback: number): number
	if type(value) == "number" and value == value then
		return value
	end
	return fallback
end

local function cleanStats(raw: any, fallback: { startTroops: number, damage: number, capacity: number }): Stats
	local source = if type(raw) == "table" then raw else {}
	return {
		startTroops = numberOr(source.startTroops, fallback.startTroops),
		damage = numberOr(source.damage, fallback.damage),
		capacity = numberOr(source.capacity, fallback.capacity),
		payoutBonus = if type(source.payoutBonus) == "number" then source.payoutBonus else nil,
	}
end

local function safeResolve(s: Session): Result?
	local ok, result = pcall(RunnerSim.Resolve, s.course, s.stats, s.choices, s.stances)
	if ok and type(result) == "table" then
		return result
	end
	warn("[RunnerController] RunnerSim.Resolve failed: " .. tostring(result))
	return nil
end

local function findOutcome(result: Result, rowIndex: number): RowOutcome?
	if type(result.outcomes) ~= "table" then
		return nil
	end
	for _, outcome in result.outcomes do
		if outcome.row == rowIndex then
			return outcome
		end
	end
	return nil
end

-- Which lane (option) of a row the avatar is in, by its lateral position.
local function laneAt(row: Row, lateral: number): number
	local best, bestDistance = 1, math.huge
	for index, option in row.options do
		local lane = if type(option.lane) == "number" then option.lane else index
		local half = option.width / 2
		if lateral >= option.x - half and lateral <= option.x + half then
			return lane
		end
		local d = math.abs(lateral - option.x)
		if d < bestDistance then
			best, bestDistance = lane, d
		end
	end
	return best
end

local function isFightRow(row: Row): boolean
	return row.kind == "squad" or row.kind == "barricade" or row.kind == "contest"
end

-- What a squad / barricade / shoot-to-grow row looks like for the visuals in
-- EVERY lane (wide shooting hits the other lane too), straight from the row's
-- RunnerSim outcome. Visual only: troops / cash / destroyed always come from
-- the outcome itself.
local function engagementFor(row: Row, lane: number, outcome: RowOutcome?): Engagement?
	if not outcome or not isFightRow(row) then
		return nil
	end
	local fights: { [number]: Fight } = {}
	for index, option in row.options do
		local l = if type(option.lane) == "number" then option.lane else index
		local own = l == lane
		local damage = numberOr(if own then outcome.damage else outcome.otherDamage, 0)
		if row.kind == "squad" then
			local enemies = math.max(0, math.floor(numberOr(option.enemies, 0)))
			local kills = math.clamp(math.floor(numberOr(if own then outcome.kills else outcome.otherKills, 0)), 0, enemies)
			fights[l] = {
				enemies = enemies,
				kills = kills,
				share = if enemies > 0 then kills / enemies else 1,
				destroyed = kills >= enemies,
			}
		elseif row.kind == "barricade" then
			local destroyed = if own then outcome.destroyed == true else outcome.otherDestroyed == true
			local hp = math.max(1e-6, numberOr(option.hp, 1))
			fights[l] = {
				enemies = 0,
				kills = 0,
				share = if destroyed then 1 else math.clamp(damage / hp, 0, 1),
				destroyed = destroyed,
			}
		else
			local steps = math.max(0, math.floor(numberOr(if own then outcome.steps else outcome.otherSteps, 0)))
			local amount = numberOr(if own then outcome.amount else outcome.otherAmount, numberOr(option.amount, 0))
			fights[l] = {
				enemies = 0,
				kills = 0,
				share = steps / math.max(1, numberOr(option.growMax, 1)),
				destroyed = false,
				steps = steps,
				amount = amount,
			}
		end
	end
	return {
		lane = lane,
		stance = math.max(0, math.floor(numberOr(outcome.stance, 0))),
		across = math.max(0, math.floor(numberOr(outcome.across, 0))),
		fights = fights,
	}
end

local function unitDps(s: Session, tier: number, dmg: number): number
	local ok, dps = pcall(RunnerSim.UnitDps, s.stats, tier, dmg)
	return if ok and type(dps) == "number" then dps else 0
end

-- Bottom-left HUD panel: troops (true count), weapon, squad DPS, carried cash.
local function updateHud(s: Session, troopsOverride: number?)
	local hud = s.hud
	if not hud then
		return
	end
	local troops = troopsOverride or s.live.troops
	local tier = math.clamp(math.floor(s.live.tier), 1, RunnerDefs.MAX_WEAPON_TIER)
	hud.SetStats({
		troops = troops,
		weaponName = RunnerDefs.WEAPONS[tier].name,
		weaponTier = tier,
		maxTier = RunnerDefs.MAX_WEAPON_TIER,
		dps = troops * unitDps(s, tier, s.live.dmg),
		cash = s.live.cash,
		capacity = s.stats.capacity,
	})
end

-------------------------------------------------------------------------------
-- Cleanup
-------------------------------------------------------------------------------
local function restoreCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Ends the local session. Safe to call many times.
local function cleanup()
	local s = session
	if not s then
		return
	end
	session = nil
	s.phase = "ended"
	RunService:UnbindFromRenderStep(RENDER_NAME)
	for _, connection in s.connections do
		connection:Disconnect()
	end
	table.clear(s.connections)
	local function try(fn: () -> ())
		local ok, err = pcall(function(): any
			fn()
			return nil
		end)
		if not ok then
			warn("[RunnerController] cleanup step failed: " .. tostring(err))
		end
	end
	try(function()
		if s.closeSummary then
			s.closeSummary()
			s.closeSummary = nil
		end
	end)
	try(function()
		if s.closeMessage then
			s.closeMessage()
			s.closeMessage = nil
		end
	end)
	try(function()
		if s.prepare then
			s.prepare.Destroy()
			s.prepare = nil
		end
	end)
	try(function()
		if s.hud then
			s.hud.Destroy()
			s.hud = nil
		end
	end)
	try(function()
		if s.visuals then
			s.visuals:Destroy()
			s.visuals = nil
		end
	end)
	try(function()
		if s.humanoid.Parent then
			s.humanoid:Move(Vector3.zero, false)
			s.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
	end)
	try(restoreCamera)
	try(function()
		setControlsEnabled(true)
	end)
	-- The return teleport may drop us on the portal pad: wait until we step off.
	portalArmed = false
	portalCooldownUntil = os.clock() + PORTAL_COOLDOWN
end

-- Leave the run: local cleanup now, then tell the server (teleports to base).
local function leave(s: Session)
	if session ~= s then
		return
	end
	cleanup()
	task.spawn(function()
		local reply = Net.Request("RunnerLeave")
		if not reply.ok then
			warn("[RunnerController] RunnerLeave failed: " .. tostring(reply.err))
		end
	end)
end

local function fail(s: Session, message: string?)
	if session ~= s then
		return
	end
	toast(message or "Something went wrong with the run", "error")
	leave(s)
end

-------------------------------------------------------------------------------
-- Run flow
-------------------------------------------------------------------------------
local function crossRow(s: Session, index: number, lane: number, lateral: number)
	local crossed = s.course.rows[index]
	s.choices[index] = lane
	s.laterals[index] = lateral
	s.stances[index] = if crossed then RunnerSim.Stance(crossed, lane, lateral) else 0
	s.nextRow = index + 1
	s.engageKeys[index] = nil
	local result = safeResolve(s)
	local outcome = if result then findOutcome(result, index) else nil
	local row = s.course.rows[index]
	local visuals = s.visuals
	local cashBefore = s.live.cash
	if visuals then
		visuals:RowCrossed(index, lane, outcome, s.stats.capacity, engagementFor(row, lane, outcome))
	end
	if outcome then
		s.live = {
			troops = outcome.troopsAfter,
			cash = outcome.cashAfter,
			tier = outcome.weaponTier,
			dmg = outcome.damageMult,
		}
	end
	if visuals then
		visuals:SetSquad(s.live.troops, s.live.tier)
	end
	updateHud(s)
	if s.hud and s.live.cash > cashBefore + 0.5 then
		s.hud.PopCash()
	end
end

-- Squads / barricades / shoot-to-grow gates within gun range: tell the
-- visuals what the fight will look like (in both lanes) if we stay where we
-- are now. Re-predicted only when a relevant lane or stance (or the last
-- crossed row) changes.
local function updateEngagements(s: Session, distance: number, lateral: number)
	local visuals = s.visuals
	if not visuals then
		return
	end
	local rows = s.course.rows
	local lanes: { number } = {}
	local stances: { number } = {}
	local key = tostring(s.nextRow)
	for index = s.nextRow, #rows do
		local row = rows[index]
		if distance < row.distance - GUN_RANGE then
			break
		end
		local lane = laneAt(row, lateral)
		local stance = RunnerSim.Stance(row, lane, lateral)
		lanes[index] = lane
		stances[index] = stance
		key ..= ":" .. lane .. "/" .. stance
		if isFightRow(row) and s.engageKeys[index] ~= key then
			s.engageKeys[index] = key
			local predicted = table.clone(s.choices)
			local predictedStances = table.clone(s.stances)
			for j = s.nextRow, index do
				predicted[j] = lanes[j]
				predictedStances[j] = stances[j]
			end
			local ok, result = pcall(RunnerSim.Resolve, s.course, s.stats, predicted, predictedStances)
			local outcome = if ok and type(result) == "table" then findOutcome(result, index) else nil
			local engagement = engagementFor(row, lane, outcome)
			if engagement then
				visuals:Engage(index, engagement)
			end
		end
	end
end

local function bossReward(result: Result): number
	for _, line in result.lines do
		if line.kind == "boss" then
			return line.value
		end
	end
	return 0
end

-- The summary appears once BOTH the boss fight has played (fightDone) and the
-- RunnerFinish reply is in (finishDone). It always shows the server's result.
-- TRY AGAIN after a lost run: the server ends this run and starts the same
-- level on the track (RunnerRetry); we then build the new run like a fresh one.
local function retry(s: Session)
	if session ~= s or opening then
		return
	end
	opening = true
	task.spawn(function()
		local reply = Net.Request("RunnerRetry", s.runId)
		opening = false
		if session ~= s then
			return
		end
		if not reply.ok then
			toast(reply.err or "Could not start the run", "error")
			leave(s)
			return
		end
		cleanup() -- the old run's visuals, HUD and input
		local start = startSessionRef
		if start and not session then
			start(reply)
		end
	end)
end

local function tryShowSummary(s: Session)
	if session ~= s or s.phase ~= "boss" or not s.fightDone or not s.finishDone then
		return
	end
	local reply = s.finishReply
	if not reply then
		fail(s, s.finishError or "Could not finish the run")
		return
	end
	s.phase = "summary"
	if s.closeMessage then
		s.closeMessage()
		s.closeMessage = nil
	end
	if s.hud then
		s.hud.SetStatsVisible(false) -- the summary lists everything; keep the screen clear
	end
	local result = reply.result :: Result
	local paid = numberOr(reply.paid, 0)
	local lost = type(result.boss) ~= "table" or result.boss.victory ~= true
	local data = State.Get()
	local upgrades = if data then data.runner.upgrades else { troops = 0, damage = 0, capacity = 0 }
	s.closeSummary = RunnerUI.ShowSummary({
		Level = s.level,
		Result = result,
		Paid = paid,
		Boosted = reply.boosted == true,
		Upgrades = upgrades,
		OnCollect = function()
			s.closeSummary = nil
			leave(s)
			toast("💡 Spend your cash on base unlocks - or press 🪖 Army Run to play again", "info")
		end,
		-- A lost level is played again until it is won (owner request).
		OnRetry = if lost
			then function()
				s.closeSummary = nil
				retry(s)
			end
			else nil,
	})
end

local function markFightDone(s: Session)
	if session ~= s or s.fightDone then
		return
	end
	s.fightDone = true
	tryShowSummary(s)
	-- The reply never came: give up instead of waiting forever.
	task.delay(FINISH_GIVE_UP, function()
		if session == s and s.phase == "boss" and not s.finishDone then
			fail(s, "Could not finish the run")
		end
	end)
end

-- Plays the boss fight with the SERVER's outcome (RunnerFinish reply), so the
-- screen always matches the payout. Only when the request failed (or is far
-- too slow) does it fall back to our own RunnerSim.Resolve prediction.
local function startFight(s: Session)
	if session ~= s or s.phase ~= "boss" or s.fightStarted then
		return
	end
	s.fightStarted = true
	local reply = s.finishReply
	local result: Result? = if reply then reply.result :: Result else s.localResult
	local outcome: BossOutcome? = if result and type(result.boss) == "table" then result.boss else nil
	local visuals = s.visuals
	if not result or not outcome or not visuals then
		markFightDone(s)
		return
	end
	local fightResult: Result = result
	local fightOutcome: BossOutcome = outcome
	local tier = s.live.tier
	local dmg = s.live.dmg
	local total = visuals:StartBossFight(fightOutcome, {
		onProgress = function(alive: number, _hp: number)
			if session == s then
				updateHud(s, alive)
			end
		end,
		onResolved = function(victory: boolean)
			if session ~= s then
				return
			end
			s.live = { troops = fightOutcome.survivors, cash = s.live.cash, tier = tier, dmg = dmg }
			updateHud(s)
			if s.closeMessage then
				s.closeMessage()
			end
			if victory then
				s.closeMessage = RunnerUI.ShowMessage(
					"BOSS DEFEATED!",
					"+" .. Format.Money(bossReward(fightResult)) .. " boss reward",
					P.Coin,
					3
				)
			else
				s.closeMessage =
					RunnerUI.ShowMessage("DEFEATED BY THE BOSS", "Pick the best lanes to beat it", P.ButtonRed, 3.2)
			end
		end,
		onDone = function()
			markFightDone(s)
		end,
	})
	-- Safety net: finish even if the visuals stopped updating.
	task.delay(total + BOSS_SAFETY, function()
		markFightDone(s)
	end)
end

-- Sends RunnerFinish exactly ONCE, as soon as the squad reaches the castle
-- (the boss intro covers the round trip). The server rejects runs faster
-- than RunnerSim.MinDuration x 0.9; we never report before MinDuration +
-- FINISH_SLACK (arriving at the castle normally takes longer anyway).
local function sendFinish(s: Session)
	if session ~= s or s.finishSent then
		return
	end
	s.finishSent = true
	local okMin, minDuration = pcall(RunnerSim.MinDuration, s.course)
	if okMin and type(minDuration) == "number" then
		local wait = minDuration + FINISH_SLACK - (os.clock() - s.startClock)
		if wait > 0 then
			task.wait(wait)
			if session ~= s then
				return
			end
		end
	end
	local reply = Net.Request("RunnerFinish", s.runId, s.choices, s.laterals)
	if session ~= s then
		return
	end
	if reply.ok and type(reply.result) == "table" then
		s.finishReply = reply
	else
		s.finishError = if reply.ok then "Could not finish the run" else reply.err
	end
	s.finishDone = true
	if s.fightStarted then
		tryShowSummary(s) -- fight already playing (slow reply) or done
	else
		startFight(s)
	end
end

local function beginBoss(s: Session, lateral: number)
	s.phase = "boss"
	-- Any row we somehow skipped counts with the lane we are in now.
	local rows = s.course.rows
	for index = s.nextRow, #rows do
		crossRow(s, index, laneAt(rows[index], lateral), lateral)
	end
	s.humanoid:Move(Vector3.zero, false)
	if s.hud then
		s.hud.SetProgress(1)
	end
	-- Our own prediction: the boss's max HP for the intro (the same number the
	-- server uses: same course + stats) and the fallback if RunnerFinish fails.
	local predicted = safeResolve(s)
	s.localResult = predicted
	local intro = 0
	local visuals = s.visuals
	if visuals then
		local hp = if predicted and type(predicted.boss) == "table" then numberOr(predicted.boss.hp, 0) else 0
		intro = visuals:OpenCastle(hp)
	end
	-- We are inside the RenderStep callback and sendFinish yields: spawn it.
	task.spawn(sendFinish, s)
	-- Reply far too slow: play our prediction rather than a frozen boss.
	task.delay(intro + FINISH_REPLY_WAIT, function()
		startFight(s)
	end)
end

local function requestGo(s: Session)
	if s.phase ~= "prepare" or s.goPending or next(s.buying) ~= nil then
		return
	end
	s.goPending = true
	task.spawn(function()
		local reply = Net.Request("RunnerGo", s.runId)
		s.goPending = false
		if session ~= s or s.phase ~= "prepare" then
			return
		end
		if not reply.ok then
			fail(s, reply.err or "Could not start the run")
			return
		end
		s.stats = cleanStats(reply.stats, s.previewStats)
		s.runSpeed = numberOr(reply.runSpeed, s.runSpeed)
		-- Boss HP is an exact search over the whole course (memoized per
		-- course + stats): compute it now so the first row crossing has no hitch.
		pcall(RunnerSim.BossHp, s.course, s.stats)
		s.phase = "running"
		s.startClock = os.clock()
		s.lastProgressClock = os.clock()
		s.live = { troops = s.stats.startTroops, cash = 0, tier = 1, dmg = 1 }
		local root = getRoot(s.character)
		if root then
			s.targetLateral = math.clamp(root.Position.X - s.centreX, -LATERAL_LIMIT, LATERAL_LIMIT)
			s.lastDistance = s.startZ - root.Position.Z
		end
		if s.prepare then
			s.prepare.Destroy()
			s.prepare = nil
		end
		if s.visuals then
			s.visuals:SetSquad(s.live.troops, 1)
		end
		if s.hud then
			s.hud.SetStatsVisible(true)
		end
		updateHud(s)
	end)
end

local function buyUpgrade(s: Session, kind: string)
	if s.phase ~= "prepare" or s.buying[kind] or s.goPending then
		return
	end
	s.buying[kind] = true
	if s.prepare then
		s.prepare.SetBusy(kind, true)
	end
	task.spawn(function()
		local reply = Net.Request("BuyRunnerUpgrade", kind)
		s.buying[kind] = nil
		if session ~= s then
			return
		end
		if reply.ok then
			if type(reply.level) == "number" then
				s.levelOverrides[kind] = reply.level
			end
			if type(reply.stats) == "table" then
				local stats = cleanStats(reply.stats, s.previewStats)
				s.previewStats = { startTroops = stats.startTroops, damage = stats.damage, capacity = stats.capacity }
				s.stats = stats
			end
			toast("Permanent upgrade bought!", "success")
			if s.visuals and s.phase == "prepare" then
				s.visuals:SetSquad(s.previewStats.startTroops, 1)
			end
		else
			toast(reply.err or "Could not buy the upgrade", "error")
		end
		local prepare = s.prepare
		if prepare then
			prepare.SetBusy(kind, false)
			local data = State.Get()
			if data then
				prepare.Update(data, s.previewStats, s.levelOverrides)
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Per-frame update
-------------------------------------------------------------------------------
local function updateCamera(s: Session, root: BasePart, dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local alpha = 1 - math.exp(-dt * 6)
	local lateral = root.Position.X - s.centreX
	local running = s.phase == "prepare" or s.phase == "running"
	-- Boss fight: frame the squad and the boss (focus between them, centred).
	local bossAt = if running or not s.visuals then nil else s.visuals:BossFocus()
	s.camLateral += ((if bossAt then 0 else lateral * 0.55) - s.camLateral) * alpha
	s.camOffset = s.camOffset:Lerp(if running then CAMERA_OFFSET else BOSS_CAMERA_OFFSET, alpha * 0.5)
	local focusZ = if bossAt then root.Position.Z + (bossAt.Z - root.Position.Z) * 0.4 else root.Position.Z
	local goal = Vector3.new(s.centreX + s.camLateral, Layout.FLOOR_Y + 2, focusZ)
	local focus = if s.camFocus then s.camFocus:Lerp(goal, alpha) else goal
	s.camFocus = focus
	local lookAt = if bossAt then focus + Vector3.new(0, 1, -1) else focus + Vector3.new(0, 0, -CAMERA_LOOK_AHEAD)
	camera.CFrame = CFrame.lookAt(focus + s.camOffset, lookAt)
end

local function step(dt: number)
	local s = session
	if not s then
		return
	end
	dt = math.min(dt, 0.1)
	if player.Character ~= s.character then
		cleanup() -- respawned
		return
	end
	local root = getRoot(s.character)
	if not root or s.humanoid.Health <= 0 then
		return -- dying: the server switches us back to Base, which cleans up
	end

	-- Watchdog: the server ended our run but we missed the message.
	if State.Mode() ~= "Runner" then
		local since = s.notRunnerSince or os.clock()
		s.notRunnerSince = since
		if os.clock() - since > MODE_GRACE then
			cleanup()
			return
		end
	else
		s.notRunnerSince = nil
	end

	local distance = s.startZ - root.Position.Z
	local lateral = root.Position.X - s.centreX
	local visuals = s.visuals

	if s.phase == "running" then
		-- Steering: keys / stick move the target lane, drags move it directly.
		local input = s.thumbX
		if s.held[Enum.KeyCode.A] or s.held[Enum.KeyCode.Left] or s.held[Enum.KeyCode.DPadLeft] then
			input -= 1
		end
		if s.held[Enum.KeyCode.D] or s.held[Enum.KeyCode.Right] or s.held[Enum.KeyCode.DPadRight] then
			input += 1
		end
		s.targetLateral =
			math.clamp(s.targetLateral + math.clamp(input, -1, 1) * KEY_STEER_SPEED * dt, -LATERAL_LIMIT, LATERAL_LIMIT)
		local speed = math.max(1, s.runSpeed)
		local sideways = math.clamp((s.targetLateral - lateral) * STEER_GAIN, -speed * 0.9, speed * 0.9)
		s.humanoid:Move(Vector3.new(sideways, 0, -speed).Unit, false)

		-- Rows: record the lane on crossing, then shoot at what is in range.
		local rows = s.course.rows
		while s.nextRow <= #rows and distance >= rows[s.nextRow].distance do
			local index = s.nextRow
			crossRow(s, index, laneAt(rows[index], lateral), lateral)
		end
		updateEngagements(s, distance, lateral)

		-- Progress bar + stuck check.
		local stopDistance = if visuals then visuals.stopDistance else Layout.RUNNER_TRACK_LENGTH
		if s.hud then
			s.hud.SetProgress(distance / math.max(1, stopDistance))
		end
		if distance > s.lastDistance + 0.5 then
			s.lastDistance = distance
			s.lastProgressClock = os.clock()
		elseif os.clock() - s.lastProgressClock > STUCK_TIME then
			fail(s, "Your run got stuck - please try again")
			return
		end
		if distance >= stopDistance then
			beginBoss(s, lateral)
		end
	else
		s.humanoid:Move(Vector3.zero, false)
	end

	if visuals then
		visuals:Update(dt, root, s.phase == "running")
	end
	updateCamera(s, root, dt)
end

-------------------------------------------------------------------------------
-- Input
-------------------------------------------------------------------------------
local STEER_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.A] = true,
	[Enum.KeyCode.D] = true,
	[Enum.KeyCode.Left] = true,
	[Enum.KeyCode.Right] = true,
	[Enum.KeyCode.DPadLeft] = true,
	[Enum.KeyCode.DPadRight] = true,
}

local function connectInput(s: Session)
	local function viewportWidth(): number
		local camera = Workspace.CurrentCamera
		return if camera then math.max(200, camera.ViewportSize.X) else 1000
	end

	table.insert(
		s.connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if session ~= s then
				return
			end
			if STEER_KEYS[input.KeyCode] then
				if processed and input.UserInputType == Enum.UserInputType.Keyboard then
					return -- typing in chat
				end
				s.held[input.KeyCode] = true
				requestGo(s)
			elseif
				not processed
				and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
				and s.dragInput == nil
			then
				s.dragInput = input
				s.dragLastX = input.Position.X
				s.dragTotal = 0
			end
		end)
	)

	table.insert(
		s.connections,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if session ~= s then
				return
			end
			if input.KeyCode == Enum.KeyCode.Thumbstick1 then
				local x = input.Position.X
				s.thumbX = if math.abs(x) > 0.2 then x else 0
				if math.abs(x) > 0.5 then
					requestGo(s)
				end
				return
			end
			local drag = s.dragInput
			if not drag then
				return
			end
			local isMouseDrag = drag.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseMovement
			if input == drag or isMouseDrag then
				local dx = input.Position.X - s.dragLastX
				s.dragLastX = input.Position.X
				s.dragTotal += math.abs(dx)
				if s.phase == "prepare" then
					if s.dragTotal >= DRAG_START_PIXELS then
						requestGo(s)
					end
				elseif s.phase == "running" then
					-- Dragging across ~60% of the screen sweeps the whole track.
					local studsPerPixel = Layout.RUNNER_TRACK_WIDTH / (viewportWidth() * 0.6)
					s.targetLateral = math.clamp(s.targetLateral + dx * studsPerPixel, -LATERAL_LIMIT, LATERAL_LIMIT)
				end
			end
		end)
	)

	table.insert(
		s.connections,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if session ~= s then
				return
			end
			if STEER_KEYS[input.KeyCode] then
				s.held[input.KeyCode] = nil
			end
			local drag = s.dragInput
			if
				drag
				and (
					input == drag
					or (
						input.UserInputType == Enum.UserInputType.MouseButton1
						and drag.UserInputType == Enum.UserInputType.MouseButton1
					)
				)
			then
				s.dragInput = nil
			end
		end)
	)
end

-------------------------------------------------------------------------------
-- Session start
-------------------------------------------------------------------------------
local function startSession(reply: { [string]: any })
	local course = reply.course
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local valid = type(reply.runId) == "string"
		and type(course) == "table"
		and type(course.rows) == "table"
		and type(course.boss) == "table"
		and type(reply.slot) == "number"
	if not valid or not character or not humanoid then
		toast("Could not start the run, please try again", "error")
		task.spawn(Net.Request, "RunnerLeave")
		return
	end

	local slot = reply.slot :: number
	local fallbackStats = { startTroops = 1, damage = 1, capacity = 0 }
	local stats = cleanStats(reply.stats, fallbackStats)
	local s: Session = {
		runId = reply.runId :: string,
		course = course :: Course,
		level = numberOr(reply.level, 1),
		slot = slot,
		centreX = Layout.RunnerPoint(slot, 0, 0).X,
		startZ = Layout.RunnerPoint(slot, 0, 0).Z,
		stats = stats,
		previewStats = { startTroops = stats.startTroops, damage = stats.damage, capacity = stats.capacity },
		runSpeed = numberOr(reply.runSpeed, DEFAULT_RUN_SPEED),
		phase = "prepare",
		choices = {},
		laterals = {},
		stances = {},
		nextRow = 1,
		engageKeys = {},
		live = { troops = stats.startTroops, cash = 0, tier = 1, dmg = 1 },
		targetLateral = 0,
		camLateral = 0,
		camOffset = CAMERA_OFFSET,
		camFocus = nil,
		startClock = os.clock(),
		lastDistance = 0,
		lastProgressClock = os.clock(),
		notRunnerSince = nil,
		character = character,
		humanoid = humanoid,
		connections = {},
		visuals = nil,
		hud = nil,
		prepare = nil,
		closeSummary = nil,
		closeMessage = nil,
		goPending = false,
		buying = {},
		levelOverrides = {},
		dragInput = nil,
		dragLastX = 0,
		dragTotal = 0,
		held = {},
		thumbX = 0,
		localResult = nil,
		finishSent = false,
		finishDone = false,
		finishReply = nil,
		finishError = nil,
		fightStarted = false,
		fightDone = false,
	}
	session = s

	local ok, err = pcall(function()
		local visuals = RunnerVisuals.new(s.course, slot, character)
		s.visuals = visuals
		visuals:SetSquad(stats.startTroops, 1)
		s.hud = RunnerUI.ShowHud(s.level)
		local data = State.Get()
		if data then
			s.prepare = RunnerUI.ShowPrepare({
				Data = data,
				Stats = s.previewStats,
				OnBuy = function(kind: string)
					buyUpgrade(s, kind)
				end,
				OnBack = function()
					leave(s)
				end,
			})
		end
	end)
	if not ok then
		warn("[RunnerController] building the run failed: " .. tostring(err))
		fail(s, "Could not build the run, please try again")
		return
	end

	-- Take over the avatar and camera.
	setControlsEnabled(false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, step)
	connectInput(s)

	table.insert(
		s.connections,
		State.Changed:Connect(function(data: PlayerData)
			if session == s and s.prepare then
				s.prepare.Update(data, s.previewStats, s.levelOverrides)
			end
		end)
	)
	table.insert(
		s.connections,
		humanoid.Died:Connect(function()
			if session == s then
				cleanup()
			end
		end)
	)
	-- If the player was already gone by the time controls were disabled.
	if session ~= s then
		cleanup()
	end
end

startSessionRef = startSession

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------
function RunnerController:OpenPrepare()
	if session or opening then
		return
	end
	if State.Mode() ~= "Base" then
		toast("Finish what you are doing first!", "error")
		return
	end
	if not State.Get() then
		toast("Still loading your data...", "info")
		return
	end
	opening = true
	getControls() -- make sure the control module is ready before we need it
	local reply = Net.Request("RunnerPrepare")
	opening = false
	if not reply.ok then
		toast(reply.err or "Could not start a run", "error")
		return
	end
	if session then
		return
	end
	startSession(reply)
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------
function RunnerController:Init(reg: { [string]: any })
	registry = reg
end

function RunnerController:Start()
	task.spawn(getControls)

	local hud = registry.HUDController
	if hud and hud.AddMenuButton then
		hud:AddMenuButton({
			Id = "Run",
			Title = "Army Run",
			Icon = "🪖",
			Order = 1,
			OnClick = function()
				task.spawn(function()
					RunnerController:OpenPrepare()
				end)
			end,
		})
	end

	-- Any mode other than Runner ends the local session (death, leaving...).
	State.ModeChanged:Connect(function(newMode: string)
		if session and newMode ~= "Runner" then
			cleanup()
		end
	end)
	Net.On("Runner", function(msg: string, payload: any)
		local s = session
		if msg == "Ended" and s and type(payload) == "table" and payload.runId == s.runId then
			cleanup()
		end
	end)
	player.CharacterAdded:Connect(function()
		if session then
			cleanup()
		end
	end)

	-- ARMY RUN portal pad in area 1 (BASE builds the pad, we detect the player).
	local portal = Layout.RunnerPortalPosition()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator < 0.2 then
			return
		end
		accumulator = 0
		if session or opening or State.Mode() ~= "Base" then
			portalArmed = false
			return
		end
		local root = getRoot(player.Character)
		if not root then
			return
		end
		local offset = root.Position - portal
		local flat = Vector2.new(offset.X, offset.Z).Magnitude
		if flat > PORTAL_RADIUS or math.abs(offset.Y) > 12 then
			portalArmed = true -- must step off and back on to trigger again
		elseif Theme.IsModalOpen() then
			-- Looking at a dialog (shop, purchase, ...): never yank the player
			-- into a run. Step off and back on once the dialog is closed.
			portalArmed = false
		elseif portalArmed and os.clock() >= portalCooldownUntil then
			portalArmed = false
			portalCooldownUntil = os.clock() + PORTAL_COOLDOWN
			task.spawn(function()
				RunnerController:OpenPrepare()
			end)
		end
	end)
end

return RunnerController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopController (client)
	Everything the player sees of the SHOP system:

		* HUD card "Shop" (🛒, pink header) -> UI/ShopUI panel (Vehicles / Boosts)
		* HUD card "Ride" (🚙, only when a vehicle is equipped) -> Net "ToggleRide".
		  Its title switches to "Get off" while riding (Player attribute "Riding").
		* HUD status chip "2x CASH 12:30" while a 2x boost runs. It counts down
		  locally every second and is corrected by every data Sync / "Timer" event.
		* Random boost offers on the home map (World/BoostOfferVisuals). Walking
		  into one opens Theme.PurchaseDialog (Robux or cash) ->
		  Net.Request("BuyBoostOffer", offerId, route). It does not open while
		  another Theme dialog/panel or the inventory is open (the offer then
		  re-triggers when you walk into it again). Time skips show what they
		  pay you now (ShopUI.BoostPricing: Economy.TimeSkipPayout of your shops) and the full value
		  with every shop staffed; their cash price is 80% of the first.
		  Every dialog/panel opened here uses Context = "Base" (closed by the
		  HUD when you leave the base).

	Server events it listens to:
		"Boost"   "Offer" / "OfferGone" / "Timer"   (BoostService)
		"Shop"    "Purchased"                       (ShopService, Robux receipts)
	It sends Net.FireServer("Boost", "Ready") once so the server re-sends any
	offers that appeared before this script was listening.

	Public API (other controllers):
		ShopController.Priority = 10
		ShopController:Init(registry)
		ShopController:Start()
		ShopController:OpenShop(tab: string?)    -- "Vehicles" (default) | "Boosts"
		ShopController:GetBoostSeconds(): number -- 2x seconds left (local estimate)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local ShopUI = require(Client.UI.ShopUI)
local InventoryUI = require(Client.UI.InventoryUI)
local BoostOfferVisuals = require(Client.World.BoostOfferVisuals)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local P = Config.Palette
local player = Players.LocalPlayer

local ShopController = {}
ShopController.Priority = 10

local registry: { [string]: any } = {}

-- Requests still waiting for the server (stops double clicks).
local pending: { [string]: boolean } = {}

-- 2x timer: seconds left at the moment `boostSyncedAt` (os.clock()).
local boostSeconds = 0
local boostSyncedAt = os.clock()

-- The boost-offer dialog that is open right now (if any).
local offerDialog: { offerId: string, close: () -> () }? = nil

local rideButton: TextButton? = nil

local boostById: { [string]: Config.BoostDef } = {}
for _, def in Config.Boosts do
	boostById[def.id] = def
end

local function request(key: string, action: string, ...: any): Net.Result?
	if pending[key] then
		return nil
	end
	pending[key] = true
	local result = Net.Request(action, ...)
	pending[key] = nil
	if not result.ok then
		Theme.Toast(tostring(result.err or "Something went wrong"), "error")
	end
	return result
end

function ShopController:GetBoostSeconds(): number
	return math.max(0, boostSeconds - (os.clock() - boostSyncedAt))
end

local function setBoostSeconds(seconds: any)
	if type(seconds) == "number" and seconds == seconds then
		boostSeconds = math.max(0, seconds)
		boostSyncedAt = os.clock()
	end
end

-------------------------------------------------------------------------------
-- Boost offers
-------------------------------------------------------------------------------

local function closeOfferDialog(offerId: string?)
	local dialog = offerDialog
	if dialog and (offerId == nil or dialog.offerId == offerId) then
		offerDialog = nil
		dialog.close()
	end
end

local function offerDescription(def: Config.BoostDef, preview: number?, value: number): string
	if def.kind == "multiplier" then
		return ("Doubles ALL cash you earn (runs, shops, combat) for %d minutes of play time. Adds to any time you already have.\nWorth about %s if you keep playing."):format(
			def.minutes or 0,
			Format.Money(value)
		)
	end
	local now = preview or 0
	if now >= value then
		return ("Instantly collects %d hours of your shops' revenue. Shops with an employee pay the whole time, the others until their stock runs out.\nPays %s now."):format(
			def.hours or 0,
			Format.Money(now)
		)
	end
	return ("Instantly collects %d hours of your shops' revenue. Shops with an employee pay the whole time, the others until their stock runs out.\nPays %s now (up to %s when every shop has an employee)."):format(
		def.hours or 0,
		Format.Money(now),
		Format.Money(value)
	)
end

-- Returns true when the dialog opened. false = refused (another dialog, the
-- shop or the inventory is open, ...): BoostOfferVisuals then re-arms the
-- offer so walking into it again retries.
local function openOfferDialog(offer: BoostOfferVisuals.Offer): boolean
	if offerDialog or State.Mode() ~= "Base" or ShopUI.IsOpen() or Theme.IsModalOpen() or InventoryUI.IsOpen() then
		return false
	end
	local data = State.Get()
	local def = boostById[offer.boostId]
	if not data or not def then
		return false
	end
	-- Display only: the server prices the boost again when you buy it.
	local price, preview, value = ShopUI.BoostPricing(def, data)
	local productId = Config.ProductIds[def.id] or 0
	local offerId = offer.id
	local close = Theme.PurchaseDialog({
		Title = def.name,
		Description = offerDescription(def, preview, value),
		RobuxPrice = def.robux,
		RobuxEnabled = productId ~= 0,
		CashPrice = price,
		CashAffordable = price > 0 and data.cash + 1e-6 >= price,
		Footnote = if def.kind == "timeskip"
			then "Cash price = 80% of what it pays (never more than 80% of its full value), so you get +25% back"
			else "Cash price = 80% of its value: buying with cash still pays back +25% if you use it fully",
		Context = "Base",
		OnClose = function()
			if offerDialog and offerDialog.offerId == offerId then
				offerDialog = nil
			end
		end,
		OnRobux = function()
			request("offer:" .. offerId, "BuyBoostOffer", offerId, "robux")
		end,
		OnCash = function()
			local result = request("offer:" .. offerId, "BuyBoostOffer", offerId, "cash", price)
			if result and result.ok then
				BoostOfferVisuals.Remove(offerId)
			end
		end,
	})
	offerDialog = { offerId = offerId, close = close }
	return true
end

local function onBoostEvent(msg: any, payload: any)
	if type(payload) ~= "table" then
		return
	end
	if msg == "Offer" then
		BoostOfferVisuals.Add(payload)
	elseif msg == "OfferGone" then
		if type(payload.id) == "string" then
			BoostOfferVisuals.Remove(payload.id)
			closeOfferDialog(payload.id)
		end
	elseif msg == "Timer" then
		setBoostSeconds(payload.seconds)
	end
end

-------------------------------------------------------------------------------
-- Shop panel
-------------------------------------------------------------------------------

local function buyVehicle(vehicleId: string, route: string)
	-- The server shows the "You got the ..." toast once the vehicle is granted
	-- (right away for cash, after the Roblox window for Robux).
	request("vehicle:" .. vehicleId, "BuyVehicle", vehicleId, route)
end

local function equipVehicle(vehicleId: string)
	local result = request("equip", "EquipVehicle", vehicleId)
	if result and result.ok then
		Theme.Toast("🚙 Vehicle equipped! Use the Ride button to drive it.", "success")
	end
end

function ShopController:OpenShop(tab: string?)
	if State.Mode() ~= "Base" then
		Theme.Toast("The shop is open in your base", "error")
		return
	end
	closeOfferDialog(nil)
	ShopUI.Open({
		Tab = tab,
		OnBuyVehicle = buyVehicle,
		OnEquipVehicle = equipVehicle,
		GetBoostSeconds = function(): number
			return ShopController:GetBoostSeconds()
		end,
	})
end

-------------------------------------------------------------------------------
-- Ride button
-------------------------------------------------------------------------------

local function updateRideTitle()
	local button = rideButton
	if not button then
		return
	end
	local title = button:FindFirstChild("Title", true)
	if title and title:IsA("TextLabel") then
		title.Text = if player:GetAttribute("Riding") == true then "Get off" else "Ride"
	end
end

local function toggleRide()
	if State.Mode() ~= "Base" and player:GetAttribute("Riding") ~= true then
		Theme.Toast("You can only ride in your base", "error")
		return
	end
	request("ride", "ToggleRide")
end

-------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------

function ShopController:Init(reg: { [string]: any })
	registry = reg
end

function ShopController:Start()
	local hud = registry.HUDController

	local data = State.Get()
	if data then
		setBoostSeconds(data.boosts.multiplierSeconds)
	end

	if hud and type(hud.AddMenuButton) == "function" then
		hud:AddMenuButton({
			Id = "Shop",
			Title = "Shop",
			Icon = "🛒",
			Order = 4,
			HeaderColor = P.CardPink,
			HeaderDarkColor = P.CardPinkDark,
			OnClick = function()
				ShopController:OpenShop(nil)
			end,
		})
		rideButton = hud:AddMenuButton({
			Id = "Ride",
			Title = "Ride",
			Icon = "🚙",
			Order = 5,
			OnClick = toggleRide,
			Visible = function(snapshot: any): boolean
				local equipped = snapshot.vehicles and snapshot.vehicles.equipped
				return equipped ~= nil and snapshot.vehicles.owned[equipped] == true
			end,
		})
		updateRideTitle()
	end

	-- 2x status chip.
	local chip = if hud and type(hud.AddStatusChip) == "function"
		then hud:AddStatusChip("Boost2x", P.OfferPurple)
		else nil
	local function updateChip()
		if not chip then
			return
		end
		local seconds = ShopController:GetBoostSeconds()
		if seconds > 0 then
			chip.SetText("2x CASH " .. Format.Clock(seconds))
			chip.SetVisible(true)
		else
			chip.SetVisible(false)
		end
	end
	updateChip()
	task.spawn(function()
		while true do
			task.wait(1)
			updateChip()
		end
	end)

	State.Changed:Connect(function(snapshot)
		setBoostSeconds(snapshot.boosts.multiplierSeconds)
		updateChip()
		ShopUI.Refresh()
	end)
	State.ModeChanged:Connect(function(newMode: string)
		if newMode ~= "Base" then
			closeOfferDialog(nil)
			ShopUI.Close()
		end
	end)
	player:GetAttributeChangedSignal("Riding"):Connect(updateRideTitle)

	-- Boost offers.
	BoostOfferVisuals.Start({ OnApproach = openOfferDialog })
	Net.On("Boost", onBoostEvent)
	Net.On("Shop", function(msg: any)
		if msg == "Purchased" then
			ShopUI.Refresh()
		end
	end)
	-- Ask for offers that were sent before we were listening.
	pcall(function()
		Net.FireServer("Boost", "Ready")
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point.
	Every ModuleScript directly inside Client/Controllers is a controller:
		Controller.Priority (optional, higher = initialised first)
		Controller:Init(registry)  -- build UI, local state (no cross-controller calls)
		Controller:Start()         -- connect events, may call other controllers
	`registry` maps controller name -> controller table.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local clientFolder = script.Parent

-- Wait until the server has loaded our data (first Sync arrives right after).
local State = require(clientFolder:WaitForChild("State"))
State.Wait()

local controllersFolder = clientFolder:WaitForChild("Controllers")
local registry: { [string]: any } = {}
local ordered = {}

for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, controller = pcall(require, module)
		if ok and type(controller) == "table" then
			registry[module.Name] = controller
			table.insert(ordered, { name = module.Name, controller = controller })
		else
			warn(("[Client] failed to load %s: %s"):format(module.Name, tostring(controller)))
		end
	end
end

table.sort(ordered, function(a, b)
	local pa, pb = a.controller.Priority or 0, b.controller.Priority or 0
	if pa ~= pb then
		return pa > pb
	end
	return a.name < b.name
end)

for _, entry in ordered do
	if type(entry.controller.Init) == "function" then
		local ok, err = pcall(entry.controller.Init, entry.controller, registry)
		if not ok then
			warn(("[Client] %s:Init failed: %s"):format(entry.name, tostring(err)))
		end
	end
end

for _, entry in ordered do
	if type(entry.controller.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(entry.controller.Start, entry.controller)
			if not ok then
				warn(("[Client] %s:Start failed: %s"):format(entry.name, tostring(err)))
			end
		end)
	end
end

print(("[Client] %s started %d controllers"):format(player.Name, #ordered))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
--[[
	State (client)
	Latest PlayerData snapshot pushed by the server's DataService.

		local State = require(Client.State)
		State.Get()                -- PlayerData? (read-only, never mutate)
		State.Wait()               -- yields until the first snapshot
		State.Changed:Connect(function(data) ... end)
		State.Mode()               -- "Base" | "Runner" | "Combat"
		State.ModeChanged:Connect(function(newMode, oldMode) ... end)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Types = require(Shared.Types)

local player = Players.LocalPlayer

local State = {}
State.Changed = Signal.new()
State.ModeChanged = Signal.new()

local data: Types.PlayerData? = nil
local currentMode: string = (player:GetAttribute("Mode") :: string?) or "Base"

Net.On("Sync", function(snapshot: Types.PlayerData)
	data = snapshot
	State.Changed:Fire(snapshot)
end)

player:GetAttributeChangedSignal("Mode"):Connect(function()
	local old = currentMode
	currentMode = (player:GetAttribute("Mode") :: string?) or "Base"
	if old ~= currentMode then
		State.ModeChanged:Fire(currentMode, old)
	end
end)

function State.Get(): Types.PlayerData?
	return data
end

function State.Wait(): Types.PlayerData
	if not data then
		task.spawn(function()
			-- Ask again in case the first push happened before we listened.
			while not data do
				Net.Request("RequestSync")
				task.wait(2)
			end
		end)
	end
	while not data do
		State.Changed:Wait()
	end
	return data :: Types.PlayerData
end

function State.Mode(): string
	return currentMode
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="53">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">ChestUI</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ChestUI (client, plain module — not a controller)
	Full-screen chest opening animation shown after every combat game:
		1. a chest drawn from Frames (wood brown / silver / gold) drops in,
		2. it shakes three times (harder each time),
		3. the lid flies off with a white flash,
		4. rotating light rays appear in the colour of the item's rarity,
		5. the item card is revealed (rarity border, icon, name, rarity,
		   key stats, perks) with a big green COLLECT button.
	Tap anywhere during steps 1-4 to skip straight to the reveal.
	If several chests are played at once they are shown one after another.
	No image assets: everything is Frames, UIStroke/UIGradient and emoji.

	API:
		ChestUI.Play(chestTier: string, item: Item, onDone: (() -> ())?)
			chestTier = "wood" | "silver" | "gold" (anything else looks like wood)
			onDone is called once, after COLLECT is pressed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local EquipmentDefs = require(Shared.Combat.EquipmentDefs)
local Types = require(Shared.Types)

type Item = Types.Item

local P = Theme.Palette

local ChestUI = {}

type Job = { tier: string, item: any, onDone: (() -> ())? }
local queue: { Job } = {}
local playing = false

-- Colours per chest tier: main, dark (shading / bands), trim (corner metal).
local TIER_LOOK = {
	wood = { main = P.Wood, dark = Theme.Darken(P.Wood, 0.35), trim = P.ButtonGreyDark, title = "WOODEN CHEST" },
	silver = {
		main = Theme.Lighten(P.ButtonGrey, 0.35),
		dark = P.ButtonGreyDark,
		trim = P.White,
		title = "SILVER CHEST",
	},
	gold = { main = P.Coin, dark = P.CoinDark, trim = P.CoinShine, title = "GOLDEN CHEST" },
}

local function box(name: string, parent: Instance, color: Color3, size: UDim2, position: UDim2, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Size = size
	f.Position = position
	f.AnchorPoint = anchor or Vector2.zero
	f.Parent = parent
	return f
end

-- Builds the chest. Returns (chest group, lid).
local function buildChest(parent: Instance, look: { main: Color3, dark: Color3, trim: Color3 }): (Frame, Frame)
	local chest =
		box("Chest", parent, P.White, UDim2.fromOffset(230, 190), UDim2.fromScale(0.5, -0.6), Vector2.new(0.5, 0.5))
	chest.BackgroundTransparency = 1

	-- Body (bottom part)
	local body = box("Body", chest, look.main, UDim2.new(1, 0, 0.6, 0), UDim2.fromScale(0, 0.4))
	Theme.Corner(body, 14)
	Theme.Stroke(body, P.CardOutline, 4, true)
	Theme.Gradient(body, Theme.Lighten(look.main, 0.15), look.dark)
	-- planks
	box("Plank", body, look.dark, UDim2.new(1, -24, 0, 4), UDim2.new(0, 12, 0.5, -2)).BackgroundTransparency = 0.3
	-- metal corner bands
	for _, x in { 0.08, 0.92 } do
		local band = box("Band", body, look.trim, UDim2.new(0, 22, 1, 0), UDim2.fromScale(x, 0), Vector2.new(0.5, 0))
		Theme.Stroke(band, P.CardOutline, 2, true)
	end

	-- Lid (top part, flies off)
	local lid =
		box("Lid", chest, look.main, UDim2.new(1.04, 0, 0.44, 0), UDim2.fromScale(0.5, 0.46), Vector2.new(0.5, 1))
	lid.ZIndex = 3
	Theme.Corner(lid, 22)
	Theme.Stroke(lid, P.CardOutline, 4, true)
	Theme.Gradient(lid, Theme.Lighten(look.main, 0.25), look.main)
	local rim = box("Rim", lid, look.dark, UDim2.new(1, 0, 0, 12), UDim2.new(0, 0, 1, -12))
	rim.ZIndex = 3
	for _, x in { 0.08, 0.92 } do
		local band = box("Band", lid, look.trim, UDim2.new(0, 22, 1, 0), UDim2.fromScale(x, 0), Vector2.new(0.5, 0))
		band.ZIndex = 3
		Theme.Stroke(band, P.CardOutline, 2, true)
	end

	-- Gold lock plate with a keyhole
	local lock =
		box("Lock", chest, P.Padlock, UDim2.fromOffset(44, 50), UDim2.fromScale(0.5, 0.46), Vector2.new(0.5, 0.35))
	lock.ZIndex = 4
	Theme.Corner(lock, 10)
	Theme.Stroke(lock, P.CardOutline, 3, true)
	local keyhole =
		box("Keyhole", lock, P.CardOutline, UDim2.fromOffset(10, 18), UDim2.fromScale(0.5, 0.55), Vector2.new(0.5, 0.5))
	keyhole.ZIndex = 5
	Theme.Corner(keyhole, 0.5)

	local scale = Instance.new("UIScale")
	scale.Name = "ShakeScale"
	scale.Parent = chest
	return chest, lid
end

-- Rotating light rays (+ a soft glow in the middle).
local function buildRays(parent: Instance, color: Color3): Frame
	local rays =
		box("Rays", parent, color, UDim2.fromOffset(640, 640), UDim2.fromScale(0.5, 0.45), Vector2.new(0.5, 0.5))
	rays.BackgroundTransparency = 1
	rays.Visible = false
	local count = 8 -- 8 full-width beams = 16 rays
	for i = 0, count - 1 do
		local beam = box("Beam", rays, color, UDim2.new(0, 54, 1, 0), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
		beam.Rotation = i * (180 / count)
		beam.BackgroundTransparency = 0
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.8),
			NumberSequenceKeypoint.new(0.5, 0.25),
			NumberSequenceKeypoint.new(0.7, 0.8),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = beam
	end
	for _, spec in { { size = 330, alpha = 0.75 }, { size = 200, alpha = 0.45 } } do
		local glow = box(
			"Glow",
			rays,
			color,
			UDim2.fromOffset(spec.size, spec.size),
			UDim2.fromScale(0.5, 0.5),
			Vector2.new(0.5, 0.5)
		)
		glow.BackgroundTransparency = spec.alpha
		Theme.Corner(glow, 0.5)
	end
	local scale = Instance.new("UIScale")
	scale.Scale = 0.2
	scale.Parent = rays
	return rays
end

-- The reveal card. Returns the card frame.
local function buildCard(parent: Instance, item: any): Frame
	local clean = EquipmentDefs.SanitizeItem(item)
	local def = if clean then EquipmentDefs.Items[clean.id] else nil
	local rarity = if clean then clean.rarity else 1
	local color = Theme.RarityColor(rarity)

	local card = box(
		"ItemCard",
		parent,
		P.CardBlueDark,
		UDim2.fromOffset(360, 440),
		UDim2.new(0.5, 0, 0, 58),
		Vector2.new(0.5, 0)
	)
	card.ZIndex = 10
	card.Visible = false
	Theme.Corner(card, 18)
	local stroke = Theme.Stroke(card, color, 6, true)
	stroke.Name = "RarityBorder"
	local fill = box("Fill", card, P.CardBlue, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	fill.ZIndex = 10
	Theme.Corner(fill, 18)
	Theme.Gradient(fill, Theme.Lighten(P.CardBlue, 0.1), P.CardBlueDark)

	-- Rarity header strip
	local header = box("Header", card, color, UDim2.new(1, 0, 0, 52), UDim2.fromScale(0, 0))
	header.ZIndex = 11
	Theme.Corner(header, 18)
	Theme.Gradient(header, Theme.Lighten(color, 0.2), Theme.Darken(color, 0.15))
	Theme.Label({
		Text = Theme.RarityName(rarity):upper() .. "!",
		MaxTextSize = 34,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 12,
		Parent = header,
	})

	-- Icon on a rarity-glow circle
	local iconBack =
		box("IconBack", card, color, UDim2.fromOffset(120, 120), UDim2.new(0.5, 0, 0, 62), Vector2.new(0.5, 0))
	iconBack.ZIndex = 11
	iconBack.BackgroundTransparency = 0.55
	Theme.Corner(iconBack, 0.5)
	Theme.Stroke(iconBack, color, 3, true)
	Theme.Label({
		Text = if def then def.icon else "❓",
		MaxTextSize = 84,
		StrokeThickness = 0,
		Size = UDim2.fromScale(0.86, 0.86),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 12,
		Parent = iconBack,
	})

	Theme.Label({
		Text = if def then def.name else "Unknown item",
		MaxTextSize = 34,
		Size = UDim2.new(1, -24, 0, 38),
		Position = UDim2.new(0.5, 0, 0, 186),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 12,
		Parent = card,
	})
	Theme.Label({
		Text = Theme.RarityName(rarity)
			.. (if def then (if def.slot == "weapon" then " Weapon" else " Armour") else "")
			.. "  ·  Lv "
			.. tostring(if clean then clean.level else 1),
		MaxTextSize = 22,
		TextColor3 = color,
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 224),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 12,
		Parent = card,
	})

	local list = box("Lines", card, P.White, UDim2.new(1, -32, 0, 176), UDim2.new(0.5, 0, 0, 254), Vector2.new(0.5, 0))
	list.BackgroundTransparency = 1
	list.ZIndex = 11
	Theme.List(list, "Vertical", 2, Enum.HorizontalAlignment.Left)
	local order = 0
	local function line(text: string, textColor: Color3?, maxSize: number)
		order += 1
		Theme.Label({
			Text = text,
			MaxTextSize = maxSize,
			TextColor3 = textColor or P.White,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 22),
			LayoutOrder = order,
			ZIndex = 12,
			Parent = list,
		})
	end
	if clean then
		local stats = EquipmentDefs.ItemStatsText(clean)
		for i = 1, math.min(4, #stats) do
			line(stats[i], nil, 19)
		end
		for _, perk in EquipmentDefs.ItemPerks(clean) do
			line(
				perk.icon .. " " .. perk.name,
				if perk.source == "signature" then Theme.RarityColor(#Config.Rarities) else P.PriceGold,
				18
			)
		end
	end
	return card
end

-------------------------------------------------------------------------------
-- One chest
-------------------------------------------------------------------------------
local function playOne(job: Job)
	local look = TIER_LOOK[job.tier] or TIER_LOOK.wood
	local clean = EquipmentDefs.SanitizeItem(job.item)
	local rarityColor = Theme.RarityColor(if clean then clean.rarity else 1)
	local rarity = if clean then clean.rarity else 1

	local gui = Theme.ScreenGui("ChestReveal", 70)
	local root = Instance.new("TextButton")
	root.Name = "ChestOverlay"
	root.Text = ""
	root.AutoButtonColor = false
	root.BackgroundColor3 = P.Shade
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = 1
	root.Parent = gui

	local stage =
		box("Stage", root, P.White, UDim2.fromOffset(560, 640), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	stage.BackgroundTransparency = 1
	stage.ZIndex = 2
	Theme.ResponsiveScale(stage, 760)

	local title = Theme.Label({
		Text = look.title,
		MaxTextSize = 44,
		TextColor3 = look.main,
		StrokeThickness = 4,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 20,
		Parent = stage,
	})

	local rays = buildRays(stage, rarityColor)
	local chest, lid = buildChest(stage, look)
	rays.ZIndex = 1 -- rays behind the chest, card on top of both
	chest.ZIndex = 2
	local card = buildCard(stage, job.item)

	local skip = false
	local finished = false
	local connections: { RBXScriptConnection } = {}

	table.insert(
		connections,
		root.Activated:Connect(function()
			skip = true
		end)
	)
	table.insert(
		connections,
		RunService.RenderStepped:Connect(function(dt: number)
			if rays.Visible then
				rays.Rotation = (rays.Rotation + dt * 28) % 360
			end
		end)
	)

	-- Waits t seconds, but stops early when the player taps to skip.
	local function pause(t: number)
		local started = os.clock()
		while os.clock() - started < t and not skip and root.Parent do
			task.wait()
		end
	end

	-- 1. fade in + drop
	Theme.Tween(root, { BackgroundTransparency = 0.3 }, 0.25)
	Theme.Tween(chest, { Position = UDim2.fromScale(0.5, 0.45) }, 0.75, Enum.EasingStyle.Bounce)
	pause(0.85)

	-- 2. three shakes, each a little harder
	local shakeScale = chest:FindFirstChild("ShakeScale") :: UIScale?
	for i = 1, 3 do
		if skip then
			break
		end
		local angle = 5 + i * 4
		if shakeScale then
			shakeScale.Scale = 1 + 0.04 * i
			Theme.Tween(shakeScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		end
		Theme.Tween(chest, { Rotation = angle }, 0.06)
		pause(0.06)
		Theme.Tween(chest, { Rotation = -angle }, 0.12)
		pause(0.12)
		Theme.Tween(chest, { Rotation = 0 }, 0.08)
		pause(0.38)
	end

	-- 3. lid flies off with a flash
	local flash = box("Flash", root, P.White, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	flash.ZIndex = 30
	flash.BackgroundTransparency = 0.15
	Theme.Tween(flash, { BackgroundTransparency = 1 }, 0.55)
	task.delay(0.6, function()
		flash:Destroy()
	end)
	chest.Rotation = 0
	Theme.Tween(lid, { Position = UDim2.new(0.5, 90, -2.5, 0), Rotation = -50 }, 0.6, Enum.EasingStyle.Quad)

	-- 4. rays
	rays.Visible = true
	local rayScale = rays:FindFirstChildOfClass("UIScale")
	if rayScale then
		Theme.Tween(rayScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
	end
	pause(0.7)

	-- 5. reveal
	if shakeScale then
		Theme.Tween(shakeScale, { Scale = 0 }, 0.2)
	end
	task.delay(0.22, function()
		if chest.Parent then
			chest.Visible = false
		end
	end)
	title.Visible = false
	card.Visible = true
	Theme.Pop(card)

	local collected = false
	local button = Theme.Button({
		Name = "Collect",
		Text = "COLLECT",
		Color = P.ButtonGreen,
		DarkColor = P.ButtonGreenDark,
		MaxTextSize = 34,
		Size = UDim2.fromOffset(250, 72),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 25,
		OnClick = function()
			collected = true
		end,
		Parent = stage,
	})
	button.ZIndex = 25
	Theme.Pop(button)

	-- Sparkles for Epic / Legendary drops
	local sparkleTimer = 0
	if rarity >= 4 then
		table.insert(
			connections,
			RunService.RenderStepped:Connect(function(dt: number)
				sparkleTimer -= dt
				if sparkleTimer > 0 or finished then
					return
				end
				sparkleTimer = if rarity >= 5 then 0.15 else 0.3
				local spark = Theme.Label({
					Text = "✨",
					MaxTextSize = 40,
					StrokeThickness = 0,
					Size = UDim2.fromOffset(40, 40),
					Position = UDim2.fromScale(math.random() * 0.9 + 0.05, math.random() * 0.75 + 0.05),
					AnchorPoint = Vector2.new(0.5, 0.5),
					ZIndex = 24,
					Parent = stage,
				})
				Theme.Pop(spark)
				Theme.Tween(spark, { TextTransparency = 1 }, 0.9)
				task.delay(0.95, function()
					spark:Destroy()
				end)
			end)
		)
	end

	-- 6. wait for COLLECT (or the overlay being removed)
	while not collected and root.Parent do
		task.wait(0.05)
	end

	-- 7. clean up
	finished = true
	for _, connection in connections do
		connection:Disconnect()
	end
	Theme.Tween(root, { BackgroundTransparency = 1 }, 0.15)
	task.wait(0.05)
	root:Destroy()
end

local function runQueue()
	if playing then
		return
	end
	playing = true
	while #queue > 0 do
		local job = table.remove(queue, 1) :: Job
		local ok, err = pcall(function()
			playOne(job)
		end)
		if not ok then
			warn("[ChestUI] animation failed: " .. tostring(err))
			-- remove any half-built overlay
			local gui = Theme.ScreenGui("ChestReveal", 70)
			for _, child in gui:GetChildren() do
				child:Destroy()
			end
		end
		local onDone = job.onDone
		if onDone then
			task.spawn(onDone)
		end
	end
	playing = false
end

function ChestUI.Play(chestTier: string, item: Item, onDone: (() -> ())?)
	table.insert(queue, {
		tier = if type(chestTier) == "string" then chestTier else "wood",
		item = item,
		onDone = onDone,
	})
	task.spawn(runQueue)
end

return ChestUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">CombatUI</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CombatUI (client, plain module)
	Every screen of the combat mode, built with Theme (same look as the rest of
	the game: chunky outlined text, orange/blue cards, black banners).

	API:
		CombatUI.OpenArenaMenu({ highestLevel, onFight = function(level) end, onClose? }) -> close()
			Level select for the repeatable Combat Arena: levels 1..highestLevel+1,
			difficulty skulls, cash reward, chest, "FIGHT".
		CombatUI.ConfirmBarrier({ level, nextAreaName, reward, onConfirm, onClose? }) -> close()
			Both are "Base" dialogs (Theme Context = "Base"): opening one again
			replaces the old copy, and the HUD closes them when you leave the base.
		CombatUI.LobbyBar({ onInventory, onStart, onLeave }) -> { Destroy: () -> () }
			Small bar shown before round 1: [Inventory] [Start] [Leave].
		CombatUI.Hud({ level, mode, nextAreaName, waveCount, onLeave }) -> Hud
			The wave banner and the Leave button sit below Roblox's top bar
			(Theme.TopInset(), updated when the top bar changes size).
			Hud.SetWave(wave, waveCount)       black "WAVE 2/5" banner
			Hud.Countdown(startsAt, wave, boss) big 3-2-1 / "WAVE 2" / "BOSS!" in the middle
			Hud.SetCash(amount)                 lime money tag above your character
			Hud.SetVitals(hp, maxHp, shield)    HP bar above your character + bottom bar
			Hud.SetCharacter(character)         (re)attach the billboard above the avatar
			Hud.Hint(text, seconds?)            small tip above the HP bar
			Hud.Hurt()                          red screen flash
			Hud.SetFightVisible(visible)        hide the fight HUD on the result screen
			Hud.Destroy()
		CombatUI.AbilityChoice({ options, timeout, onPick = function(id) end }) -> close()
			Three Theme cards (icon, name, description, stacks, "PICK") + timer.
		CombatUI.Result({ result, onChest = function(done) end, onContinue }) -> close()
			VICTORY / DEFEAT, cash earned, then the chest, then "CONTINUE".
			A defeat without a chest explains how to earn one (CombatDefs.ChestTier).
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatDefs = require(Shared.Combat.CombatDefs)
local Format = require(Shared.Format)

local P = Theme.Palette

local CombatUI = {}

local MAX_MENU_LEVELS = 60 -- how many levels the arena menu lists (newest first)

local function getGui(): ScreenGui
	return Theme.ScreenGui("CombatUI", 30)
end

local CHEST_NAMES = { wood = "Wooden chest", silver = "Silver chest", gold = "Gold chest" }
local CHEST_ICONS = { wood = "📦", silver = "🎁", gold = "👑" }

-------------------------------------------------------------------------------
-- Arena level select
-------------------------------------------------------------------------------
export type ArenaMenuOptions = {
	highestLevel: number,
	onFight: (level: number) -> (),
	onClose: (() -> ())?, -- called once when the menu closes (any reason)
}

function CombatUI.OpenArenaMenu(opts: ArenaMenuOptions): () -> ()
	local _, content, close = Theme.Panel({
		Name = "ArenaMenu",
		Context = "Base",
		Title = "⚔️ Combat Arena",
		HeaderColor = P.ButtonRed,
		HeaderDarkColor = P.ButtonRedDark,
		Size = UDim2.fromOffset(620, 520),
		OnClose = opts.onClose,
	})
	Theme.List(content, "Vertical", 8)

	Theme.Label({
		Text = "Stand still to shoot • Move to dodge • Win chests with armour & weapons",
		MaxTextSize = 20,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 1,
		ZIndex = 13,
		Parent = content,
	})

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Levels"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.new(1, 0, 1, -40)
	scroll.LayoutOrder = 2
	scroll.ZIndex = 13
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = P.White
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.Parent = content
	Theme.List(scroll, "Vertical", 8)
	Theme.Padding(scroll, 4)

	local highest = math.max(0, math.floor(opts.highestLevel))
	local top = highest + 1
	local bottom = math.max(1, top - MAX_MENU_LEVELS + 1)
	local order = 0
	for level = top, bottom, -1 do
		order += 1
		local isNew = level == top
		local boss = CombatDefs.HasBoss(level, "arena")
		local row = Instance.new("Frame")
		row.Name = "Level" .. level
		row.BackgroundColor3 = if isNew then P.CardOrange else P.CardBlueDark
		row.Size = UDim2.new(1, -12, 0, 64)
		row.LayoutOrder = order
		row.ZIndex = 14
		row.Parent = scroll
		Theme.Corner(row, 12)
		Theme.Stroke(row, P.CardOutline, 2, true)

		Theme.Label({
			Text = ("Level %d%s"):format(level, if boss then " 👑" else ""),
			MaxTextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0.3, 0, 0.6, 0),
			Position = UDim2.new(0, 12, 0, 4),
			ZIndex = 15,
			Parent = row,
		})
		local skulls = string.rep("💀", CombatDefs.DifficultySkulls(level))
		Theme.Label({
			Text = (if isNew then "NEW  " else "✔ ") .. skulls,
			MaxTextSize = 18,
			StrokeThickness = 0,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0.3, 0, 0.35, 0),
			Position = UDim2.new(0, 12, 0.6, 0),
			ZIndex = 15,
			Parent = row,
		})
		local plan = CombatDefs.LevelPlan(level, "arena")
		local chest = if boss then "gold" else "silver"
		Theme.Label({
			Text = ("%s  %s  •  %d waves"):format(Format.Money(plan.reward), CHEST_ICONS[chest], plan.waveCount),
			TextColor3 = P.PriceGold,
			MaxTextSize = 24,
			Size = UDim2.new(0.42, 0, 0.7, 0),
			Position = UDim2.new(0.31, 0, 0.15, 0),
			ZIndex = 15,
			Parent = row,
		})
		local fight = Theme.Button({
			Text = "FIGHT",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.new(0.24, 0, 0, 50),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			ZIndex = 16,
			MaxTextSize = 24,
			OnClick = function()
				close()
				opts.onFight(level)
			end,
			Parent = row,
		})
		fight.ZIndex = 16
	end
	return close
end

-------------------------------------------------------------------------------
-- Barrier confirm
-------------------------------------------------------------------------------
export type BarrierOptions = {
	level: number,
	nextAreaName: string,
	reward: number,
	onConfirm: () -> (),
	onClose: (() -> ())?, -- called once when the dialog closes (also right before onConfirm)
}

function CombatUI.ConfirmBarrier(opts: BarrierOptions): () -> ()
	return Theme.Confirm({
		Name = "BarrierConfirm",
		Context = "Base",
		Title = "🛡️ Barrier Squad",
		Body = ("Defeat the squad guarding %s!\nLevel %d • 4 waves • Officer boss\nUp to %s + a gold chest"):format(
			opts.nextAreaName,
			opts.level,
			Format.Money(opts.reward)
		),
		ConfirmText = "FIGHT!",
		OnConfirm = opts.onConfirm,
		OnClose = opts.onClose,
	})
end

-------------------------------------------------------------------------------
-- Lobby bar (before the first round)
-------------------------------------------------------------------------------
export type LobbyOptions = { onInventory: () -> (), onStart: () -> (), onLeave: () -> () }

function CombatUI.LobbyBar(opts: LobbyOptions): { Destroy: () -> () }
	local gui = getGui()
	local bar = Instance.new("Frame")
	bar.Name = "LobbyBar"
	bar.BackgroundColor3 = P.PillBlack
	bar.BackgroundTransparency = 0.1
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -24)
	bar.Size = UDim2.fromOffset(620, 96)
	bar.ZIndex = 5
	bar.Parent = gui
	Theme.Corner(bar, 18)
	Theme.Stroke(bar, P.CardOutline, 3, true)
	Theme.ResponsiveScale(bar)
	Theme.Padding(bar, 12)
	Theme.List(bar, "Horizontal", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	Theme.Button({
		Text = "🎒 Inventory",
		Color = P.CardBlue,
		DarkColor = P.CardBlueDark,
		Size = UDim2.fromOffset(190, 64),
		LayoutOrder = 1,
		ZIndex = 6,
		OnClick = opts.onInventory,
		Parent = bar,
	})
	Theme.Button({
		Text = "⚔️ Start",
		Color = P.ButtonGreen,
		DarkColor = P.ButtonGreenDark,
		Size = UDim2.fromOffset(190, 64),
		LayoutOrder = 2,
		ZIndex = 6,
		OnClick = opts.onStart,
		Parent = bar,
	})
	Theme.Button({
		Text = "Leave",
		Color = P.ButtonRed,
		DarkColor = P.ButtonRedDark,
		Size = UDim2.fromOffset(170, 64),
		LayoutOrder = 3,
		ZIndex = 6,
		OnClick = opts.onLeave,
		Parent = bar,
	})
	Theme.Pop(bar)
	return {
		Destroy = function()
			bar:Destroy()
		end,
	}
end

-------------------------------------------------------------------------------
-- In-fight HUD
-------------------------------------------------------------------------------
export type HudOptions = {
	level: number,
	mode: string,
	nextAreaName: string?,
	waveCount: number,
	onLeave: () -> (),
}

export type Hud = {
	SetWave: (wave: number, waveCount: number) -> (),
	Countdown: (startsAt: number, wave: number, boss: boolean) -> (),
	SetCash: (amount: number) -> (),
	SetVitals: (hp: number, maxHp: number, shield: number) -> (),
	SetCharacter: (character: Model?) -> (),
	Hint: (text: string, seconds: number?) -> (),
	Hurt: () -> (),
	SetFightVisible: (visible: boolean) -> (),
	Destroy: () -> (),
}

local function hpColor(fraction: number): Color3
	if fraction < 0.3 then
		return P.ButtonRed
	elseif fraction < 0.6 then
		return P.Coin
	end
	return P.MoneyGreen
end

function CombatUI.Hud(opts: HudOptions): Hud
	local gui = getGui()
	local root = Instance.new("Frame")
	root.Name = "CombatHud"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui

	-- top centre: black wave banner + level label (below Roblox's top bar:
	-- the CombatUI gui ignores the GUI inset)
	local top = Instance.new("Frame")
	top.Name = "Top"
	top.BackgroundTransparency = 1
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, Theme.TopInset() + 8)
	top.Size = UDim2.fromOffset(320, 90)
	top.Parent = root
	Theme.ResponsiveScale(top)
	local _, setBanner = Theme.Banner({
		Text = "GET READY",
		Size = UDim2.fromOffset(290, 50),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = top,
	})
	local levelText = if opts.mode == "barrier"
		then ("Barrier • Level %d"):format(opts.level)
		else ("Arena • Level %d"):format(opts.level)
	Theme.Label({
		Text = levelText,
		MaxTextSize = 22,
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, 56),
		Parent = top,
	})

	-- top left: retreat button
	local leave = Theme.Button({
		Name = "Leave",
		Text = "🏳️ Leave",
		Color = P.ButtonRed,
		DarkColor = P.ButtonRedDark,
		Size = UDim2.fromOffset(130, 50),
		Position = UDim2.fromOffset(16, Theme.TopInset() + 8),
		MaxTextSize = 22,
		OnClick = opts.onLeave,
		Parent = root,
	})
	Theme.ResponsiveScale(leave) -- reuses the button's own "ThemeScale" UIScale

	-- keep both below the top bar if it changes size
	local insetConnection = GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
		local y = Theme.TopInset() + 8
		top.Position = UDim2.new(0.5, 0, 0, y)
		leave.Position = UDim2.fromOffset(16, y)
	end)

	-- bottom bar: shield + HP bar
	local bottom = Instance.new("Frame")
	bottom.Name = "Bottom"
	bottom.BackgroundColor3 = P.PillBlack
	bottom.BackgroundTransparency = 0.1
	bottom.AnchorPoint = Vector2.new(0.5, 1)
	bottom.Position = UDim2.new(0.5, 0, 1, -20)
	bottom.Size = UDim2.fromOffset(460, 46)
	bottom.Parent = root
	Theme.Corner(bottom, 0.5)
	Theme.Stroke(bottom, P.CardOutline, 2.5, true)
	Theme.ResponsiveScale(bottom)
	local barBack = Instance.new("Frame")
	barBack.Name = "BarBack"
	barBack.BackgroundColor3 = P.Shade
	barBack.AnchorPoint = Vector2.new(0, 0.5)
	barBack.Position = UDim2.new(0, 64, 0.5, 0)
	barBack.Size = UDim2.new(1, -78, 0, 26)
	barBack.Parent = bottom
	Theme.Corner(barBack, 0.5)
	local barFill = Instance.new("Frame")
	barFill.Name = "Fill"
	barFill.BackgroundColor3 = P.MoneyGreen
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.Parent = barBack
	Theme.Corner(barFill, 0.5)
	local barText = Theme.Label({
		Text = "",
		MaxTextSize = 20,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = barBack,
	})
	local shieldText = Theme.Label({
		Text = "❤️",
		MaxTextSize = 26,
		StrokeThickness = 0,
		Size = UDim2.new(0, 56, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Parent = bottom,
	})

	local hint = Theme.Label({
		Text = "",
		MaxTextSize = 24,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -76),
		Size = UDim2.fromOffset(560, 34),
		Visible = false,
		Parent = root,
	})

	-- centre: countdown / wave call-outs
	local center = Theme.Label({
		Text = "",
		MaxTextSize = 96,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromOffset(600, 120),
		StrokeThickness = 5,
		Visible = false,
		Parent = root,
	})

	-- red flash when hurt
	local flash = Instance.new("Frame")
	flash.Name = "Hurt"
	flash.BackgroundColor3 = P.ButtonRed
	flash.BackgroundTransparency = 1
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 0
	flash.Active = false
	flash.Parent = root

	-- billboard above the avatar: lime money tag (image 2) + HP bar
	local board: BillboardGui? = nil
	local tagSetter: ((string) -> ())? = nil
	local miniFill: Frame? = nil
	local miniShield: TextLabel? = nil
	local cashText = Format.Money(0)
	local vitals = { hp = 0, maxHp = 0, shield = 0 }

	local function applyMini()
		local fill = miniFill
		if fill then
			local fraction = if vitals.maxHp > 0 then math.clamp(vitals.hp / vitals.maxHp, 0, 1) else 0
			fill.Size = UDim2.fromScale(fraction, 1)
			fill.BackgroundColor3 = hpColor(fraction)
		end
		local shield = miniShield
		if shield then
			shield.Text = string.rep("🛡️", math.min(3, vitals.shield))
		end
	end

	local countdownToken = 0
	local hintToken = 0
	local hud = {} :: Hud

	function hud.SetWave(wave: number, waveCount: number)
		setBanner(("WAVE %d/%d"):format(math.max(1, wave), waveCount))
	end

	function hud.Countdown(startsAt: number, wave: number, boss: boolean)
		countdownToken += 1
		local token = countdownToken
		hud.SetWave(wave, opts.waveCount)
		center.Visible = true
		task.spawn(function()
			while token == countdownToken do
				local left = startsAt - Workspace:GetServerTimeNow()
				if left > 1.2 and wave == 1 then
					center.Text = tostring(math.ceil(left - 0.2))
					center.TextColor3 = P.White
				elseif left > 0 then
					center.Text = if boss then "⚠️ BOSS WAVE" else ("WAVE %d"):format(wave)
					center.TextColor3 = if boss then P.ButtonRed else P.PriceGold
				elseif left > -0.8 then
					center.Text = "FIGHT!"
					center.TextColor3 = P.MoneyGreen
				else
					center.Visible = false
					break
				end
				task.wait(0.1)
			end
		end)
	end

	function hud.SetCash(amount: number)
		cashText = Format.Money(amount)
		local setter = tagSetter
		if setter then
			setter(cashText)
		end
	end

	function hud.SetVitals(hp: number, maxHp: number, shield: number)
		vitals.hp, vitals.maxHp, vitals.shield = hp, maxHp, shield
		local fraction = if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0
		barFill.Size = UDim2.fromScale(fraction, 1)
		barFill.BackgroundColor3 = hpColor(fraction)
		barText.Text = ("%s / %s"):format(Format.Short(math.ceil(hp)), Format.Short(math.ceil(maxHp)))
		shieldText.Text = if shield > 0 then "🛡️" .. (if shield > 1 then tostring(shield) else "") else "❤️"
		applyMini()
	end

	function hud.SetCharacter(character: Model?)
		if board then
			board:Destroy()
			board = nil
			tagSetter = nil
			miniFill = nil
			miniShield = nil
		end
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			return
		end
		local created = Theme.Billboard({
			Name = "CombatPlayerBar",
			Adornee = rootPart,
			Parent = rootPart,
			Size = UDim2.fromOffset(130, 66),
			StudsOffset = Vector3.new(0, 4.6, 0),
			AlwaysOnTop = true,
			MaxDistance = 250,
		})
		local tag, setText = Theme.MoneyTag({
			Text = cashText,
			Size = UDim2.fromOffset(120, 36),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			MaxTextSize = 24,
			Parent = created,
		})
		tag.Name = "MoneyTag"
		local back = Instance.new("Frame")
		back.Name = "Hp"
		back.BackgroundColor3 = P.PillBlack
		back.AnchorPoint = Vector2.new(0.5, 1)
		back.Position = UDim2.new(0.5, 0, 1, -2)
		back.Size = UDim2.new(0.9, 0, 0, 14)
		back.Parent = created
		Theme.Corner(back, 0.5)
		Theme.Stroke(back, P.CardOutline, 1.5, true)
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.BackgroundColor3 = P.MoneyGreen
		fill.Size = UDim2.fromScale(1, 1)
		fill.Parent = back
		Theme.Corner(fill, 0.5)
		local shieldLabel = Theme.Label({
			Text = "",
			MaxTextSize = 16,
			StrokeThickness = 0,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(0, -2, 0.5, 0),
			Size = UDim2.fromOffset(50, 18),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = back,
		})
		board = created
		tagSetter = setText
		miniFill = fill
		miniShield = shieldLabel
		applyMini()
	end

	function hud.Hint(text: string, seconds: number?)
		hintToken += 1
		local token = hintToken
		hint.Text = text
		hint.Visible = true
		task.delay(seconds or 4, function()
			if token == hintToken then
				hint.Visible = false
			end
		end)
	end

	function hud.Hurt()
		flash.BackgroundTransparency = 0.6
		Theme.Tween(flash, { BackgroundTransparency = 1 }, 0.35)
	end

	function hud.SetFightVisible(visible: boolean)
		top.Visible = visible
		leave.Visible = visible
		bottom.Visible = visible
		if not visible then
			center.Visible = false
			hint.Visible = false
			countdownToken += 1
		end
	end

	function hud.Destroy()
		countdownToken += 1
		hintToken += 1
		insetConnection:Disconnect()
		if board then
			board:Destroy()
			board = nil
		end
		root:Destroy()
	end

	return hud
end

-------------------------------------------------------------------------------
-- Ability pick (1 of 3)
-------------------------------------------------------------------------------
export type AbilityOption = {
	id: string,
	name: string,
	icon: string,
	description: string,
	stacks: number,
	maxStacks: number,
}
export type AbilityChoiceOptions = { options: { AbilityOption }, timeout: number, onPick: (id: string) -> () }

function CombatUI.AbilityChoice(opts: AbilityChoiceOptions): () -> ()
	local gui = Theme.ScreenGui("CombatChoice", 45)
	local shade = Instance.new("Frame")
	shade.Name = "AbilityChoice"
	shade.BackgroundColor3 = P.Shade
	shade.BackgroundTransparency = 0.4
	shade.Size = UDim2.fromScale(1, 1)
	shade.Active = true
	shade.Parent = gui

	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(720, 420)
	holder.Parent = shade
	Theme.ResponsiveScale(holder)

	Theme.Label({
		Text = "Choose an ability!",
		MaxTextSize = 44,
		StrokeThickness = 4,
		Size = UDim2.new(1, 0, 0, 56),
		Parent = holder,
	})
	local timer = Theme.Label({
		Text = "",
		MaxTextSize = 22,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 56),
		Parent = holder,
	})

	local row = Instance.new("Frame")
	row.Name = "Cards"
	row.BackgroundTransparency = 1
	row.Position = UDim2.fromOffset(0, 92)
	row.Size = UDim2.new(1, 0, 0, 320)
	row.Parent = holder
	Theme.List(row, "Horizontal", 18, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local closed = false
	local picked = false
	local function close()
		if closed then
			return
		end
		closed = true
		shade:Destroy()
	end

	for index, option in opts.options do
		local card, body = Theme.Card({
			Title = option.name,
			Size = UDim2.fromOffset(220, 310),
			LayoutOrder = index,
			TitleSize = 24,
			Parent = row,
		})
		Theme.List(body, "Vertical", 6)
		Theme.Label({
			Text = option.icon,
			MaxTextSize = 64,
			StrokeThickness = 0,
			Size = UDim2.new(1, 0, 0, 72),
			LayoutOrder = 1,
			ZIndex = card.ZIndex + 3,
			Parent = body,
		})
		Theme.Label({
			Text = option.description,
			MaxTextSize = 20,
			Size = UDim2.new(1, 0, 0, 70),
			LayoutOrder = 2,
			ZIndex = card.ZIndex + 3,
			Parent = body,
		})
		local stars = ""
		if option.maxStacks <= 5 then
			stars = string.rep("★", option.stacks) .. string.rep("☆", option.maxStacks - option.stacks)
		elseif option.stacks > 0 then
			stars = ("x%d"):format(option.stacks)
		end
		Theme.Label({
			Text = stars,
			TextColor3 = P.PriceGold,
			MaxTextSize = 20,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = 3,
			ZIndex = card.ZIndex + 3,
			Parent = body,
		})
		Theme.Button({
			Text = "PICK",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.new(1, -8, 0, 54),
			LayoutOrder = 4,
			ZIndex = card.ZIndex + 4,
			OnClick = function()
				if picked or closed then
					return
				end
				picked = true
				close()
				opts.onPick(option.id)
			end,
			Parent = body,
		})
		Theme.Pop(card)
	end

	-- timer text (the server auto-picks the first card when it runs out)
	local deadline = os.clock() + opts.timeout
	task.spawn(function()
		while not closed do
			local left = math.max(0, math.ceil(deadline - os.clock()))
			timer.Text = ("Auto-pick in %ds"):format(left)
			task.wait(0.25)
		end
	end)
	return close
end

-------------------------------------------------------------------------------
-- Result screen
-------------------------------------------------------------------------------
export type ResultOptions = {
	result: { [string]: any },
	onChest: (done: () -> ()) -> (),
	onContinue: () -> (),
}

function CombatUI.Result(opts: ResultOptions): () -> ()
	local result = opts.result
	local victory = result.victory == true
	local panel, content, close = Theme.Panel({
		Name = "CombatResult",
		Title = if victory then "VICTORY!" else "DEFEAT",
		HeaderColor = if victory then P.ButtonGreen else P.ButtonRed,
		HeaderDarkColor = if victory then P.ButtonGreenDark else P.ButtonRedDark,
		Size = UDim2.fromOffset(520, 440),
		Closable = false,
	})
	Theme.List(content, "Vertical", 8)

	local lines = {}
	local level = tonumber(result.level) or 0
	if result.mode == "barrier" then
		table.insert(lines, ("Barrier squad • Level %d"):format(level))
	else
		table.insert(lines, ("Combat Arena • Level %d"):format(level))
	end
	table.insert(
		lines,
		("Waves cleared: %d/%d    Enemies: %d"):format(
			tonumber(result.wavesCleared) or 0,
			tonumber(result.waveCount) or 0,
			tonumber(result.kills) or 0
		)
	)
	for index, text in lines do
		Theme.Label({
			Text = text,
			MaxTextSize = 24,
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = index,
			ZIndex = 13,
			Parent = content,
		})
	end

	local paid = tonumber(result.paid) or 0
	local cashRow = Instance.new("Frame")
	cashRow.Name = "Cash"
	cashRow.BackgroundTransparency = 1
	cashRow.Size = UDim2.new(1, 0, 0, 56)
	cashRow.LayoutOrder = 10
	cashRow.ZIndex = 13
	cashRow.Parent = content
	Theme.MoneyTag({
		Text = "+" .. Format.Money(paid) .. (if result.boosted then "  (2x)" else ""),
		Size = UDim2.fromOffset(280, 52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 30,
		ZIndex = 14,
		Parent = cashRow,
	})

	local chest = result.chest
	local chestTier = if type(chest) == "table" and type(chest.tier) == "string" then chest.tier else nil

	local note = ""
	if result.barrierDefeated then
		note = ("The way to %s is open — unlock its gate!"):format(tostring(result.nextAreaName or "the next area"))
	elseif result.newBest then
		note = "New best level! The next level is unlocked."
	elseif not victory and chestTier then
		note = "Cash you collected is yours, and you earned a chest. Upgrade your gear and try again!"
	elseif not victory then
		-- matches CombatDefs.ChestTier: wood needs 1 kill or CHEST_MIN_SECONDS of fighting
		note = ("No chest this time: defeat an enemy or fight for %d seconds to earn one."):format(
			CombatDefs.CHEST_MIN_SECONDS
		)
	end
	Theme.Label({
		Text = note,
		TextColor3 = P.PriceGold,
		MaxTextSize = 20,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = 11,
		ZIndex = 13,
		Parent = content,
	})

	local button: TextButton
	local continueMode = chestTier == nil
	local opened = false
	button = Theme.Button({
		Text = if continueMode
			then "CONTINUE"
			else ("%s OPEN %s"):format(
				CHEST_ICONS[chestTier] or "🎁",
				string.upper(CHEST_NAMES[chestTier] or "chest")
			),
		Color = if continueMode then P.ButtonGreen else P.CardOrange,
		DarkColor = if continueMode then P.ButtonGreenDark else P.CardOrangeDark,
		Size = UDim2.fromOffset(320, 66),
		LayoutOrder = 12,
		ZIndex = 14,
		OnClick = function()
			if continueMode then
				close()
				opts.onContinue()
				return
			end
			if opened then
				return
			end
			opened = true
			-- hide the whole panel (and its dim background) while the chest plays
			local shade = panel.Parent
			local function setShown(shown: boolean)
				if shade and shade:IsA("GuiObject") then
					shade.Visible = shown
				end
			end
			setShown(false)
			opts.onChest(function()
				continueMode = true
				setShown(true)
				Theme.SetButtonText(button, "CONTINUE")
				Theme.Pop(button)
			end)
		end,
		Parent = content,
	})
	return close
end

return CombatUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">InventoryUI</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InventoryUI (client, plain module — not a controller)
	The "Armoury": review your armour and weapons, equip them, upgrade them
	with coins and scrap the ones you do not need.

	Layout (one big Theme.Panel, about 780 x 540, shrinks on small screens):
		LEFT   two big equipped-slot tiles (Weapon, Armour) + a summary of your
		       combined combat stats (HP, damage, fire rate, bullets, crit,
		       damage reduction, speed, perks).
		RIGHT  scrolling grid of every item you own (rarity-coloured border,
		       emoji icon, "Lv n", green "E" badge when equipped, pink "NEW"
		       for fresh chest drops). Sorted weapons first, then rarity, then level.
		       Clicking an item opens its detail card with EQUIP / UPGRADE / SCRAP.
		BOTTOM (optional) a big green action button, e.g. "START BATTLE".
	The panel refreshes live whenever the server sends new data (State.Changed).

	API:
		InventoryUI.Open(opts: {
			Title: string?,          -- panel title (default "Armoury")
			ActionText: string?,     -- show a big green action button with this text
			OnAction: (() -> ())?,   -- called when the action button is pressed (then the panel closes)
			OnClose: (() -> ())?,    -- called once when the panel closes (any reason)
			Context: string?,        -- Theme panel context, e.g. "Base" (the HUD closes "Base"
			                         -- dialogs when you leave the base); the combat lobby passes none
		}): () -> ()                 -- returns close(); safe to call more than once
		InventoryUI.MarkNew(uid: string)  -- show the "NEW" badge on an item until it is viewed
		InventoryUI.IsOpen(): boolean

	Server requests used: "EquipItem", "UpgradeItem", "ScrapItem" (InventoryService).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local EquipmentDefs = require(Shared.Combat.EquipmentDefs)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

type Item = Types.Item
type PlayerData = Types.PlayerData

export type OpenOptions = {
	Title: string?,
	ActionText: string?,
	OnAction: (() -> ())?,
	OnClose: (() -> ())?,
	Context: string?,
}

type Entry = { uid: string, item: Item, def: EquipmentDefs.ItemDef, equipped: boolean }

local P = Theme.Palette
local Z = 13 -- ZIndex of panel content (Theme panels use 11-12)

local InventoryUI = {}

local newUids: { [string]: boolean } = {}
local activeClose: (() -> ())? = nil

function InventoryUI.MarkNew(uid: string)
	if type(uid) == "string" then
		newUids[uid] = true
	end
end

function InventoryUI.IsOpen(): boolean
	return activeClose ~= nil
end

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local function fmt(n: number): string
	if math.abs(n - math.floor(n + 0.5)) < 0.05 then
		return tostring(math.floor(n + 0.5))
	end
	return string.format("%.1f", n)
end

local function pct(fraction: number): string
	return fmt(fraction * 100) .. "%"
end

local function newFrame(name: string, parent: Instance): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = Z
	f.Parent = parent
	return f
end

local function newScroller(name: string, parent: Instance): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.Name = name
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ZIndex = Z
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = P.White
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.CanvasSize = UDim2.new(0, 0, 0, 0)
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.Parent = parent
	return s
end

-- "Inset" background used for the stats box, the grid and the detail card.
local function inset(frame: GuiObject, transparency: number?)
	frame.BackgroundColor3 = P.CardBlueDark
	frame.BackgroundTransparency = transparency or 0.25
	Theme.Corner(frame, 12)
	Theme.Stroke(frame, P.CardOutline, 2, true)
end

-- A "label ...... value" line for the stats summary.
local function statRow(parent: Instance, order: number, left: string, right: string, rightColor: Color3?)
	local row = newFrame("Row", parent)
	row.Size = UDim2.new(1, 0, 0, 24)
	row.LayoutOrder = order
	Theme.Label({
		Text = left,
		MaxTextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.62, 0, 1, 0),
		ZIndex = Z + 1,
		Parent = row,
	})
	Theme.Label({
		Text = right,
		MaxTextSize = 19,
		TextColor3 = rightColor or P.White,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.38, 0, 1, 0),
		Position = UDim2.fromScale(0.62, 0),
		ZIndex = Z + 1,
		Parent = row,
	})
end

-- One wrapped text line in a vertical list.
local function textLine(parent: Instance, order: number, text: string, height: number, color: Color3?, maxSize: number?)
	return Theme.Label({
		Text = text,
		MaxTextSize = maxSize or 19,
		TextColor3 = color or P.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -4, 0, height),
		LayoutOrder = order,
		ZIndex = Z + 1,
		Parent = parent,
	})
end

-- Sorted list of the items you own (unknown item ids are skipped).
local function sortedEntries(data: PlayerData): { Entry }
	local list: { Entry } = {}
	if type(data.inventory) ~= "table" then
		return list
	end
	local equipped = if type(data.equipped) == "table" then data.equipped else {} :: any
	for uid, raw in data.inventory do
		local item = EquipmentDefs.SanitizeItem(raw)
		local def = item and EquipmentDefs.Items[item.id]
		if item and def then
			table.insert(list, {
				uid = uid,
				item = item,
				def = def,
				equipped = equipped.weapon == uid or equipped.armour == uid,
			})
		end
	end
	table.sort(list, function(a: Entry, b: Entry): boolean
		if a.def.slot ~= b.def.slot then
			return a.def.slot == "weapon"
		end
		if a.item.rarity ~= b.item.rarity then
			return a.item.rarity > b.item.rarity
		end
		if a.item.level ~= b.item.level then
			return a.item.level > b.item.level
		end
		if a.def.order ~= b.def.order then
			return a.def.order < b.def.order
		end
		return (tonumber(a.uid) or 0) < (tonumber(b.uid) or 0)
	end)
	return list
end

-- Square-ish item badge: rarity border + glow, emoji icon.
local function drawItemFace(parent: GuiObject, item: Item, def: EquipmentDefs.ItemDef, iconSize: number)
	local color = Theme.RarityColor(item.rarity)
	parent.BackgroundColor3 = P.CardBlueDark
	parent.BackgroundTransparency = 0
	Theme.Corner(parent, 12)
	local stroke = Theme.Stroke(parent, color, 3, true)
	stroke.Name = "RarityStroke"

	local glow = newFrame("Glow", parent)
	glow.Size = UDim2.fromScale(1, 1)
	glow.BackgroundTransparency = 0
	glow.BackgroundColor3 = color
	Theme.Corner(glow, 12)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.92),
		NumberSequenceKeypoint.new(0.55, 0.7),
		NumberSequenceKeypoint.new(1, 0.25),
	})
	gradient.Parent = glow

	Theme.Label({
		Name = "Icon",
		Text = def.icon,
		MaxTextSize = iconSize,
		StrokeThickness = 0,
		Size = UDim2.new(1, -8, 0.62, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = Z + 2,
		Parent = parent,
	})
	return stroke
end

local function badge(parent: Instance, text: string, color: Color3, position: UDim2, anchor: Vector2, width: number)
	local b = newFrame("Badge" .. text, parent)
	b.BackgroundTransparency = 0
	b.BackgroundColor3 = color
	b.Size = UDim2.fromOffset(width, 22)
	b.Position = position
	b.AnchorPoint = anchor
	b.ZIndex = Z + 4
	Theme.Corner(b, 0.5)
	Theme.Stroke(b, P.CardOutline, 2, true)
	Theme.Label({
		Text = text,
		MaxTextSize = 16,
		StrokeThickness = 1.5,
		Size = UDim2.new(1, -4, 1, -2),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = Z + 5,
		Parent = b,
	})
	return b
end

-------------------------------------------------------------------------------
-- Open
-------------------------------------------------------------------------------
function InventoryUI.Open(opts: OpenOptions): () -> ()
	opts = if type(opts) == "table" then opts else {}
	-- Only one Armoury at a time.
	local previous = activeClose
	if previous then
		previous()
	end

	local hasAction = type(opts.ActionText) == "string" and opts.ActionText ~= ""

	-- Fit the panel on the screen (Theme.Panel scales by screen HEIGHT; we
	-- also make sure the WIDTH fits narrow phones).
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 800)
	local uiScale = math.clamp(viewport.Y / 820, 0.55, 1.25)
	local width = math.clamp((viewport.X - 24) / uiScale, 520, 780)
	local height = math.clamp((viewport.Y - 16) / uiScale, 420, if hasAction then 610 else 540)

	local closed = false
	local stateConn: { Disconnect: (any) -> () }? = nil
	local closeConfirm: (() -> ())? = nil
	local closeSelf: () -> () = function() end

	local function cleanup()
		if closed then
			return
		end
		closed = true
		if stateConn then
			stateConn:Disconnect()
			stateConn = nil
		end
		if closeConfirm then
			local c = closeConfirm
			closeConfirm = nil
			pcall(c)
		end
		if activeClose == closeSelf then
			activeClose = nil
		end
	end

	local _, content, panelClose = Theme.Panel({
		Name = "Armoury",
		Context = opts.Context,
		Title = opts.Title or "Armoury",
		HeaderColor = P.CardOrange,
		HeaderDarkColor = P.CardOrangeDark,
		Size = UDim2.fromOffset(width, height),
		OnClose = function()
			cleanup()
			local onClose = opts.OnClose
			if onClose then
				local ok, err = pcall(function()
					onClose()
				end)
				if not ok then
					warn("[InventoryUI] OnClose failed: " .. tostring(err))
				end
			end
		end,
	})
	closeSelf = function()
		panelClose()
	end
	activeClose = closeSelf

	local bottomSpace = if hasAction then 76 else 0

	---------------------------------------------------------------- columns
	local left = newFrame("Left", content)
	left.Size = UDim2.new(0.37, -6, 1, -bottomSpace)

	local right = newFrame("Right", content)
	right.Position = UDim2.new(0.37, 6, 0, 0)
	right.Size = UDim2.new(0.63, -6, 1, -bottomSpace)

	-- Equipped slot tiles
	local slotRow = newFrame("Slots", left)
	slotRow.Size = UDim2.new(1, 0, 0, 150)

	-- Stats summary
	local statsBox = newFrame("Stats", left)
	statsBox.Position = UDim2.new(0, 0, 0, 158)
	statsBox.Size = UDim2.new(1, 0, 1, -158)
	inset(statsBox)
	Theme.Label({
		Text = "YOUR COMBAT STATS",
		MaxTextSize = 20,
		TextColor3 = P.PriceGold,
		Size = UDim2.new(1, -12, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = Z + 1,
		Parent = statsBox,
	})
	local statsList = newScroller("List", statsBox)
	statsList.Position = UDim2.new(0, 10, 0, 34)
	statsList.Size = UDim2.new(1, -16, 1, -40)
	Theme.List(statsList, "Vertical", 2, Enum.HorizontalAlignment.Left)

	-- Item grid
	local countLabel = Theme.Label({
		Text = "ITEMS",
		MaxTextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 0, 28),
		Position = UDim2.new(0, 4, 0, 0),
		ZIndex = Z,
		Parent = right,
	})
	local gridBox = newFrame("GridBox", right)
	gridBox.Position = UDim2.new(0, 0, 0, 32)
	gridBox.Size = UDim2.new(1, 0, 1, -32)
	inset(gridBox)
	local grid = newScroller("Grid", gridBox)
	grid.Position = UDim2.fromOffset(4, 4)
	grid.Size = UDim2.new(1, -8, 1, -8)
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(86, 98)
	gridLayout.CellPadding = UDim2.fromOffset(9, 9)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gridLayout.Parent = grid
	Theme.Padding(grid, 8, 10)

	-- Detail card (covers the grid while open)
	local detail = newFrame("Detail", right)
	detail.ZIndex = Z + 10
	detail.Size = UDim2.fromScale(1, 1)
	detail.Visible = false
	inset(detail, 0)
	detail.BackgroundColor3 = P.CardBlue
	Theme.Gradient(detail, Theme.Lighten(P.CardBlue, 0.08), P.CardBlueDark)

	---------------------------------------------------------------- action button
	if hasAction then
		local acted = false
		Theme.Button({
			Name = "Action",
			Text = opts.ActionText,
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			MaxTextSize = 36,
			Size = UDim2.new(0.5, 0, 0, 66),
			Position = UDim2.new(0.5, 0, 1, -2),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = Z + 2,
			OnClick = function()
				if acted or closed then
					return
				end
				acted = true
				local onAction = opts.OnAction
				if onAction then
					local ok, err = pcall(function()
						onAction()
					end)
					if not ok then
						warn("[InventoryUI] OnAction failed: " .. tostring(err))
					end
				end
				closeSelf()
			end,
			Parent = content,
		})
	end

	---------------------------------------------------------------- state
	local selectedUid: string? = nil
	local busy = false
	local inventoryKey = ""
	local detailKey = ""
	local detailButtons: {
		equip: TextButton?,
		upgrade: TextButton?,
		scrap: TextButton?,
		price: number?,
		equipped: boolean,
	} =
		{ equipped = false }
	local tileStrokes: { [string]: UIStroke } = {}

	local refresh: () -> ()
	local showDetail: (uid: string?) -> ()

	local function setSelectedStroke()
		for uid, stroke in tileStrokes do
			local tile = stroke.Parent
			if uid == selectedUid then
				stroke.Color = P.White
				stroke.Thickness = 4
			elseif tile then
				stroke.Color = (tile :: Instance):GetAttribute("RarityColor") :: Color3? or P.White
				stroke.Thickness = 3
			end
		end
	end

	-- Sends one of the three requests (ignores double clicks while waiting).
	local function request(action: string, uid: string, onOk: (result: { [string]: any }) -> ())
		if busy or closed then
			return
		end
		busy = true
		refresh()
		local result = Net.Request(action, uid)
		busy = false
		if result.ok then
			onOk(result)
		else
			Theme.Toast(result.err or "Something went wrong", "error")
		end
		if not closed then
			refresh()
		end
	end

	---------------------------------------------------------------- left column
	local function drawSlots(data: PlayerData)
		for _, child in slotRow:GetChildren() do
			child:Destroy()
		end
		local equipped = if type(data.equipped) == "table" then data.equipped else {} :: any
		for index, slot in { "weapon", "armour" } do
			local uid = equipped[slot]
			local raw = if type(uid) == "string" and type(data.inventory) == "table" then data.inventory[uid] else nil
			local item = EquipmentDefs.SanitizeItem(raw)
			local def = item and EquipmentDefs.Items[item.id]
			if def and def.slot ~= slot then
				item, def = nil, nil
			end

			local tile = Instance.new("TextButton")
			tile.Name = slot
			tile.Text = ""
			tile.AutoButtonColor = false
			tile.ZIndex = Z
			tile.Size = UDim2.new(0.5, -5, 1, 0)
			tile.Position = if index == 1 then UDim2.new(0, 0, 0, 0) else UDim2.new(0.5, 5, 0, 0)
			tile.Parent = slotRow
			if item and def then
				drawItemFace(tile, item, def, 56)
				Theme.Label({
					Text = def.name,
					MaxTextSize = 17,
					Size = UDim2.new(1, -8, 0, 20),
					Position = UDim2.new(0.5, 0, 1, -24),
					AnchorPoint = Vector2.new(0.5, 1),
					ZIndex = Z + 2,
					Parent = tile,
				})
				Theme.Label({
					Text = "Lv " .. item.level,
					MaxTextSize = 17,
					TextColor3 = P.PriceGold,
					Size = UDim2.new(1, -8, 0, 20),
					Position = UDim2.new(0.5, 0, 1, -4),
					AnchorPoint = Vector2.new(0.5, 1),
					ZIndex = Z + 2,
					Parent = tile,
				})
				local equippedUid = uid :: string
				tile.Activated:Connect(function()
					showDetail(equippedUid)
				end)
			else
				inset(tile)
				Theme.Label({
					Text = "Empty",
					MaxTextSize = 20,
					TextColor3 = P.TrackStripe,
					Size = UDim2.new(1, -8, 0.5, 0),
					Position = UDim2.fromScale(0.5, 0.55),
					AnchorPoint = Vector2.new(0.5, 0.5),
					ZIndex = Z + 1,
					Parent = tile,
				})
			end
			badge(
				tile,
				if slot == "weapon" then "WEAPON" else "ARMOUR",
				P.CardOrange,
				UDim2.new(0.5, 0, 0, -8),
				Vector2.new(0.5, 0),
				86
			)
		end
	end

	local function drawStats(data: PlayerData)
		for _, child in statsList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local ok, raw = pcall(function(): EquipmentDefs.CombatStats
			return EquipmentDefs.LoadoutStats(data)
		end)
		if not ok or type(raw) ~= "table" then
			textLine(statsList, 1, "Stats unavailable", 24)
			return
		end
		local s = EquipmentDefs.DisplayStats(raw)
		statRow(statsList, 1, "❤️ HP", fmt(s.maxHp), P.MoneyGreen)
		statRow(statsList, 2, "💥 Damage", fmt(s.damage))
		statRow(statsList, 3, "⚡ Fire rate", string.format("%.1f/s", s.fireRate))
		statRow(statsList, 4, "🔱 Bullets", tostring(s.projectiles))
		statRow(statsList, 5, "🎯 Crit", pct(s.critChance) .. " x" .. fmt(s.critMult))
		statRow(statsList, 6, "🛡️ Dmg reduction", pct(s.damageReduction))
		statRow(statsList, 7, "👟 Speed", fmt(s.moveSpeed))

		local perkIds = {}
		for id, stacks in s.perks do
			if stacks > 0 and EquipmentDefs.PERKS[id] then
				table.insert(perkIds, id)
			end
		end
		table.sort(perkIds)
		if #perkIds == 0 then
			textLine(statsList, 10, "✨ Perks: none yet (Rare+ items have perks)", 40, P.TrackStripe, 16)
		else
			textLine(statsList, 10, "✨ Perks", 24, P.PriceGold)
			for i, id in perkIds do
				local perk = EquipmentDefs.PERKS[id]
				local stacks = s.perks[id]
				textLine(
					statsList,
					10 + i,
					perk.icon .. " " .. perk.name .. (if stacks > 1 then " x" .. stacks else ""),
					22,
					nil,
					17
				)
			end
		end
	end

	---------------------------------------------------------------- grid
	local function drawGrid(data: PlayerData, entries: { Entry })
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		table.clear(tileStrokes)
		countLabel.Text = ("ITEMS  %d / %d"):format(#entries, EquipmentDefs.MAX_INVENTORY)
		if #entries == 0 then
			local empty = textLine(grid, 1, "No items yet. Win combat games to earn chests!", 60)
			empty.Size = UDim2.fromOffset(240, 60)
			return
		end
		for index, entry in entries do
			local tile = Instance.new("TextButton")
			tile.Name = "Item" .. entry.uid
			tile.Text = ""
			tile.AutoButtonColor = false
			tile.LayoutOrder = index
			tile.ZIndex = Z
			tile.Parent = grid
			tile:SetAttribute("RarityColor", Theme.RarityColor(entry.item.rarity))
			local stroke = drawItemFace(tile, entry.item, entry.def, 40)
			tileStrokes[entry.uid] = stroke
			Theme.Label({
				Text = "Lv " .. entry.item.level,
				MaxTextSize = 18,
				Size = UDim2.new(1, -8, 0, 22),
				Position = UDim2.new(0.5, 0, 1, -4),
				AnchorPoint = Vector2.new(0.5, 1),
				ZIndex = Z + 2,
				Parent = tile,
			})
			if entry.equipped then
				local e = badge(tile, "E", P.ButtonGreen, UDim2.fromOffset(-6, -6), Vector2.zero, 24)
				e.Size = UDim2.fromOffset(24, 24)
			end
			if newUids[entry.uid] then
				badge(tile, "NEW", P.CardPink, UDim2.new(1, 6, 0, -6), Vector2.new(1, 0), 44)
			end
			local uid = entry.uid
			tile.Activated:Connect(function()
				showDetail(uid)
			end)
		end
		setSelectedStroke()
	end

	---------------------------------------------------------------- detail card
	local function updateDetailButtons()
		local data = State.Get()
		local cash = if data then data.cash else 0
		local b = detailButtons
		if b.equip then
			Theme.SetButtonEnabled(b.equip, not busy and not b.equipped)
		end
		if b.upgrade then
			local affordable = b.price ~= nil and cash + 1e-6 >= (b.price :: number)
			Theme.SetButtonEnabled(b.upgrade, not busy and affordable)
		end
		if b.scrap then
			Theme.SetButtonEnabled(b.scrap, not busy and not b.equipped)
		end
	end

	local function buildDetail(entry: Entry)
		for _, child in detail:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		detailButtons = { equipped = entry.equipped }
		local item, def = entry.item, entry.def
		local rarityColor = Theme.RarityColor(item.rarity)
		local maxLevel = Config.Rarities[item.rarity].maxLevel

		-- Back arrow
		Theme.Button({
			Name = "Back",
			Text = "◀",
			Color = P.CardOrange,
			Size = UDim2.fromOffset(44, 40),
			Position = UDim2.fromOffset(8, 8),
			ZIndex = Z + 12,
			MaxTextSize = 22,
			OnClick = function()
				showDetail(nil)
			end,
			Parent = detail,
		})

		-- Icon box
		local iconBox = newFrame("IconBox", detail)
		iconBox.ZIndex = Z + 11
		iconBox.Size = UDim2.fromOffset(96, 96)
		iconBox.Position = UDim2.fromOffset(60, 8)
		drawItemFace(iconBox, item, def, 60)

		-- Name / rarity / level
		local info = newFrame("Info", detail)
		info.ZIndex = Z + 11
		info.Position = UDim2.fromOffset(166, 6)
		info.Size = UDim2.new(1, -174, 0, 100)
		Theme.Label({
			Text = def.name,
			MaxTextSize = 30,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 34),
			ZIndex = Z + 12,
			Parent = info,
		})
		Theme.Label({
			Text = Theme.RarityName(item.rarity):upper() .. (if def.slot == "weapon" then "  WEAPON" else "  ARMOUR"),
			MaxTextSize = 22,
			TextColor3 = rarityColor,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, 34),
			ZIndex = Z + 12,
			Parent = info,
		})
		Theme.Label({
			Text = ("Level %d / %d   ·   Power %d"):format(item.level, maxLevel, EquipmentDefs.ItemPower(item)),
			MaxTextSize = 18,
			TextColor3 = P.PriceGold,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.fromOffset(0, 62),
			ZIndex = Z + 12,
			Parent = info,
		})

		-- Description, stats and perks (scrolls if long)
		local body = newScroller("Body", detail)
		body.ZIndex = Z + 11
		body.Position = UDim2.fromOffset(12, 112)
		body.Size = UDim2.new(1, -20, 1, -112 - 80)
		Theme.List(body, "Vertical", 3, Enum.HorizontalAlignment.Left)
		local order = 0
		local function line(text: string, height: number, color: Color3?, maxSize: number?)
			order += 1
			local l = textLine(body, order, text, height, color, maxSize)
			l.ZIndex = Z + 12
		end
		line(def.description, 38, P.TrackStripe, 17)
		for _, text in EquipmentDefs.ItemStatsText(item) do
			line(text, 24, nil, 20)
		end
		local perks = EquipmentDefs.ItemPerks(item)
		if #perks > 0 then
			line("✨ Perks", 24, P.PriceGold, 20)
			for _, perk in perks do
				local tag = if perk.source == "builtin"
					then " (built-in)"
					elseif perk.source == "signature" then " ★"
					else ""
				line(
					perk.icon .. " " .. perk.name .. tag,
					22,
					if perk.source == "signature" then rarityColor else nil,
					18
				)
				line("     " .. perk.description, 20, P.TrackStripe, 15)
			end
		elseif item.rarity < 3 then
			line("Rare, Epic and Legendary items roll extra perks.", 22, P.TrackStripe, 15)
		end
		if item.rarity < #Config.Rarities then
			line("Legendary signature: " .. def.signatureName, 22, Theme.RarityColor(#Config.Rarities), 15)
		end

		-- Buttons
		local row = newFrame("Buttons", detail)
		row.ZIndex = Z + 11
		row.Position = UDim2.new(0, 8, 1, -74)
		row.Size = UDim2.new(1, -16, 0, 66)
		Theme.List(row, "Horizontal", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local buttonSize = UDim2.new(1 / 3, -6, 0, 62)

		local uid = entry.uid
		detailButtons.equip = Theme.Button({
			Name = "Equip",
			Text = if entry.equipped then "EQUIPPED" else "EQUIP",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = buttonSize,
			LayoutOrder = 1,
			ZIndex = Z + 12,
			MaxTextSize = 24,
			OnClick = function()
				request("EquipItem", uid, function()
					Theme.Toast("Equipped " .. def.name .. "!", "success")
				end)
			end,
			Parent = row,
		})

		local price = Economy.EquipmentUpgradePrice(item.rarity, item.level)
		detailButtons.price = price
		local upgrade = Theme.Button({
			Name = "Upgrade",
			Text = if price then "UPGRADE\n" .. Format.Money(price) else "MAX LEVEL",
			Color = P.CardOrange,
			DarkColor = P.CardOrangeDark,
			Size = buttonSize,
			LayoutOrder = 2,
			ZIndex = Z + 12,
			MaxTextSize = 22,
			OnClick = function()
				request("UpgradeItem", uid, function(result)
					Theme.Toast(("%s upgraded to Lv %s!"):format(def.name, tostring(result.level or "?")), "success")
				end)
			end,
			Parent = row,
		})
		detailButtons.upgrade = upgrade
		if price then
			-- gold coin on the left of the price (like the reference HUD)
			local face = upgrade:FindFirstChild("Face")
			local label = face and face:FindFirstChild("Label") :: TextLabel?
			if label then
				label.Size = UDim2.new(1, -40, 1, -8)
				label.Position = UDim2.new(0.5, 14, 0.5, 0)
			end
			Theme.CoinIcon({
				Size = UDim2.fromOffset(24, 24),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, -2),
				ZIndex = Z + 14,
				Parent = upgrade,
			})
		end

		local scrapValue = EquipmentDefs.ScrapValue(item)
		detailButtons.scrap = Theme.Button({
			Name = "Scrap",
			Text = "SCRAP\n+" .. Format.Money(scrapValue),
			Color = P.ButtonRed,
			DarkColor = P.ButtonRedDark,
			Size = buttonSize,
			LayoutOrder = 3,
			ZIndex = Z + 12,
			MaxTextSize = 22,
			OnClick = function()
				if busy or closed or detailButtons.equipped then
					return
				end
				if closeConfirm then
					pcall(closeConfirm)
				end
				closeConfirm = Theme.Confirm({
					Title = "Scrap item?",
					Body = ("Scrap your %s %s (Lv %d) for %s? This cannot be undone."):format(
						Theme.RarityName(item.rarity),
						def.name,
						item.level,
						Format.Money(scrapValue)
					),
					ConfirmText = "SCRAP",
					ConfirmColor = P.ButtonRed,
					OnClose = function()
						closeConfirm = nil
					end,
					OnConfirm = function()
						if closed then
							return
						end
						request("ScrapItem", uid, function(result)
							local value = tonumber(result.value) or scrapValue
							Theme.Toast("Scrapped for +" .. Format.Money(value), "cash")
							if selectedUid == uid then
								showDetail(nil)
							end
						end)
					end,
				})
			end,
			Parent = row,
		})
		updateDetailButtons()
	end

	showDetail = function(uid: string?)
		if closed then
			return
		end
		selectedUid = uid
		detailKey = ""
		if uid and newUids[uid] then
			newUids[uid] = nil
			inventoryKey = "" -- redraw the grid to drop the NEW badge
		end
		refresh()
	end

	---------------------------------------------------------------- refresh
	refresh = function()
		if closed then
			return
		end
		local data = State.Get()
		if not data then
			countLabel.Text = "Loading..."
			return
		end
		local entries = sortedEntries(data)

		-- Rebuild the grid + left column only when the items actually changed
		-- (cash changes every few seconds and must not flicker the grid).
		local parts = {}
		for _, e in entries do
			table.insert(
				parts,
				("%s:%s:%d:%d:%s:%s"):format(
					e.uid,
					e.item.id,
					e.item.rarity,
					e.item.level,
					if e.equipped then "E" else "",
					if newUids[e.uid] then "N" else ""
				)
			)
		end
		local key = table.concat(parts, "|")
		if key ~= inventoryKey then
			inventoryKey = key
			drawSlots(data)
			drawStats(data)
			drawGrid(data, entries)
		end

		-- Detail card
		local entry: Entry? = nil
		if selectedUid then
			for _, e in entries do
				if e.uid == selectedUid then
					entry = e
					break
				end
			end
			if not entry then
				selectedUid = nil -- scrapped / gone
			end
		end
		if entry then
			local dKey = ("%s:%d:%d:%s"):format(
				entry.uid,
				entry.item.rarity,
				entry.item.level,
				tostring(entry.equipped)
			)
			if dKey ~= detailKey then
				detailKey = dKey
				buildDetail(entry)
			end
			detail.Visible = true
			updateDetailButtons()
		else
			detailKey = ""
			detail.Visible = false
		end
		setSelectedStroke()
	end

	stateConn = State.Changed:Connect(function()
		refresh()
	end)
	refresh()

	return closeSelf
end

return InventoryUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">RunnerUI</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RunnerUI (client, plain module - not a controller)
	All screens of the army runner, styled like reference image 2 with Theme.

	Public API:
		RunnerUI.ShowHud(level) -> Hud
			Hud.SetLevel(level)          -- black "Level N" banner (top centre)
			Hud.SetProgress(fraction)    -- thin progress bar under the banner
			Hud.SetStats(stats: HudStats) -- live squad panel in the BOTTOM-LEFT corner
			Hud.SetStatsVisible(visible) -- hidden on the pre-run screen (the cards show the
			                                stats) and on the summary (RunnerController)
			Hud.PopCash()                -- bounce the money tag (cash picked up)
			Hud.Destroy()
			HudStats = { troops, weaponName, weaponTier, maxTier, dps, cash, capacity }
			  Panel (owner request: stats in a corner, not above the head; bottom-left,
			  clear of Roblox's chat window in the top-left; the default touch
			  thumbstick is off during the run):
			  🪖 troops · 🔫 weapon (tier) · 💥 squad damage per second ·
			  💰 lime-green money tag "carried / capacity" (reference image 2).

		RunnerUI.ShowMessage(title, subtitle?, color?, duration?) -> close()
			big centre message ("BOSS DEFEATED!", "DEFEATED BY THE BOSS").

		RunnerUI.ShowPrepare({
			Data = PlayerData, Stats = { startTroops, damage, capacity },
			OnBuy = function(kind) end,  -- kind = "troops" | "damage" | "capacity"
			OnBack = function() end,
		}) -> Prepare
			Prepare.Update(data, stats, levelOverrides?)  -- refresh cards
			Prepare.SetBusy(kind, busy)  -- grey out a price button while buying
			Prepare.Destroy()
		  Layout (image 2): LEFT column "PERMANENT UPGRADES" with three cards
		  (orange header, blue body): Starting Troops, Damage, Carry Capacity.
		  RIGHT pink "Bonuses" card (vehicle bonus, 2x cash). BOTTOM centre the
		  tutorial hand with a <-> arrow "Drag or press A / D to start".
		  Bottom-right a small "Back" button.

		RunnerUI.ShowSummary({
			Level = number, Result = RunnerSim.Result, Paid = number,
			Boosted = boolean, Upgrades = { troops, damage, capacity },
			OnCollect = function() end,
			OnRetry = (function() end)?,   -- only after a LOST run (boss not beaten)
		}) -> close()
		  A lost run keeps its level (owner request: play it until you win), so
		  with OnRetry the panel says "Beat the boss to unlock Level N+1" and
		  shows TRY AGAIN (same level right away, OnRetry) next to BASE (OnCollect).
		  "RUN COMPLETE!" panel with a boss status pill ("Boss defeated!" /
		  "Defeated by the boss"). A sub-heading "COLLECTED THIS RUN" lists every
		  result line (what you picked up during this run and its cash value,
		  whole dollars),
		  then the TOTAL actually paid. A second sub-heading "PERMANENT UPGRADES"
		  shows the bought starting stats, kept clearly apart (brief requirement).
		  The panel deliberately has no Context, so HUD's Theme.CloseModals("Base")
		  (run when the mode changes to Runner) never closes it.

	Screen-size scaling uses Theme.ResponsiveScale on plain holder frames only
	(one UIScale per object, shared with Theme.Pop / button press animations).
	The HUD banner sits below Roblox's top bar (Theme.TopInset()); the stats
	panel sits in the bottom-left corner.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Types = require(Shared.Types)
local RunnerSim = require(Shared.Runner.RunnerSim)

local Theme = require(script.Parent.Theme)

type PlayerData = Types.PlayerData
type Result = RunnerSim.Result
type RunnerStats = { startTroops: number, damage: number, capacity: number }

local P = Config.Palette
local _player = Players.LocalPlayer

local RunnerUI = {}

-------------------------------------------------------------------------------
-- Shared bits
-------------------------------------------------------------------------------
type UpgradeInfo = {
	kind: string,
	title: string,
	icon: string,
	value: (RunnerStats) -> string,
}

local UPGRADES: { UpgradeInfo } = {
	{
		kind = "troops",
		title = "Starting Troops",
		icon = "🪖",
		value = function(stats: RunnerStats): string
			return tostring(math.floor(stats.startTroops)) .. " troops"
		end,
	},
	{
		kind = "damage",
		title = "Damage",
		icon = "💥",
		value = function(stats: RunnerStats): string
			return "DMG " .. Format.Short(math.floor(stats.damage * 10 + 0.5) / 10)
		end,
	},
	{
		kind = "capacity",
		title = "Carry Capacity",
		icon = "💰",
		value = function(stats: RunnerStats): string
			return Format.Money(stats.capacity)
		end,
	},
}

local function getGui(): ScreenGui
	return Theme.ScreenGui("RunnerUI", 8)
end

-- Screen-size scaling goes through Theme.ResponsiveScale, which reuses the
-- object's single "ThemeScale" UIScale (Roblox applies only one UIScale per
-- object) and stops listening when the screen is destroyed. It is only put
-- on plain holder frames, never on a button or anything Theme.Pop animates.
local function responsive(gui: GuiObject)
	Theme.ResponsiveScale(gui)
end

local function upgradeLevel(data: PlayerData, kind: string, overrides: { [string]: number }?): number
	local levels = data.runner.upgrades :: { [string]: number }
	local level = levels[kind] or 0
	if overrides and overrides[kind] then
		level = math.max(level, overrides[kind])
	end
	return level
end

local function vehicleBonusFor(data: PlayerData): (string?, number)
	local equipped = data.vehicles and data.vehicles.equipped
	if not equipped then
		return nil, 0
	end
	for _, def in Config.Vehicles do
		if def.id == equipped then
			return def.name, def.runnerBonus
		end
	end
	return nil, 0
end

local function safeEffect(kind: string, level: number): string
	local ok, text = pcall(Economy.RunnerUpgradeEffect, kind, level)
	if ok and type(text) == "string" and text ~= "" then
		return text
	end
	return "Small boost"
end

-------------------------------------------------------------------------------
-- HUD: "Level N" banner + progress bar
-------------------------------------------------------------------------------
export type HudStats = {
	troops: number,
	weaponName: string,
	weaponTier: number,
	maxTier: number,
	dps: number,
	cash: number,
	capacity: number,
}

export type Hud = {
	SetLevel: (level: number) -> (),
	SetProgress: (fraction: number) -> (),
	SetStats: (stats: HudStats) -> (),
	SetStatsVisible: (visible: boolean) -> (),
	PopCash: () -> (),
	Destroy: () -> (),
}

local function wholeText(n: number): string
	return (Format.Money(math.max(0, math.floor(n + 0.5))):gsub("^%$", ""))
end

function RunnerUI.ShowHud(level: number): Hud
	local gui = getGui()
	local root = Instance.new("Frame")
	root.Name = "RunnerHud"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0)
	-- RunnerUI ignores the GUI inset: start below Roblox's top bar.
	root.Position = UDim2.new(0.5, 0, 0, Theme.TopInset() + 6)
	root.Size = UDim2.fromOffset(300, 80)
	root.Parent = gui
	responsive(root)

	local _, setBanner = Theme.Banner({
		Text = "Level " .. level,
		Size = UDim2.fromOffset(290, 48),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = root,
	})

	local bar = Instance.new("Frame")
	bar.Name = "Progress"
	bar.BackgroundColor3 = P.PillBlack
	bar.BackgroundTransparency = 0.2
	bar.AnchorPoint = Vector2.new(0.5, 0)
	bar.Position = UDim2.new(0.5, 0, 0, 56)
	bar.Size = UDim2.fromOffset(240, 14)
	bar.Parent = root
	Theme.Corner(bar, 0.5)
	Theme.Stroke(bar, P.CardOutline, 2, true)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = P.MoneyGreen
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = bar
	Theme.Corner(fill, 0.5)

	---------------------------------------------------------------------------
	-- BOTTOM-LEFT squad panel (the top-left corner is Roblox's chat window)
	---------------------------------------------------------------------------
	local corner = Instance.new("Frame")
	corner.Name = "RunnerStats"
	corner.BackgroundTransparency = 1
	corner.AnchorPoint = Vector2.new(0, 1)
	corner.Position = UDim2.new(0, 12, 1, -12)
	corner.Size = UDim2.fromOffset(232, 186)
	corner.Visible = false
	corner.Parent = gui
	responsive(corner)

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.BackgroundColor3 = P.PillBlack
	card.BackgroundTransparency = 0.18
	card.Size = UDim2.fromScale(1, 1)
	card.Parent = corner
	Theme.Corner(card, 14)
	Theme.Stroke(card, P.CardOutline, 2.5, true)
	Theme.Padding(card, 8, 8)
	Theme.List(card, "Vertical", 4, Enum.HorizontalAlignment.Left)

	local function statRow(order: number, icon: string, size: number): TextLabel
		local row = Instance.new("Frame")
		row.Name = "Row" .. order
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, size)
		row.LayoutOrder = order
		row.Parent = card
		Theme.Label({
			Text = icon,
			StrokeThickness = 0,
			MaxTextSize = size - 4,
			Size = UDim2.new(0, size, 1, 0),
			Parent = row,
		})
		return Theme.Label({
			Text = "",
			MaxTextSize = size - 6,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -(size + 6), 1, 0),
			Position = UDim2.fromOffset(size + 6, 0),
			Parent = row,
		})
	end
	local troopsLabel = statRow(1, "🪖", 36)
	local weaponLabel = statRow(2, "🔫", 30)
	local dpsLabel = statRow(3, "💥", 30)
	local moneyTag, setMoney = Theme.MoneyTag({
		Name = "Cash",
		Text = "$0",
		MaxTextSize = 26,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 4,
		Parent = card,
	})
	Theme.CoinIcon({
		Size = UDim2.fromOffset(30, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, -2),
		ZIndex = 4,
		Parent = moneyTag,
	})

	local lastTroops = -1
	return {
		SetLevel = function(newLevel: number)
			setBanner("Level " .. newLevel)
		end,
		SetProgress = function(fraction: number)
			fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		end,
		SetStats = function(stats: HudStats)
			local count = math.max(0, math.floor(stats.troops))
			troopsLabel.Text = wholeText(count) .. (if count == 1 then " troop" else " troops")
			if lastTroops >= 0 and count ~= lastTroops then
				troopsLabel.TextColor3 = if count > lastTroops then P.MoneyGreen else P.ButtonRed
				task.delay(0.35, function()
					troopsLabel.TextColor3 = P.White
				end)
			end
			lastTroops = count
			weaponLabel.Text = ("%s  %d/%d"):format(stats.weaponName, stats.weaponTier, stats.maxTier)
			dpsLabel.Text = wholeText(stats.dps) .. " DPS"
			local full = stats.capacity > 0 and stats.cash >= stats.capacity - 0.5
			if full then
				setMoney("     " .. Format.Money(stats.cash) .. " FULL!")
			else
				setMoney("     " .. Format.Money(stats.cash) .. " / " .. Format.Money(stats.capacity))
			end
		end,
		SetStatsVisible = function(visible: boolean)
			if visible and not corner.Visible then
				corner.Visible = true
				Theme.Pop(card)
			else
				corner.Visible = visible
			end
		end,
		PopCash = function()
			Theme.Pop(moneyTag)
		end,
		Destroy = function()
			root:Destroy()
			corner:Destroy()
		end,
	}
end

-------------------------------------------------------------------------------
-- Big centre message (boss result)
-------------------------------------------------------------------------------
function RunnerUI.ShowMessage(title: string, subtitle: string?, color: Color3?, duration: number?): () -> ()
	local holder = Instance.new("Frame")
	holder.Name = "RunnerMessage"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.32)
	holder.Size = UDim2.fromOffset(760, 150)
	holder.Parent = getGui()
	responsive(holder)
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.BackgroundTransparency = 1
	inner.Size = UDim2.fromScale(1, 1)
	inner.Parent = holder
	Theme.Label({
		Text = title,
		TextColor3 = color or P.Coin,
		MaxTextSize = 72,
		StrokeThickness = 4,
		Size = UDim2.new(1, 0, 0, 86),
		Parent = inner,
	})
	if subtitle and subtitle ~= "" then
		Theme.Label({
			Text = subtitle,
			MaxTextSize = 32,
			StrokeThickness = 3,
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromOffset(0, 92),
			Parent = inner,
		})
	end
	Theme.Pop(inner)
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		holder:Destroy()
	end
	if duration and duration > 0 then
		task.delay(duration, close)
	end
	return close
end

-------------------------------------------------------------------------------
-- Pre-run screen
-------------------------------------------------------------------------------
export type Prepare = {
	Update: (data: PlayerData, stats: RunnerStats, overrides: { [string]: number }?) -> (),
	SetBusy: (kind: string, busy: boolean) -> (),
	Destroy: () -> (),
}

type CardRefs = {
	info: UpgradeInfo,
	value: TextLabel,
	level: TextLabel,
	nextText: TextLabel,
	button: TextButton,
	busy: boolean,
}

function RunnerUI.ShowPrepare(props: {
	Data: PlayerData,
	Stats: RunnerStats,
	OnBuy: (kind: string) -> (),
	OnBack: () -> (),
}): Prepare
	local root = Instance.new("Frame")
	root.Name = "RunnerPrepare"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = getGui()

	---------------------------------------------------------------------------
	-- LEFT: permanent upgrade cards
	---------------------------------------------------------------------------
	local left = Instance.new("Frame")
	left.Name = "Upgrades"
	left.BackgroundTransparency = 1
	left.AnchorPoint = Vector2.new(0, 0.5)
	left.Position = UDim2.new(0, 16, 0.5, 10)
	left.Size = UDim2.fromOffset(214, 660)
	left.Parent = root
	responsive(left)
	Theme.List(left, "Vertical", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local heading = Instance.new("Frame")
	heading.Name = "Heading"
	heading.BackgroundColor3 = P.PillBlack
	heading.BackgroundTransparency = 0.1
	heading.Size = UDim2.fromOffset(214, 58)
	heading.LayoutOrder = 0
	heading.Parent = left
	Theme.Corner(heading, 12)
	Theme.Stroke(heading, P.CardOutline, 2, true)
	Theme.Label({
		Text = "PERMANENT UPGRADES",
		TextColor3 = P.PriceGold,
		MaxTextSize = 22,
		Size = UDim2.new(1, -12, 0, 30),
		Position = UDim2.fromOffset(6, 4),
		Parent = heading,
	})
	Theme.Label({
		Text = "Kept forever · small boost per level",
		MaxTextSize = 14,
		StrokeThickness = 1.5,
		Size = UDim2.new(1, -12, 0, 18),
		Position = UDim2.fromOffset(6, 34),
		Parent = heading,
	})

	local cards: { CardRefs } = {}
	for index, info in UPGRADES do
		local card, body = Theme.Card({
			Name = info.kind,
			Title = info.title,
			HeaderHeight = 34,
			TitleSize = 22,
			Size = UDim2.fromOffset(206, 182),
			LayoutOrder = index,
			Parent = left,
		})
		card.Active = true
		Theme.List(body, "Vertical", 3)

		local top = Instance.new("Frame")
		top.BackgroundTransparency = 1
		top.Size = UDim2.new(1, 0, 0, 42)
		top.LayoutOrder = 1
		top.Parent = body
		Theme.Label({
			Text = info.icon,
			StrokeThickness = 0,
			MaxTextSize = 36,
			Size = UDim2.new(0, 42, 1, 0),
			Parent = top,
		})
		local value = Theme.Label({
			Text = "",
			MaxTextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -48, 1, 0),
			Position = UDim2.fromOffset(48, 0),
			Parent = top,
		})
		local level = Theme.Label({
			Text = "LEVEL 1 ⬆",
			MaxTextSize = 20,
			Size = UDim2.new(1, 0, 0, 22),
			LayoutOrder = 2,
			Parent = body,
		})
		local nextText = Theme.Label({
			Text = "",
			MaxTextSize = 15,
			StrokeThickness = 1.5,
			TextColor3 = Color3.fromRGB(220, 238, 255),
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = 3,
			Parent = body,
		})
		local refs: CardRefs
		local button = Theme.Button({
			Name = "Buy",
			Text = "",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.new(1, 0, 0, 40),
			MaxTextSize = 22,
			LayoutOrder = 4,
			OnClick = function()
				if refs and not refs.busy then
					props.OnBuy(info.kind)
				end
			end,
			Parent = body,
		})
		Theme.CoinIcon({
			Size = UDim2.fromOffset(26, 26),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 8, 0.5, -2),
			Parent = button,
		})
		refs = { info = info, value = value, level = level, nextText = nextText, button = button, busy = false }
		table.insert(cards, refs)
	end

	---------------------------------------------------------------------------
	-- RIGHT: bonuses card (pink header like "Skins" in image 2)
	---------------------------------------------------------------------------
	local rightHolder = Instance.new("Frame")
	rightHolder.Name = "BonusHolder"
	rightHolder.BackgroundTransparency = 1
	rightHolder.AnchorPoint = Vector2.new(1, 0.5)
	rightHolder.Position = UDim2.new(1, -16, 0.5, 60)
	rightHolder.Size = UDim2.fromOffset(206, 230)
	rightHolder.Parent = root
	responsive(rightHolder)
	local _, bonusBody = Theme.Card({
		Name = "Bonuses",
		Title = "Bonuses",
		HeaderColor = P.CardPink,
		HeaderDarkColor = P.CardPinkDark,
		HeaderHeight = 38,
		TitleSize = 26,
		Size = UDim2.fromScale(1, 1),
		Parent = rightHolder,
	})
	Theme.List(bonusBody, "Vertical", 4)
	local function bonusRow(order: number, icon: string, title: string): TextLabel
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 82)
		row.LayoutOrder = order
		row.Parent = bonusBody
		Theme.Label({ Text = icon, StrokeThickness = 0, MaxTextSize = 34, Size = UDim2.new(0, 40, 0, 40), Parent = row })
		Theme.Label({
			Text = title,
			MaxTextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -44, 0, 40),
			Position = UDim2.fromOffset(44, 0),
			Parent = row,
		})
		return Theme.Label({
			Text = "",
			MaxTextSize = 20,
			TextColor3 = P.MoneyGreen,
			Size = UDim2.new(1, 0, 0, 36),
			Position = UDim2.fromOffset(0, 42),
			Parent = row,
		})
	end
	local vehicleValue = bonusRow(1, "🚙", "Vehicle")
	local boostValue = bonusRow(2, "⚡", "2x Cash")

	---------------------------------------------------------------------------
	-- BOTTOM: tutorial hand + <-> arrow
	---------------------------------------------------------------------------
	local hint = Instance.new("Frame")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -24)
	hint.Size = UDim2.fromOffset(420, 190)
	hint.Parent = root
	responsive(hint)

	local arrowBar = Instance.new("Frame")
	arrowBar.Name = "Arrow"
	arrowBar.BackgroundColor3 = P.White
	arrowBar.AnchorPoint = Vector2.new(0.5, 0.5)
	arrowBar.Position = UDim2.new(0.5, 0, 0, 52)
	arrowBar.Size = UDim2.fromOffset(250, 14)
	arrowBar.Parent = hint
	Theme.Corner(arrowBar, 0.5)
	Theme.Stroke(arrowBar, P.TextStroke, 3, true)
	for _, side in { -1, 1 } do
		Theme.Label({
			Text = if side < 0 then "◀" else "▶",
			MaxTextSize = 64,
			StrokeThickness = 3,
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, side * 140, 0, 50),
			Parent = hint,
		})
	end
	local hand = Theme.Label({
		Text = "👆",
		StrokeThickness = 0,
		MaxTextSize = 72,
		Size = UDim2.fromOffset(84, 84),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, -60, 0, 50),
		Parent = hint,
	})
	-- Slide the hand left <-> right forever (stops when destroyed).
	local slide = TweenService:Create(
		hand,
		TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = UDim2.new(0.5, 60, 0, 50) }
	)
	slide:Play()
	Theme.Label({
		Text = "Drag or press A / D to start",
		MaxTextSize = 30,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -40),
		Parent = hint,
	})

	---------------------------------------------------------------------------
	-- Back button (bottom-right, clear of the upgrade column)
	---------------------------------------------------------------------------
	local backHolder = Instance.new("Frame")
	backHolder.BackgroundTransparency = 1
	backHolder.AnchorPoint = Vector2.new(1, 1)
	backHolder.Position = UDim2.new(1, -16, 1, -16)
	backHolder.Size = UDim2.fromOffset(130, 56)
	backHolder.Parent = root
	responsive(backHolder)
	Theme.Button({
		Name = "Back",
		Text = "Back",
		Color = P.ButtonRed,
		DarkColor = P.ButtonRedDark,
		Size = UDim2.fromScale(1, 1),
		MaxTextSize = 26,
		OnClick = function()
			props.OnBack()
		end,
		Parent = backHolder,
	})

	---------------------------------------------------------------------------
	-- Refresh
	---------------------------------------------------------------------------
	local lastData = props.Data
	local lastStats = props.Stats
	local lastOverrides: { [string]: number }? = nil

	local function refresh()
		local data = lastData
		for _, refs in cards do
			local kind = refs.info.kind
			local level = upgradeLevel(data, kind, lastOverrides)
			refs.value.Text = refs.info.value(lastStats)
			-- Upgrade levels are stored from 0; shown from LEVEL 1. [PROPOSAL]
			refs.level.Text = "LEVEL " .. (level + 1) .. " ⬆"
			local price: number? = nil
			if level < Economy.RunnerUpgradeMaxLevel then
				local ok, value = pcall(Economy.RunnerUpgradePrice, kind, level)
				if ok and type(value) == "number" then
					price = value
				end
			end
			if price == nil then
				refs.nextText.Text = "Fully upgraded!"
				Theme.SetButtonText(refs.button, "MAX")
				Theme.SetButtonEnabled(refs.button, false)
			else
				refs.nextText.Text = "Next: " .. safeEffect(kind, level)
				Theme.SetButtonText(refs.button, "     " .. Format.Money(price))
				local affordable = data.cash + 1e-6 >= price
				Theme.SetButtonEnabled(refs.button, affordable and not refs.busy)
			end
		end

		local vehicleName, bonus = vehicleBonusFor(data)
		if vehicleName and bonus > 0 then
			vehicleValue.Text = "+" .. Format.Percent(bonus) .. " cash"
			vehicleValue.TextColor3 = P.MoneyGreen
		else
			vehicleValue.Text = "None (Shop)"
			vehicleValue.TextColor3 = P.White
		end
		local boostSeconds = data.boosts and data.boosts.multiplierSeconds or 0
		if boostSeconds > 0 then
			boostValue.Text = "ON " .. Format.Clock(boostSeconds)
			boostValue.TextColor3 = P.MoneyGreen
		else
			boostValue.Text = "Off"
			boostValue.TextColor3 = P.White
		end
	end
	refresh()

	return {
		Update = function(data: PlayerData, stats: RunnerStats, overrides: { [string]: number }?)
			lastData = data
			lastStats = stats
			lastOverrides = overrides
			if root.Parent then
				refresh()
			end
		end,
		SetBusy = function(kind: string, busy: boolean)
			for _, refs in cards do
				if refs.info.kind == kind then
					refs.busy = busy
					if not busy then
						Theme.Pop(refs.button)
					end
				end
			end
			if root.Parent then
				refresh()
			end
		end,
		Destroy = function()
			slide:Cancel()
			root:Destroy()
		end,
	}
end

-------------------------------------------------------------------------------
-- Completion summary
-------------------------------------------------------------------------------
local LINE_ICONS: { [string]: string } = {
	troops = "🪖",
	weapon = "🔫",
	damage = "💥",
	cash = "💰",
	enemies = "🎯",
	boss = "👹",
	bonus = "🚙",
}

local function subHeading(parent: Instance, order: number, text: string, color: Color3)
	local pill = Instance.new("Frame")
	pill.Name = "SubHeading"
	pill.BackgroundColor3 = P.PillBlack
	pill.BackgroundTransparency = 0.15
	pill.Size = UDim2.new(1, 0, 0, 32)
	pill.LayoutOrder = order
	pill.Parent = parent
	Theme.Corner(pill, 0.5)
	Theme.Label({
		Text = text,
		TextColor3 = color,
		MaxTextSize = 22,
		Size = UDim2.new(1, -16, 1, -4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = pill,
	})
end

local function moneyText(value: number): string
	if value < 0 then
		return Format.Money(value)
	elseif value < 0.5 then
		return Format.Money(0)
	end
	return "+" .. Format.Money(value)
end

local function summaryRow(parent: Instance, order: number, icon: string, label: string, detail: string, value: number?)
	local row = Instance.new("Frame")
	row.Name = "Line"
	row.BackgroundColor3 = P.CardBlueDark
	row.BackgroundTransparency = 0.35
	row.Size = UDim2.new(1, -8, 0, 46)
	row.LayoutOrder = order
	row.Parent = parent
	Theme.Corner(row, 10)
	Theme.Label({ Text = icon, StrokeThickness = 0, MaxTextSize = 28, Size = UDim2.fromOffset(40, 46), Parent = row })
	Theme.Label({
		Text = label,
		MaxTextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.62, -44, 0, 24),
		Position = UDim2.fromOffset(42, 2),
		Parent = row,
	})
	Theme.Label({
		Text = detail,
		MaxTextSize = 15,
		StrokeThickness = 1.5,
		TextColor3 = Color3.fromRGB(220, 238, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.62, -44, 0, 18),
		Position = UDim2.fromOffset(42, 26),
		Parent = row,
	})
	if value then
		Theme.Label({
			Text = moneyText(value),
			TextColor3 = if value < 0 then P.ButtonRed elseif value < 0.5 then P.White else P.MoneyGreen,
			MaxTextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.38, -46, 1, -8),
			Position = UDim2.new(0.62, 0, 0, 4),
			Parent = row,
		})
		Theme.CoinIcon({
			Size = UDim2.fromOffset(28, 28),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Parent = row,
		})
	end
end

function RunnerUI.ShowSummary(props: {
	Level: number,
	Result: Result,
	Paid: number,
	Boosted: boolean,
	Upgrades: { troops: number, damage: number, capacity: number },
	OnCollect: () -> (),
	OnRetry: (() -> ())?,
}): () -> ()
	local collected = false
	local onRetry = props.OnRetry
	local _, content, close = Theme.Panel({
		Name = "RunnerSummary",
		Title = "RUN COMPLETE!",
		Closable = false,
		Size = UDim2.fromOffset(600, 660),
	})
	Theme.List(content, "Vertical", 8)

	Theme.Label({
		Text = if onRetry
			then ("Level %d - beat the boss to unlock Level %d"):format(props.Level, props.Level + 1)
			else "Level " .. props.Level,
		TextColor3 = P.PriceGold,
		MaxTextSize = 28,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 1,
		Parent = content,
	})

	-- Boss result pill (owner request: a boss at the end of every run).
	local result = props.Result
	local bossOutcome = if type(result) == "table" and type(result.boss) == "table" then result.boss else nil
	if bossOutcome then
		local won = bossOutcome.victory == true
		local pill = Instance.new("Frame")
		pill.Name = "BossStatus"
		pill.BackgroundColor3 = if won then P.ButtonGreenDark else P.ButtonRedDark
		pill.Size = UDim2.new(1, 0, 0, 36)
		pill.LayoutOrder = 2
		pill.Parent = content
		Theme.Corner(pill, 0.5)
		Theme.Stroke(pill, P.CardOutline, 2, true)
		Theme.Label({
			Text = if won then "👑 Boss defeated!" else "💀 Defeated by the boss - pick the best lanes to beat it",
			MaxTextSize = 24,
			Size = UDim2.new(1, -16, 1, -4),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Parent = pill,
		})
	end

	subHeading(content, 3, "COLLECTED THIS RUN (this run only)", P.MoneyGreen)

	local list = Instance.new("ScrollingFrame")
	list.Name = "Lines"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.new(1, 0, 0, if bossOutcome then 200 else 232)
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.ScrollBarThickness = 6
	list.LayoutOrder = 4
	list.Parent = content
	Theme.List(list, "Vertical", 5)

	local order = 0
	local lines: { RunnerSim.Line } = if type(result) == "table" and type(result.lines) == "table"
		then result.lines
		else {}
	for _, line in lines do
		order += 1
		local value = if type(line.value) == "number" then line.value else 0
		local label, detail = tostring(line.label), tostring(line.detail or "")
		if line.kind == "bonus" then
			-- The only payout bonus is the equipped vehicle's runner bonus.
			label, detail = "Vehicle bonus", label .. " payout"
		end
		summaryRow(list, order, LINE_ICONS[line.kind] or "⭐", label, detail, value)
	end
	local total = if type(result) == "table" and type(result.total) == "number" then result.total else 0
	if props.Boosted then
		order += 1
		summaryRow(list, order, "⚡", "2x CASH", "Boost active - payout doubled", math.max(0, props.Paid - total))
	end
	if order == 0 then
		summaryRow(list, 1, "🪖", "No pickups this time", "Try the blue gates!", nil)
	end

	-- TOTAL (what was actually added to your cash).
	local totalRow = Instance.new("Frame")
	totalRow.Name = "Total"
	totalRow.BackgroundColor3 = P.PillBlack
	totalRow.BackgroundTransparency = 0.1
	totalRow.Size = UDim2.new(1, 0, 0, 60)
	totalRow.LayoutOrder = 5
	totalRow.Parent = content
	Theme.Corner(totalRow, 14)
	Theme.Stroke(totalRow, P.CardOutline, 2, true)
	Theme.Label({
		Text = "TOTAL",
		MaxTextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.4, -16, 1, -10),
		Position = UDim2.fromOffset(16, 5),
		Parent = totalRow,
	})
	Theme.Label({
		Text = Format.Money(props.Paid),
		TextColor3 = P.MoneyGreen,
		MaxTextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.6, -66, 1, -10),
		Position = UDim2.new(0.4, 0, 0, 5),
		Parent = totalRow,
	})
	Theme.CoinIcon({
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Parent = totalRow,
	})

	-- PERMANENT upgrades, clearly separated from what was collected this run.
	subHeading(content, 6, "PERMANENT UPGRADES (kept forever)", P.PriceGold)
	local upgrades = props.Upgrades
	Theme.Label({
		Text = ("🪖 Troops Lv %d   ·   💥 Damage Lv %d   ·   💰 Carry Lv %d"):format(
			(upgrades.troops or 0) + 1,
			(upgrades.damage or 0) + 1,
			(upgrades.capacity or 0) + 1
		),
		MaxTextSize = 20,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 7,
		Parent = content,
	})

	local buttonRow = Instance.new("Frame")
	buttonRow.BackgroundTransparency = 1
	buttonRow.Size = UDim2.new(1, 0, 0, 66)
	buttonRow.LayoutOrder = 8
	buttonRow.Parent = content
	local function finish(action: () -> ())
		if collected then
			return
		end
		collected = true
		close()
		action()
	end
	if onRetry then
		-- Lost: TRY AGAIN (the same level, right away) is the big button.
		Theme.Button({
			Name = "TryAgain",
			Text = "🔁 TRY AGAIN",
			Color = P.CardOrange,
			DarkColor = P.CardOrangeDark,
			Size = UDim2.fromOffset(250, 64),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(0.5, -6, 0, 0),
			MaxTextSize = 30,
			OnClick = function()
				finish(onRetry)
			end,
			Parent = buttonRow,
		})
		Theme.Button({
			Name = "Collect",
			Text = "🏠 BASE",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.fromOffset(190, 64),
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.new(0.5, 6, 0, 0),
			MaxTextSize = 30,
			OnClick = function()
				finish(props.OnCollect)
			end,
			Parent = buttonRow,
		})
	else
		Theme.Button({
			Name = "Collect",
			Text = "COLLECT",
			Color = P.ButtonGreen,
			DarkColor = P.ButtonGreenDark,
			Size = UDim2.fromOffset(240, 64),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			MaxTextSize = 32,
			OnClick = function()
				finish(props.OnCollect)
			end,
			Parent = buttonRow,
		})
	end

	return close
end

return RunnerUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopUI (client, plain module - not a controller)
	The big pink "Shop" panel (pink header like the "Skins" card in reference
	image 2) with two tabs:

		VEHICLES  one card per Config.Vehicles entry: emoji, name, speed,
		          runner bonus. Locked ones say "Unlocks in Area N". Owned ones
		          show EQUIP / EQUIPPED, the rest BUY, which opens the two-route
		          Theme.PurchaseDialog (fixed Robux price or a cash price that
		          grows with your progress: Economy.VehicleCoinPrice).
		BOOSTS    how the random offers on the home map work, every boost with
		          its appearance chance (Config.Boosts weights, using the same
		          candidate rule as BoostService: a time skip is only offered
		          when it would pay >= 25% of its full value right now), its
		          Robux price, its current cash price, and the active 2x timer.
		          Time skips show "Pays $X now" (Economy.TimeSkipPayout of your
		          shops) and "up to $V when every shop has an employee"; their
		          cash price is 80% of what they pay you now (+25%).

	Public API (used by Controllers/ShopController):
		ShopUI.Open(opts): () -> ()        -- returns close(); does nothing extra if already open
			opts = {
				Tab = "Vehicles" | "Boosts" | nil,
				OnBuyVehicle = function(vehicleId: string, route: "cash" | "robux") end,
				OnEquipVehicle = function(vehicleId: string) end,
				GetBoostSeconds = function(): number end,   -- 2x seconds left right now
				OnClose = function() end?,
			}
		ShopUI.Refresh()                   -- call after a data Sync (rebuilds only if something relevant changed)
		ShopUI.IsOpen(): boolean
		ShopUI.Close()
		ShopUI.BoostPricing(def, data): (price, preview?, reference)
			-- cash price right now (same maths as the server), what a time skip
			   pays right now (nil for 2x) and Economy.BoostValue (the reference)

	All text/prices are display only: the server re-checks every purchase.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(Client.UI.Theme)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local P = Config.Palette

export type OpenOptions = {
	Tab: string?,
	OnBuyVehicle: (vehicleId: string, route: string) -> (),
	OnEquipVehicle: (vehicleId: string) -> (),
	GetBoostSeconds: () -> number,
	OnClose: (() -> ())?,
}

local ShopUI = {}

-- Emoji shown on each vehicle card. [PROPOSAL] (no image assets allowed)
local VEHICLE_EMOJI: { [string]: string } = {
	bike = "🏍️",
	jeep = "🚙",
	truck = "🚚",
	humvee = "🛻",
	apc = "🚛",
	tank = "🪖",
	heavytank = "💥",
	hovertank = "🛸",
}
local STYLE_EMOJI: { [string]: string } = {
	bike = "🏍️",
	jeep = "🚙",
	truck = "🚚",
	apc = "🚛",
	tank = "🪖",
	hover = "🛸",
}

-- Base walk speed shown for comparison (default.project.json CharacterWalkSpeed).
local NORMAL_WALK_SPEED = 20

local shopGui: ScreenGui? = nil
local options: OpenOptions? = nil
local closePanel: (() -> ())? = nil
local content: Frame? = nil
local currentTab = "Vehicles"
local lastSignature = ""
local timerLabel: TextLabel? = nil
local timerThread: thread? = nil
local dialogClose: (() -> ())? = nil

-- Labels of the boosts tab that are updated in place (stock changes every
-- sale, rebuilding the whole tab that often would reset the scroll).
type BoostRow = {
	def: Config.BoostDef,
	detail: TextLabel,
	chance: TextLabel,
	price: TextLabel,
	cashPill: Frame,
}
local boostRows: { BoostRow } = {}

local function getGui(): ScreenGui
	if not shopGui then
		-- Below Theme's modal gui (50) so purchase dialogs appear on top.
		shopGui = Theme.ScreenGui("ShopUI", 40)
	end
	return shopGui :: ScreenGui
end

-- 0.02 -> "2%", 0.2667 -> "26.7%" (one decimal at most, no float noise)
local function pct(fraction: number): string
	return string.format("%g%%", math.floor(fraction * 1000 + 0.5) / 10)
end

-- Cash price, time-skip preview (nil for 2x) and reference value of a boost
-- for this player right now. The server recomputes the price at purchase.
function ShopUI.BoostPricing(def: Config.BoostDef, data: any): (number, number?, number)
	local area = data.base.highestArea
	local reference = Economy.BoostValue(def.id, area)
	if def.kind == "timeskip" then
		local preview = Economy.TimeSkipPayout(data.base.sections, (def.hours or 0) * 3600)
		return Economy.TimeSkipCoinPrice(def.id, area, preview), preview, reference
	end
	return Economy.BoostCoinPrice(def.id, area), nil, reference
end

-- Chance of each boost being the next offer, with the same candidate filter
-- as BoostService.spawnOffer (time skips only when worth offering).
local function offerChances(data: any): { [string]: number }
	local weights: { [string]: number } = {}
	local total = 0
	for _, def in Config.Boosts do
		local offered = true
		if def.kind == "timeskip" then
			local _, preview = ShopUI.BoostPricing(def, data)
			offered = Economy.TimeSkipWorthOffering(def.id, data.base.highestArea, preview or 0)
		end
		if offered then
			weights[def.id] = math.max(0, def.weight)
			total += math.max(0, def.weight)
		end
	end
	local chances: { [string]: number } = {}
	for _, def in Config.Boosts do
		chances[def.id] = if total > 0 then (weights[def.id] or 0) / total else 0
	end
	return chances
end

-- A compact text describing everything the current tab depends on, so we
-- only rebuild when it changes (data syncs arrive about once per second).
local function signature(): string
	local data = State.Get()
	if not data then
		return "nodata"
	end
	local parts = { currentTab, tostring(data.base.highestArea), tostring(data.vehicles.equipped) }
	if currentTab == "Vehicles" then
		for _, def in Config.Vehicles do
			local price = Economy.VehicleCoinPrice(def.id, data.base.highestArea)
			table.insert(
				parts,
				def.id
					.. (if data.vehicles.owned[def.id] then "o" else "-")
					.. (if data.cash + 1e-6 >= price then "a" else "-")
			)
		end
	end
	-- Boosts tab: prices / previews / chances are updated in place
	-- (updateBoostRows), only the tab and the area rebuild it.
	return table.concat(parts, "|")
end

local function smallLabel(
	parent: Instance,
	text: string,
	order: number,
	height: number,
	color: Color3?,
	maxSize: number?
): TextLabel
	return Theme.Label({
		Text = text,
		TextColor3 = color or P.White,
		MaxTextSize = maxSize or 20,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = order,
		Parent = parent,
	})
end

-------------------------------------------------------------------------------
-- Vehicles tab
-------------------------------------------------------------------------------

local function openVehicleDialog(def: Config.VehicleDef)
	local data = State.Get()
	local opts = options
	if not data or not opts or dialogClose then
		return
	end
	local price = Economy.VehicleCoinPrice(def.id, data.base.highestArea)
	local productId = Config.ProductIds["vehicle_" .. def.id] or 0
	dialogClose = Theme.PurchaseDialog({
		Title = def.name,
		Description = ("Ride it around your base at speed %d (walking is %d).\nWhile equipped, every Army Run pays +%s cash."):format(
			def.speed,
			NORMAL_WALK_SPEED,
			pct(def.runnerBonus)
		),
		RobuxPrice = def.robux,
		RobuxEnabled = productId ~= 0,
		CashPrice = price,
		CashAffordable = data.cash + 1e-6 >= price,
		Footnote = "The Robux price is fixed. The cash price grows with the areas you unlock.",
		Context = "Base",
		OnClose = function()
			dialogClose = nil
		end,
		OnRobux = function()
			opts.OnBuyVehicle(def.id, "robux")
		end,
		OnCash = function()
			opts.OnBuyVehicle(def.id, "cash")
		end,
	})
end

local function buildVehicleCard(parent: Instance, def: Config.VehicleDef, index: number)
	local data = State.Get()
	if not data then
		return
	end
	local owned = data.vehicles.owned[def.id] == true
	local equipped = owned and data.vehicles.equipped == def.id
	local locked = not owned and data.base.highestArea < def.area
	local price = Economy.VehicleCoinPrice(def.id, data.base.highestArea)

	local card, body = Theme.Card({
		Name = "Vehicle_" .. def.id,
		Title = def.name,
		TitleSize = 22,
		HeaderColor = if locked then P.ButtonGrey elseif equipped then P.ButtonGreen else P.CardOrange,
		HeaderDarkColor = if locked then P.ButtonGreyDark elseif equipped then P.ButtonGreenDark else P.CardOrangeDark,
		BodyColor = if locked then P.ButtonGreyDark else P.CardBlue,
		BodyDarkColor = if locked then P.Shade else P.CardBlueDark,
		HeaderHeight = 38,
		LayoutOrder = index,
		Parent = parent,
	})
	card.Size = UDim2.fromScale(1, 1)
	Theme.List(body, "Vertical", 2)

	local emoji = VEHICLE_EMOJI[def.id] or STYLE_EMOJI[def.style] or "🚙"
	smallLabel(body, if locked then "🔒" else emoji, 1, 66, nil, 56)
	smallLabel(body, ("⚡ Speed %d"):format(def.speed), 2, 24)
	smallLabel(body, ("💰 +%s run cash"):format(pct(def.runnerBonus)), 3, 24, P.MoneyGreen)

	local status: string
	local statusColor = P.PriceGold
	if owned then
		status = if equipped then "Equipped ✓" else "Owned"
		statusColor = P.MoneyGreen
	elseif locked then
		status = ("Unlocks in Area %d"):format(def.area)
		statusColor = P.White
	else
		status = ("%s or %s"):format(Format.Robux(def.robux), Format.Money(price))
	end
	smallLabel(body, status, 4, 36, statusColor, 20)

	local buttonText: string
	local color = P.ButtonGreen
	local dark = P.ButtonGreenDark
	local enabled = true
	local onClick: () -> ()
	if equipped then
		buttonText = "EQUIPPED"
		enabled = false
		onClick = function() end
	elseif owned then
		buttonText = "EQUIP"
		color, dark = P.CardBlue, P.CardBlueDark
		onClick = function()
			local opts = options
			if opts then
				opts.OnEquipVehicle(def.id)
			end
		end
	elseif locked then
		buttonText = "LOCKED"
		enabled = false
		onClick = function() end
	else
		buttonText = "BUY"
		onClick = function()
			openVehicleDialog(def)
		end
	end
	local button = Theme.Button({
		Text = buttonText,
		Color = color,
		DarkColor = dark,
		Size = UDim2.new(1, -8, 0, 46),
		LayoutOrder = 5,
		MaxTextSize = 24,
		OnClick = onClick,
		Parent = body,
	})
	if not enabled then
		Theme.SetButtonEnabled(button, false)
	end
end

local function buildVehiclesTab(page: Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Vehicles"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = P.CardOutline
	scroll.Parent = page
	Theme.Padding(scroll, 6)

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(186, 268)
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = scroll

	for index, def in Config.Vehicles do
		buildVehicleCard(scroll, def, index)
	end
end

-------------------------------------------------------------------------------
-- Boosts tab
-------------------------------------------------------------------------------

local function timerText(): string
	local opts = options
	local seconds = if opts then opts.GetBoostSeconds() else 0
	if seconds > 0 then
		return ("⚡ 2x CASH active: %s left"):format(Format.Clock(seconds))
	end
	return "No 2x boost active right now"
end

local function boostDetailText(def: Config.BoostDef, preview: number?, reference: number): string
	if def.kind == "multiplier" then
		return ("Doubles ALL cash you earn for %d min of play time  •  worth ~%s"):format(
			def.minutes or 0,
			Format.Money(reference)
		)
	end
	local now = preview or 0
	if now >= reference then
		return ("Pays %s now"):format(Format.Money(now))
	end
	return ("Pays %s now  •  up to %s when every shop has an employee"):format(
		Format.Money(now),
		Format.Money(reference)
	)
end

local function chanceText(chance: number): string
	return ("🍀 %s chance"):format(pct(chance))
end

-- Refresh the numbers of every boost row (stock, cash and area change often).
local function updateBoostRows()
	local data = State.Get()
	if not data or #boostRows == 0 then
		return
	end
	local chances = offerChances(data)
	for _, row in boostRows do
		if not row.price.Parent then
			continue
		end
		local price, preview, reference = ShopUI.BoostPricing(row.def, data)
		local affordable = price > 0 and data.cash + 1e-6 >= price
		row.detail.Text = boostDetailText(row.def, preview, reference)
		row.chance.Text = chanceText(chances[row.def.id] or 0)
		row.price.Text = Format.Money(price)
		row.cashPill.BackgroundColor3 = if affordable then P.ButtonGreen else P.ButtonGreyDark
	end
end

local function buildBoostRow(parent: Instance, def: Config.BoostDef, order: number, chance: number)
	local data = State.Get()
	if not data then
		return
	end
	local price, preview, value = ShopUI.BoostPricing(def, data)
	local affordable = price > 0 and data.cash + 1e-6 >= price

	local row = Instance.new("Frame")
	row.Name = "Boost_" .. def.id
	row.BackgroundColor3 = P.OfferPurple
	row.Size = UDim2.new(1, -12, 0, 66)
	row.LayoutOrder = order
	row.Parent = parent
	Theme.Corner(row, 12)
	Theme.Stroke(row, P.OfferPurpleDark, 2.5, true)

	Theme.Label({
		Text = if def.kind == "multiplier" then "⚡" else "⏩",
		MaxTextSize = 40,
		StrokeThickness = 0,
		Size = UDim2.new(0, 56, 1, 0),
		Parent = row,
	})
	Theme.Label({
		Text = def.name,
		MaxTextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.42, -60, 0.5, -2),
		Position = UDim2.fromOffset(58, 4),
		Parent = row,
	})
	local detail = Theme.Label({
		Text = boostDetailText(def, preview, value),
		MaxTextSize = 16,
		TextColor3 = Color3.fromRGB(226, 214, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.42, -60, 0.5, -6),
		Position = UDim2.new(0, 58, 0.5, 0),
		Parent = row,
	})

	-- Chance pill
	local chancePill = Instance.new("Frame")
	chancePill.BackgroundColor3 = P.OfferPurpleDark
	chancePill.AnchorPoint = Vector2.new(0, 0.5)
	chancePill.Position = UDim2.new(0.42, 4, 0.5, 0)
	chancePill.Size = UDim2.new(0.2, -8, 0, 46)
	chancePill.Parent = row
	Theme.Corner(chancePill, 10)
	local chanceLabel = Theme.Label({
		Text = chanceText(chance),
		MaxTextSize = 18,
		Size = UDim2.new(1, -8, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = chancePill,
	})

	-- Robux price pill
	local robuxPill = Instance.new("Frame")
	robuxPill.BackgroundColor3 = P.Robux
	robuxPill.AnchorPoint = Vector2.new(0, 0.5)
	robuxPill.Position = UDim2.new(0.62, 4, 0.5, 0)
	robuxPill.Size = UDim2.new(0.15, -8, 0, 46)
	robuxPill.Parent = row
	Theme.Corner(robuxPill, 10)
	Theme.Stroke(robuxPill, P.RobuxDark, 2, true)
	Theme.Label({
		Text = Format.Robux(def.robux),
		MaxTextSize = 20,
		Size = UDim2.new(1, -8, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = robuxPill,
	})

	-- Cash price pill (green when you can afford it)
	local cashPill = Instance.new("Frame")
	cashPill.BackgroundColor3 = if affordable then P.ButtonGreen else P.ButtonGreyDark
	cashPill.AnchorPoint = Vector2.new(0, 0.5)
	cashPill.Position = UDim2.new(0.77, 4, 0.5, 0)
	cashPill.Size = UDim2.new(0.23, -10, 0, 46)
	cashPill.Parent = row
	Theme.Corner(cashPill, 10)
	Theme.Stroke(cashPill, P.CardOutline, 2, true)
	Theme.CoinIcon({
		Size = UDim2.fromOffset(28, 28),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Parent = cashPill,
	})
	local priceLabel = Theme.Label({
		Text = Format.Money(price),
		TextColor3 = P.PriceGold,
		MaxTextSize = 20,
		Size = UDim2.new(1, -44, 1, -6),
		Position = UDim2.new(0, 38, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = cashPill,
	})
	table.insert(
		boostRows,
		{ def = def, detail = detail, chance = chanceLabel, price = priceLabel, cashPill = cashPill }
	)
end

local function buildBoostsTab(page: Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Boosts"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = P.CardOutline
	scroll.Parent = page
	Theme.Padding(scroll, 6)
	Theme.List(scroll, "Vertical", 8)

	-- How it works
	local info = Instance.new("Frame")
	info.Name = "HowItWorks"
	info.BackgroundColor3 = P.CardBlueDark
	info.Size = UDim2.new(1, -12, 0, 165)
	info.LayoutOrder = 1
	info.Parent = scroll
	Theme.Corner(info, 12)
	Theme.Stroke(info, P.CardOutline, 2.5, true)
	Theme.Label({
		Text = "🎁 How boost offers work",
		MaxTextSize = 26,
		Size = UDim2.new(1, -20, 0, 34),
		Position = UDim2.fromOffset(10, 4),
		Parent = info,
	})
	local minMinutes = Config.BoostOffers.MinInterval / 60
	local maxMinutes = Config.BoostOffers.MaxInterval / 60
	Theme.Label({
		Text = ("Every %s-%s minutes a purple bubble pops up on a walkway of your base (up to %d at once, each stays %ds). Walk into it to buy it with Robux or cash. It is luck: cheap boosts appear often, valuable ones rarely. 2x cash price = 80%% of its value (+25%% if you keep playing). Time skips: cash price = 80%% of what it pays you now (+25%%); they only appear once your shops would collect at least %d%% of the full amount, so hire employees!"):format(
			string.format("%g", math.floor(minMinutes * 10 + 0.5) / 10),
			string.format("%g", math.floor(maxMinutes * 10 + 0.5) / 10),
			Config.BoostOffers.MaxActive,
			Config.BoostOffers.Lifetime,
			math.floor(Economy.TimeSkipOfferMinShare * 100 + 0.5)
		),
		MaxTextSize = 18,
		TextColor3 = Color3.fromRGB(226, 238, 255),
		Size = UDim2.new(1, -20, 1, -44),
		Position = UDim2.fromOffset(10, 38),
		Parent = info,
	})

	-- Active 2x timer
	local timerRow = Instance.new("Frame")
	timerRow.Name = "Timer"
	timerRow.BackgroundColor3 = P.PillBlack
	timerRow.Size = UDim2.new(1, -12, 0, 46)
	timerRow.LayoutOrder = 2
	timerRow.Parent = scroll
	Theme.Corner(timerRow, 0.5)
	timerLabel = Theme.Label({
		Text = timerText(),
		MaxTextSize = 24,
		TextColor3 = P.MoneyGreen,
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = timerRow,
	})

	local data = State.Get()
	local chances = if data then offerChances(data) else {}
	for index, def in Config.Boosts do
		buildBoostRow(scroll, def, 10 + index, chances[def.id] or 0)
	end
end

-------------------------------------------------------------------------------
-- Panel
-------------------------------------------------------------------------------

local rebuild: () -> ()

local function buildTabs(parent: Frame)
	local row = Instance.new("Frame")
	row.Name = "Tabs"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 56)
	row.Parent = parent
	Theme.List(row, "Horizontal", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local tabs = { { id = "Vehicles", text = "🚙 VEHICLES" }, { id = "Boosts", text = "⚡ BOOSTS" } }
	for index, tab in tabs do
		local active = currentTab == tab.id
		Theme.Button({
			Name = tab.id,
			Text = tab.text,
			Color = if active then P.CardPink else P.ButtonGrey,
			DarkColor = if active then P.CardPinkDark else P.ButtonGreyDark,
			Size = UDim2.fromOffset(220, 52),
			LayoutOrder = index,
			MaxTextSize = 26,
			OnClick = function()
				if currentTab ~= tab.id then
					currentTab = tab.id
					rebuild()
				end
			end,
			Parent = row,
		})
	end
end

rebuild = function()
	local frame = content
	if not frame then
		return
	end
	timerLabel = nil
	table.clear(boostRows)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	buildTabs(frame)
	local page = Instance.new("Frame")
	page.Name = "Page"
	page.BackgroundTransparency = 1
	page.Position = UDim2.fromOffset(0, 64)
	page.Size = UDim2.new(1, 0, 1, -64)
	page.Parent = frame
	if currentTab == "Boosts" then
		buildBoostsTab(page)
	else
		buildVehiclesTab(page)
	end
	lastSignature = signature()
end

function ShopUI.IsOpen(): boolean
	return closePanel ~= nil
end

function ShopUI.Close()
	local close = closePanel
	if close then
		close()
	end
end

function ShopUI.Open(opts: OpenOptions): () -> ()
	if closePanel then
		return closePanel :: () -> ()
	end
	options = opts
	currentTab = if opts.Tab == "Boosts" then "Boosts" else "Vehicles"

	local _, body, close = Theme.Panel({
		Name = "Shop",
		Title = "🛒 Shop",
		HeaderColor = P.CardPink,
		HeaderDarkColor = P.CardPinkDark,
		Size = UDim2.fromOffset(880, 590),
		Gui = getGui(),
		Context = "Base",
		OnClose = function()
			closePanel = nil
			content = nil
			timerLabel = nil
			table.clear(boostRows)
			options = nil
			local thread = timerThread
			timerThread = nil
			if thread and coroutine.status(thread) == "suspended" then
				pcall(task.cancel, thread)
			end
			local dialog = dialogClose
			dialogClose = nil
			if dialog then
				dialog()
			end
			if opts.OnClose then
				opts.OnClose()
			end
		end,
	})
	content = body
	closePanel = close
	rebuild()

	-- Keep the 2x timer text ticking while the panel is open.
	timerThread = task.spawn(function()
		while closePanel == close do
			task.wait(1)
			local label = timerLabel
			if label and label.Parent then
				label.Text = timerText()
			end
		end
	end)
	return close
end

function ShopUI.Refresh()
	if not closePanel then
		return
	end
	if signature() ~= lastSignature then
		rebuild()
	else
		updateBoostRows()
	end
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Theme (client UI kit)
	Builds every piece of UI in the look of the reference images: chunky
	FredokaOne text with dark outlines, black currency pill with a gold coin,
	orange-header / blue-body cards, green money tags, rounded glossy buttons.
	No image assets are needed (coins and icons are drawn with frames/emoji).

	Most functions take a props table. Common props:
		Name, Parent, Size, Position, AnchorPoint, LayoutOrder, ZIndex, Visible

	Quick reference:
		Theme.ScreenGui(name, displayOrder?) -> ScreenGui
		Theme.Label({ Text, TextColor3?, MaxTextSize?, StrokeThickness?, ... }) -> TextLabel
		Theme.Button({ Text, Color?, DarkColor?, OnClick, MaxTextSize?, ... }) -> TextButton
		Theme.SetButtonEnabled(button, enabled)
		Theme.Card({ Title, HeaderColor?, HeaderDarkColor?, BodyColor?, BodyDarkColor?, ... }) -> (card, body)
		Theme.Panel({ Title, Name?, Context?, HeaderColor?, OnClose?, Size?, Gui? }) -> (panel, content, close)
		Theme.IsModalOpen() -> boolean, Theme.CloseModals(context?), Theme.TopInset() -> number
		Theme.CoinIcon({ ... }) -> Frame
		Theme.CashPill({ ... }) -> (Frame, setAmount(number))
		Theme.MoneyTag({ Text, ... }) -> (Frame, setText(string))
		Theme.Banner({ Text, ... }) -> (Frame, setText(string))
		Theme.PurchaseDialog({ Title, Description, RobuxPrice?, RobuxEnabled?, CashPrice?, OnRobux?, OnCash?, Context? })
		Theme.Confirm({ Title, Body, ConfirmText?, OnConfirm, Name?, Context? })
		Theme.Toast(text, kind?)
		Theme.FloatText(worldPosition, text, color?)
		Theme.Billboard({ Adornee?, Parent, Size, StudsOffset?, AlwaysOnTop?, MaxDistance? }) -> BillboardGui
		Theme.RarityColor(rarity) -> Color3
		Theme.Tween(instance, goals, duration?, style?, direction?) -> Tween
		Theme.Pop(guiObject)
		Theme.Corner/Stroke/Gradient/Padding/List/AspectRatio helpers
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local P = Config.Palette
local player = Players.LocalPlayer

local Theme = {}
Theme.Palette = P
Theme.Font = Config.Font

type Props = { [string]: any }

local GENERIC_KEYS = {
	"Name",
	"Size",
	"Position",
	"AnchorPoint",
	"LayoutOrder",
	"ZIndex",
	"Visible",
	"BackgroundColor3",
	"BackgroundTransparency",
	"ClipsDescendants",
	"AutomaticSize",
	"Rotation",
}

local function applyGeneric(instance: Instance, props: Props)
	local target = instance :: any
	for _, key in GENERIC_KEYS do
		if props[key] ~= nil then
			target[key] = props[key]
		end
	end
end

-------------------------------------------------------------------------------
-- Low-level helpers
-------------------------------------------------------------------------------

-- Generic creator: Theme.New("Frame", { Size = ..., Parent = ... }, { children })
function Theme.New(className: string, props: Props?, children: { Instance }?): Instance
	local instance = Instance.new(className) :: any
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = if radius and radius < 1 and radius > 0 then UDim.new(radius, 0) else UDim.new(0, radius or 12)
	c.Parent = parent
	return c
end

-- isBorder = true draws an outline around a frame; otherwise it outlines text.
function Theme.Stroke(parent: Instance, color: Color3?, thickness: number?, isBorder: boolean?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or P.TextStroke
	s.Thickness = thickness or 2.5
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.ApplyStrokeMode = if isBorder then Enum.ApplyStrokeMode.Border else Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
	return s
end

function Theme.Gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Theme.Padding(parent: Instance, px: number, py: number?): UIPadding
	local p = Instance.new("UIPadding")
	local vertical = py or px
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, vertical)
	p.PaddingBottom = UDim.new(0, vertical)
	p.Parent = parent
	return p
end

-- direction: "Vertical" | "Horizontal"
function Theme.List(
	parent: Instance,
	direction: string?,
	padding: number?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = if direction == "Horizontal" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding or 8)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	l.Parent = parent
	return l
end

function Theme.AspectRatio(parent: Instance, ratio: number): UIAspectRatioConstraint
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.Parent = parent
	return a
end

function Theme.Tween(
	instance: Instance,
	goals: { [string]: any },
	duration: number?,
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goals
	)
	tween:Play()
	return tween
end

-- Every object gets at most ONE UIScale (Roblox applies only one per object).
-- It is shared by the press / pop animations and Theme.ResponsiveScale; the
-- animations scale relative to its "BaseScale" attribute (1 unless the object
-- is responsive, then the screen-size factor).
local SCALE_NAME = "ThemeScale"

local function getScale(gui: GuiObject): UIScale
	local scale = gui:FindFirstChild(SCALE_NAME) :: UIScale?
	if not scale then
		local created = Instance.new("UIScale")
		created.Name = SCALE_NAME
		created:SetAttribute("BaseScale", 1)
		created.Parent = gui
		scale = created
	end
	return scale :: UIScale
end

-- The running pop / press animation of each UIScale, so a screen resize can
-- stop it (otherwise it would finish at the old size).
local scaleTweens: { [UIScale]: Tween } = setmetatable({} :: any, { __mode = "k" })

local function tweenScale(scale: UIScale, target: number, duration: number, style: Enum.EasingStyle?)
	local tween = Theme.Tween(scale, { Scale = target }, duration, style)
	scaleTweens[scale] = tween
end

local function baseScaleOf(scale: UIScale): number
	local base = scale:GetAttribute("BaseScale")
	return if type(base) == "number" then base else 1
end

-- Quick "bounce" used when something is bought / appears.
function Theme.Pop(gui: GuiObject)
	local scale = getScale(gui)
	local base = baseScaleOf(scale)
	scale.Scale = base * 0.85
	tweenScale(scale, base, 0.35, Enum.EasingStyle.Back)
end

function Theme.RarityColor(rarity: number): Color3
	return P.Rarity[math.clamp(rarity, 1, #P.Rarity)]
end

function Theme.RarityName(rarity: number): string
	local def = Config.Rarities[math.clamp(rarity, 1, #Config.Rarities)]
	return def.name
end

-- Shrinks UI on small (phone) screens, grows it a little on big screens.
function Theme.ResponsiveScale(gui: GuiObject, baseHeight: number?): UIScale
	local scale = getScale(gui)
	if scale:GetAttribute("Responsive") then
		return scale -- already responsive
	end
	scale:SetAttribute("Responsive", true)
	local function update()
		local camera = Workspace.CurrentCamera
		local height = if camera then camera.ViewportSize.Y else 800
		local base = math.clamp(height / (baseHeight or 820), 0.55, 1.25)
		local running = scaleTweens[scale]
		if running then
			running:Cancel()
			scaleTweens[scale] = nil
		end
		scale:SetAttribute("BaseScale", base)
		scale.Scale = base
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		local connection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		-- Stop listening once the UI is destroyed (panels are created and destroyed often).
		scale.Destroying:Connect(function()
			connection:Disconnect()
		end)
	end
	return scale
end

-------------------------------------------------------------------------------
-- Building blocks
-------------------------------------------------------------------------------

function Theme.ScreenGui(name: string, displayOrder: number?): ScreenGui
	local playerGui = player:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing and existing:IsA("ScreenGui") then
		return existing
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder or 0
	gui.Parent = playerGui
	return gui
end

-- Bold outlined label. Text scales to fit, up to MaxTextSize.
function Theme.Label(props: Props): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Config.Font
	label.Text = props.Text or ""
	label.TextColor3 = props.TextColor3 or P.White
	label.TextScaled = true
	label.TextWrapped = props.TextWrapped ~= false
	label.RichText = props.RichText == true
	label.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center
	label.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	label.Size = UDim2.fromScale(1, 1)
	applyGeneric(label, props)
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = props.MaxTextSize or 32
	limit.MinTextSize = props.MinTextSize or 8
	limit.Parent = label
	if props.StrokeThickness ~= 0 then
		Theme.Stroke(label, props.StrokeColor, props.StrokeThickness or 2.5)
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

local function darken(color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end
Theme.Darken = darken

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end
Theme.Lighten = lighten

-- Glossy rounded button with a darker "lip" underneath (pressable look).
function Theme.Button(props: Props): TextButton
	local color: Color3 = props.Color or P.ButtonGreen
	local dark: Color3 = props.DarkColor or darken(color, 0.3)

	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.Text = ""
	button.BackgroundColor3 = dark
	button.Size = UDim2.fromOffset(200, 60)
	applyGeneric(button, props)
	button.BackgroundColor3 = dark
	Theme.Corner(button, props.CornerRadius or 14)
	Theme.Stroke(button, P.CardOutline, 2.5, true)

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.BackgroundColor3 = color
	face.Size = UDim2.new(1, 0, 1, -5)
	face.ZIndex = button.ZIndex
	face.Parent = button
	Theme.Corner(face, props.CornerRadius or 14)
	Theme.Gradient(face, lighten(color, 0.18), color)

	local label = Theme.Label({
		Name = "Label",
		Text = props.Text or "",
		MaxTextSize = props.MaxTextSize or 28,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = button.ZIndex + 1,
		RichText = props.RichText,
		Parent = face,
	})
	label.Name = "Label"

	local scale = getScale(button)
	button.MouseButton1Down:Connect(function()
		tweenScale(scale, baseScaleOf(scale) * 0.94, 0.08)
	end)
	button.MouseButton1Up:Connect(function()
		tweenScale(scale, baseScaleOf(scale), 0.12, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		tweenScale(scale, baseScaleOf(scale), 0.12)
	end)
	if props.OnClick then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") then
				return
			end
			props.OnClick()
		end)
	end
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("BaseDarkColor", dark)
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function Theme.SetButtonText(button: TextButton, text: string)
	local face = button:FindFirstChild("Face")
	local label = face and face:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Greys a Theme.Button out (and ignores clicks) or restores its colour.
function Theme.SetButtonEnabled(button: TextButton, enabled: boolean)
	button:SetAttribute("Disabled", not enabled)
	local face = button:FindFirstChild("Face") :: Frame?
	local base = button:GetAttribute("BaseColor") :: Color3?
	local baseDark = button:GetAttribute("BaseDarkColor") :: Color3?
	if face and base and baseDark then
		local color = if enabled then base else P.ButtonGrey
		face.BackgroundColor3 = color
		button.BackgroundColor3 = if enabled then baseDark else P.ButtonGreyDark
		local gradient = face:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Color = ColorSequence.new(lighten(color, 0.18), color)
		end
	end
end

-- Gold coin drawn from frames (matches the coin in both reference images).
function Theme.CoinIcon(props: Props): Frame
	local coin = Instance.new("Frame")
	coin.Name = "Coin"
	coin.BackgroundColor3 = P.CoinDark
	coin.Size = UDim2.fromOffset(40, 40)
	applyGeneric(coin, props)
	Theme.Corner(coin, 0.5)
	Theme.Stroke(coin, P.TextStroke, 2, true)
	Theme.AspectRatio(coin, 1)

	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	inner.Size = UDim2.fromScale(0.74, 0.74)
	inner.BackgroundColor3 = P.Coin
	inner.ZIndex = coin.ZIndex
	inner.Parent = coin
	Theme.Corner(inner, 0.5)
	Theme.Gradient(inner, P.CoinShine, P.Coin, 45)
	if props.Parent then
		coin.Parent = props.Parent
	end
	return coin
end

-- Black rounded currency pill: [coin] $1,562.50 (top-right of both images).
function Theme.CashPill(props: Props): (Frame, (number) -> ())
	local pill = Instance.new("Frame")
	pill.Name = props.Name or "CashPill"
	pill.BackgroundColor3 = P.PillBlack
	pill.BackgroundTransparency = 0.05
	pill.Size = UDim2.fromOffset(240, 58)
	applyGeneric(pill, props)
	Theme.Corner(pill, 0.5)

	local coin = Theme.CoinIcon({
		Size = UDim2.new(0, 0, 1, 8),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -6, 0.5, 0),
		ZIndex = pill.ZIndex + 1,
		Parent = pill,
	})
	coin.Size = UDim2.fromScale(0, 1.15)
	coin.AutomaticSize = Enum.AutomaticSize.None
	local aspect = coin:FindFirstChildOfClass("UIAspectRatioConstraint")
	if aspect then
		aspect.DominantAxis = Enum.DominantAxis.Height
	end

	local label = Theme.Label({
		Name = "Amount",
		Text = Format.Money(0),
		MaxTextSize = 34,
		Size = UDim2.new(1, -70, 0.78, 0),
		Position = UDim2.new(0, 58, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = pill.ZIndex + 1,
		Parent = pill,
	})

	local shown = 0
	local target = 0
	local animating = false
	local function setAmount(amount: number)
		target = amount
		if animating then
			return
		end
		animating = true
		task.spawn(function()
			local from = shown
			local started = os.clock()
			local duration = if math.abs(target - from) > 0 then 0.45 else 0
			while os.clock() - started < duration do
				local alpha = (os.clock() - started) / duration
				alpha = 1 - (1 - alpha) ^ 3
				shown = from + (target - from) * alpha
				label.Text = Format.Money(shown)
				task.wait()
				if target ~= amount then
					-- New target arrived mid-animation: restart from where we are.
					from = shown
					amount = target
					started = os.clock()
				end
			end
			shown = target
			label.Text = Format.Money(shown)
			animating = false
		end)
		if target > shown + 0.001 then
			Theme.Pop(pill)
		end
	end
	if props.Parent then
		pill.Parent = props.Parent
	end
	return pill, setAmount
end

-- Green money tag floating above the runner squad ("$122.50" in image 2).
function Theme.MoneyTag(props: Props): (Frame, (string) -> ())
	local tag = Instance.new("Frame")
	tag.Name = props.Name or "MoneyTag"
